<Page
    x:Class="MTM_Receiving_Application.Module_Reporting.Views.View_Reporting_PreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_Core.Models.Reporting"
    xmlns:previewModels="using:MTM_Receiving_Application.Module_Reporting.Models"
    Background="Transparent"
    mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Key="PreviewModuleCardTemplate" x:DataType="previewModels:Model_ReportingPreviewModuleCard">
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="0">
                    <Border Padding="12,10" Background="{x:Bind AccentBackgroundBrush}">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{x:Bind AccentForegroundBrush}"
                            Text="{x:Bind CardTitle}"
                            TextWrapping="WrapWholeWords" />
                    </Border>

                    <StackPanel
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        Spacing="16">
                        <StackPanel Spacing="8" Visibility="{x:Bind SummaryVisibility, Mode=OneWay}">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Summary" />

                            <ScrollViewer HorizontalAlignment="Stretch" Style="{StaticResource SharedScrollViewerHorizontalAutoVerticalOffHiddenStyle}">
                                <Border
                                    Width="{x:Bind SummaryTable.TableWidth}"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <StackPanel>
                                        <Border x:Name="SummaryHeaderRow" Background="{x:Bind AccentBackgroundBrush}">
                                            <ItemsControl ItemsSource="{x:Bind SummaryTable.Columns}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:Model_ReportSummaryColumn">
                                                        <Border
                                                            Width="{x:Bind Width}"
                                                            Background="{Binding Background, ElementName=SummaryHeaderRow}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="0,0,1,0">
                                                            <TextBlock
                                                                Padding="12,10"
                                                                HorizontalAlignment="Center"
                                                                FontWeight="SemiBold"
                                                                Foreground="White"
                                                                Text="{x:Bind Header}"
                                                                TextAlignment="Center"
                                                                TextWrapping="WrapWholeWords" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <ItemsControl ItemsSource="{x:Bind SummaryTable.Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:Model_ReportSummaryTableRow">
                                                    <Border
                                                        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="0,0,0,1">
                                                        <ItemsControl ItemsSource="{x:Bind Cells}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:Model_ReportSummaryTableCell">
                                                                    <Border
                                                                        Width="{x:Bind Width}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="0,0,1,0">
                                                                        <TextBlock
                                                                            Padding="12,10"
                                                                            HorizontalAlignment="Center"
                                                                            FontWeight="SemiBold"
                                                                            Text="{x:Bind Value}"
                                                                            TextAlignment="Center" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DetailSectionTitle}" />

                            <TextBlock
                                x:Name="DetailSectionNoteTextBlock"
                                x:Load="{x:Bind HasDetailSectionNote, Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind DetailSectionNote}"
                                TextWrapping="WrapWholeWords" />

                            <TextBlock
                                x:Name="DetailDescriptionTextBlock"
                                x:Load="{x:Bind HasDescription, Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Description}"
                                TextWrapping="WrapWholeWords" />

                            <ScrollViewer HorizontalAlignment="Stretch" Style="{StaticResource SharedScrollViewerHorizontalAutoVerticalOffHiddenStyle}">
                                <Border
                                    Width="{x:Bind DetailTableWidth}"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <StackPanel>
                                        <Border Background="{x:Bind AccentBackgroundBrush}">
                                            <ItemsControl ItemsSource="{x:Bind IncludedColumns}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="previewModels:Model_ReportingPreviewColumnOption">
                                                        <Border
                                                            Width="{x:Bind Width}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="0,0,1,0">
                                                            <TextBlock
                                                                Padding="12,10"
                                                                HorizontalAlignment="Center"
                                                                FontWeight="SemiBold"
                                                                Foreground="White"
                                                                Text="{x:Bind Header}"
                                                                TextAlignment="Center"
                                                                TextWrapping="WrapWholeWords" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <ItemsControl ItemsSource="{x:Bind PreviewRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="previewModels:Model_ReportingPreviewRow">
                                                    <Border
                                                        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="0,0,0,1">
                                                        <ItemsControl ItemsSource="{x:Bind Cells}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="previewModels:Model_ReportingPreviewCell">
                                                                    <Border
                                                                        Width="{x:Bind Width}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="0,0,1,0">
                                                                        <TextBlock
                                                                            Padding="12,10"
                                                                            Text="{x:Bind Value}"
                                                                            TextAlignment="{x:Bind TextAlignment}"
                                                                            TextWrapping="WrapWholeWords" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OptionsModuleTemplate" x:DataType="previewModels:Model_ReportingPreviewModuleCard">
            <StackPanel Spacing="12">
                <CheckBox
                    Content="Include this module in the preview and copied output"
                    FontWeight="SemiBold"
                    IsChecked="{x:Bind IsIncluded, Mode=TwoWay}" />

                <TextBlock
                    x:Name="OptionsDetailSectionNoteTextBlock"
                    x:Load="{x:Bind HasDetailSectionNote, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind DetailSectionNote}"
                    TextWrapping="WrapWholeWords" />

                <TextBlock
                    FontWeight="SemiBold"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Sort rows" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Choose how this module table is ordered in the preview and copied report."
                    TextWrapping="WrapWholeWords" />

                <ComboBox
                    DisplayMemberPath="Label"
                    Header="Sort by"
                    ItemsSource="{x:Bind SortOptions}"
                    SelectedValue="{x:Bind SelectedSortOptionKey, Mode=TwoWay}"
                    SelectedValuePath="Key" />

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton
                        Content="Ascending"
                        IsChecked="{x:Bind IsAscendingSortDirection, Mode=TwoWay}"
                        IsEnabled="{x:Bind IsSortDirectionEnabled, Mode=OneWay}" />
                    <RadioButton
                        Content="Descending"
                        IsChecked="{x:Bind IsDescendingSortDirection, Mode=TwoWay}"
                        IsEnabled="{x:Bind IsSortDirectionEnabled, Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                    FontWeight="SemiBold"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Detail columns" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Only columns that contain data for this module are listed below."
                    TextWrapping="WrapWholeWords" />

                <ItemsControl ItemsSource="{x:Bind AvailableColumns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="previewModels:Model_ReportingPreviewColumnOption">
                            <CheckBox IsChecked="{x:Bind IsIncluded, Mode=TwoWay}" IsEnabled="{x:Bind CanChangeInOptions, Mode=OneWay}">
                                <CheckBox.Content>
                                    <TextBlock Text="{x:Bind Header}" TextWrapping="WrapWholeWords" />
                                </CheckBox.Content>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
            <StackPanel Padding="20,18,20,20" Spacing="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            FontWeight="SemiBold"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.PreviewSummaryTitle, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Review the generated modules below, then use Customize Preview to choose which modules and detail columns stay in the final preview and copied report."
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.OpenOptionsCommand}"
                        Content="Options" />

                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.CopyToRecipientsCommand}"
                        Content="Copy To" />

                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.CopyCcRecipientsCommand}"
                        Content="Copy CC" />

                    <Button
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.CopyEmailFormatCommand}"
                        Content="Copy Report Summary"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <Border
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontWeight="SemiBold"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Included Modules" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.IncludedPreviewModuleCards, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="previewModels:Model_ReportingPreviewModuleCard">
                                    <Border
                                        Margin="0,0,16,0"
                                        Padding="12,6"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind AccentBackgroundBrush}"
                                        CornerRadius="999">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind AccentForegroundBrush}"
                                            Text="{x:Bind ModuleName}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Pivot x:Name="PreviewModulesPivot" x:Load="{x:Bind ViewModel.HasIncludedPreviewModuleCards, Mode=OneWay}">
                    <PivotItem
                        x:Name="ReceivingPreviewPivotItem"
                        x:Load="{x:Bind ViewModel.HasReceivingIncludedPreviewModuleCard, Mode=OneWay}"
                        Header="Receiving">
                        <ContentControl Content="{x:Bind ViewModel.ReceivingPreviewModuleCard, Mode=OneWay}" ContentTemplate="{StaticResource PreviewModuleCardTemplate}" />
                    </PivotItem>
                    <PivotItem
                        x:Name="DunnagePreviewPivotItem"
                        x:Load="{x:Bind ViewModel.HasDunnageIncludedPreviewModuleCard, Mode=OneWay}"
                        Header="Dunnage">
                        <ContentControl Content="{x:Bind ViewModel.DunnagePreviewModuleCard, Mode=OneWay}" ContentTemplate="{StaticResource PreviewModuleCardTemplate}" />
                    </PivotItem>
                    <PivotItem
                        x:Name="VolvoPreviewPivotItem"
                        x:Load="{x:Bind ViewModel.HasVolvoIncludedPreviewModuleCard, Mode=OneWay}"
                        Header="Volvo">
                        <ContentControl Content="{x:Bind ViewModel.VolvoPreviewModuleCard, Mode=OneWay}" ContentTemplate="{StaticResource PreviewModuleCardTemplate}" />
                    </PivotItem>
                </Pivot>
            </StackPanel>
        </ScrollViewer>

        <Border
            x:Name="OptionsOverlayBorder"
            x:Load="{x:Bind ViewModel.IsOptionsOpen, Mode=OneWay}"
            Background="#66000000">
            <Border
                Width="760"
                MaxWidth="760"
                MaxHeight="820"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="8">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Options" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Choose how detail rows are combined, decide which modules stay included, and control which detail columns remain visible."
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <ScrollViewer
                        Grid.Row="1"
                        MaxHeight="680"
                        Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
                        <StackPanel Spacing="20">
                            <Border
                                Padding="8"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="{x:Bind ViewModel.IsRowDisplayModeSettingsExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock
                                                    MaxLines="1"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="Row Display Mode"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="Choose how preview rows are grouped before they are displayed or copied."
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="{x:Bind ViewModel.SelectedRowDisplayModeOption.Label, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Expander.Header>

                                    <StackPanel Margin="0,16,0,0" Spacing="10">
                                        <ComboBox
                                            DisplayMemberPath="Label"
                                            Header="Row display mode"
                                            ItemsSource="{x:Bind ViewModel.RowDisplayModeOptions, Mode=OneWay}"
                                            SelectedItem="{x:Bind ViewModel.SelectedRowDisplayModeOption, Mode=TwoWay}" />

                                        <Border
                                            Padding="12"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel Spacing="6">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="Selected Mode Explanation" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ViewModel.SelectedRowDisplayModeExplanation, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Modules that do not expose part-number grouping data stay in raw-row mode for the part-based combine options."
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <StackPanel Spacing="10">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Module Options" />

                                <Pivot>
                                    <PivotItem
                                        x:Name="ReceivingOptionsPivotItem"
                                        x:Load="{x:Bind ViewModel.HasReceivingPreviewModuleCard, Mode=OneWay}"
                                        Header="Receiving">
                                        <ContentControl Content="{x:Bind ViewModel.ReceivingPreviewModuleCard, Mode=OneWay}" ContentTemplate="{StaticResource OptionsModuleTemplate}" />
                                    </PivotItem>
                                    <PivotItem
                                        x:Name="DunnageOptionsPivotItem"
                                        x:Load="{x:Bind ViewModel.HasDunnagePreviewModuleCard, Mode=OneWay}"
                                        Header="Dunnage">
                                        <ContentControl Content="{x:Bind ViewModel.DunnagePreviewModuleCard, Mode=OneWay}" ContentTemplate="{StaticResource OptionsModuleTemplate}" />
                                    </PivotItem>
                                    <PivotItem
                                        x:Name="VolvoOptionsPivotItem"
                                        x:Load="{x:Bind ViewModel.HasVolvoPreviewModuleCard, Mode=OneWay}"
                                        Header="Volvo">
                                        <ContentControl Content="{x:Bind ViewModel.VolvoPreviewModuleCard, Mode=OneWay}" ContentTemplate="{StaticResource OptionsModuleTemplate}" />
                                    </PivotItem>
                                </Pivot>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Button
                        Grid.Row="2"
                        MinWidth="96"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.CloseOptionsCommand}"
                        Content="Done" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</Page>
