<Project>
  <PropertyGroup>
    <!-- Default to x64 platform for WinUI 3 projects when not explicitly specified -->
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <!-- Exclude the MTM Receiving Manager reference directory from all SDK glob discovery -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildThisFileDirectory)MTM Receiving Manager\**\*;$(MSBuildThisFileDirectory)obj_verify\**\*;**\obj_verify\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    Both advisories are about System.Security.Cryptography.Pkcs, which Microsoft.Data.SqlClient declares
    and .NET 10 prunes for these target frameworks: the package never reaches the output (it is absent
    from deps.json), so what runs is the shared framework's copy instead. Suppressed per advisory rather
    than per warning code, so a different advisory on this or any other package still reports. The real
    fix is the .NET Desktop Runtime, which carries these below 10.0.13; remove these entries once
    Microsoft.Data.SqlClient asks for a patched Pkcs on its own. Declared here so the app and the test
    project, which audits the same graph through its project reference, agree.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" />
  </ItemGroup>
</Project>
