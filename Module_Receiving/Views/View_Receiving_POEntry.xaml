<UserControl
    x:Class="MTM_Receiving_Application.Module_Receiving.Views.View_Receiving_POEntry"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:sharedControls="using:MTM_Receiving_Application.Module_Shared.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_DecimalToInt x:Key="DecimalToIntConverter" />
    </UserControl.Resources>

    <Grid
        x:Name="POEntryRootGrid"
        Padding="24,0,24,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RowSpacing="20">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ReceivingPOEntryAdaptiveStates">
                <VisualState x:Name="ReceivingDefaultState" />
                <VisualState x:Name="ReceivingCompactState">
                    <VisualState.Setters>
                        <Setter Target="POEntryRootGrid.Padding" Value="10,0,10,0" />
                        <Setter Target="POEntryRootGrid.RowSpacing" Value="12" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ReceivingWideState">
                    <VisualState.Setters>
                        <Setter Target="POEntryRootGrid.Padding" Value="20,0,20,0" />
                        <Setter Target="POEntryRootGrid.RowSpacing" Value="20" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Input Section (Row 0)  -->
        <Grid Grid.Row="0">
            <!--  PO Entry Mode  -->
            <StackPanel Visibility="{x:Bind ViewModel.IsNonPOItem, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <!--  PO Number Input with Icon  -->
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE8A5;" />
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.PoNumberHeaderText, Mode=OneWay}" />
                            </StackPanel>

                            <TextBox
                                x:Name="PoNumberTextBox"
                                MinWidth="320"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind ViewModel.PoNumberAccessibilityName, Mode=OneWay}"
                                KeyDown="PoNumberTextBox_KeyDown"
                                LostFocus="POTextBox_LostFocus"
                                PlaceholderText="{x:Bind ViewModel.GetPlaceholder('Field.PONumber'), Mode=OneWay}"
                                TabIndex="0"
                                Text="{x:Bind ViewModel.PoNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  Validation Message  -->
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.PoValidationMessage, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsLoadPOEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                            <!--  PO Status Display  -->
                            <Border
                                Margin="0,8,0,0"
                                Padding="8,4"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8C9;" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.PoStatusLabelText, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.PoStatusDescription, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!--  Action Buttons  -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                AutomationProperties.Name="{x:Bind ViewModel.LoadPoAccessibilityName, Mode=OneWay}"
                                Command="{x:Bind ViewModel.LoadPOCommand}"
                                IsEnabled="{x:Bind ViewModel.IsLoadPOEnabled, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LoadPO'), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE896;" />
                                    <TextBlock Text="{x:Bind ViewModel.LoadPoButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.ToggleNonPOCommand}"
                                Content="{x:Bind ViewModel.SwitchToNonPoButtonText, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.SwitchToNonPO'), Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Non-PO Entry Mode  -->
            <StackPanel Visibility="{x:Bind ViewModel.IsNonPOItem, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <!--  Part ID Input with Icon  -->
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE8B7;" />
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.PartIdentifierHeaderText, Mode=OneWay}" />
                            </StackPanel>

                            <sharedControls:Control_Shared_TypedLookupTextBox
                                x:Name="PartIDLookupControl"
                                AutoResolveFuzzyMatches="False"
                                MinWidth="320"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind ViewModel.PartIdAccessibilityName, Mode=OneWay}"
                                HeaderText=""
                                InputValue="{x:Bind ViewModel.PartID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                LookupType="PartNumber"
                                PlaceholderText="{x:Bind ViewModel.GetPlaceholder('Field.PartID'), Mode=OneWay}"
                                ValidationCompleted="PartIDLookupControl_ValidationCompleted" />
                        </StackPanel>

                        <!--  Package Type Display (Auto-detected)  -->
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}"
                                    Glyph="&#xE7B8;" />
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.PackageTypeAutoHeaderText, Mode=OneWay}" />
                            </StackPanel>

                            <TextBlock
                                Foreground="{StaticResource ReceivingAccentBrush}"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.PackageType, Mode=OneWay}" />
                        </StackPanel>

                        <!--  Action Buttons  -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                AutomationProperties.Name="{x:Bind ViewModel.LookupPartAccessibilityName, Mode=OneWay}"
                                Command="{x:Bind ViewModel.LookupPartCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LookupPart'), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE721;" />
                                    <TextBlock Text="{x:Bind ViewModel.LookupPartButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.ToggleNonPOCommand}"
                                Content="{x:Bind ViewModel.SwitchToPoButtonText, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.SwitchToPO'), Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!--  Loading Indicator  -->
        <ProgressBar
            Grid.Row="0"
            Margin="0,0,0,-10"
            VerticalAlignment="Bottom"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

    </Grid>
</UserControl>
