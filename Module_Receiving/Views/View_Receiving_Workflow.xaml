<Page
    x:Class="MTM_Receiving_Application.Module_Receiving.Views.View_Receiving_Workflow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MTM_Receiving_Application.Module_Receiving.ViewModels"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_BoolToString x:Key="BoolToStringConverter" />
        <converters:Converter_StringFormat x:Key="StringFormatConverter" />
    </Page.Resources>

    <Grid
        x:Name="ReceivingWorkflowRootGrid"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ReceivingWorkflowAdaptiveStates">
                <VisualState x:Name="ReceivingDefaultState" />
                <VisualState x:Name="ReceivingCompactState">
                    <VisualState.Setters>
                        <Setter Target="ReceivingWorkflowContentGrid.Margin" Value="10,10,10,10" />
                        <Setter Target="ReceivingWorkflowNavigationGrid.Margin" Value="12" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ReceivingWideState">
                    <VisualState.Setters>
                        <Setter Target="ReceivingWorkflowContentGrid.Margin" Value="20,16,20,20" />
                        <Setter Target="ReceivingWorkflowNavigationGrid.Margin" Value="28" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Content Area  -->
        <Grid
            x:Name="ReceivingWorkflowContentGrid"
            Grid.Row="1"
            Margin="16,12,16,16"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <!--  Mode Selection View  -->
            <ContentControl
                x:Name="ModeSelectionHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsModeSelectionVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Manual Entry View  -->
            <ContentControl
                x:Name="ManualEntryHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsManualEntryVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Edit Mode View  -->
            <ContentControl
                x:Name="EditModeHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsEditModeVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Reconciliation Review View  -->
            <ContentControl
                x:Name="ReconciliationReviewHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsReconciliationReviewVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Guided Wizard Views  -->
            <!--  PO Entry View  -->
            <ContentControl
                x:Name="POEntryHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsPOEntryVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!--  Load Entry View  -->
            <ContentControl
                x:Name="LoadEntryHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsLoadEntryVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!--  Weight/Quantity Entry View  -->
            <ContentControl
                x:Name="WeightQuantityHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsWeightQuantityEntryVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!--  Heat/Lot Entry View  -->
            <ContentControl
                x:Name="HeatLotHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsHeatLotEntryVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!--  Package Type Entry View  -->
            <ContentControl
                x:Name="PackageTypeHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsPackageTypeEntryVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!--  Review View  -->
            <ContentControl
                x:Name="ReviewHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsReviewVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Saving Progress  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Visibility="{x:Bind ViewModel.IsSavingVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressRing
                    Width="64"
                    Height="64"
                    IsActive="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.SaveProgressMessage, Mode=OneWay}" />
                <ProgressBar
                    MinWidth="300"
                    MaxWidth="600"
                    HorizontalAlignment="Stretch"
                    Maximum="100"
                    Value="{x:Bind ViewModel.SaveProgressValue, Mode=OneWay}" />
            </StackPanel>

            <!--  Completion Summary  -->
            <StackPanel
                MaxWidth="900"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="24"
                Visibility="{x:Bind ViewModel.IsCompleteVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <FontIcon
                    FontSize="64"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xE930;"
                    Visibility="{x:Bind ViewModel.LastSaveResult.Success, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <FontIcon
                    FontSize="64"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="&#xE783;"
                    Visibility="{x:Bind ViewModel.LastSaveResult.Success, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.CompletionSuccessTitleText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.LastSaveResult.Success, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.CompletionFailureTitleText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.LastSaveResult.Success, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />

                <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.LastSaveResult.LoadsSaved, Mode=OneWay}" />
                    <Run Text="{x:Bind ViewModel.CompletionLoadsSavedSuffixText, Mode=OneWay}" />
                </TextBlock>

                <StackPanel
                    Padding="16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8"
                    Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CompletionSaveDetailsTitleText, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.CompletionLabelDataLabelText, Mode=OneWay}" />
                        <TextBlock
                            Foreground="Green"
                            Text="{x:Bind ViewModel.CompletionSavedText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.LastSaveResult.LabelQueueSuccess, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            Foreground="Red"
                            Text="{x:Bind ViewModel.CompletionFailedText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.LastSaveResult.LabelQueueSuccess, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />
                    </StackPanel>

                    <!--  File Path Display  -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.CompletionDatabaseLabelText, Mode=OneWay}" />
                        <TextBlock
                            Foreground="Green"
                            Text="{x:Bind ViewModel.CompletionSavedText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.LastSaveResult.DatabaseSuccess, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            Foreground="Red"
                            Text="{x:Bind ViewModel.CompletionFailedText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.LastSaveResult.DatabaseSuccess, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />
                    </StackPanel>
                </StackPanel>

                <!--  Failure Reason Display  -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.LastSaveResult.Success, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}">
                    <TextBlock
                        Foreground="Red"
                        Text="{x:Bind ViewModel.LastSaveResult.LabelDataErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.LastSaveResult.LabelDataSuccess, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />
                    <TextBlock
                        Foreground="Red"
                        Text="{x:Bind ViewModel.LastSaveResult.DatabaseErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.LastSaveResult.DatabaseSuccess, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        Command="{x:Bind ViewModel.StartNewEntryCommand}"
                        Content="{x:Bind ViewModel.CompletionStartNewEntryText, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.StartNew'), Mode=OneWay}" />
                    <Button
                        Command="{x:Bind ViewModel.ReturnToModeSelectionCommand}"
                        Content="{x:Bind ViewModel.WorkflowModeSelectionText, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.WorkflowModeSelectionText, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--  Navigation Buttons  -->
        <Grid
            x:Name="ReceivingWorkflowNavigationGrid"
            Grid.Row="2"
            Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Left-aligned buttons  -->
            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="OnResetLabelDataClick"
                    Content="{x:Bind ViewModel.WorkflowResetLabelDataText, Mode=OneWay}"
                    Foreground="Red"
                    IsEnabled="{x:Bind ViewModel.CanClearLabelData, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.ResetLabelData'), Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsModeSelectionVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button
                    Background="Transparent"
                    BorderBrush="{ThemeResource SystemAccentColor}"
                    Command="{x:Bind ViewModel.ReturnToModeSelectionCommand}"
                    Content="{x:Bind ViewModel.WorkflowModeSelectionText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsModeSelectionVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />
                <Button
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="OnResetLabelDataClick"
                    Content="{x:Bind ViewModel.WorkflowResetLabelDataText, Mode=OneWay}"
                    Foreground="Red"
                    IsEnabled="{x:Bind ViewModel.CanClearLabelData, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.ResetLabelData'), Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsModeSelectionVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />
            </StackPanel>

            <!--  Right-aligned utility buttons  -->
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="HelpButton_Click"
                    Style="{StaticResource WindowChromeStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.StepHelp'), Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE946;" />
                </Button>
            </StackPanel>

            <!--  Center navigation buttons  -->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="{x:Bind ViewModel.ShowWorkflowNavigationButtons, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Command="{x:Bind ViewModel.PreviousStepCommand}" Visibility="{x:Bind ViewModel.ShowWorkflowBackButton, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE760;" />
                        <TextBlock Text="{x:Bind ViewModel.WorkflowBackText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{x:Bind ViewModel.NextStepCommand}"
                    IsEnabled="{x:Bind ViewModel.IsNextButtonEnabled, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.ShowWorkflowNextButton, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.WorkflowNextText, Mode=OneWay}" />
                        <FontIcon Glyph="&#xE761;" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
