<UserControl
    x:Class="MTM_Receiving_Application.Module_Receiving.Views.View_Receiving_HeatLot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_Receiving.Models"
    x:Name="Root"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:Converter_StringFormat x:Key="StringFormatConverter" />
        <converters:Converter_IntToVisibility x:Key="IntToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Padding="20">
        <!--  Content Section  -->
        <Grid>
            <StackPanel Spacing="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.HeatLotHeaderText, Mode=OneWay}" />

                    <Button
                        Grid.Column="1"
                        Margin="2"
                        Command="{x:Bind ViewModel.AutoFillCommand}"
                        Content="{x:Bind ViewModel.HeatLotAutoFillText, Mode=OneWay}"
                        CornerRadius="8"
                        FontSize="16"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.HeatLotAutoFillTooltipText, Mode=OneWay}" />
                </Grid>

                <ScrollViewer
                    Grid.Row="2"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        x:Name="LoadsItemsControl"
                        FlowDirection="LeftToRight"
                        ItemsSource="{Binding ElementName=Root, Path=ViewModel.Loads}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    MinHeight="90"
                                    Margin="0,0,4,4"
                                    Padding="16,12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Glyph="&#xE7B8;" />
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding LoadNumber, Converter={StaticResource StringFormatConverter}, ConverterParameter='Load #{0}'}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBox
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding ElementName=Root, Path=ViewModel.HeatLotAccessibilityName}"
                                        Header="{Binding ElementName=Root, Path=ViewModel.HeatLotFieldHeaderText}"
                                        PlaceholderText="{Binding ElementName=Root, Path=ViewModel.HeatLotFieldPlaceholderText}"
                                        Text="{Binding HeatLotNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
