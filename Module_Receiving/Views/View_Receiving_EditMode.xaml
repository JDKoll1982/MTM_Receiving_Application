<UserControl
    x:Class="MTM_Receiving_Application.Module_Receiving.Views.View_Receiving_EditMode"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="using:MTM_Receiving_Application.Module_Core.Models.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sharedControls="using:MTM_Receiving_Application.Module_Shared.Views.Controls"
    xmlns:viewmodels="using:MTM_Receiving_Application.Module_Receiving.ViewModels"
    x:Name="Root"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_DecimalToString x:Key="DecimalToStringConverter" />
        <converters:Converter_DateTimeToString x:Key="DateTimeToStringConverter" />
        <converters:Converter_PartIDToQualityHoldBrush x:Key="PartIDToQualityHoldBrushConverter" />
        <converters:Converter_PartIDToQualityHoldTextColor x:Key="PartIDToQualityHoldTextColorConverter" />
    </UserControl.Resources>

    <Grid
        Padding="16"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Row 0: toolbar (load data, date filter, search)  -->
            <RowDefinition Height="*" />
            <!--  Row 1: data grid  -->
            <RowDefinition Height="Auto" />
            <!--  Row 2: footer (pagination + save)  -->
        </Grid.RowDefinitions>

        <!--  ============================================================ Row 0: Ribbon toolbar  -->
        <Border
            Grid.Row="0"
            Padding="10,6"
            Margin="0,0,0,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!--  File  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Edit  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Filter Date  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Find (column picker)  -->
                    <ColumnDefinition Width="*" />
                    <!--  flexible search field  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  result summary  -->
                </Grid.ColumnDefinitions>

                <!--  Group: File  -->
                <StackPanel Grid.Column="0" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button
                            Width="34"
                            Height="34"
                            Padding="0"
                            Command="{x:Bind ViewModel.LoadFromCurrentLabelsCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LoadRecentCSV'), Mode=OneWay}">
                            <FontIcon Glyph="&#xE8E5;" />
                        </Button>
                        <Button
                            Width="34"
                            Height="34"
                            Padding="0"
                            Command="{x:Bind ViewModel.LoadFromHistoryCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LoadHistoricalData'), Mode=OneWay}">
                            <FontIcon Glyph="&#xE74C;" />
                        </Button>
                    </StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="File" />
                </StackPanel>

                <Rectangle
                    Grid.Column="1"
                    Width="1"
                    Height="54"
                    Margin="2,0"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!--  Group: Edit  -->
                <StackPanel Grid.Column="2" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button
                            Width="34"
                            Height="34"
                            Padding="0"
                            Command="{x:Bind ViewModel.SelectAllCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.SelectAll'), Mode=OneWay}">
                            <FontIcon Glyph="&#xE8B3;" />
                        </Button>
                        <Button
                            Width="34"
                            Height="34"
                            Padding="0"
                            Command="{x:Bind ViewModel.RemoveRowCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.RemoveRow'), Mode=OneWay}">
                            <FontIcon Glyph="&#xE74D;" />
                        </Button>
                        <Button
                            x:Name="ColumnsButton"
                            Width="34"
                            Height="34"
                            Padding="0"
                            Click="ColumnsButton_Click"
                            ToolTipService.ToolTip="Choose visible columns">
                            <FontIcon Glyph="&#xE71D;" />
                        </Button>
                    </StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Edit" />
                </StackPanel>

                <Rectangle
                    Grid.Column="3"
                    Width="1"
                    Height="54"
                    Margin="2,0"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!--  Group: Filter Date — single button opens a flyout with range pickers and presets  -->
                <StackPanel Grid.Column="4" Spacing="3">
                    <Button
                        x:Name="DateRangeButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Background="{x:Bind ViewModel.DateRangeButtonBackground, Mode=OneWay}"
                        ToolTipService.ToolTip="Filter by date range">
                        <FontIcon Glyph="&#xE787;" />
                        <Button.Flyout>
                            <Flyout x:Name="DateRangeFlyout" Placement="Bottom">
                                <StackPanel MinWidth="330" Padding="8" Spacing="12">
                                    <!--  Start / End date pickers  -->
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CalendarDatePicker
                                            Grid.Column="0"
                                            Width="112"
                                            Date="{x:Bind ViewModel.FilterStartDate, Mode=TwoWay}"
                                            PlaceholderText="{x:Bind ViewModel.GetPlaceholder('Field.StartDate'), Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind ViewModel.EditModeToText, Mode=OneWay}" />
                                        <CalendarDatePicker
                                            Grid.Column="2"
                                            Width="112"
                                            Date="{x:Bind ViewModel.FilterEndDate, Mode=TwoWay}"
                                            PlaceholderText="{x:Bind ViewModel.GetPlaceholder('Field.EndDate'), Mode=OneWay}" />
                                    </Grid>

                                    <!--  Quick date presets  -->
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button
                                            Background="{x:Bind ViewModel.TodayFilterButtonBackground, Mode=OneWay}"
                                            Click="DateFilterActionButton_Click"
                                            Content="Today"
                                            Tag="{x:Bind ViewModel.SetFilterTodayCommand}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.FilterToday'), Mode=OneWay}" />
                                        <Button
                                            Background="{x:Bind ViewModel.YesterdayFilterButtonBackground, Mode=OneWay}"
                                            Click="DateFilterActionButton_Click"
                                            Content="Yesterday"
                                            Tag="{x:Bind ViewModel.SetFilterYesterdayCommand}"
                                            ToolTipService.ToolTip="Filter to yesterday" />
                                        <Button
                                            Background="{x:Bind ViewModel.ThisWeekFilterButtonBackground, Mode=OneWay}"
                                            Click="DateFilterActionButton_Click"
                                            Content="Week"
                                            Tag="{x:Bind ViewModel.SetFilterThisWeekCommand}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.FilterThisWeek'), Mode=OneWay}" />
                                        <Button
                                            Background="{x:Bind ViewModel.ThisQuarterFilterButtonBackground, Mode=OneWay}"
                                            Click="DateFilterActionButton_Click"
                                            Content="Quarter"
                                            Tag="{x:Bind ViewModel.SetFilterThisQuarterCommand}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.FilterThisQuarter'), Mode=OneWay}" />
                                        <Button
                                            Background="{x:Bind ViewModel.ShowAllFilterButtonBackground, Mode=OneWay}"
                                            Click="DateFilterActionButton_Click"
                                            Content="All"
                                            Tag="{x:Bind ViewModel.SetFilterShowAllCommand}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.ClearFilters'), Mode=OneWay}" />
                                    </StackPanel>

                                    <!--  Apply a custom range  -->
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Click="DateFilterActionButton_Click"
                                        Content="Apply Date Range"
                                        Tag="{x:Bind ViewModel.SearchByDateCommand}"
                                        ToolTipService.ToolTip="Search by date range" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.EditModeFilterDateText, Mode=OneWay}" />
                </StackPanel>

                <Rectangle
                    Grid.Column="5"
                    Width="1"
                    Height="54"
                    Margin="2,0"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!--  Group: Find (column picker)  -->
                <StackPanel Grid.Column="6" Spacing="3">
                    <ComboBox
                        MinWidth="110"
                        ItemsSource="{x:Bind ViewModel.SearchByOptions}"
                        SelectedItem="{x:Bind ViewModel.SearchByColumnKey, Mode=TwoWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Find" />
                </StackPanel>

                <!--  Flexible search field (fills remaining width)  -->
                <Grid
                    Grid.Column="7"
                    Margin="0,0,12,0"
                    VerticalAlignment="Top">
                    <TextBox
                        x:Name="SearchBox"
                        MinWidth="170"
                        Padding="8,5,40,5"
                        PlaceholderText="Type to filter&#x2026;"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Width="32"
                        Height="32"
                        Margin="0,0,2,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.ClearSearchCommand}"
                        ToolTipService.ToolTip="Clear search"
                        Visibility="{x:Bind ViewModel.HasSearchText, Mode=OneWay}">
                        <FontIcon FontSize="11" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <!--  Result summary (right-aligned)  -->
                <TextBlock
                    Grid.Column="8"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontStyle="Italic"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
            </Grid>
        </Border>

        <!--  ============================================================ Row 1: Data Grid  -->
        <controls:DataGrid
            x:Name="EditModeDataGrid"
            Grid.Row="1"
            AutoGenerateColumns="False"
            CanUserSortColumns="True"
            CurrentCellChanged="EditModeDataGrid_CurrentCellChanged"
            GridLinesVisibility="All"
            HeadersVisibility="Column"
            IsReadOnly="False"
            ItemsSource="{x:Bind ViewModel.Loads, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}"
            KeyDown="EditModeDataGrid_KeyDown"
            LoadingRow="EditModeDataGrid_LoadingRow"
            SelectedItem="{x:Bind ViewModel.SelectedLoad, Mode=TwoWay}"
            SelectionMode="Single"
            Sorting="EditModeDataGrid_Sorting"
            Tapped="EditModeDataGrid_Tapped">
            <controls:DataGrid.Columns>
                <!--  Checkbox column — always visible  -->
                <controls:DataGridTemplateColumn
                    Width="50"
                    CanUserResize="False"
                    Header=""
                    Tag="Checkbox">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox
                                MinWidth="0"
                                Margin="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <!--  LoadNumber — always visible  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding LoadNumber}"
                    Header="{x:Bind ViewModel.EditModeColumnLoadNumberText, Mode=OneWay}"
                    IsReadOnly="True"
                    Tag="LoadNumber" />

                <!--  ReceivedDate  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding ReceivedDate, Converter={StaticResource DateTimeToStringConverter}}"
                    Header="Received Date"
                    IsReadOnly="True"
                    Tag="ReceivedDate" />

                <!--  PartID — always visible, quality-hold coloured  -->
                <controls:DataGridTemplateColumn
                    Width="*"
                    Header="{x:Bind ViewModel.EditModeColumnPartIdText, Mode=OneWay}"
                    Tag="PartID">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Padding="12,0"
                                VerticalAlignment="Center"
                                Foreground="{Binding PartID, Converter={StaticResource PartIDToQualityHoldTextColorConverter}}"
                                Text="{Binding PartID}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                    <controls:DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <sharedControls:Control_Shared_TypedLookupTextBox
                                VerticalAlignment="Stretch"
                                AutoResolveFuzzyMatches="False"
                                GotFocus="LookupControl_GotFocus"
                                HeaderText=""
                                InputValue="{Binding PartID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                LookupType="PartNumber"
                                LostFocus="LookupControl_LostFocus"
                                Loaded="PartLookupControl_Loaded"
                                ValidationCompleted="PartLookupControl_ValidationCompleted" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellEditingTemplate>
                </controls:DataGridTemplateColumn>

                <!--  PartType  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PartType}"
                    Header="Part Type"
                    Tag="PartType" />

                <!--  PONumber  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PoNumber}"
                    Header="PO Number"
                    Tag="PONumber" />

                <!--  POLineNumber  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PoLineNumber}"
                    Header="PO Line #"
                    IsReadOnly="True"
                    Tag="POLineNumber" />

                <!--  WeightQuantity  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding WeightQuantity, Converter={StaticResource DecimalToStringConverter}}"
                    Header="{x:Bind ViewModel.EditModeColumnWeightQtyText, Mode=OneWay}"
                    Tag="WeightQuantity" />

                <!--  HeatLotNumber  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding HeatLotNumber}"
                    Header="{x:Bind ViewModel.EditModeColumnHeatLotText, Mode=OneWay}"
                    Tag="HeatLotNumber" />

                <!--  InitialLocation  -->
                <controls:DataGridTemplateColumn
                    Width="Auto"
                    Header="Location"
                    Tag="InitialLocation">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Padding="12,0"
                                VerticalAlignment="Center"
                                Text="{Binding InitialLocation}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                    <controls:DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <sharedControls:Control_Shared_TypedLookupTextBox
                                VerticalAlignment="Stretch"
                                AutoResolveFuzzyMatches="False"
                                GotFocus="LookupControl_GotFocus"
                                HeaderText=""
                                InputValue="{Binding InitialLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                LookupType="Location"
                                LostFocus="LookupControl_LostFocus"
                                Loaded="LocationLookupControl_Loaded"
                                ValidationCompleted="LocationLookupControl_ValidationCompleted"
                                WarehouseCode="002" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellEditingTemplate>
                </controls:DataGridTemplateColumn>

                <!--  RemainingQuantity  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding RemainingQuantity, Converter={StaticResource DecimalToStringConverter}}"
                    Header="Remaining Qty"
                    IsReadOnly="True"
                    Tag="RemainingQuantity" />

                <!--  PackagesPerLoad  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PackagesPerLoad}"
                    Header="{x:Bind ViewModel.EditModeColumnPkgsPerLoadText, Mode=OneWay}"
                    Tag="PackagesPerLoad" />

                <!--  PackageType  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PackageTypeName}"
                    Header="{x:Bind ViewModel.EditModeColumnPkgTypeText, Mode=OneWay}"
                    IsReadOnly="True"
                    Tag="PackageType" />

                <!--  WeightPerPackage  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding WeightPerPackageValueDisplay}"
                    Header="{x:Bind ViewModel.EditModeColumnWtPerPkgText, Mode=OneWay}"
                    IsReadOnly="True"
                    Tag="WeightPerPackage" />

                <!--  IsNonPOItem  -->
                <controls:DataGridCheckBoxColumn
                    Width="Auto"
                    Binding="{Binding IsNonPOItem}"
                    Header="Non-PO?"
                    IsReadOnly="True"
                    Tag="IsNonPOItem" />

                <!--  UserId  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding UserId}"
                    Header="User"
                    IsReadOnly="True"
                    Tag="UserId" />

                <!--  EmployeeNumber  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding EmployeeNumber}"
                    Header="Employee #"
                    IsReadOnly="True"
                    Tag="EmployeeNumber" />

                <!--  IsQualityHoldRequired  -->
                <controls:DataGridCheckBoxColumn
                    Width="Auto"
                    Binding="{Binding IsQualityHoldRequired}"
                    Header="QH Required?"
                    IsReadOnly="True"
                    Tag="IsQualityHoldRequired" />

                <!--  IsQualityHoldAcknowledged  -->
                <controls:DataGridCheckBoxColumn
                    Width="Auto"
                    Binding="{Binding IsQualityHoldAcknowledged}"
                    Header="QH Acknowledged?"
                    IsReadOnly="True"
                    Tag="IsQualityHoldAcknowledged" />

                <!--  QualityHoldRestrictionType  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding QualityHoldRestrictionType}"
                    Header="QH Restriction"
                    IsReadOnly="True"
                    Tag="QualityHoldRestrictionType" />

                <!--  PartDescription  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PartDescription}"
                    Header="Part Description"
                    IsReadOnly="True"
                    Tag="PartDescription" />

                <!--  UnitOfMeasure  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding UnitOfMeasure}"
                    Header="UOM"
                    IsReadOnly="True"
                    Tag="UnitOfMeasure" />

                <!--  QtyOrdered  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding QtyOrdered, Converter={StaticResource DecimalToStringConverter}}"
                    Header="Qty Ordered"
                    IsReadOnly="True"
                    Tag="QtyOrdered" />

                <!--  POVendor  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PoVendor}"
                    Header="Vendor"
                    IsReadOnly="True"
                    Tag="POVendor" />

                <!--  POStatus  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PoStatus}"
                    Header="PO Status"
                    IsReadOnly="True"
                    Tag="POStatus" />

                <!--  PODueDate  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PoDueDate, Converter={StaticResource DateTimeToStringConverter}}"
                    Header="PO Due Date"
                    IsReadOnly="True"
                    Tag="PODueDate" />
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!--  ============================================================ Empty state overlay (Row 3)  -->
        <Grid
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
            <Image
                MaxWidth="520"
                MaxHeight="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/Backgrounds/NothingFound.jpg"
                Stretch="UniformToFill" />
        </Grid>

        <!--  ============================================================ Row 4: Footer (Pagination + Save)  -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Pagination Controls  -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{x:Bind ViewModel.FirstPageCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.FirstPage'), Mode=OneWay}">
                    <FontIcon Glyph="&#xE892;" />
                </Button>
                <Button Command="{x:Bind ViewModel.PreviousPageCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.PreviousPage'), Mode=OneWay}">
                    <FontIcon Glyph="&#xE76B;" />
                </Button>

                <Rectangle
                    Width="1"
                    Height="24"
                    Margin="8,0"
                    Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.EditModePageText, Mode=OneWay}" />
                <TextBox
                    x:Name="GoToPageTextBox"
                    Width="60"
                    HorizontalContentAlignment="Center"
                    KeyDown="GoToPageTextBox_KeyDown"
                    Text="{x:Bind ViewModel.GotoPageNumber, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.EditModeOfText, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}" />

                <Button
                    Command="{x:Bind ViewModel.GoToPageCommand}"
                    Content="{x:Bind ViewModel.EditModeGoText, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.GoToPage'), Mode=OneWay}" />

                <Rectangle
                    Width="1"
                    Height="24"
                    Margin="8,0"
                    Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                <Button Command="{x:Bind ViewModel.NextPageCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.NextPage'), Mode=OneWay}">
                    <FontIcon Glyph="&#xE76C;" />
                </Button>
                <Button Command="{x:Bind ViewModel.LastPageCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LastPage'), Mode=OneWay}">
                    <FontIcon Glyph="&#xE893;" />
                </Button>
            </StackPanel>

            <!--  Page size selector  -->
            <StackPanel
                Grid.Column="1"
                Margin="8,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Text="Per page:" />
                <ComboBox
                    MinWidth="70"
                    ItemsSource="{x:Bind ViewModel.PageSizeOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedPageSize, Mode=TwoWay}" />
            </StackPanel>

            <!--  Save button  -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Content="{x:Bind ViewModel.EditModeSaveAndFinishText, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.SaveAndFinish'), Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!--  ============================================================ IsBusy Overlay  -->
        <Grid Grid.RowSpan="5" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <Rectangle Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.7" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <ProgressRing
                    Width="48"
                    Height="48"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
