<UserControl
    x:Class="MTM_Receiving_Application.Module_Receiving.Views.View_Receiving_EditMode"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="using:MTM_Receiving_Application.Module_Core.Models.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MTM_Receiving_Application.Module_Receiving.ViewModels"
    x:Name="Root"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:Converter_DecimalToString x:Key="DecimalToStringConverter" />
        <converters:Converter_DateTimeToString x:Key="DateTimeToStringConverter" />
        <converters:Converter_PartIDToQualityHoldBrush x:Key="PartIDToQualityHoldBrushConverter" />
        <converters:Converter_PartIDToQualityHoldTextColor x:Key="PartIDToQualityHoldTextColorConverter" />
    </UserControl.Resources>

    <Grid
        Padding="16"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Row 0: main toolbar  -->
            <RowDefinition Height="Auto" />
            <!--  Row 1: date filter toolbar  -->
            <RowDefinition Height="Auto" />
            <!--  Row 2: search bar + result summary  -->
            <RowDefinition Height="*" />
            <!--  Row 3: data grid  -->
            <RowDefinition Height="Auto" />
            <!--  Row 4: footer (pagination + save)  -->
        </Grid.RowDefinitions>

        <!--  ============================================================ Row 0: Main Toolbar  -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <!--  Load Data Section  -->
                <TextBlock
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.EditModeLoadDataFromText, Mode=OneWay}" />

                <Button Command="{x:Bind ViewModel.LoadFromCurrentLabelsCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LoadRecentCSV'), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" />
                        <TextBlock Text="{x:Bind ViewModel.EditModeCurrentLabelsText, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.LoadFromHistoryCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LoadHistoricalData'), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74C;" />
                        <TextBlock Text="{x:Bind ViewModel.EditModeHistoryText, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <!--  Separator  -->
                <Rectangle
                    Width="1"
                    Height="24"
                    Margin="8,0"
                    Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                <!--  Edit Actions  -->
                <Button Command="{x:Bind ViewModel.SelectAllCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.SelectAll'), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B3;" />
                        <TextBlock Text="{x:Bind ViewModel.SelectAllButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.RemoveRowCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.RemoveRow'), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" />
                        <TextBlock Text="{x:Bind ViewModel.EditModeRemoveRowText, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <!--  Separator  -->
                <Rectangle
                    Width="1"
                    Height="24"
                    Margin="8,0"
                    Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                <!--  Column Chooser  -->
                <Button
                    x:Name="ColumnsButton"
                    Click="ColumnsButton_Click"
                    ToolTipService.ToolTip="Choose visible columns">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71D;" />
                        <TextBlock Text="Columns" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  Help button (right-aligned)  -->
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.ShowHelpCommand}"
                ToolTipService.ToolTip="Help">
                <FontIcon Glyph="&#xE897;" />
            </Button>
        </Grid>

        <!--  ============================================================ Row 1: Date Filter Toolbar  -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.EditModeFilterDateText, Mode=OneWay}" />

                <CalendarDatePicker
                    Width="140"
                    Date="{x:Bind ViewModel.FilterStartDate, Mode=TwoWay}"
                    PlaceholderText="{x:Bind ViewModel.GetPlaceholder('Field.StartDate'), Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.EditModeToText, Mode=OneWay}" />
                <CalendarDatePicker
                    Width="140"
                    Date="{x:Bind ViewModel.FilterEndDate, Mode=TwoWay}"
                    PlaceholderText="{x:Bind ViewModel.GetPlaceholder('Field.EndDate'), Mode=OneWay}" />

                <Rectangle
                    Width="1"
                    Height="24"
                    Margin="8,0"
                    Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                <Button
                    Command="{x:Bind ViewModel.SetFilterLastWeekCommand}"
                    Content="{x:Bind ViewModel.EditModeLastWeekText, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.FilterLastWeek'), Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.SetFilterTodayCommand}"
                    Content="{x:Bind ViewModel.EditModeTodayText, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.FilterToday'), Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.SetFilterThisWeekCommand}"
                    Content="{x:Bind ViewModel.EditModeThisWeekText, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.FilterThisWeek'), Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.SetFilterThisMonthCommand}"
                    Content="{x:Bind ViewModel.ThisMonthButtonText, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.FilterThisMonth'), Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.SetFilterThisQuarterCommand}"
                    Content="{x:Bind ViewModel.ThisQuarterButtonText, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.FilterThisQuarter'), Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.SetFilterShowAllCommand}"
                    Content="{x:Bind ViewModel.EditModeShowAllText, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.ClearFilters'), Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!--  ============================================================ Row 2: Search Bar + Result Summary  -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  "Search by" label  -->
            <TextBlock
                Grid.Column="0"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="Search by:" />

            <!--  Column selector  -->
            <ComboBox
                Grid.Column="1"
                MinWidth="130"
                ItemsSource="{x:Bind ViewModel.SearchByOptions}"
                SelectedItem="{x:Bind ViewModel.SearchByColumnKey, Mode=TwoWay}" />

            <!--  Small separator  -->
            <Rectangle
                Grid.Column="2"
                Width="1"
                Height="20"
                Margin="8,0"
                Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" />

            <!--  Search TextBox with overlay clear button  -->
            <Grid Grid.Column="3" Width="280">
                <TextBox
                    x:Name="SearchBox"
                    Padding="8,5,40,5"
                    PlaceholderText="Type to filter&#x2026;"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Width="32"
                    Height="32"
                    Margin="0,0,2,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ClearSearchCommand}"
                    ToolTipService.ToolTip="Clear search"
                    Visibility="{x:Bind ViewModel.HasSearchText, Mode=OneWay}">
                    <FontIcon FontSize="11" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <!--  Result summary  -->
            <TextBlock
                Grid.Column="5"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontStyle="Italic"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
        </Grid>

        <!--  ============================================================ Row 3: Data Grid  -->
        <controls:DataGrid
            x:Name="EditModeDataGrid"
            Grid.Row="3"
            AutoGenerateColumns="False"
            CanUserSortColumns="True"
            CurrentCellChanged="EditModeDataGrid_CurrentCellChanged"
            GridLinesVisibility="All"
            HeadersVisibility="Column"
            IsReadOnly="False"
            ItemsSource="{x:Bind ViewModel.Loads, Mode=OneWay}"
            KeyDown="EditModeDataGrid_KeyDown"
            SelectedItem="{x:Bind ViewModel.SelectedLoad, Mode=TwoWay}"
            SelectionMode="Single"
            Sorting="EditModeDataGrid_Sorting"
            Tapped="EditModeDataGrid_Tapped">
            <controls:DataGrid.Columns>
                <!--  Checkbox column — always visible  -->
                <controls:DataGridTemplateColumn
                    Width="50"
                    CanUserResize="False"
                    Header=""
                    Tag="Checkbox">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox
                                MinWidth="0"
                                Margin="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <!--  LoadNumber — always visible  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding LoadNumber}"
                    Header="{x:Bind ViewModel.EditModeColumnLoadNumberText, Mode=OneWay}"
                    IsReadOnly="True"
                    Tag="LoadNumber" />

                <!--  ReceivedDate  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding ReceivedDate, Converter={StaticResource DateTimeToStringConverter}}"
                    Header="Received Date"
                    IsReadOnly="True"
                    Tag="ReceivedDate" />

                <!--  PartID — always visible, quality-hold coloured  -->
                <controls:DataGridTemplateColumn
                    Width="*"
                    Header="{x:Bind ViewModel.EditModeColumnPartIdText, Mode=OneWay}"
                    Tag="PartID">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Padding="12,0"
                                VerticalAlignment="Center"
                                Foreground="{Binding PartID, Converter={StaticResource PartIDToQualityHoldTextColorConverter}}"
                                Text="{Binding PartID}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                    <controls:DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox
                                VerticalAlignment="Stretch"
                                BorderThickness="0"
                                Text="{Binding PartID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellEditingTemplate>
                </controls:DataGridTemplateColumn>

                <!--  PartType  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PartType}"
                    Header="Part Type"
                    Tag="PartType" />

                <!--  PONumber  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PoNumber}"
                    Header="PO Number"
                    Tag="PONumber" />

                <!--  POLineNumber  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PoLineNumber}"
                    Header="PO Line #"
                    IsReadOnly="True"
                    Tag="POLineNumber" />

                <!--  WeightQuantity  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding WeightQuantity, Converter={StaticResource DecimalToStringConverter}}"
                    Header="{x:Bind ViewModel.EditModeColumnWeightQtyText, Mode=OneWay}"
                    Tag="WeightQuantity" />

                <!--  HeatLotNumber  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding HeatLotNumber}"
                    Header="{x:Bind ViewModel.EditModeColumnHeatLotText, Mode=OneWay}"
                    Tag="HeatLotNumber" />

                <!--  InitialLocation  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding InitialLocation}"
                    Header="Location"
                    Tag="InitialLocation" />

                <!--  RemainingQuantity  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding RemainingQuantity, Converter={StaticResource DecimalToStringConverter}}"
                    Header="Remaining Qty"
                    IsReadOnly="True"
                    Tag="RemainingQuantity" />

                <!--  PackagesPerLoad  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PackagesPerLoad}"
                    Header="{x:Bind ViewModel.EditModeColumnPkgsPerLoadText, Mode=OneWay}"
                    Tag="PackagesPerLoad" />

                <!--  PackageType  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PackageTypeName}"
                    Header="{x:Bind ViewModel.EditModeColumnPkgTypeText, Mode=OneWay}"
                    IsReadOnly="True"
                    Tag="PackageType" />

                <!--  WeightPerPackage  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding WeightPerPackageValueDisplay}"
                    Header="{x:Bind ViewModel.EditModeColumnWtPerPkgText, Mode=OneWay}"
                    IsReadOnly="True"
                    Tag="WeightPerPackage" />

                <!--  IsNonPOItem  -->
                <controls:DataGridCheckBoxColumn
                    Width="Auto"
                    Binding="{Binding IsNonPOItem}"
                    Header="Non-PO?"
                    IsReadOnly="True"
                    Tag="IsNonPOItem" />

                <!--  UserId  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding UserId}"
                    Header="User"
                    IsReadOnly="True"
                    Tag="UserId" />

                <!--  EmployeeNumber  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding EmployeeNumber}"
                    Header="Employee #"
                    IsReadOnly="True"
                    Tag="EmployeeNumber" />

                <!--  IsQualityHoldRequired  -->
                <controls:DataGridCheckBoxColumn
                    Width="Auto"
                    Binding="{Binding IsQualityHoldRequired}"
                    Header="QH Required?"
                    IsReadOnly="True"
                    Tag="IsQualityHoldRequired" />

                <!--  IsQualityHoldAcknowledged  -->
                <controls:DataGridCheckBoxColumn
                    Width="Auto"
                    Binding="{Binding IsQualityHoldAcknowledged}"
                    Header="QH Acknowledged?"
                    IsReadOnly="True"
                    Tag="IsQualityHoldAcknowledged" />

                <!--  QualityHoldRestrictionType  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding QualityHoldRestrictionType}"
                    Header="QH Restriction"
                    IsReadOnly="True"
                    Tag="QualityHoldRestrictionType" />

                <!--  PartDescription  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PartDescription}"
                    Header="Part Description"
                    IsReadOnly="True"
                    Tag="PartDescription" />

                <!--  UnitOfMeasure  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding UnitOfMeasure}"
                    Header="UOM"
                    IsReadOnly="True"
                    Tag="UnitOfMeasure" />

                <!--  QtyOrdered  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding QtyOrdered, Converter={StaticResource DecimalToStringConverter}}"
                    Header="Qty Ordered"
                    IsReadOnly="True"
                    Tag="QtyOrdered" />

                <!--  POVendor  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PoVendor}"
                    Header="Vendor"
                    IsReadOnly="True"
                    Tag="POVendor" />

                <!--  POStatus  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PoStatus}"
                    Header="PO Status"
                    IsReadOnly="True"
                    Tag="POStatus" />

                <!--  PODueDate  -->
                <controls:DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding PoDueDate, Converter={StaticResource DateTimeToStringConverter}}"
                    Header="PO Due Date"
                    IsReadOnly="True"
                    Tag="PODueDate" />
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!--  ============================================================ Row 4: Footer (Pagination + Save)  -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Pagination Controls  -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{x:Bind ViewModel.FirstPageCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.FirstPage'), Mode=OneWay}">
                    <FontIcon Glyph="&#xE892;" />
                </Button>
                <Button Command="{x:Bind ViewModel.PreviousPageCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.PreviousPage'), Mode=OneWay}">
                    <FontIcon Glyph="&#xE76B;" />
                </Button>

                <Rectangle
                    Width="1"
                    Height="24"
                    Margin="8,0"
                    Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.EditModePageText, Mode=OneWay}" />
                <TextBox
                    x:Name="GoToPageTextBox"
                    Width="60"
                    HorizontalContentAlignment="Center"
                    KeyDown="GoToPageTextBox_KeyDown"
                    Text="{x:Bind ViewModel.GotoPageNumber, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.EditModeOfText, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}" />

                <Button
                    Command="{x:Bind ViewModel.GoToPageCommand}"
                    Content="{x:Bind ViewModel.EditModeGoText, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.GoToPage'), Mode=OneWay}" />

                <Rectangle
                    Width="1"
                    Height="24"
                    Margin="8,0"
                    Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                <Button Command="{x:Bind ViewModel.NextPageCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.NextPage'), Mode=OneWay}">
                    <FontIcon Glyph="&#xE76C;" />
                </Button>
                <Button Command="{x:Bind ViewModel.LastPageCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LastPage'), Mode=OneWay}">
                    <FontIcon Glyph="&#xE893;" />
                </Button>
            </StackPanel>

            <!--  Page size selector  -->
            <StackPanel
                Grid.Column="1"
                Margin="8,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Text="Per page:" />
                <ComboBox
                    MinWidth="70"
                    ItemsSource="{x:Bind ViewModel.PageSizeOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedPageSize, Mode=TwoWay}" />
            </StackPanel>

            <!--  Save button  -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Content="{x:Bind ViewModel.EditModeSaveAndFinishText, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.SaveAndFinish'), Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!--  ============================================================ IsBusy Overlay  -->
        <Grid Grid.RowSpan="5" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <Rectangle Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.7" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <ProgressRing
                    Width="48"
                    Height="48"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
