<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Brand accent brushes for the three primary working modules.
        Single source of truth shared by the Receiving, Dunnage, Volvo,
        Reporting, and Reprint modules. These are fixed brand colors, so they
        are referenced with StaticResource and stay the same in light/dark themes.
    -->
    <SolidColorBrush x:Key="ReceivingAccentBrush" Color="#0B6157" />
    <SolidColorBrush x:Key="DunnageAccentBrush" Color="#8A5E00" />
    <SolidColorBrush x:Key="VolvoAccentBrush" Color="#1E4F7A" />
    <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="#FFFFFF" />
</ResourceDictionary>
