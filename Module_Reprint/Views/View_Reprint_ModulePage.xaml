<Page
    x:Class="MTM_Receiving_Application.Module_Reprint.Views.View_Reprint_ModulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:previewModels="using:MTM_Receiving_Application.Module_Reprint.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="20,18,20,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Filters Row  -->
        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CalendarDatePicker
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}"
                Header="From" />

            <CalendarDatePicker
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}"
                Header="To" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                <Button Content="All" Command="{x:Bind ViewModel.LoadAllCommand}" />
                <Button
                    Width="34"
                    Height="34"
                    Padding="0"
                    Command="{x:Bind ViewModel.ToggleDatePresetsCommand}"
                    ToolTipService.ToolTip="More date ranges">
                    <FontIcon
                        FontSize="12"
                        Glyph="{x:Bind ViewModel.DatePresetsToggleGlyph, Mode=OneWay}" />
                </Button>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="{x:Bind ViewModel.DatePresetsExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="Today" Command="{x:Bind ViewModel.LoadTodayCommand}" />
                    <Button Content="Yesterday" Command="{x:Bind ViewModel.LoadYesterdayCommand}" />
                    <Button Content="Week" Command="{x:Bind ViewModel.LoadThisWeekCommand}" />
                    <Button Content="Month" Command="{x:Bind ViewModel.LoadThisMonthCommand}" />
                    <Button Content="Quarter" Command="{x:Bind ViewModel.LoadThisQuarterCommand}" />
                </StackPanel>
            </StackPanel>

            <ComboBox
                Grid.Column="3"
                Header="Search By"
                DisplayMemberPath="Label"
                ItemsSource="{x:Bind ViewModel.SearchByOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedSearchBy, Mode=TwoWay}" />

            <TextBox
                Grid.Column="4"
                Header="Search"
                PlaceholderText="Type to search history..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

            <Button
                Grid.Column="5"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.ReloadCommand}"
                Content="Search" />

            <Button
                Grid.Column="6"
                VerticalAlignment="Bottom"
                Click="SearchPickerButton_Click"
                Content="Pick"
                ToolTipService.ToolTip="Pick a part from the loaded history to search by" />

            <Button
                Grid.Column="7"
                VerticalAlignment="Bottom"
                Click="ColumnsButton_Click"
                ToolTipService.ToolTip="Choose visible columns">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71D;" />
                    <TextBlock Text="Columns" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  History Grid  -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnSpacing="8" Padding="8,6" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="" />
                    <TextBlock x:Name="DateHeader" Grid.Column="1" FontWeight="SemiBold" Text="Date" />
                    <TextBlock x:Name="PartHeader" Grid.Column="2" FontWeight="SemiBold" Text="Part" />
                    <TextBlock x:Name="QtyHeader" Grid.Column="3" FontWeight="SemiBold" Text="Qty" HorizontalAlignment="Right" />
                    <TextBlock x:Name="ReferenceHeader" Grid.Column="4" FontWeight="SemiBold" Text="Reference" />
                </Grid>

                <ListView
                    x:Name="HistoryListView"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.HistoryRows, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="previewModels:Model_ReprintSelectableRow">
                            <Border Background="{x:Bind RowBackground}">
                                <Grid
                                    ColumnSpacing="8"
                                    Padding="8,4"
                                    ColumnDefinitions="36,*,*,90,*">
                                    <CheckBox
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                        IsEnabled="{x:Bind CanSelect}"
                                        Visibility="{x:Bind CanSelect, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind RecordDate}"
                                        Visibility="{x:Bind ShowDateColumn, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Part}"
                                        Visibility="{x:Bind ShowPartColumn, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Quantity}"
                                        Visibility="{x:Bind ShowQtyColumn, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Reference}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind ShowReferenceColumn, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!--  Bottom Footer  -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox
                Grid.Column="0"
                VerticalAlignment="Center"
                Content="{x:Bind ViewModel.SelectAllLabel, Mode=OneWay}"
                IsChecked="{x:Bind ViewModel.IsSelectAllChecked, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.IsSelectAllEnabled, Mode=OneWay}" />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" />

            <Button
                Grid.Column="3"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.BackCommand}"
                Content="Back" />

            <Button
                Grid.Column="4"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.ReprintCommand}"
                Content="{x:Bind ViewModel.ReprintButtonLabel, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
