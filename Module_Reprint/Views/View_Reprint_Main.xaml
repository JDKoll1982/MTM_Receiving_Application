<Page
    x:Class="MTM_Receiving_Application.Module_Reprint.Views.View_Reprint_Main"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            ReceivingAccentBrush / DunnageAccentBrush / VolvoAccentBrush are
            resolved from the shared Module_Core/Themes/ModuleAccentBrushes.xaml.
        -->

        <!--
            Card-style button for the Reprint mode cards. Uses a custom template so the
            solid accent Background stays opaque on hover/press (an opaque darkening
            overlay) instead of the default Button PointerOver brush that washes the
            accent out to near-transparent.
        -->
        <Style x:Key="ReprintModeCardButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                            <Border
                                x:Name="HoverOverlay"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Background" Value="#22000000" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Background" Value="#40000000" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="CardBorder.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
        <StackPanel Padding="20,18,20,20" Spacing="16">
            <Button
                Width="36"
                Height="36"
                Padding="0"
                HorizontalAlignment="Right"
                AutomationProperties.Name="Help"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OnHelpClick"
                CornerRadius="4"
                ToolTipService.ToolTip="Help">
                <FontIcon FontSize="16" Glyph="&#xE946;" />
            </Button>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Choose a module to reprint labels from" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Pick a module, review its history, check the rows you want to reprint, then click Reprint Selected to move them back into the active label queue."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Border
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Receiving module card  -->
                    <Grid Grid.Column="0" Padding="12">
                        <Button
                            MinHeight="220"
                            Padding="20"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="Reprint Receiving labels"
                            Background="{StaticResource ReceivingAccentBrush}"
                            Command="{x:Bind ViewModel.SelectReceivingCommand}"
                            Style="{StaticResource ReprintModeCardButtonStyle}">
                            <StackPanel VerticalAlignment="Center" Spacing="12">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontSize="42"
                                    Foreground="White"
                                    Glyph="&#xE74C;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Receiving"
                                    TextAlignment="Center" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="White"
                                    Opacity="0.9"
                                    Text="Receiving labels"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--  Dunnage module card  -->
                    <Grid Grid.Column="1" Padding="12">
                        <Button
                            MinHeight="220"
                            Padding="20"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="Reprint Dunnage labels"
                            Background="{StaticResource DunnageAccentBrush}"
                            Command="{x:Bind ViewModel.SelectDunnageCommand}"
                            Style="{StaticResource ReprintModeCardButtonStyle}">
                            <StackPanel VerticalAlignment="Center" Spacing="12">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontSize="42"
                                    Foreground="White"
                                    Glyph="&#xEA18;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Dunnage"
                                    TextAlignment="Center" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="White"
                                    Opacity="0.9"
                                    Text="Dunnage labels"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--  Volvo module card  -->
                    <Grid Grid.Column="2" Padding="12">
                        <Button
                            MinHeight="220"
                            Padding="20"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="Reprint Volvo labels"
                            Background="{StaticResource VolvoAccentBrush}"
                            Command="{x:Bind ViewModel.SelectVolvoCommand}"
                            Style="{StaticResource ReprintModeCardButtonStyle}">
                            <StackPanel VerticalAlignment="Center" Spacing="12">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontSize="42"
                                    Foreground="White"
                                    Glyph="&#xE7B8;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Volvo"
                                    TextAlignment="Center" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="White"
                                    Opacity="0.9"
                                    Text="Volvo generated labels"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
