<Page
    x:Class="MTM_Receiving_Application.Module_Reprint.Views.View_Reprint_Main"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            ReceivingAccentBrush / DunnageAccentBrush / VolvoAccentBrush are
            resolved from the shared Module_Core/Themes/ModuleAccentBrushes.xaml.
        -->

        <!--
            Card-style button for the Reprint mode cards. Uses a custom template so the
            solid accent Background stays opaque on hover/press (an opaque darkening
            overlay) instead of the default Button PointerOver brush that washes the
            accent out to near-transparent.
        -->
        <Style x:Key="ReprintModeCardButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                            <Border
                                x:Name="HoverOverlay"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Background" Value="#22000000" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Background" Value="#40000000" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="CardBorder.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
        <StackPanel Padding="20,18,20,20" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Choose a module to reprint labels from" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Pick a module, review its history, check the rows you want to reprint, then click Reprint Selected to move them back into the active label queue."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Width="220"
                    Height="220"
                    Background="{StaticResource ReceivingAccentBrush}"
                    Command="{x:Bind ViewModel.SelectReceivingCommand}"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ReprintModeCardButtonStyle}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE74C;" FontSize="42" Foreground="White" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White" Text="Receiving" TextAlignment="Center" />
                        <TextBlock FontSize="12" Foreground="White" Opacity="0.9" Text="Receiving labels" TextAlignment="Center" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="1"
                    Width="220"
                    Height="220"
                    Background="{StaticResource DunnageAccentBrush}"
                    Command="{x:Bind ViewModel.SelectDunnageCommand}"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ReprintModeCardButtonStyle}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xEA18;" FontSize="42" Foreground="White" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White" Text="Dunnage" TextAlignment="Center" />
                        <TextBlock FontSize="12" Foreground="White" Opacity="0.9" Text="Dunnage labels" TextAlignment="Center" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    Width="220"
                    Height="220"
                    Background="{StaticResource VolvoAccentBrush}"
                    Command="{x:Bind ViewModel.SelectVolvoCommand}"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ReprintModeCardButtonStyle}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE7B8;" FontSize="42" Foreground="White" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White" Text="Volvo" TextAlignment="Center" />
                        <TextBlock FontSize="12" Foreground="White" Opacity="0.9" Text="Volvo generated labels" TextAlignment="Center" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
