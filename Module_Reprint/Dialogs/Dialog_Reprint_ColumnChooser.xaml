<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Reprint.Dialogs.Dialog_Reprint_ColumnChooser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Choose visible columns"
    Opened="Dialog_Opened">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">720</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">640</x:Double>
    </ContentDialog.Resources>
    <Grid
        x:Name="RootGrid"
        MinWidth="720"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <TextBlock
                Margin="0,0,260,0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Choose which columns appear in the reprint history grid. The selection checkbox column is always shown."
                TextWrapping="Wrap" />

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    Padding="12"
                    VerticalAlignment="Center"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Always Shown" />
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Selection checkbox" />
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Click="SelectAllButton_Click"
                    Content="Select All" />
                <Button
                    Click="ClearAllButton_Click"
                    Content="Clear All" />
                <Button
                    Click="ResetButton_Click"
                    Content="Reset" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            Padding="16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <ScrollViewer Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
                <StackPanel
                    x:Name="ColumnsPanel"
                    Spacing="16" />
            </ScrollViewer>
        </Border>

        <Border
            Grid.Row="3"
            Margin="0,12,0,0"
            Padding="0,12,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="FooterCancelButton"
                    MinWidth="100"
                    Click="OnFooterCancelButtonClick"
                    Content="Cancel" />
                <Button
                    x:Name="FooterApplyButton"
                    MinWidth="100"
                    Click="OnFooterApplyButtonClick"
                    Content="Apply" />
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>
