<UserControl
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_ModeSelectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MTM_Receiving_Application.Module_Dunnage.ViewModels"
    mc:Ignorable="d">
    <Border
        Padding="20"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid
            Padding="24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
                Grid.Row="0"
                Grid.Column="0"
                MinWidth="240"
                Padding="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="Guided Wizard Mode"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Command="{x:Bind ViewModel.SelectGuidedModeCommand}"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="48"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE771;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Guided Wizard" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Step-by-step workflow for dunnage receiving with validation at each stage."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <!--  Edit Mode Column  -->
            <Button
                Grid.Row="0"
                Grid.Column="1"
                MinWidth="240"
                Padding="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="Edit Mode"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Command="{x:Bind ViewModel.SelectEditModeCommand}"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="48"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE70F;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Edit Mode" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Load historical dunnage records for editing and correction."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button
                Grid.Row="0"
                Grid.Column="2"
                MinWidth="240"
                Padding="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="Search Mode"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Command="{x:Bind ViewModel.OpenImageSearchCommand}"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="48"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE7C5;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Image Search" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Search Dunnage Parts by Image."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>


            <!--  Guided Mode Checkbox  -->
            <CheckBox
                Grid.Row="1"
                Grid.Column="0"
                HorizontalAlignment="Center"
                Checked="OnGuidedDefaultChecked"
                Content="Set as default mode"
                IsChecked="{x:Bind ViewModel.IsGuidedModeDefault, Mode=TwoWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Tooltip.Button.QuickGuidedWizard'), Mode=OneWay}"
                Unchecked="OnGuidedDefaultUnchecked" />

            <!--  Edit Mode Checkbox  -->
            <CheckBox
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Center"
                Checked="OnEditDefaultChecked"
                Content="Set as default mode"
                IsChecked="{x:Bind ViewModel.IsEditModeDefault, Mode=TwoWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.QuickEditMode'), Mode=OneWay}"
                Unchecked="OnEditDefaultUnchecked" />

            <!--  Search Mode Checkbox  -->
            <CheckBox
                Grid.Row="1"
                Grid.Column="2"
                HorizontalAlignment="Center"
                Checked="OnImageSearchDefaultChecked"
                Content="Set as default mode"
                IsChecked="{x:Bind ViewModel.IsImageSearchModeDefault, Mode=TwoWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.ImageSearchDefaultMode'), Mode=OneWay}"
                Unchecked="OnImageSearchDefaultUnchecked" />
        </Grid>
    </Border>
</UserControl>
