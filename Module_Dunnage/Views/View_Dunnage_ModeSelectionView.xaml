<UserControl
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_ModeSelectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MTM_Receiving_Application.Module_Dunnage.ViewModels"
    mc:Ignorable="d">
    <Border
        Padding="20"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="24">
                <!--  Guided Wizard Column  -->
                <StackPanel Spacing="12">
                    <Button
                        Width="280"
                        Height="180"
                        Padding="20"
                        AutomationProperties.Name="Guided Wizard Mode"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Command="{x:Bind ViewModel.SelectGuidedModeCommand}"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <FontIcon
                                FontSize="48"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE771;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Guided Wizard" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Step-by-step workflow for dunnage receiving with validation at each stage."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <!--  Guided Mode Checkbox  -->
                    <CheckBox
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.SetGuidedAsDefaultCommand}"
                        CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                        Content="Set as default mode"
                        IsChecked="{x:Bind ViewModel.IsGuidedModeDefault, Mode=TwoWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Tooltip.Button.QuickGuidedWizard'), Mode=OneWay}" />
                </StackPanel>

                <!--  Manual Entry Column  -->
                <StackPanel Spacing="12">
                    <Button
                        Width="280"
                        Height="180"
                        Padding="20"
                        AutomationProperties.Name="Manual Entry Mode"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Command="{x:Bind ViewModel.SelectManualModeCommand}"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <FontIcon
                                FontSize="48"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE7F0;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Manual Entry" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Bulk grid entry for receiving multiple dunnage items simultaneously."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <!--  Manual Mode Checkbox  -->
                    <CheckBox
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.SetManualAsDefaultCommand}"
                        CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                        Content="Set as default mode"
                        IsChecked="{x:Bind ViewModel.IsManualModeDefault, Mode=TwoWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Tooltip.Button.QuickManualEntry'), Mode=OneWay}" />
                </StackPanel>

                <!--  Edit Mode Column  -->
                <StackPanel Spacing="12">
                    <Button
                        Width="280"
                        Height="180"
                        Padding="20"
                        AutomationProperties.Name="Edit Mode"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Command="{x:Bind ViewModel.SelectEditModeCommand}"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <FontIcon
                                FontSize="48"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE70F;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Edit Mode" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Load historical dunnage records for editing and correction."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <!--  Edit Mode Checkbox  -->
                    <CheckBox
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.SetEditAsDefaultCommand}"
                        CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                        Content="Set as default mode"
                        IsChecked="{x:Bind ViewModel.IsEditModeDefault, Mode=TwoWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.QuickEditMode'), Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <Button
                Grid.Row="1"
                Margin="12,24,12,0"
                Padding="16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OpenImageSearch_Click"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon
                        FontSize="28"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE721;" />
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Search Dunnage Parts by Image" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Open a visual 3x3 browser of Dunnage parts that already have image paths so you can identify a part from its picture before viewing the full record."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
