<UserControl
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_Control_IconPickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:Material.Icons"
    xmlns:materialIcons="using:Material.Icons.WinUI3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_Dunnage.Models"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:Converter_IntToVisibility x:Key="IntToVisibilityConverter" />

        <Style x:Key="IconGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <!--  Displays a single icon from the full icon list; shows the icon centered in a bordered card with a tooltip of the icon's name  -->
        <DataTemplate x:Key="IconTemplate" x:DataType="icons:MaterialIconKind">
            <Border
                Width="40"
                Height="40"
                Padding="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                ToolTipService.ToolTip="{x:Bind}">
                <materialIcons:MaterialIcon
                    Width="24"
                    Height="24"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    Kind="{x:Bind}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RecentIconTemplate" x:DataType="models:Model_IconDefinition">
            <Border
                Width="40"
                Height="40"
                Padding="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                ToolTipService.ToolTip="{x:Bind Name}">
                <materialIcons:MaterialIcon
                    Width="24"
                    Height="24"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    Kind="{x:Bind Kind}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!--  Root layout panel; stacks the recently used section, search box, and full icon grid vertically  -->
    <StackPanel Spacing="12">
        <!--
            Recently Used Section: only visible when there is at least one recently used icon;
            displays a compact horizontal grid of up to 6 recently used icons per row
        -->
        <StackPanel Spacing="8" Visibility="{x:Bind RecentlyUsedIcons.Count, Mode=OneWay, Converter={StaticResource IntToVisibilityConverter}}">
            <!--  Section label for the recently used icons  -->
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Text="Recently Used" />
            <!--  Grid of recently used icons; selecting an item triggers OnRecentIconSelectionChanged  -->
            <GridView
                x:Name="RecentIconsGrid"
                MaxHeight="60"
                ItemContainerStyle="{StaticResource IconGridViewItemStyle}"
                ItemTemplate="{StaticResource RecentIconTemplate}"
                ItemsSource="{x:Bind RecentlyUsedIcons, Mode=OneWay}"
                SelectionChanged="OnRecentIconSelectionChanged"
                SelectionMode="Single">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!--  Wrap icons based on available width  -->
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
        </StackPanel>

        <!--  Search Box: filters the full icon list as the user types  -->
        <TextBox
            x:Name="SearchBox"
            PlaceholderText="Search icons..."
            TextChanged="OnSearchTextChanged" />

        <!--
            All Icons Grid: scrollable grid of all available icons (or filtered results);
            two-way binds the selected item to SelectedIcon
        -->
        <GridView
            x:Name="AllIconsGrid"
            MaxHeight="300"
            ItemContainerStyle="{StaticResource IconGridViewItemStyle}"
            ItemTemplate="{StaticResource IconTemplate}"
            SelectedItem="{x:Bind SelectedIcon, Mode=TwoWay}"
            SelectionMode="Single">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--  Wrap icons based on available width  -->
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>
    </StackPanel>
</UserControl>
