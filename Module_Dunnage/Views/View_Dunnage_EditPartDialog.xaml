<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_EditPartDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:models="using:MTM_Receiving_Application.Module_Dunnage.Models"
    x:Name="RootDialog"
    Title="Edit Dunnage Part">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1600</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
        <converters:Converter_EmptyStringToVisibility x:Key="EmptyStringToVisibilityConverter" />
        <!--  Help Button Style  -->
        <Style x:Key="HelpButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.Resources>
    <Grid
        x:Name="RootGrid"
        MinWidth="900"
        MaxWidth="1280">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                Margin="0,0,220,0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Update the selected dunnage part in four short steps."
                TextWrapping="Wrap" />

            <Border
                Padding="12"
                HorizontalAlignment="Right"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Current Part ID" />
                        <TextBlock
                            x:Name="CurrentPartIdTextBlock"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Dunnage Type" />
                        <TextBlock
                            x:Name="TypeNameTextBlock"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="WizardContentGrid" Grid.Row="1">
            <Grid
                x:Name="StepPartSetupPanel"
                Padding="4"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Part ID" />
                            <TextBox
                                x:Name="PartIdTextBox"
                                MaxLength="100"
                                PlaceholderText="Enter part ID"
                                TextChanged="RequiredPartFieldChanged" />
                            <Button
                                x:Name="SuggestPartIdButton"
                                HorizontalAlignment="Left"
                                Click="SuggestPartIdButton_Click"
                                Content="Suggest Part ID" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Update the part ID directly or start with a suggestion based on the details below."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Inventory Type" />
                            <ComboBox
                                x:Name="InventoryTypeComboBox"
                                SelectedIndex="0"
                                SelectionChanged="RequiredPartFieldChanged">
                                <ComboBoxItem Content="Not Inventoried" />
                                <ComboBoxItem Content="Adjust In" />
                                <ComboBoxItem Content="Receive In" />
                                <ComboBoxItem Content="Both" />
                            </ComboBox>
                        </StackPanel>

                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ValidationViewModel.ValidationMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ValidationViewModel.ValidationMessage, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}" />

                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Home Location" />
                            <TextBox
                                x:Name="HomeLocationTextBox"
                                MaxLength="100"
                                PlaceholderText="e.g. A-12-B, DOCK-2, Rack by 100-15" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Part Image (PNG/JPG)" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="96"
                                    Height="96"
                                    Padding="4"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Tapped="OnOpenImageFolderTapped"
                                    ToolTipService.ToolTip="Open containing folder in File Explorer">
                                    <Image x:Name="PartImagePreview" Stretch="Uniform" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <TextBlock
                                        x:Name="PartImagePathTextBlock"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="WrapWholeWords" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="ChooseImageButton_Click" Content="Choose Image (PNG/JPG)" />
                                        <Button
                                            x:Name="RotateImageButton"
                                            Click="RotateImageButton_Click"
                                            Content="Rotate 90Â°"
                                            IsEnabled="False" />
                                        <Button Click="ClearImageButton_Click" Content="Clear Image" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Additional Notes (Optional)" />
                            <TextBox
                                x:Name="NotesTextBox"
                                Height="150"
                                AcceptsReturn="True"
                                MaxLength="500"
                                PlaceholderText="Add any extra notes for this part"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid
                x:Name="StepTypeSpecsPanel"
                Padding="4"
                RowSpacing="12"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Part Details" />
                    <Button
                        Grid.Column="1"
                        Click="ChooseExistingSpecsButton_Click"
                        Content="Copy From Existing Part" />
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Copy saved details from another part, then update anything that should be different. If there are many fields, they will be shown a few at a time."
                    TextWrapping="Wrap" />

                <Border
                    Grid.Row="2"
                    Padding="16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock
                                x:Name="NoConfiguredSpecsTextBlock"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="No saved detail fields are set up for this dunnage type." />
                            <Grid
                                x:Name="DynamicSpecsGrid"
                                ColumnSpacing="16"
                                RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="PreviousSpecPageButton"
                                Click="OnPreviousSpecPageClick"
                                Content="Previous" />
                            <TextBlock
                                x:Name="SpecPageSummaryTextBlock"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <Button
                                x:Name="NextSpecPageButton"
                                Grid.Column="2"
                                Click="OnNextSpecPageClick"
                                Content="Next" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid
                x:Name="StepQuantityTypePanel"
                Padding="4"
                RowSpacing="12"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Choose the label header that should appear next to the quantity on printed Dunnage labels."
                    TextWrapping="Wrap" />

                <Border
                    Grid.Row="1"
                    Padding="16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Custom Quantity Type" />
                            <TextBox
                                x:Name="QuantityTypeTextBox"
                                MaxLength="100"
                                PlaceholderText="For example: Weight, Pieces, Gallons"
                                TextChanged="QuantityTypeInputChanged" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Leave this blank if you want to pick a saved value from the list below or keep the current default."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Saved Quantity Types" />
                            <ListView
                                x:Name="QuantityTypesListView"
                                MinHeight="160"
                                MaxHeight="280"
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                ItemsSource="{x:Bind QuantityTypes, Mode=OneWay}"
                                SelectionChanged="QuantityTypesListView_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Model_DunnageQuantityType">
                                        <TextBlock Padding="4" Text="{x:Bind QuantityType}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="If both the custom box and a saved value are filled in when you save, you'll be asked which one to keep."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        <Border
            Grid.Row="2"
            Margin="0,12,0,0"
            Padding="0,12,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="BackStepButton"
                        MinWidth="96"
                        Click="OnBackStepClick"
                        Content="Back" />
                    <Button
                        x:Name="NextStepButton"
                        MinWidth="96"
                        Click="OnNextStepClick"
                        Content="Next" />
                </StackPanel>

                <TextBlock
                    x:Name="StepSummaryTextBlock"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="FooterDeleteButton"
                        MinWidth="100"
                        Click="OnFooterDeleteButtonClick"
                        Content="Delete"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="FooterCancelButton"
                        MinWidth="100"
                        Click="OnFooterCancelButtonClick"
                        Content="Cancel" />
                    <Button
                        x:Name="FooterPrimaryButton"
                        MinWidth="100"
                        Click="OnFooterPrimaryButtonClick"
                        Content="Save Changes"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
