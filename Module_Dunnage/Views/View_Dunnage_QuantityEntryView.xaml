<UserControl
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_QuantityEntryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_Dunnage.Models"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:Converter_EmptyStringToVisibility x:Key="EmptyStringToVisibilityConverter" />
        <converters:Converter_DecimalToDouble x:Key="DecimalToDoubleConverter" />
    </UserControl.Resources>

    <Grid Padding="16">
        <!--  Quantity Input  -->
        <ScrollViewer Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
            <StackPanel Spacing="12">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Number of Loads" />
                        <NumberBox
                            x:Name="NumberOfLoadsNumberBox"
                            HorizontalAlignment="Stretch"
                            AcceptsExpression="False"
                            LargeChange="10"
                            Loaded="NumberOfLoadsNumberBox_Loaded"
                            Maximum="99"
                            Minimum="1"
                            PlaceholderText="1-99"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Unloaded="IntegerNumberBox_Unloaded"
                            ValidationMode="InvalidInputOverwritten"
                            Value="{x:Bind ViewModel.NumberOfLoads, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Choose how many separate dunnage loads to generate for this part."
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Quantity Per Load" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Loads, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Model_DunnageLoad">
                                    <Grid Margin="0,0,0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Glyph="&#xE7B8;" />
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                                <Run Text="Load #" />
                                                <Run Text="{x:Bind LoadNumber}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <NumberBox
                                            Grid.Column="1"
                                            AcceptsExpression="False"
                                            Header="Quantity"
                                            Loaded="LoadQuantityNumberBox_Loaded"
                                            Minimum="0"
                                            PlaceholderText="Enter quantity"
                                            SpinButtonPlacementMode="Inline"
                                            Unloaded="IntegerNumberBox_Unloaded"
                                            ValidationMode="InvalidInputOverwritten"
                                            Value="{x:Bind Quantity, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Validation Message  -->
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.ValidationMessage, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
