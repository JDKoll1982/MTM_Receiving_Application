<Page
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_AdminPartsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MTM_Receiving_Application.Module_Dunnage.ViewModels"
    x:DataType="viewmodels:ViewModel_Dunnage_AdminParts"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Manage Dunnage Parts" />
            <TextBlock
                Margin="0,8,0,0"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Add, edit, and search dunnage parts with spec values" />
        </StackPanel>

        <!--  Toolbar  -->
        <CommandBar
            Grid.Row="1"
            Margin="0,0,0,16"
            DefaultLabelPosition="Right">
            <AppBarButton
                Icon="Add"
                Label="Add New Part"
                ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.CreatePart'), Mode=OneWay}" />
            <AppBarSeparator />
            <AppBarButton
                Icon="Edit"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                Label="Edit Part"
                ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.EditPart'), Mode=OneWay}" />
            <AppBarButton
                Command="{x:Bind ViewModel.ShowDeleteConfirmationCommand}"
                Icon="Delete"
                IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}"
                Label="Delete Part"
                ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.DeletePart'), Mode=OneWay}" />
            <AppBarSeparator />
            <AppBarButton
                Command="{x:Bind ViewModel.ReturnToAdminHubCommand}"
                Icon="Back"
                Label="Back to Admin Hub"
                ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.ReturnToAdmin'), Mode=OneWay}" />
        </CommandBar>

        <!--  Search and Filter Bar  -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Search Box  -->
            <TextBox
                Grid.Column="0"
                Margin="0,0,12,0"
                PlaceholderText="Search by Part ID..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Invoked="OnSearchKeyboardAccelerator" />
                </TextBox.KeyboardAccelerators>
            </TextBox>

            <!--  Type Filter  -->
            <ComboBox
                Grid.Column="1"
                MinWidth="200"
                Margin="0,0,12,0"
                DisplayMemberPath="DunnageType"
                ItemsSource="{x:Bind ViewModel.AvailableTypes, Mode=OneWay}"
                PlaceholderText="Filter by Type"
                SelectedItem="{x:Bind ViewModel.SelectedFilterType, Mode=TwoWay}" />

            <!--  Filter Buttons  -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.SearchPartsCommand}"
                    Content="Search"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button Command="{x:Bind ViewModel.FilterByTypeCommand}" Content="Filter by Type" />
                <Button Command="{x:Bind ViewModel.ClearFiltersCommand}" Content="Clear" />
            </StackPanel>
        </Grid>

        <!--  DataGrid  -->
        <Border
            Grid.Row="3"
            Padding="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <controls:DataGrid
                    AlternatingRowBackground="{ThemeResource SubtleFillColorSecondaryBrush}"
                    AutoGenerateColumns="False"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="True"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind ViewModel.Parts, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedPart, Mode=TwoWay}"
                    SelectionMode="Single"
                    VerticalScrollBarVisibility="Auto">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTemplateColumn Width="100" Header="Image">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="56"
                                        Height="56"
                                        Padding="4"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <Image Source="{Binding ImageSource}" Stretch="UniformToFill" />
                                    </Border>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <!--  Part ID Column  -->
                        <controls:DataGridTextColumn
                            Width="2*"
                            Binding="{Binding PartId}"
                            CanUserResize="True"
                            Header="Part ID" />

                        <!--  Type Column  -->
                        <controls:DataGridTextColumn
                            Width="*"
                            Binding="{Binding DunnageTypeName}"
                            CanUserResize="True"
                            Header="Type" />

                        <!--  Spec Values Column (Note: Dynamic spec columns would require code-behind)  -->
                        <controls:DataGridTextColumn
                            Width="2*"
                            Binding="{Binding DunnageSpecValuesJson}"
                            CanUserResize="True"
                            Header="Specifications" />

                        <!--  Date Added Column  -->
                        <controls:DataGridTextColumn
                            Width="*"
                            Binding="{Binding CreatedDate, Converter={StaticResource DateTimeToStringConverter}}"
                            CanUserResize="True"
                            Header="Date Added" />

                        <!--  Added By Column  -->
                        <controls:DataGridTextColumn
                            Width="*"
                            Binding="{Binding CreatedBy}"
                            CanUserResize="True"
                            Header="Added By" />
                    </controls:DataGrid.Columns>
                </controls:DataGrid>

                <!--  Empty State  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.Parts.Count, Mode=OneWay, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverse}">
                    <FontIcon
                        FontSize="72"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Glyph="&#xE8F1;" />
                    <TextBlock
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="No parts found" />
                    <TextBlock
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Try adjusting your filters or add a new part" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Pagination Controls  -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Record Count  -->
            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                <Run Text="Showing" />
                <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.Parts.Count, Mode=OneWay}" />
                <Run Text="of" />
                <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.TotalRecords, Mode=OneWay}" />
                <Run Text="parts" />
            </TextBlock>

            <!--  Pagination Buttons  -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    MinWidth="80"
                    Command="{x:Bind ViewModel.FirstPageCommand}"
                    Content="First"
                    IsEnabled="{x:Bind ViewModel.CanNavigatePrevious, Mode=OneWay}" />
                <Button
                    MinWidth="80"
                    Command="{x:Bind ViewModel.PreviousPageCommand}"
                    Content="Previous"
                    IsEnabled="{x:Bind ViewModel.CanNavigatePrevious, Mode=OneWay}" />
                <TextBlock Margin="12,0,12,0" VerticalAlignment="Center">
                    <Run Text="Page" />
                    <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}" />
                    <Run Text="of" />
                    <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}" />
                </TextBlock>
                <Button
                    MinWidth="80"
                    Command="{x:Bind ViewModel.NextPageCommand}"
                    Content="Next"
                    IsEnabled="{x:Bind ViewModel.CanNavigateNext, Mode=OneWay}" />
                <Button
                    MinWidth="80"
                    Command="{x:Bind ViewModel.LastPageCommand}"
                    Content="Last"
                    IsEnabled="{x:Bind ViewModel.CanNavigateNext, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!--  Status Bar  -->
        <StackPanel
            Grid.Row="5"
            Margin="0,16,0,0"
            Orientation="Horizontal"
            Spacing="8">
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
