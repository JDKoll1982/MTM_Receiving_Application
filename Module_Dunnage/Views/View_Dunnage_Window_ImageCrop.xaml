<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_Window_ImageCrop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Title="Crop Image">
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="16,16,16,8"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="Drag the handles to choose the area to keep. The cropped image is saved at the full resolution of the selected area."
            TextWrapping="Wrap" />

        <Border
            Grid.Row="1"
            Margin="16,0,16,8"
            Padding="8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <controls:ImageCropper
                x:Name="CropperControl"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                CropShape="Rectangular"
                ThumbPlacement="All" />
        </Border>

        <StackPanel
            Grid.Row="2"
            Margin="16,0,16,8"
            Orientation="Horizontal"
            Spacing="12">
            <RadioButton
                x:Name="FreeAspectRadioButton"
                Checked="OnAspectRatioChanged"
                Content="Free"
                GroupName="CropAspectRatio"
                IsChecked="True" />
            <RadioButton
                x:Name="SquareAspectRadioButton"
                Checked="OnAspectRatioChanged"
                Content="Square (1:1)"
                GroupName="CropAspectRatio" />
            <RadioButton
                x:Name="LandscapeAspectRadioButton"
                Checked="OnAspectRatioChanged"
                Content="Landscape (4:3)"
                GroupName="CropAspectRatio" />
            <RadioButton
                x:Name="WideAspectRadioButton"
                Checked="OnAspectRatioChanged"
                Content="Wide (16:9)"
                GroupName="CropAspectRatio" />
            <Button Click="OnResetCropClick" Content="Reset" />
        </StackPanel>

        <TextBlock
            x:Name="CropStatusTextBlock"
            Grid.Row="3"
            Margin="16,0,16,8"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <Grid
            Grid.Row="4"
            Margin="16,0,16,16"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="1"
                MinWidth="96"
                Click="OnCancelClick"
                Content="Cancel" />
            <Button
                x:Name="ApplyButton"
                Grid.Column="2"
                MinWidth="120"
                Click="OnApplyClick"
                Content="Apply Crop"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
