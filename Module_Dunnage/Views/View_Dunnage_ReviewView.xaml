<UserControl
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_ReviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="using:Material.Icons.WinUI3"
    xmlns:models="using:MTM_Receiving_Application.Module_Dunnage.Models"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_EmptyStringToVisibility x:Key="EmptyStringToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Padding="6" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Success Message  -->
        <InfoBar
            Grid.Row="0"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsSuccessMessageVisible, Mode=OneWay}"
            Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
            Severity="Success" />

        <!--  Content Section with View Toggle  -->
        <Grid Grid.Row="1">
            <!--  Single Entry View  -->
            <Grid Visibility="{x:Bind ViewModel.IsSingleView, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Entry Header  -->
                <Border
                    Grid.Row="0"
                    Padding="16,10"
                    Background="{StaticResource DunnageAccentBrush}"
                    CornerRadius="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="White"
                            Glyph="&#xE8FD;" />

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="0">
                            <TextBlock
                                Foreground="White"
                                Style="{StaticResource BodyLargeTextBlockStyle}"
                                Text="{x:Bind ViewModel.CurrentLoad.PartId, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="White"
                                Opacity="0.85"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.CurrentLoad.TypeName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Opacity="0.85"
                            Style="{StaticResource CaptionTextBlockStyle}">
                            <Run Text="Entry" />
                            <Run Text="{x:Bind ViewModel.CurrentEntryIndex, Mode=OneWay}" />
                            <Run Text="of" />
                            <Run Text="{x:Bind ViewModel.LoadCount, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Border>

                <!--  Single Entry Content  -->
                <Grid
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Details Card  -->
                    <Border
                        Grid.Column="0"
                        Padding="20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="16">

                            <StackPanel Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Quantity" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{StaticResource BodyLargeTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CurrentLoad.QuantityDisplay, Mode=OneWay}" />
                            </StackPanel>

                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Grid ColumnSpacing="24" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Location" />
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind ViewModel.CurrentLoad.Location, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="PO number" />
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind ViewModel.CurrentLoad.PoNumber, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Inventory method" />
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind ViewModel.CurrentLoad.InventoryMethod, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Spacing="2"
                                    Visibility="{x:Bind ViewModel.HasCurrentVendorState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Vendor" />
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind ViewModel.CurrentVendorName, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.CurrentVendorErrorMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.CurrentVendorErrorMessage, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}" />

                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <StackPanel Spacing="4">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Load details" />
                                <TextBlock
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CurrentLoad.SpecSummaryDisplay, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  Photo Card  -->
                    <Border
                        Grid.Column="1"
                        Width="360"
                        Padding="12"
                        VerticalAlignment="Top"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Tapped="OnPhotoCardTapped"
                        ToolTipService.ToolTip="Click to view the full image"
                        Visibility="{x:Bind ViewModel.HasCurrentVisual, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Spacing="8">
                            <Border
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Image
                                    MaxHeight="300"
                                    Source="{x:Bind ViewModel.CurrentVisualSource, Mode=OneWay}"
                                    Stretch="Uniform" />
                            </Border>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Part photo" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  Navigation Bar for Single View  -->
                <CommandBar
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    DefaultLabelPosition="Right">
                    <AppBarButton
                        AutomationProperties.Name="Previous Entry"
                        Command="{x:Bind ViewModel.PreviousEntryCommand}"
                        Icon="Back"
                        IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                        Label="Previous" />

                    <AppBarButton
                        AutomationProperties.Name="Next Entry"
                        Command="{x:Bind ViewModel.NextEntryCommand}"
                        Icon="Forward"
                        IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                        Label="Next" />

                    <AppBarSeparator />

                    <AppBarButton
                        AutomationProperties.Name="Switch to Table View"
                        Command="{x:Bind ViewModel.SwitchToTableViewCommand}"
                        Icon="ViewAll"
                        Label="Table View" />
                </CommandBar>
            </Grid>

            <!--  Table View (DataGrid)  -->
            <Grid Visibility="{x:Bind ViewModel.IsTableView, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <controls:DataGrid
                        x:Name="ReviewDataGrid"
                        AutoGenerateColumns="False"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        Sorting="ReviewDataGrid_Sorting"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{x:Bind ViewModel.SessionLoads, Mode=OneWay}"
                        SelectionMode="Single">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn
                                Width="120"
                                Binding="{Binding TypeName}"
                                Header="Type" />
                            <controls:DataGridTextColumn
                                Width="150"
                                Binding="{Binding PartId}"
                                Header="Part ID" />
                            <controls:DataGridTextColumn
                                Width="100"
                                Binding="{Binding Quantity}"
                                Header="Quantity" />
                            <controls:DataGridTextColumn
                                Width="150"
                                Binding="{Binding PoNumber}"
                                Header="PO Number" />
                            <controls:DataGridTextColumn
                                Width="150"
                                Binding="{Binding Location}"
                                Header="Location" />
                            <controls:DataGridTextColumn
                                Width="*"
                                Binding="{Binding InventoryMethod}"
                                Header="Inventory Method" />
                            <controls:DataGridTextColumn
                                Width="2*"
                                Binding="{Binding SpecSummaryDisplay}"
                                Header="Load Details" />
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </Border>

                <!--  Navigation Bar for Table View  -->
                <CommandBar
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    DefaultLabelPosition="Right">
                    <AppBarButton
                        AutomationProperties.Name="Switch to Single View"
                        Command="{x:Bind ViewModel.SwitchToSingleViewCommand}"
                        Label="Single View">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8FD;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Grid>
        </Grid>

        <!--  Action Buttons  -->
        <Grid
            Grid.Row="2"
            Margin="0,16,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="1"
                AutomationProperties.Name="Save to Database"
                Command="{x:Bind ViewModel.SaveAllCommand}"
                IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE74E;" />
                    <TextBlock Text="Save All" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
