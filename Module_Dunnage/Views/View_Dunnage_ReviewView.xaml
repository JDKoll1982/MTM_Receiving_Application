<UserControl
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_ReviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="using:Material.Icons.WinUI3"
    xmlns:models="using:MTM_Receiving_Application.Module_Dunnage.Models"
    xmlns:views="using:MTM_Receiving_Application.Module_Dunnage.Views"
    x:DataType="views:View_Dunnage_ReviewView"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_EmptyStringToVisibility x:Key="EmptyStringToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Success Message  -->
        <InfoBar
            Grid.Row="0"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsSuccessMessageVisible, Mode=OneWay}"
            Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
            Severity="Success" />

        <!--  Content Section with View Toggle  -->
        <Grid Grid.Row="1">
            <!--  Single Entry View  -->
            <Grid Visibility="{x:Bind ViewModel.IsSingleView, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Entry Counter  -->
                <Border
                    Grid.Row="0"
                    Padding="12,6"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="8,8,0,0">
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            FontSize="16"
                            Foreground="White"
                            Glyph="&#xE8FD;" />
                        <TextBlock Foreground="White" Style="{StaticResource SubtitleTextBlockStyle}">
                            <Run Text="Entry" />
                            <Run Text="{x:Bind ViewModel.CurrentEntryIndex, Mode=OneWay}" />
                            <Run Text="of" />
                            <Run Text="{x:Bind ViewModel.LoadCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!--  Single Entry Form  -->
                <Grid Grid.Row="1">
                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,8,8">
                        <Grid MaxWidth="900">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Left Column  -->
                            <StackPanel
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                Spacing="12">
                                <Border
                                    Width="160"
                                    Height="160"
                                    Padding="4"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{x:Bind ViewModel.HasCurrentVisual, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Image Source="{x:Bind ViewModel.CurrentVisualSource, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border>

                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="Load Details" />

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Type" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <mi:MaterialIcon
                                            Width="18"
                                            Height="18"
                                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                            Kind="{x:Bind ViewModel.CurrentLoad.TypeIconKind, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CurrentLoad.TypeName, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Part ID" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CurrentLoad.PartId, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Quantity" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CurrentLoad.Quantity, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  Right Column  -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                Spacing="12">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="Additional Information" />

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="PO Number" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CurrentLoad.PoNumber, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Location" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CurrentLoad.Location, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Inventory Method" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CurrentLoad.InventoryMethod, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!--  Navigation Bar for Single View  -->
                <CommandBar
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    DefaultLabelPosition="Right">
                    <AppBarButton
                        AutomationProperties.Name="Previous Entry"
                        Command="{x:Bind ViewModel.PreviousEntryCommand}"
                        Icon="Back"
                        IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                        Label="Previous" />

                    <AppBarButton
                        AutomationProperties.Name="Next Entry"
                        Command="{x:Bind ViewModel.NextEntryCommand}"
                        Icon="Forward"
                        IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                        Label="Next" />

                    <AppBarSeparator />

                    <AppBarButton
                        AutomationProperties.Name="Switch to Table View"
                        Command="{x:Bind ViewModel.SwitchToTableViewCommand}"
                        Icon="ViewAll"
                        Label="Table View" />
                </CommandBar>
            </Grid>

            <!--  Table View (DataGrid)  -->
            <Grid Visibility="{x:Bind ViewModel.IsTableView, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <controls:DataGrid
                        x:Name="ReviewDataGrid"
                        AutoGenerateColumns="False"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{x:Bind ViewModel.SessionLoads, Mode=OneWay}"
                        SelectionMode="Single">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn
                                Width="120"
                                Binding="{Binding TypeName}"
                                Header="Type" />
                            <controls:DataGridTextColumn
                                Width="150"
                                Binding="{Binding PartId}"
                                Header="Part ID" />
                            <controls:DataGridTextColumn
                                Width="100"
                                Binding="{Binding Quantity}"
                                Header="Quantity" />
                            <controls:DataGridTextColumn
                                Width="150"
                                Binding="{Binding PoNumber}"
                                Header="PO Number" />
                            <controls:DataGridTextColumn
                                Width="150"
                                Binding="{Binding Location}"
                                Header="Location" />
                            <controls:DataGridTextColumn
                                Width="*"
                                Binding="{Binding InventoryMethod}"
                                Header="Inventory Method" />
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </Border>

                <!--  Navigation Bar for Table View  -->
                <CommandBar
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    DefaultLabelPosition="Right">
                    <AppBarButton
                        AutomationProperties.Name="Switch to Single View"
                        Command="{x:Bind ViewModel.SwitchToSingleViewCommand}"
                        Label="Single View">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8FD;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Grid>
        </Grid>

        <!--  Action Buttons  -->
        <Grid
            Grid.Row="2"
            Margin="0,16,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="1"
                AutomationProperties.Name="Add Another Load"
                Command="{x:Bind ViewModel.AddAnotherCommand}"
                ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.AddAnother'), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                    <TextBlock Text="Add Another" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                AutomationProperties.Name="Save to Database"
                Command="{x:Bind ViewModel.SaveAllCommand}"
                IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE74E;" />
                    <TextBlock Text="Save All" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
