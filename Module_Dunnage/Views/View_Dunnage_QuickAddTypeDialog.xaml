<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_QuickAddTypeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:local="using:MTM_Receiving_Application.Module_Dunnage.Views"
    xmlns:materialIcons="using:Material.Icons.WinUI3"
    xmlns:models="using:MTM_Receiving_Application.Module_Dunnage.Models"
    x:Name="RootDialog"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1600</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
        <converters:Converter_IconCodeToGlyph x:Key="IconCodeToGlyphConverter" />
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <!--  Help Button Style  -->
        <Style x:Key="HelpButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.Resources>

    <Grid
        x:Name="RootGrid"
        MinWidth="900"
        MaxWidth="1280">
        <!--  Two-row root: header bar + main content  -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Row 0: Description + Help Button  -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                Margin="0,0,80,0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.DialogDescription, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                x:Name="HelpButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Style="{StaticResource HelpButtonStyle}"
                ToolTipService.ToolTip="Click for help about dunnage types">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE946;" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="Help" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout>
                        <StackPanel
                            MaxWidth="400"
                            Padding="4"
                            Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="Dunnage Types" />
                                <Border
                                    Width="60"
                                    Height="2"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="1" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">Define categories of dunnage materials for receiving classification.</TextBlock>
                            </StackPanel>
                            <Border
                                Padding="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="Type Name" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap">
                                        Choose a descriptive name like 'Pallet', 'Crate', or 'Foam Insert'. This will be displayed in selection lists.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border
                                Padding="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="Specifications" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap">
                                        Add custom fields to capture specific data for this type. For example, 'Material' (Text), 'Weight Capacity' (Number with unit 'lbs'), or 'Recyclable' (Boolean).
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border
                                Padding="12"
                                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                            Glyph="&#xE946;" />
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                            Text="Tip" />
                                    </StackPanel>
                                    <TextBlock FontSize="11" TextWrapping="Wrap">Required specs must be filled when creating new parts. Use Number type for measurements and validation.</TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!--  Row 1: Two-column main content  -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Left column: Type Name + Visual Mode  -->
            <StackPanel Grid.Column="0" Spacing="12">

                <!--  Type Name  -->
                <Border
                    Padding="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Type Name" />
                        <TextBox
                            MaxLength="100"
                            PlaceholderText="e.g., Pallet, Crate, Blocking"
                            Text="{x:Bind ViewModel.TypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTipService.ToolTip="Enter a unique descriptive name for this dunnage type" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasValidationMessage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <!--  Visual Mode Toggle  -->
                <Border
                    Padding="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ToggleSwitch
                        Header="Visual Mode"
                        IsOn="{x:Bind ViewModel.IsImageMode, Mode=TwoWay}"
                        OffContent="Icon"
                        OnContent="Image" />
                </Border>

                <!--  Hidden-tab panel: Icon or Image  -->
                <Grid>
                    <!--  Icon Selection  -->
                    <Border
                        Padding="12"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{x:Bind ViewModel.UseIconVisual, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Select Icon" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Choose an icon to represent this type" />
                            <Button
                                x:Name="SelectIconButton"
                                Padding="16,12"
                                HorizontalAlignment="Stretch"
                                Click="OnSelectIconClick"
                                ToolTipService.ToolTip="Click to browse and select an icon from the icon library">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <materialIcons:MaterialIcon
                                        Width="24"
                                        Height="24"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                        Kind="{x:Bind ViewModel.SelectedIconKind, Mode=OneWay}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="Click to select icon" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.SelectedIconKind, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!--  Image Selection  -->
                    <Border
                        Padding="12"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{x:Bind ViewModel.UseImageVisual, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Type Image (PNG/JPG)" />
                            <TextBlock
                                Grid.Row="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Upload a PNG or JPG image to represent this dunnage type."
                                TextWrapping="Wrap" />
                            <Grid
                                Grid.Row="2"
                                ColumnSpacing="12"
                                RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Width="80"
                                    Height="80"
                                    Padding="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Tapped="OnOpenImageFolderTapped"
                                    ToolTipService.ToolTip="Open containing folder in File Explorer">
                                    <Image
                                        Source="{x:Bind ViewModel.SelectedImageSource, Mode=OneWay}"
                                        Stretch="UniformToFill"
                                        Visibility="{x:Bind ViewModel.HasSelectedImage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Border>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.SelectedImageFileName, Mode=OneWay}"
                                        TextWrapping="NoWrap" />
                                    <Grid
                                        Grid.Row="2"
                                        ColumnSpacing="6"
                                        RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            HorizontalAlignment="Stretch"
                                            Click="OnChooseImageClick"
                                            Content="Choose Image (PNG/JPG)" />

                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            Click="OnRotateImageClick"
                                            Content="Rotate 90°"
                                            IsEnabled="{x:Bind ViewModel.HasSelectedImage, Mode=OneWay}" />

                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Click="OnClearImageClick"
                                            Content="Clear" />
                                    </Grid>
                                </Grid>


                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <!--  Right column: Specifications  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="130" />
                </Grid.RowDefinitions>

                <!--  Section header  -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Specifications" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Define custom fields to capture specific data for this dunnage type" />
                </StackPanel>

                <!--  Add Spec Form — interior scrolls when options expand  -->
                <Border
                    Grid.Row="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Field name + type selector  -->
                        <Grid
                            Grid.Row="0"
                            Padding="16,16,16,0"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                PlaceholderText="Field Name (e.g. Material, Weight)"
                                Text="{x:Bind ViewModel.NewSpecName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTipService.ToolTip="Enter a unique name for this specification field" />
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectedItem="{x:Bind ViewModel.NewSpecType, Mode=TwoWay}"
                                ToolTipService.ToolTip="Select the data type for this field">
                                <x:String>Text</x:String>
                                <x:String>Number</x:String>
                                <x:String>Boolean</x:String>
                                <x:String>Choices</x:String>
                            </ComboBox>
                        </Grid>

                        <!--  Collapsible options — scrollable so they never overflow  -->
                        <ScrollViewer
                            Grid.Row="1"
                            Padding="16,12,16,0"
                            Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
                            <StackPanel Spacing="12">

                                <!--  Number validation  -->
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowNumberOptions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Number Validation" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox
                                            Header="Min Value"
                                            PlaceholderText="Optional"
                                            SpinButtonPlacementMode="Compact"
                                            ToolTipService.ToolTip="Minimum allowed value (optional)"
                                            Value="{x:Bind ViewModel.NewSpecMinValue, Mode=TwoWay}" />
                                        <NumberBox
                                            Grid.Column="1"
                                            Header="Max Value"
                                            PlaceholderText="Optional"
                                            SpinButtonPlacementMode="Compact"
                                            ToolTipService.ToolTip="Maximum allowed value (optional)"
                                            Value="{x:Bind ViewModel.NewSpecMaxValue, Mode=TwoWay}" />
                                        <TextBox
                                            Grid.Column="2"
                                            Header="Unit"
                                            PlaceholderText="e.g. inches, lbs"
                                            Text="{x:Bind ViewModel.NewSpecUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTipService.ToolTip="Unit of measurement (optional)" />
                                    </Grid>
                                </StackPanel>

                                <!--  Choices  -->
                                <Border
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="{x:Bind ViewModel.ShowChoicesOptions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Choice Values" />
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Add the allowed values for this field. Example: Tall, Short."
                                            TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                HorizontalAlignment="Stretch"
                                                PlaceholderText="Add a choice"
                                                Text="{x:Bind ViewModel.NewSpecChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button
                                                Grid.Column="1"
                                                Command="{x:Bind ViewModel.AddChoiceCommand}"
                                                Content="Add Choice"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        </Grid>
                                        <ListView
                                            Height="100"
                                            Padding="4"
                                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            ItemsSource="{x:Bind ViewModel.CurrentChoices, Mode=OneWay}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Grid Padding="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind}" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Click="OnRemoveChoiceClick"
                                                            Content="&#xE74D;"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            Style="{StaticResource SubtleButtonStyle}"
                                                            ToolTipService.ToolTip="Remove this choice" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!--  Required field + Add button  -->
                        <Grid
                            Grid.Row="2"
                            Padding="16,12,16,16"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="Required Field"
                                IsChecked="{x:Bind ViewModel.NewSpecRequired, Mode=TwoWay}"
                                ToolTipService.ToolTip="Check if this field is required" />
                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.AddSpecCommand}"
                                Content="Add Field"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Add this specification to the list below" />
                        </Grid>
                    </Grid>
                </Border>

                <!--  Added specs list  -->
                <ListView
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    Padding="4"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ItemsSource="{x:Bind ViewModel.Specs, Mode=OneWay}"
                    ToolTipService.ToolTip="List of specifications defined for this type">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Model_SpecItem">
                            <Grid Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Description}" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Margin="8,0"
                                    Padding="6,2"
                                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                    CornerRadius="3"
                                    Visibility="{x:Bind IsRequiredVisibility}">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Text="Required" />
                                </Border>
                                <Button
                                    Grid.Column="2"
                                    Click="OnRemoveSpecClick"
                                    Content="&#xE74D;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Remove this specification" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!--  Footer  -->
        <Border
            Grid.Row="2"
            Margin="0,12,0,0"
            Padding="0,12,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="FooterDeleteButton"
                    MinWidth="100"
                    Click="OnFooterDeleteButtonClick"
                    Content="Delete"
                    Visibility="Collapsed" />
                <Button
                    x:Name="FooterCancelButton"
                    MinWidth="100"
                    Click="OnFooterCancelButtonClick"
                    Content="Cancel" />
                <Button
                    x:Name="FooterPrimaryButton"
                    MinWidth="100"
                    Click="OnFooterPrimaryButtonClick"
                    Content="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>
