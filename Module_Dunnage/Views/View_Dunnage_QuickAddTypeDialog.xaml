<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_QuickAddTypeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:local="using:MTM_Receiving_Application.Module_Dunnage.Views"
    xmlns:materialIcons="using:Material.Icons.WinUI3"
    xmlns:models="using:MTM_Receiving_Application.Module_Dunnage.Models"
    Title="Add New Dunnage Type"
    Width="900"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
    PrimaryButtonText="Add Type">
    <ContentDialog.Resources>
        <converters:Converter_IconCodeToGlyph x:Key="IconCodeToGlyphConverter" />
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <!--  Help Button Style  -->
        <Style x:Key="HelpButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12" Spacing="24">
            <!--  Header with Help Button  -->
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Enter details for the new dunnage type"
                    TextWrapping="Wrap" />

                <Button
                    x:Name="HelpButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource HelpButtonStyle}"
                    ToolTipService.ToolTip="Click for help about dunnage types">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE946;" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="Help" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel
                                MaxWidth="400"
                                Padding="4"
                                Spacing="16">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="Dunnage Types" />
                                    <Border
                                        Width="60"
                                        Height="2"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="1" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">Define categories of dunnage materials for receiving classification.</TextBlock>
                                </StackPanel>

                                <Border
                                    Padding="12"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="Type Name" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap">
                                            Choose a descriptive name like 'Pallet', 'Crate', or 'Foam Insert'. This will be displayed in selection lists.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Padding="12"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="Specifications" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap">
                                            Add custom fields to capture specific data for this type. For example, 'Material' (Text), 'Weight Capacity' (Number with unit 'lbs'), or 'Recyclable' (Boolean).
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Padding="12"
                                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                    BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                                Glyph="&#xE946;" />
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                                Text="Tip" />
                                        </StackPanel>
                                        <TextBlock FontSize="11" TextWrapping="Wrap">Required specs must be filled when creating new parts. Use Number type for measurements and validation.</TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!--  Type Name Field  -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Type Name" />
                <TextBox
                    x:Name="TypeNameTextBox"
                    MaxLength="100"
                    PlaceholderText="e.g., Pallet, Crate, Blocking"
                    TextChanged="OnTypeNameChanged"
                    ToolTipService.ToolTip="Enter a unique descriptive name for this dunnage type" />
                <TextBlock
                    x:Name="ValidationTextBlock"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Type name is required"
                    Visibility="Collapsed" />
            </StackPanel>

            <!--  Icon Selection  -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Select Icon" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Choose an icon to represent this type" />

                <Button
                    x:Name="SelectIconButton"
                    Padding="16,12"
                    HorizontalAlignment="Stretch"
                    Click="OnSelectIconClick"
                    ToolTipService.ToolTip="Click to browse and select an icon from the icon library">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon
                            x:Name="SelectedIconDisplay"
                            Width="24"
                            Height="24"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Kind="{x:Bind SelectedIconKind, Mode=OneWay}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="Click to select icon" />
                            <TextBlock
                                x:Name="SelectedIconNameText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Box" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Type Image (PNG)" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Optional: upload a PNG image to represent this dunnage type in selection, admin, and review views."
                    TextWrapping="Wrap" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="96"
                        Height="96"
                        Padding="4"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Image
                            Source="{x:Bind SelectedImageSource, Mode=OneWay}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind HasSelectedImage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind SelectedImagePath, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnChooseImageClick" Content="Choose PNG" />
                            <Button Click="OnClearImageClick" Content="Clear Image" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!--  Specifications  -->
            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Specifications" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Define custom fields to capture specific data for this dunnage type" />
                </StackPanel>

                <!--  Add Spec Form  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="NewSpecNameBox"
                                PlaceholderText="Field Name (e.g. Material, Weight)"
                                ToolTipService.ToolTip="Enter a unique name for this specification field" />
                            <ComboBox
                                x:Name="NewSpecTypeCombo"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                ToolTipService.ToolTip="Select the data type for this field">
                                <ComboBoxItem Content="Text" />
                                <ComboBoxItem Content="Number" />
                                <ComboBoxItem Content="Boolean" />
                                <ComboBoxItem Content="Choices" />
                            </ComboBox>
                        </Grid>

                        <!--  Number Type Options  -->
                        <StackPanel
                            x:Name="NumberOptionsPanel"
                            Spacing="8"
                            Visibility="Collapsed">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Number Validation" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    x:Name="NewSpecMinValueBox"
                                    Header="Min Value"
                                    PlaceholderText="Optional"
                                    SpinButtonPlacementMode="Compact"
                                    ToolTipService.ToolTip="Minimum allowed value (optional)" />
                                <NumberBox
                                    x:Name="NewSpecMaxValueBox"
                                    Grid.Column="1"
                                    Header="Max Value"
                                    PlaceholderText="Optional"
                                    SpinButtonPlacementMode="Compact"
                                    ToolTipService.ToolTip="Maximum allowed value (optional)" />
                                <TextBox
                                    x:Name="NewSpecUnitBox"
                                    Grid.Column="2"
                                    Header="Unit"
                                    PlaceholderText="e.g. inches, lbs"
                                    ToolTipService.ToolTip="Unit of measurement (optional)" />
                            </Grid>
                        </StackPanel>

                        <Border
                            x:Name="ChoicesOptionsPanel"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Choice Values" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Add the allowed values for this field. Example: Tall, Short."
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="NewSpecChoiceBox"
                                        HorizontalAlignment="Stretch"
                                        PlaceholderText="Add a choice" />
                                    <Button
                                        Grid.Column="1"
                                        Click="OnAddChoiceClick"
                                        Content="Add Choice"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </Grid>
                                <ListView
                                    x:Name="ChoicesListView"
                                    Height="110"
                                    Padding="4"
                                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid Padding="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="{x:Bind}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Click="OnRemoveChoiceClick"
                                                    Content="&#xE74D;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    ToolTipService.ToolTip="Remove this choice" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="16">
                                <CheckBox
                                    x:Name="NewSpecRequiredCheck"
                                    Content="Required Field"
                                    ToolTipService.ToolTip="Check if this field is required" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Click="OnAddSpecClick"
                                Content="Add Field"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Add this specification to the list below" />
                        </Grid>
                    </StackPanel>
                </Border>

                <ListView
                    x:Name="SpecsListView"
                    Height="130"
                    Padding="4"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ToolTipService.ToolTip="List of specifications defined for this type">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Model_SpecItem">
                            <Grid Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Description}" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Margin="8,0"
                                    Padding="6,2"
                                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                    CornerRadius="3"
                                    Visibility="{x:Bind IsRequiredVisibility}">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Text="Required" />
                                </Border>
                                <Button
                                    Grid.Column="2"
                                    Click="OnRemoveSpecClick"
                                    Content="&#xE74D;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Remove this specification" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
