<UserControl
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_dunnage_typeselectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialIcons="using:Material.Icons.WinUI3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_Dunnage.Models"
    xmlns:viewmodels="using:MTM_Receiving_Application.Module_Dunnage.ViewModels"
    x:Name="RootUserControl"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:Converter_IconCodeToGlyph x:Key="IconCodeToGlyphConverter" />
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  3x3 Type Grid  -->
        <Grid x:Name="CardAreaHost" Grid.Row="1">

            <GridView
                x:Name="TypeGridView"
                MaxWidth="912"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                IsItemClickEnabled="True"
                ItemClick="TypeCard_ItemClick"
                ItemsSource="{x:Bind ViewModel.DisplayedTypes, Mode=OneWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectedItem="{x:Bind ViewModel.SelectedType, Mode=TwoWay}"
                SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:Model_DunnageType">
                        <Border
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Command="{Binding ElementName=RootUserControl, Path=ViewModel.EditTypeCommand}"
                                        CommandParameter="{x:Bind}"
                                        Icon="Edit"
                                        Text="Edit"
                                        Visibility="{Binding ElementName=RootUserControl, Path=ViewModel.CanManageDefinitions, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <MenuFlyoutItem
                                        Command="{Binding ElementName=RootUserControl, Path=ViewModel.DeleteTypeCommand}"
                                        CommandParameter="{x:Bind}"
                                        Icon="Delete"
                                        Text="Delete"
                                        Visibility="{Binding ElementName=RootUserControl, Path=ViewModel.CanManageDefinitions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Width="72"
                                    Height="72"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{x:Bind HasImagePath, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Image Source="{x:Bind ImageSource, Mode=OneWay}" Stretch="Uniform" />
                                </Border>

                                <Border
                                    Grid.Row="0"
                                    Width="72"
                                    Height="72"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{x:Bind HasImagePath, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}">
                                    <materialIcons:MaterialIcon
                                        Width="36"
                                        Height="36"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                        Kind="{x:Bind IconKind, Mode=OneWay}" />
                                </Border>



                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    MaxLines="2"
                                    Text="{x:Bind TypeName}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <!--  Pagination Controls  -->
        <Grid
            Grid.Row="2"
            Padding="12"
            HorizontalAlignment="Stretch"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock VerticalAlignment="Center" Text="Sort by" />

                <ComboBox
                    MinWidth="240"
                    HorizontalAlignment="Left"
                    ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                    ToolTipService.ToolTip="Sort the available dunnage types." />
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  First Page  -->
                <Button
                    Grid.Column="0"
                    Command="{x:Bind ViewModel.FirstPageCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.FirstPage'), Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE892;" />
                </Button>

                <!--  Previous Page  -->
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.PreviousPageCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.PreviousPage'), Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE76B;" />
                </Button>

                <!--  Page Info  -->
                <Border
                    Grid.Column="2"
                    MinWidth="120"
                    Padding="12,6"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.PageInfo, Mode=OneWay}" />
                </Border>

                <!--  Next Page  -->
                <Button
                    Grid.Column="3"
                    Command="{x:Bind ViewModel.NextPageCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.NextPage'), Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE76C;" />
                </Button>

                <!--  Last Page  -->
                <Button
                    Grid.Column="4"
                    Command="{x:Bind ViewModel.LastPageCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LastPage'), Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE893;" />
                </Button>
            </Grid>

            <!--  Quick Add Button  -->
            <Button
                Grid.Column="2"
                Margin="20,0,0,0"
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.QuickAddTypeCommand}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{Binding ElementName=RootUserControl, Path=ViewModel.CanManageDefinitions, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="Quick Add Type" />
                </StackPanel>
            </Button>

        </Grid>
    </Grid>
</UserControl>
