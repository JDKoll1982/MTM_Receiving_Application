<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_Dialog_PartInfoModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:models="using:MTM_Receiving_Application.Module_Dunnage.Models"
    CloseButtonText="Close">
    <ContentDialog.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <x:Double x:Key="ContentDialogMaxWidth">1600</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
    </ContentDialog.Resources>
    <Grid MinWidth="760" MaxWidth="860">
        <ScrollViewer MaxHeight="760" Style="{StaticResource SharedScrollViewerHorizontalAutoVerticalOffHiddenStyle}">
            <StackPanel Spacing="16">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Heading}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Inspect the stored part metadata, inventory settings, and spec values for this Dunnage part."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid MinHeight="220">
                            <Image
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{x:Bind ViewModel.ImageSource, Mode=OneWay}"
                                Stretch="Uniform" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="No image available"
                                Visibility="{x:Bind ViewModel.HasImage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <Border
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="4">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Part ID" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.PartId}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Spacing="4">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Dunnage Type" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.DunnageTypeName}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Spacing="4">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Home Location" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.HomeLocation}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Spacing="4">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Inventory Type" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.InventoryType}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Spacing="4">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Load Type" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.LoadType}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Spacing="4">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Image Path" />
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind ViewModel.ImagePath}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Spacing="4">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Created" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CreatedDate}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.CreatedBy}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Spacing="4">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Modified" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.ModifiedDate}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.ModifiedBy}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Spec Values" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SpecValues, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:Model_DunnageDisplayField">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Label}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind Value}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
