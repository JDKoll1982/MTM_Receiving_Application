<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_QuickAddPartDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MTM_Receiving_Application.Module_Dunnage.Models"
    Title="Add New Dunnage Part"
    Width="820"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
    PrimaryButtonText="Add Part">
    <ScrollViewer MaxHeight="640">
        <StackPanel Padding="8" Spacing="20">
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Enter details for the new dunnage part. This dialog uses the same spec-driven fields as Edit Part."
                TextWrapping="Wrap" />

            <Border
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="4">
                <StackPanel Spacing="4">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Dunnage Type" />
                    <TextBlock
                        x:Name="TypeNameTextBlock"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="20" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Part ID" />
                    <TextBox
                        x:Name="PartIdTextBox"
                        MaxLength="100"
                        PlaceholderText="Enter part ID" />
                    <Button
                        x:Name="SuggestPartIdButton"
                        HorizontalAlignment="Left"
                        Click="SuggestPartIdButton_Click"
                        Content="Suggest from Specs" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="You can edit the Part ID directly or use the suggested value based on the configured specs."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Inventory Type" />
                    <ComboBox x:Name="InventoryTypeComboBox" SelectedIndex="0">
                        <ComboBoxItem Content="Not Inventoried" />
                        <ComboBoxItem Content="Adjust In" />
                        <ComboBoxItem Content="Receive In" />
                        <ComboBoxItem Content="Both" />
                    </ComboBox>
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Home Location" />
                    <TextBox
                        x:Name="HomeLocationTextBox"
                        MaxLength="100"
                        PlaceholderText="e.g. A-12-B, DOCK-2, Rack by 100-15" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Part Image (PNG)" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="96"
                            Height="96"
                            Padding="4"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Image x:Name="PartImagePreview" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <TextBlock
                                x:Name="PartImagePathTextBlock"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="WrapWholeWords" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="ChooseImageButton_Click" Content="Choose PNG" />
                                <Button Click="ClearImageButton_Click" Content="Clear Image" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    Grid.Column="0"
                    Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Additional Notes (Optional)" />
                    <TextBox
                        x:Name="NotesTextBox"
                        Height="100"
                        AcceptsReturn="True"
                        MaxLength="500"
                        PlaceholderText="Any additional specifications or notes"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Specifications" />
                        <Button
                            Grid.Column="1"
                            Click="ChooseExistingSpecsButton_Click"
                            Content="Choose Existing Specs" />
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Fill out the configured specs for this dunnage type, or reuse a saved spec set from an existing part." />
                    <Grid
                        x:Name="DynamicSpecsGrid"
                        ColumnSpacing="16"
                        RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <Border
                        Padding="12"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Part-Specific Specs" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Add extra key/value specs that are saved on this part only." />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewCustomSpecNameTextBox" PlaceholderText="Spec name" />
                                <TextBox
                                    x:Name="NewCustomSpecValueTextBox"
                                    Grid.Column="1"
                                    PlaceholderText="Spec value" />
                                <Button
                                    Grid.Column="2"
                                    Click="AddCustomSpecButton_Click"
                                    Content="Add Spec" />
                            </Grid>
                            <TextBlock
                                x:Name="CustomSpecsValidationTextBlock"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <ListView
                                x:Name="CustomSpecsListView"
                                MinHeight="80"
                                MaxHeight="180"
                                Padding="4"
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Model_DunnagePartCustomSpecEntry">
                                        <Grid Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox PlaceholderText="Spec name" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                PlaceholderText="Spec value"
                                                Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button
                                                Grid.Column="2"
                                                Margin="8,0,0,0"
                                                Click="RemoveCustomSpecButton_Click"
                                                Content="&#xE74D;"
                                                FontFamily="Segoe MDL2 Assets"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                ToolTipService.ToolTip="Remove this part-specific spec" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
