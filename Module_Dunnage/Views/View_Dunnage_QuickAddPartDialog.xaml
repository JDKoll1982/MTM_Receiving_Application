<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_QuickAddPartDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add New Dunnage Part"
    Width="820"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
    PrimaryButtonText="Add Part">
    <ScrollViewer MaxHeight="640">
        <StackPanel Padding="8" Spacing="20">
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Enter details for the new dunnage part. This dialog uses the same spec-driven fields as Edit Part."
                TextWrapping="Wrap" />

            <Border
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="4">
                <StackPanel Spacing="4">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Dunnage Type" />
                    <TextBlock
                        x:Name="TypeNameTextBlock"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="20" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Part ID" />
                    <TextBox
                        x:Name="PartIdTextBox"
                        MaxLength="100"
                        PlaceholderText="Enter part ID" />
                    <Button
                        x:Name="SuggestPartIdButton"
                        HorizontalAlignment="Left"
                        Click="SuggestPartIdButton_Click"
                        Content="Suggest from Specs" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="You can edit the Part ID directly or use the suggested value based on the configured specs."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Inventory Type" />
                    <ComboBox x:Name="InventoryTypeComboBox" SelectedIndex="0">
                        <ComboBoxItem Content="Not Inventoried" />
                        <ComboBoxItem Content="Adjust In" />
                        <ComboBoxItem Content="Receive In" />
                        <ComboBoxItem Content="Both" />
                    </ComboBox>
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Home Location" />
                    <TextBox
                        x:Name="HomeLocationTextBox"
                        MaxLength="100"
                        PlaceholderText="e.g. A-12-B, DOCK-2, Rack by 100-15" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Additional Notes (Optional)" />
                    <TextBox
                        x:Name="NotesTextBox"
                        Height="100"
                        AcceptsReturn="True"
                        MaxLength="500"
                        PlaceholderText="Any additional specifications or notes"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Spacing="12">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Specifications" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Fill out the configured specs for this dunnage type." />
                    <Grid
                        x:Name="DynamicSpecsGrid"
                        ColumnSpacing="16"
                        RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
