<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_QuickAddPartDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MTM_Receiving_Application.Module_Dunnage.Models"
    x:Name="RootDialog"
    Title="Add New Dunnage Part">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1600</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
        <!--  Help Button Style  -->
        <Style x:Key="HelpButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.Resources>
    <Grid
        x:Name="RootGrid"
        MinWidth="900"
        MaxWidth="1280">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                Margin="0,0,220,0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Add a new dunnage part in three short steps."
                TextWrapping="Wrap" />

            <Border
                Padding="12"
                HorizontalAlignment="Right"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Dunnage Type" />
                    <TextBlock
                        x:Name="TypeNameTextBlock"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="WizardContentGrid" Grid.Row="1">
            <Grid
                x:Name="StepPartSetupPanel"
                Padding="4"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Part ID" />
                            <TextBox
                                x:Name="PartIdTextBox"
                                MaxLength="100"
                                PlaceholderText="Enter part ID" />
                            <Button
                                x:Name="SuggestPartIdButton"
                                HorizontalAlignment="Left"
                                Click="SuggestPartIdButton_Click"
                                Content="Suggest Part ID" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Type the part ID yourself or start with a suggested ID based on the details you entered."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Inventory Type" />
                            <ComboBox x:Name="InventoryTypeComboBox" SelectedIndex="0">
                                <ComboBoxItem Content="Not Inventoried" />
                                <ComboBoxItem Content="Adjust In" />
                                <ComboBoxItem Content="Receive In" />
                                <ComboBoxItem Content="Both" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Home Location" />
                            <TextBox
                                x:Name="HomeLocationTextBox"
                                MaxLength="100"
                                PlaceholderText="e.g. A-12-B, DOCK-2, Rack by 100-15" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Part Image (PNG)" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="96"
                                    Height="96"
                                    Padding="4"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Image x:Name="PartImagePreview" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <TextBlock
                                        x:Name="PartImagePathTextBlock"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="WrapWholeWords" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="ChooseImageButton_Click" Content="Choose PNG" />
                                        <Button
                                            x:Name="RotateImageButton"
                                            Click="RotateImageButton_Click"
                                            Content="Rotate 90°"
                                            IsEnabled="False" />
                                        <Button Click="ClearImageButton_Click" Content="Clear Image" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Additional Notes (Optional)" />
                            <TextBox
                                x:Name="NotesTextBox"
                                Height="150"
                                AcceptsReturn="True"
                                MaxLength="500"
                                PlaceholderText="Add any extra notes for this part"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid
                x:Name="StepTypeSpecsPanel"
                Padding="4"
                RowSpacing="12"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Part Details" />
                    <Button
                        Grid.Column="1"
                        Click="ChooseExistingSpecsButton_Click"
                        Content="Copy From Existing Part" />
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Enter the saved details for this dunnage type, or copy them from an existing part. If there are many fields, they will be shown a few at a time."
                    TextWrapping="Wrap" />

                <Border
                    Grid.Row="2"
                    Padding="16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock
                                x:Name="NoConfiguredSpecsTextBlock"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="No saved detail fields are set up for this dunnage type." />
                            <Grid
                                x:Name="DynamicSpecsGrid"
                                ColumnSpacing="16"
                                RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="PreviousSpecPageButton"
                                Click="OnPreviousSpecPageClick"
                                Content="Previous" />
                            <TextBlock
                                x:Name="SpecPageSummaryTextBlock"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <Button
                                x:Name="NextSpecPageButton"
                                Grid.Column="2"
                                Click="OnNextSpecPageClick"
                                Content="Next" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid
                x:Name="StepPartSpecificSpecsPanel"
                Padding="4"
                RowSpacing="12"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Padding="16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            Padding="16,16,16,0"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PartSpecificSpecNameTextBox" PlaceholderText="Field label (for example: Edge Guard)" />
                            <ComboBox
                                x:Name="PartSpecificSpecTypeComboBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="PartSpecificSpecTypeComboBox_SelectionChanged">
                                <x:String>Text</x:String>
                                <x:String>Number</x:String>
                                <x:String>Boolean</x:String>
                                <x:String>Choices</x:String>
                            </ComboBox>
                        </Grid>

                        <ScrollViewer
                            Grid.Row="1"
                            Padding="16,12,16,0"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Extra Information To Capture" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Add any extra fields operators should fill in when this part is received. These prompts stay with the part for future use."
                                    TextWrapping="Wrap" />

                                <Border
                                    x:Name="PartSpecificNumberOptionsBorder"
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="Collapsed">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Number Rules" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox
                                                x:Name="PartSpecificMinValueNumberBox"
                                                Header="Minimum"
                                                PlaceholderText="Optional"
                                                SpinButtonPlacementMode="Compact" />
                                            <NumberBox
                                                x:Name="PartSpecificMaxValueNumberBox"
                                                Grid.Column="1"
                                                Header="Maximum"
                                                PlaceholderText="Optional"
                                                SpinButtonPlacementMode="Compact" />
                                            <TextBox
                                                x:Name="PartSpecificUnitTextBox"
                                                Grid.Column="2"
                                                Header="Unit"
                                                PlaceholderText="For example: inches or lbs" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border
                                    x:Name="PartSpecificChoicesBorder"
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="Collapsed">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Options" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="PartSpecificChoiceTextBox"
                                                HorizontalAlignment="Stretch"
                                                PlaceholderText="Add an option" />
                                            <Button
                                                Grid.Column="1"
                                                Click="AddPartSpecificChoiceButton_Click"
                                                Content="Add Option"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        </Grid>
                                        <ListView
                                            x:Name="PartSpecificChoicesListView"
                                            Height="100"
                                            Padding="4"
                                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Grid Padding="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind}" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Click="RemovePartSpecificChoiceButton_Click"
                                                            Content="&#xE74D;"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            Style="{StaticResource SubtleButtonStyle}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    x:Name="CustomSpecsValidationTextBlock"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />

                                <ListView
                                    x:Name="PartSpecificSpecsListView"
                                    Padding="4"
                                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    ItemsSource="{x:Bind PartSpecificSpecs, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Model_SpecItem">
                                            <Grid Padding="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind Name}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Description}" />
                                                </StackPanel>
                                                <Border
                                                    Grid.Column="1"
                                                    Margin="8,0"
                                                    Padding="6,2"
                                                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                    CornerRadius="3"
                                                    Visibility="{x:Bind IsRequiredVisibility}">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Text="Required" />
                                                </Border>
                                                <Button
                                                    Grid.Column="2"
                                                    Click="RemovePartSpecificSpecButton_Click"
                                                    Content="&#xE74D;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    Style="{StaticResource SubtleButtonStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid
                            Grid.Row="2"
                            Padding="16,12,16,16"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                x:Name="PartSpecificRequiredCheckBox"
                                VerticalAlignment="Center"
                                Content="Required" />
                            <Button
                                Grid.Column="1"
                                Click="AddPartSpecificSpecButton_Click"
                                Content="Add Prompt"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border
            Grid.Row="2"
            Margin="0,12,0,0"
            Padding="0,12,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="BackStepButton"
                        MinWidth="96"
                        Click="OnBackStepClick"
                        Content="Back" />
                    <Button
                        x:Name="NextStepButton"
                        MinWidth="96"
                        Click="OnNextStepClick"
                        Content="Next" />
                </StackPanel>

                <TextBlock
                    x:Name="StepSummaryTextBlock"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="FooterDeleteButton"
                        MinWidth="100"
                        Click="OnFooterDeleteButtonClick"
                        Content="Delete"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="FooterCancelButton"
                        MinWidth="100"
                        Click="OnFooterCancelButtonClick"
                        Content="Cancel" />
                    <Button
                        x:Name="FooterPrimaryButton"
                        MinWidth="100"
                        Click="OnFooterPrimaryButtonClick"
                        Content="Add Part"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
