<UserControl
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_PartSelectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="using:Material.Icons.WinUI3"
    xmlns:models="using:MTM_Receiving_Application.Module_Dunnage.Models"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter"/>
        <converters:Converter_EmptyStringToVisibility x:Key="EmptyStringToVisibilityConverter"/>
        <Style x:Key="PartCardGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="188"/>
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ListViewItemPresenter
                            ContentMargin="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            PointerOverBackground="{ThemeResource ControlFillColorTertiaryBrush}"
                            PointerOverForeground="{ThemeResource TextFillColorPrimaryBrush}"
                            PointerOverBackgroundMargin="0"
                            SelectedBackground="{ThemeResource AccentFillColorSecondaryBrush}"
                            SelectedPointerOverBackground="{ThemeResource AccentFillColorTertiaryBrush}"
                            SelectedPressedBackground="{ThemeResource AccentFillColorDefaultBrush}"
                            SelectionCheckMarkVisualEnabled="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

        <Grid Grid.Row="0"
              RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Section 1: ComboBox / Cards -->
            <Border Grid.Row="0"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="Select Part"/>
                    <ComboBox
                        Grid.Row="1"
                        x:Name="PartNumberComboBox"
                        MinWidth="300"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="PartId"
                        ItemsSource="{x:Bind ViewModel.AvailableParts, Mode=OneWay}"
                        PlaceholderText="{x:Bind ViewModel.GetPlaceholder('Field.PartSelection'), Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedPart, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsImageDisplayPreferred, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}"/>

                    <Grid
                        Grid.Row="2"
                        Visibility="{x:Bind ViewModel.IsImageDisplayPreferred, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <GridView
                            x:Name="PartCardGridView"
                            HorizontalAlignment="Stretch"
                            IsItemClickEnabled="False"
                            ItemsSource="{x:Bind ViewModel.AvailableParts, Mode=OneWay}"
                            ScrollViewer.HorizontalScrollBarVisibility="Visible"
                            ScrollViewer.HorizontalScrollMode="Enabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectedItem="{x:Bind ViewModel.SelectedPart, Mode=TwoWay}"
                            SelectionMode="Single">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem" BasedOn="{StaticResource PartCardGridViewItemStyle}"/>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:Model_DunnagePart">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border
                                            Grid.Row="0"
                                            Width="76"
                                            Height="76"
                                            Margin="0,0,0,8"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{x:Bind HasPreferredVisual, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Source="{x:Bind PreferredVisualSource, Mode=OneWay}"
                                                   Stretch="Uniform"/>
                                        </Border>

                                        <Border
                                            Grid.Row="0"
                                            Width="76"
                                            Height="76"
                                            Margin="0,0,0,8"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{x:Bind HasPreferredVisual, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="36"
                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                Glyph="&#xE8B7;"/>
                                        </Border>

                                        <TextBlock
                                            Grid.Row="1"
                                            HorizontalAlignment="Center"
                                            MaxLines="1"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind PartId}"
                                            ToolTipService.ToolTip="{x:Bind PartId}"/>

                                        <TextBlock
                                            Grid.Row="2"
                                            Margin="0,2,0,0"
                                            HorizontalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind QuantityType}"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWholeWords"/>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </Grid>
            </Border>

            <!-- Section 3: Part Details -->
            <Border Grid.Row="1"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.IsPartSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Text="Part Details"/>

                    <Grid Grid.Row="1"
                          ColumnSpacing="16"
                          RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Grid.RowSpan="3"
                            Width="88"
                            Height="88"
                            Margin="0,0,10,0"
                            Padding="2"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{x:Bind ViewModel.HasSelectedPartVisual, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image Source="{x:Bind ViewModel.SelectedPartVisualSource, Mode=OneWay}"
                                   Stretch="Uniform"/>
                        </Border>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Part ID:"/>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   FontWeight="SemiBold"
                                   Text="{x:Bind ViewModel.SelectedPart.PartId, Mode=OneWay}"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Type:"/>
                        
                                <TextBlock Grid.Row="1"
                                    Grid.Column="2" Text="{x:Bind ViewModel.SelectedTypeName, Mode=OneWay}"/>
                 

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   VerticalAlignment="Top"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Specs:"/>
                        <StackPanel Grid.Row="2"
                                    Grid.Column="2"
                                    Spacing="2">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedPartSpecSummaries, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}"
                                                   TextWrapping="WrapWholeWords"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="No specs available for this part."
                                       Visibility="{x:Bind ViewModel.HasSelectedPartSpecs, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.IsInventoryNotificationVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <FontIcon FontSize="16"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                  Glyph="&#xE946;"/>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Inventory Method:"/>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Text="{x:Bind ViewModel.InventoryMethod, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Padding="12"
            Margin="0,12,0,0"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <!--  Action Buttons  -->
            <Grid Grid.Row="1"
                  ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Command="{x:Bind ViewModel.QuickAddPartCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.CanManageDefinitions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE710;"/>
                        <TextBlock Text="Add New Part"/>
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.EditPartCommand}"
                    ToolTipService.ToolTip="Edit the selected part's specifications and home location"
                    Visibility="{x:Bind ViewModel.CanManageDefinitions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE70F;"/>
                        <TextBlock Text="Edit Part"/>
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.DeletePartCommand}"
                    ToolTipService.ToolTip="Permanently delete the selected part"
                    Visibility="{x:Bind ViewModel.CanManageDefinitions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE74D;"/>
                        <TextBlock Text="Delete Part"/>
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="3"
                    Command="{x:Bind ViewModel.LoadPartsCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.Refresh'), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE72C;"/>
                        <TextBlock Text="Refresh Parts"/>
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="4"
                    Command="{x:Bind ViewModel.ChangePartTypeCommand}"
                    ToolTipService.ToolTip="Move the selected part to a different dunnage type"
                    Visibility="{x:Bind ViewModel.CanManageDefinitions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE8A9;"/>
                        <TextBlock Text="Change Type"/>
                    </StackPanel>
                </Button>

                <!--  Column 5 is the * spacer  -->

                <ToggleSwitch
                    Grid.Column="6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    IsOn="{x:Bind ViewModel.IsImageDisplayPreferred, Mode=TwoWay}"
                    OffContent="Drop-down"
                    OnContent="Image Cards"
                    ToolTipService.ToolTip="{x:Bind ViewModel.DisplayFormatToggleTooltip, Mode=OneWay}"
                    Toggled="OnDisplayFormatPreferenceToggled"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
