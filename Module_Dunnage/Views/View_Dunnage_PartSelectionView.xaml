<UserControl
    x:Class="MTM_Receiving_Application.Module_Dunnage.Views.View_Dunnage_PartSelectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="using:Material.Icons.WinUI3"
    xmlns:models="using:MTM_Receiving_Application.Module_Dunnage.Models"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter"/>
        <converters:Converter_EmptyStringToVisibility x:Key="EmptyStringToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--  Part Selection Form  -->
        <ScrollViewer Grid.Row="0"
                Style="{StaticResource SharedScrollViewerBothAutoHiddenStyle}">
            <StackPanel Spacing="24">
                <!--  Part Dropdown  -->
                <StackPanel
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsImageDisplayPreferred, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Select Part"/>
                    <ComboBox
                        x:Name="PartNumberComboBox"
                        MinWidth="300"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="PartId"
                        ItemsSource="{x:Bind ViewModel.AvailableParts, Mode=OneWay}"
                        PlaceholderText="{x:Bind ViewModel.GetPlaceholder('Field.PartSelection'), Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedPart, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsImageDisplayPreferred, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Select Part"/>

                    <GridView
                        x:Name="PartCardGridView"
                        HorizontalAlignment="Stretch"
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.AvailableParts, Mode=OneWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Auto"
                        SelectedItem="{x:Bind ViewModel.SelectedPart, Mode=TwoWay}"
                        SelectionMode="Single">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding"
                                        Value="0"/>
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment"
                                        Value="Stretch"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:Model_DunnagePart">
                                <Border
                                    Margin="4"
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border
                                            Grid.Row="0"
                                            Width="96"
                                            Height="96"
                                            Margin="0,0,0,10"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{x:Bind HasPreferredVisual, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Source="{x:Bind PreferredVisualSource, Mode=OneWay}"
                                                    Stretch="Uniform"/>
                                        </Border>

                                        <Border
                                            Grid.Row="0"
                                            Width="96"
                                            Height="96"
                                            Margin="0,0,0,10"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{x:Bind HasPreferredVisual, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="36"
                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                Glyph="&#xE8B7;"/>
                                        </Border>

                                        <TextBlock
                                            Grid.Row="1"
                                            HorizontalAlignment="Center"
                                            MaxLines="1"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind PartId}"
                                            ToolTipService.ToolTip="{x:Bind PartId}"/>

                                        <TextBlock
                                            Grid.Row="2"
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind QuantityType}"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWholeWords"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!--  Part Details Card  -->
                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.IsPartSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!--  Header  -->
                        <TextBlock
                            Grid.Row="0"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Part Details"/>

                        <!--  Details Grid  -->
                        <Grid
                            Grid.Row="1"
                            ColumnSpacing="24"
                            RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Width="120"
                                Height="120"
                                Margin="0,0,12,0"
                                Padding="4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{x:Bind ViewModel.HasSelectedPartVisual, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Image Source="{x:Bind ViewModel.SelectedPartVisualSource, Mode=OneWay}"
                                        Stretch="Uniform"/>
                            </Border>

                            <!--  Part ID  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Part ID:"/>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.SelectedPart.PartId, Mode=OneWay}"/>

                            <!--  Type  -->
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Type:"/>
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6">
                                <mi:MaterialIcon
                                    Width="16"
                                    Height="16"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Kind="{x:Bind ViewModel.SelectedTypeIconKind, Mode=OneWay}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedTypeName, Mode=OneWay}"/>
                            </StackPanel>

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Specs:"/>
                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="2"
                                Spacing="4">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedPartSpecSummaries, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}"
                                                    TextWrapping="WrapWholeWords"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="No specs available for this part."
                                    Visibility="{x:Bind ViewModel.HasSelectedPartSpecs, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}"/>
                            </StackPanel>
                        </Grid>

                        <!--  Inventory Method (if applicable)  -->
                        <StackPanel
                            Grid.Row="3"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsInventoryNotificationVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xE946;"/>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Inventory Method:"/>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Text="{x:Bind ViewModel.InventoryMethod, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border
            Grid.Row="1"
            Padding="12"
            Margin="0,12,0,0"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <!--  Action Buttons  -->
            <Grid Grid.Row="1"
                    ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Command="{x:Bind ViewModel.QuickAddPartCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.CanManageDefinitions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                            Spacing="8">
                        <FontIcon FontSize="16"
                                Glyph="&#xE710;"/>
                        <TextBlock Text="Add New Part"/>
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.EditPartCommand}"
                    ToolTipService.ToolTip="Edit the selected part's specifications and home location"
                    Visibility="{x:Bind ViewModel.CanManageDefinitions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                            Spacing="8">
                        <FontIcon FontSize="16"
                                Glyph="&#xE70F;"/>
                        <TextBlock Text="Edit Part"/>
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.DeletePartCommand}"
                    ToolTipService.ToolTip="Permanently delete the selected part"
                    Visibility="{x:Bind ViewModel.CanManageDefinitions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                            Spacing="8">
                        <FontIcon FontSize="16"
                                Glyph="&#xE74D;"/>
                        <TextBlock Text="Delete Part"/>
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="3"
                    Command="{x:Bind ViewModel.LoadPartsCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.Refresh'), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal"
                            Spacing="8">
                        <FontIcon FontSize="16"
                                Glyph="&#xE72C;"/>
                        <TextBlock Text="Refresh Parts"/>
                    </StackPanel>
                </Button>

                <!--  Column 4 is the * spacer  -->

                <ToggleSwitch
                    Grid.Column="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    IsOn="{x:Bind ViewModel.IsImageDisplayPreferred, Mode=TwoWay}"
                    OffContent="Drop-down"
                    OnContent="Image Cards"
                    ToolTipService.ToolTip="{x:Bind ViewModel.DisplayFormatToggleTooltip, Mode=OneWay}"
                    Toggled="OnDisplayFormatPreferenceToggled"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
