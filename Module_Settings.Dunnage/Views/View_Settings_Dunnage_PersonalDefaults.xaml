<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Dunnage.Views.View_Settings_Dunnage_PersonalDefaults"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MTM_Receiving_Application.Module_Settings.Dunnage.Views"
    x:DataType="views:View_Settings_Dunnage_PersonalDefaults">
    <ScrollViewer>
        <Grid Padding="24">
            <StackPanel
                Width="960"
                HorizontalAlignment="Center"
                Spacing="20">
                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Default Dunnage Location" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="This location is applied automatically when the Dunnage details step is left blank. The value must match a valid Infor Visual location in warehouse 002."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBox
                            x:Name="DefaultLocationTextBox"
                            Header="Default Location"
                            LostFocus="DefaultLocationTextBox_LostFocus"
                            PlaceholderText="RECV"
                            Text="{x:Bind ViewModel.DefaultLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="If the entered location does not match exactly, you will be prompted to choose a fuzzy-match result."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Personal Visual Defaults" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="These settings stay user-specific. Use them to tune how large Dunnage visuals appear for you and whether part images should win when both part and type images exist."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <NumberBox
                            Header="Preferred Thumbnail Size"
                            LargeChange="32"
                            Maximum="192"
                            Minimum="48"
                            SmallChange="16"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.PreferredThumbnailSize, Mode=TwoWay}" />

                        <ToggleSwitch
                            Header="Prefer part images over type images"
                            IsOn="{x:Bind ViewModel.PreferPartImages, Mode=TwoWay}"
                            OffContent="Allow type images to lead"
                            OnContent="Use part images first" />
                    </StackPanel>
                </Border>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button Command="{x:Bind ViewModel.ResetCommand}" Content="Reset" />
                    <Button
                        Command="{x:Bind ViewModel.SaveCommand}"
                        Content="Save"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
