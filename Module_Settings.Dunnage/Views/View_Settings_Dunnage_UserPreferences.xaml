<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Dunnage.Views.View_Settings_Dunnage_UserPreferences"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MTM_Receiving_Application.Module_Settings.Dunnage.Views"
    x:DataType="views:View_Settings_Dunnage_UserPreferences"
>
    <ScrollViewer>
        <Grid Padding="24">
            <StackPanel HorizontalAlignment="Center" Width="960" Spacing="20">
                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                >
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Default Dunnage Location"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                            />
                            <TextBlock
                                Text="This location is applied automatically when the Dunnage details step is left blank. The value must match a valid Infor Visual location in warehouse 002."
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                            />
                        </StackPanel>

                        <TextBox
                            x:Name="DefaultLocationTextBox"
                            Header="Default Location"
                            Text="{x:Bind ViewModel.DefaultLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LostFocus="DefaultLocationTextBox_LostFocus"
                            PlaceholderText="RECV"
                            HorizontalAlignment="Stretch"
                        />

                        <TextBlock
                            Text="If the entered location does not match exactly, you will be prompted to choose a fuzzy-match result just like Receiving location entry."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                        />
                    </StackPanel>
                </Border>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                >
                    <StackPanel Spacing="10">
                        <TextBlock
                            Text="Behavior"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                        />
                        <TextBlock
                            Text="When a Dunnage user does not enter a location during the guided workflow, the workflow now uses this user preference instead of leaving the location unresolved."
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                        />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                    <Button
                        Content="Reset"
                        Command="{x:Bind ViewModel.ResetCommand}"
                    />
                    <Button
                        Content="Save"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                    />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
