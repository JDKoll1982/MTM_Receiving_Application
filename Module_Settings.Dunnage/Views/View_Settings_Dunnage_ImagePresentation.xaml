<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Dunnage.Views.View_Settings_Dunnage_ImagePresentation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MTM_Receiving_Application.Module_Settings.Dunnage.Views"
    x:DataType="views:View_Settings_Dunnage_ImagePresentation">
    <ScrollViewer Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
        <Grid Padding="24">
            <StackPanel
                Width="960"
                HorizontalAlignment="Center"
                Spacing="20">
                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Image Presentation" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Control whether Dunnage images render at all, how large they appear by default across the app, and which visual source wins when both a part and type image exist."
                            TextWrapping="Wrap" />

                        <ToggleSwitch Header="Enable Dunnage type images" IsOn="{x:Bind ViewModel.EnableTypeImages, Mode=TwoWay}" />

                        <ToggleSwitch Header="Enable Dunnage part images" IsOn="{x:Bind ViewModel.EnablePartImages, Mode=TwoWay}" />

                        <NumberBox
                            Header="Application Default Thumbnail Size"
                            Maximum="192"
                            Minimum="48"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.DefaultThumbnailSize, Mode=TwoWay}" />

                        <ComboBox Header="Default visual source priority" SelectedItem="{x:Bind ViewModel.DefaultVisualSource, Mode=TwoWay}">
                            <x:String>PartThenTypeThenIcon</x:String>
                            <x:String>TypeThenPartThenIcon</x:String>
                            <x:String>IconOnly</x:String>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button Command="{x:Bind ViewModel.ResetCommand}" Content="Reset" />
                    <Button
                        Command="{x:Bind ViewModel.SaveCommand}"
                        Content="Save"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
