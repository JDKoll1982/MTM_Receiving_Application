<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MTM_Receiving_Application.Module_ShipRec_Tools.Views.View_Tool_OutsideServiceHistory"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_InverseBool x:Key="InverseBoolConverter" />
        <converters:Converter_InfoBarSeverity x:Key="InfoBarSeverityConverter" />
        <converters:Converter_DateTimeToString x:Key="DateTimeToStringConverter" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,20"
            Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Outside Service History" />
            <TextBlock
                Opacity="0.7"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Search dispatch history by part or vendor." />
        </StackPanel>

        <!--  Search Row  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,16"
            Spacing="10">
            <!--  Mode toggle: Part Number ↔ Vendor Name  -->
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <ToggleButton
                        Command="{x:Bind ViewModel.SetSearchByPartCommand}"
                        Content="Part Number"
                        CornerRadius="4,0,0,4"
                        IsChecked="{x:Bind ViewModel.IsSearchByPart, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                    <ToggleButton
                        Command="{x:Bind ViewModel.SetSearchByVendorCommand}"
                        Content="Vendor Name"
                        CornerRadius="0,4,4,0"
                        IsChecked="{x:Bind ViewModel.IsSearchByVendor, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                </StackPanel>

                <CheckBox
                    Content="Combine same vendor names"
                    IsChecked="{x:Bind ViewModel.AggregateVendorNames, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.CanAggregateVendorNames, Mode=OneWay}" />
            </StackPanel>

            <!--  Query field + action buttons  -->
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.SearchLabel, Mode=OneWay}" />
                <TextBox
                    x:Name="SearchBox"
                    Width="240"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                    KeyDown="SearchBox_KeyDown"
                    PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                    Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Command="{x:Bind ViewModel.SearchCommand}"
                    Content="Search"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    Click="ClearButton_Click"
                    Content="Clear"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                <ProgressRing
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <!--  Status InfoBar  -->
        <InfoBar
            Grid.Row="2"
            Margin="0,0,0,12"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay, Converter={StaticResource InfoBarSeverityConverter}}" />

        <!--  Results Grid  -->
        <Border
            Grid.Row="3"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <controls:DataGrid
                x:Name="ResultsGrid"
                AutoGenerateColumns="False"
                AutomationProperties.Name="Outside Service History Results"
                CanUserSortColumns="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                SelectionMode="Single"
                Sorting="ResultsGrid_Sorting">
                <controls:DataGrid.CellStyle>
                    <Style TargetType="controls:DataGridCell">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </controls:DataGrid.CellStyle>
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding PartNumber}"
                        Header="Part Number"
                        IsReadOnly="True"
                        Tag="PartNumber" />
                    <controls:DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding VendorID}"
                        Header="Vendor ID"
                        IsReadOnly="True"
                        Tag="VendorID" />
                    <controls:DataGridTextColumn
                        Width="*"
                        Binding="{Binding VendorName}"
                        Header="Vendor Name"
                        IsReadOnly="True"
                        Tag="VendorName" />
                    <controls:DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding VendorCity}"
                        Header="City"
                        IsReadOnly="True"
                        Tag="VendorCity" />
                    <controls:DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding VendorState}"
                        Header="ST"
                        IsReadOnly="True"
                        Tag="VendorState" />
                    <controls:DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding DispatchID}"
                        Header="Dispatch ID"
                        IsReadOnly="True"
                        Tag="DispatchID" />
                    <controls:DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding DispatchDate, Converter={StaticResource DateTimeToStringConverter}}"
                        Header="Dispatch Date"
                        IsReadOnly="True"
                        Tag="DispatchDate" />
                    <controls:DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding QuantitySent}"
                        Header="Qty Sent"
                        IsReadOnly="True"
                        Tag="QuantitySent" />
                    <controls:DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding DispatchStatus}"
                        Header="Status"
                        IsReadOnly="True"
                        Tag="DispatchStatus" />
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Border>
    </Grid>
</Page>
