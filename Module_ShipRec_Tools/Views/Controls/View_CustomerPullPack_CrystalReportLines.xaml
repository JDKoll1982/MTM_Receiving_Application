<UserControl
    x:Class="MTM_Receiving_Application.Module_ShipRec_Tools.Views.Controls.View_CustomerPullPack_CrystalReportLines"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_ShipRec_Tools.Models"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#15008d63" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#15008d96" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#15008d5d" />

        <!--  Put the core properties into a base style inside your ResourceDictionary  -->
        <Style x:Key="CrystalSelectableListViewStyle_Base" TargetType="ListView">
            <Setter Property="SelectionMode" Value="Multiple" />
            <Setter Property="IsMultiSelectCheckBoxEnabled" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Stretch" Spacing="10">
        <StackPanel HorizontalAlignment="Stretch" Spacing="2">
            <TextBlock
                MaxLines="1"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Crystal-style Request Lines"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="2"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Matches the live grouped Customer Pull n' Pack report layout inside the application shell."
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border
            Padding="12"
            HorizontalAlignment="Stretch"
            Background="#FFC7C7C7"
            BorderBrush="#FFB2B2B2"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollViewer
                HorizontalAlignment="Stretch"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">
                <Border
                    MinWidth="1400"
                    Padding="18,18,20,24"
                    HorizontalAlignment="Stretch"
                    Background="White"
                    BorderBrush="#FF6A6A6A"
                    BorderThickness="1">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="10">
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image
                                Grid.Column="0"
                                Width="76"
                                Height="48"
                                Source="ms-appx:///Assets/MTMLogo.jpg"
                                Stretch="Uniform" />

                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Spacing="2">
                                <TextBlock
                                    MaxLines="1"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Manitowoc Tool &amp; Manufacturing, LLC"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    MaxLines="1"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Customer Pull N' pack Report (By Due Date)"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Grid Grid.Column="2" ColumnSpacing="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border
                                            Width="20"
                                            Height="16"
                                            Background="#FFFF1F1F"
                                            BorderBrush="#FF111111"
                                            BorderThickness="2" />
                                        <TextBlock
                                            MaxLines="1"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Not Enough Parts On Hand"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border
                                            Width="20"
                                            Height="16"
                                            Background="#FFFFF42B"
                                            BorderBrush="#FF111111"
                                            BorderThickness="2" />
                                        <TextBlock
                                            MaxLines="1"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Late Order"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Spacing="2">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        MaxLines="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ReportDateDisplay, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        MaxLines="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ReportTimeDisplay, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        MaxLines="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Page 1"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Border Height="2" Background="#FF333333" />

                        <ItemsControl ItemsSource="{x:Bind Groups, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Model_CustomerPullPack_CrystalReportGroup">
                                    <Border
                                        Padding="0,10,0,12"
                                        BorderBrush="#FF333333"
                                        BorderThickness="0,0,0,2">
                                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="260" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel
                                                Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                Spacing="8">
                                                <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="168" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
                                                        Grid.Column="0"
                                                        FontSize="16"
                                                        FontWeight="Bold"
                                                        MaxLines="1"
                                                        Text="{x:Bind GroupHeaderDisplay, Mode=OneTime}"
                                                        TextTrimming="CharacterEllipsis" />

                                                    <Grid
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        ColumnSpacing="6"
                                                        RowSpacing="4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="70" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            FontSize="14"
                                                            FontWeight="Bold"
                                                            MaxLines="1"
                                                            Text="QTY TO PACK:"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Border
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Width="70"
                                                            Padding="10,2"
                                                            Background="{x:Bind QuantityToPackBackgroundBrush, Mode=OneTime}">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                FontSize="14"
                                                                FontWeight="Bold"
                                                                Foreground="{x:Bind QuantityToPackForegroundBrush, Mode=OneTime}"
                                                                MaxLines="1"
                                                                Text="{x:Bind QuantityToPack, Mode=OneTime}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </Border>

                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            FontSize="14"
                                                            FontWeight="Bold"
                                                            MaxLines="1"
                                                            Text="QTY SELECTED:"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Border
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            Width="70"
                                                            Padding="10,2"
                                                            Background="{x:Bind QuantitySelectedBackgroundBrush, Mode=OneTime}">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                FontSize="14"
                                                                FontWeight="Bold"
                                                                Foreground="{x:Bind QuantitySelectedForegroundBrush, Mode=OneTime}"
                                                                MaxLines="1"
                                                                Text="{x:Bind QuantitySelected, Mode=OneTime}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Grid>

                                                    <Border
                                                        Grid.Column="2"
                                                        VerticalAlignment="Top"
                                                        BorderBrush="#FF333333"
                                                        BorderThickness="1">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Margin="6,2"
                                                                MaxLines="1"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="FG ON HAND:"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                Margin="6,2"
                                                                HorizontalAlignment="Right"
                                                                MaxLines="1"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind FgOnHandQuantity, Mode=OneTime}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <Border
                                                                Grid.Row="0"
                                                                Grid.ColumnSpan="2"
                                                                Height="1"
                                                                VerticalAlignment="Bottom"
                                                                Background="#FFBBBBBB" />

                                                            <TextBlock
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Margin="6,2"
                                                                MaxLines="1"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind FgLocationId, Mode=OneTime}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Margin="6,2"
                                                                HorizontalAlignment="Right"
                                                                MaxLines="1"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind FgOnHandQuantity, Mode=OneTime}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>

                                                <Border
                                                    VerticalAlignment="Top"
                                                    Background="#FFF4F6F8"
                                                    BorderBrush="#FFD7DCE2"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <Grid Padding="8,6" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="116" />
                                                            <ColumnDefinition Width="116" />
                                                            <ColumnDefinition Width="122" />
                                                            <ColumnDefinition Width="210" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            MaxLines="1"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="CUST_ORDER_ID"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            MaxLines="1"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="PART_ID"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            MaxLines="1"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="LOCATION ID"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="3"
                                                            MaxLines="1"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="CUSTOMER"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="4"
                                                            MaxLines="1"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="SHIP QTY"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="5"
                                                            MaxLines="1"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="PULL DATE"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="6"
                                                            MaxLines="1"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="STATUS"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>

                                                <ListView
                                                    VerticalAlignment="Top"
                                                    ItemsSource="{x:Bind RequestLines, Mode=OneTime}"
                                                    Loaded="OnSelectableRequestLineListLoaded"
                                                    SelectionChanged="OnSelectableRequestLineListSelectionChanged"
                                                    Style="{StaticResource CrystalSelectableListViewStyle_Base}">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="models:Model_CustomerPullPack_CrystalRequestLine">
                                                            <Grid Padding="8,6" ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="116" />
                                                                    <ColumnDefinition Width="116" />
                                                                    <ColumnDefinition Width="122" />
                                                                    <ColumnDefinition Width="210" />
                                                                    <ColumnDefinition Width="70" />
                                                                    <ColumnDefinition Width="80" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    MaxLines="1"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind CustomerOrderId, Mode=OneTime}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    MaxLines="1"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind ParentPartId, Mode=OneTime}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    MaxLines="1"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind LocationId, Mode=OneTime}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Grid.Column="3"
                                                                    MaxLines="1"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind CustomerLabel, Mode=OneTime}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Grid.Column="4"
                                                                    MaxLines="1"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind ShipQuantity, Mode=OneTime}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Grid.Column="5"
                                                                    MaxLines="1"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind PullDateDisplay, Mode=OneTime}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Grid.Column="6" Spacing="4">
                                                                    <Border
                                                                        Padding="10,4"
                                                                        Background="{x:Bind StatusNoteBackgroundBrush, Mode=OneTime}"
                                                                        CornerRadius="4"
                                                                        Visibility="{x:Bind HasStatusNote, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock
                                                                            Foreground="{x:Bind StatusNoteForegroundBrush, Mode=OneTime}"
                                                                            MaxLines="1"
                                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                                            Text="{x:Bind StatusNoteText, Mode=OneTime}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </Border>
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        MaxLines="2"
                                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                                        Text="{x:Bind FulfillmentDetailText, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords"
                                                                        Visibility="{x:Bind HasFulfillmentDetail, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>

                                                <TextBlock
                                                    FontWeight="Bold"
                                                    MaxLines="1"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind ServiceNote, Mode=OneTime}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{x:Bind HasServiceNote, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>

                                            <Border
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                BorderBrush="#FF333333"
                                                BorderThickness="1">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Margin="6,2"
                                                            MaxLines="1"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="SUB PARTS ON HAND:"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="6,2"
                                                            HorizontalAlignment="Right"
                                                            MaxLines="1"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind TotalSubPartsOnHand, Mode=OneTime}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Border Height="1" Background="#FFBBBBBB" />

                                                    <ListView
                                                        IsEnabled="{x:Bind HasSelectedRequestLine, Mode=OneWay}"
                                                        ItemsSource="{x:Bind SubPartLocations, Mode=OneTime}"
                                                        Loaded="OnSelectableLocationListLoaded"
                                                        SelectionChanged="OnSelectableLocationListSelectionChanged"
                                                        Style="{StaticResource CrystalSelectableListViewStyle_Base}">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="models:Model_CustomerPullPack_CrystalSubPartLocation">
                                                                <Grid Padding="12,4,12,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        Grid.Column="0"
                                                                        FontWeight="{x:Bind RowFontWeight, Mode=OneTime}"
                                                                        MaxLines="1"
                                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                                        Text="{x:Bind PartId, Mode=OneTime}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        Margin="8,0"
                                                                        FontWeight="{x:Bind RowFontWeight, Mode=OneTime}"
                                                                        MaxLines="1"
                                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                                        Text="{x:Bind SeparatorText, Mode=OneTime}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        Grid.Column="2"
                                                                        Margin="0,0,8,0"
                                                                        HorizontalAlignment="Right"
                                                                        FontWeight="{x:Bind RowFontWeight, Mode=OneTime}"
                                                                        MaxLines="1"
                                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                                        Text="{x:Bind PartLocationId, Mode=OneTime}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        Grid.Column="3"
                                                                        Margin="6,0,0,0"
                                                                        HorizontalAlignment="Right"
                                                                        FontWeight="{x:Bind RowFontWeight, Mode=OneTime}"
                                                                        MaxLines="1"
                                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                                        Text="{x:Bind OnHandQuantity, Mode=OneTime}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
