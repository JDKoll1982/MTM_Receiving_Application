<Page
    x:Class="MTM_Receiving_Application.Module_ShipRec_Tools.Views.View_Tool_ReceivingAnalytics"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="16,8,16,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Stat cards  -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="16"
                Background="#7B1FA2"
                CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock Foreground="White" Text="Total Lines" />
                    <TextBlock
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{x:Bind ViewModel.TotalLinesText, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Padding="16"
                Background="#E91E63"
                CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock Foreground="White" Text="Avg/Day" />
                    <TextBlock
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{x:Bind ViewModel.AvgPerDayText, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="2"
                Padding="16"
                Background="#00BCD4"
                CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock Foreground="White" Text="Peak Day" />
                    <TextBlock
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{x:Bind ViewModel.PeakDayText, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="3"
                Padding="16"
                Background="#4CAF50"
                CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock Foreground="White" Text="Trend vs Last Week" />
                    <TextBlock
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{x:Bind ViewModel.TrendText, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Compact controls hotbar  -->
        <Border
            Grid.Row="1"
            Padding="16,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  View mode: History vs Incoming  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="View Mode:" />
                    <ComboBox
                        MinWidth="110"
                        SelectedIndex="{x:Bind ViewModel.SelectedViewModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="History" />
                        <ComboBoxItem Content="Incoming" />
                    </ComboBox>
                </StackPanel>

                <!--  Date range (flyout with From/To pickers)  -->
                <Button
                    x:Name="DateRangeButton"
                    Grid.Column="1"
                    Height="36"
                    Padding="12,0"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Filter by date range">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE787;" />
                        <TextBlock Text="Date Range" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="DateRangeFlyout" Placement="Bottom">
                            <StackPanel MinWidth="320" Padding="8" Spacing="12">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CalendarDatePicker
                                        Grid.Column="0"
                                        Width="112"
                                        Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}"
                                        PlaceholderText="From" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="to" />
                                    <CalendarDatePicker
                                        Grid.Column="2"
                                        Width="112"
                                        Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}"
                                        PlaceholderText="To" />
                                </Grid>

                                <!--  Date type quick ranges; the available list depends on the
                                     view mode (History = past presets, Incoming = forecast presets)  -->
                                <DropDownButton
                                    x:Name="DateTypeButton"
                                    HorizontalAlignment="Stretch"
                                    ToolTipService.ToolTip="Choose a quick date range">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE787;" />
                                        <TextBlock VerticalAlignment="Center" Text="Date Type" />
                                    </StackPanel>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem
                                                IsEnabled="False"
                                                Text="HISTORY"
                                                Visibility="{x:Bind ViewModel.IsHistoryViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="Last7Days"
                                                Text="Last 7 Days"
                                                Visibility="{x:Bind ViewModel.IsHistoryViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="Last30Days"
                                                Text="Last 30 Days"
                                                Visibility="{x:Bind ViewModel.IsHistoryViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="Last90Days"
                                                Text="Last 90 Days"
                                                Visibility="{x:Bind ViewModel.IsHistoryViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="ThisMonth"
                                                Text="This Month"
                                                Visibility="{x:Bind ViewModel.IsHistoryViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="LastMonth"
                                                Text="Last Month"
                                                Visibility="{x:Bind ViewModel.IsHistoryViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="ThisQuarter"
                                                Text="This Quarter"
                                                Visibility="{x:Bind ViewModel.IsHistoryViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="ThisYear"
                                                Text="This Year"
                                                Visibility="{x:Bind ViewModel.IsHistoryViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="AllHistory"
                                                Text="All History"
                                                Visibility="{x:Bind ViewModel.IsHistoryViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

                                            <MenuFlyoutItem
                                                IsEnabled="False"
                                                Text="INCOMING"
                                                Visibility="{x:Bind ViewModel.IsIncomingViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="Next7Days"
                                                Text="Next 7 Days"
                                                Visibility="{x:Bind ViewModel.IsIncomingViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="Next30Days"
                                                Text="Next 30 Days"
                                                Visibility="{x:Bind ViewModel.IsIncomingViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="Next90Days"
                                                Text="Next 90 Days"
                                                Visibility="{x:Bind ViewModel.IsIncomingViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="ThisMonth"
                                                Text="This Month"
                                                Visibility="{x:Bind ViewModel.IsIncomingViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="NextMonth"
                                                Text="Next Month"
                                                Visibility="{x:Bind ViewModel.IsIncomingViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="ThisQuarter"
                                                Text="This Quarter"
                                                Visibility="{x:Bind ViewModel.IsIncomingViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="NextQuarter"
                                                Text="Next Quarter"
                                                Visibility="{x:Bind ViewModel.IsIncomingViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="DateTypeActionButton_Click"
                                                Tag="SixMonths"
                                                Text="Next 6 Months"
                                                Visibility="{x:Bind ViewModel.IsIncomingViewMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>

                                <Button
                                    HorizontalAlignment="Stretch"
                                    Click="DateFilterActionButton_Click"
                                    Content="Apply Date Range"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Tag="{x:Bind ViewModel.LoadCommand}"
                                    ToolTipService.ToolTip="Load analytics for the selected date range" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!--  View period  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="Period:" />
                    <ComboBox
                        MinWidth="100"
                        SelectedIndex="{x:Bind ViewModel.SelectedPeriodIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Day" />
                        <ComboBoxItem Content="Week" />
                        <ComboBoxItem Content="Month" />
                    </ComboBox>
                </StackPanel>

                <!--  Chart type  -->
                <StackPanel
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="Chart:" />
                    <ComboBox
                        MinWidth="100"
                        SelectedIndex="{x:Bind ViewModel.SelectedChartTypeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Line" />
                        <ComboBoxItem Content="Bar" />
                        <ComboBoxItem Content="Stacked" />
                    </ComboBox>
                </StackPanel>

                <!--  Actions (icon-only)  -->
                <StackPanel
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="FiltersButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        ToolTipService.ToolTip="Filters">
                        <FontIcon FontSize="16" Glyph="&#xE71E;" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border
                                    Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Width="320" Spacing="12">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="CATEGORIES" />
                                        <CheckBox Content="Parts" IsChecked="{x:Bind ViewModel.ScopeParts, Mode=TwoWay}" />
                                        <CheckBox Content="MMC (Coils)" IsChecked="{x:Bind ViewModel.ScopeCoils, Mode=TwoWay}" />
                                        <CheckBox Content="MMF (Flat)" IsChecked="{x:Bind ViewModel.ScopeFlat, Mode=TwoWay}" />
                                        <CheckBox Content="Outside Service" IsChecked="{x:Bind ViewModel.ScopeOutside, Mode=TwoWay}" />
                                        <CheckBox Content="Uninventoried" IsChecked="{x:Bind ViewModel.ScopeUninventoried, Mode=TwoWay}" />
                                        <CheckBox
                                            Content="Compare Previous Period"
                                            IsChecked="{x:Bind ViewModel.ComparePreviousPeriod, Mode=TwoWay}" />
                                        <StackPanel
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                Click="ApplyFiltersButton_Click"
                                                Content="Apply Filters"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        Width="34"
                        Height="34"
                        Padding="0"
                        Command="{x:Bind ViewModel.LoadCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Refresh">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    </Button>
                    <Button
                        Width="34"
                        Height="34"
                        Padding="0"
                        Command="{x:Bind ViewModel.ClearCommand}"
                        ToolTipService.ToolTip="Reset">
                        <FontIcon FontSize="16" Glyph="&#xE711;" />
                    </Button>
                    <Button
                        Width="34"
                        Height="34"
                        Padding="0"
                        Command="{x:Bind ViewModel.ExportCommand}"
                        ToolTipService.ToolTip="Export">
                        <FontIcon FontSize="16" Glyph="&#xE74E;" />
                    </Button>
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>

                <!--  Help  -->
                <StackPanel
                    Grid.Column="6"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Rectangle
                        Width="1"
                        Height="24"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button
                        Width="34"
                        Height="34"
                        Padding="0"
                        AutomationProperties.Name="Help"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Click="OnHelpClick"
                        CornerRadius="4"
                        ToolTipService.ToolTip="Help">
                        <FontIcon FontSize="16" Glyph="&#xE946;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Chart  -->
        <Border
            Grid.Row="2"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Receiving Analytics" />

                <lvc:CartesianChart
                    Grid.Row="1"
                    Series="{x:Bind ViewModel.Series, Mode=OneWay}"
                    XAxes="{x:Bind ViewModel.XAxes, Mode=OneWay}"
                    YAxes="{x:Bind ViewModel.YAxes, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>