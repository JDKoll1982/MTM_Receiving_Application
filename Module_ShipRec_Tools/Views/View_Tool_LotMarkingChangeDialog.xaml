<Page
    x:Class="MTM_Receiving_Application.Module_ShipRec_Tools.Views.View_Tool_LotMarkingChangeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_ShipRec_Tools.Models"
    xmlns:shipRecConverters="using:MTM_Receiving_Application.Module_ShipRec_Tools.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <shipRecConverters:Converter_LotColorCodeToBrush x:Key="LotColorCodeToBrush" />
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Padding="24,16,24,16"
            Spacing="14">

            <Border
                Padding="16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Selected lot" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            FontSize="20"
                            IsColorFontEnabled="False"
                            Text="{x:Bind ViewModel.SelectedMarking.ShapeCode, Mode=OneWay}" />
                        <Rectangle
                            Width="14"
                            Height="14"
                            VerticalAlignment="Center"
                            Fill="{x:Bind ViewModel.SelectedMarking.ColorCode, Mode=OneWay, Converter={StaticResource LotColorCodeToBrush}}"
                            RadiusX="3"
                            RadiusY="3"
                            Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                            StrokeThickness="1" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.SelectedMarking.ColorCode, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SelectedMarkingSummary, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <ComboBox
                HorizontalAlignment="Stretch"
                Header="Shape"
                ItemsSource="{x:Bind ViewModel.LegendShapes, Mode=OneWay}"
                SelectedValue="{x:Bind ViewModel.OverrideShape, Mode=TwoWay}"
                SelectedValuePath="Glyph">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Model_LotMarkingShape">
                        <TextBlock Text="{x:Bind DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox
                HorizontalAlignment="Stretch"
                Header="Color"
                ItemsSource="{x:Bind ViewModel.LegendColors, Mode=OneWay}"
                SelectedValue="{x:Bind ViewModel.OverrideColor, Mode=TwoWay}"
                SelectedValuePath="Code">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Model_LotMarkingColor">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Rectangle
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                Fill="{x:Bind Code, Converter={StaticResource LotColorCodeToBrush}}"
                                RadiusX="2"
                                RadiusY="2"
                                Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                StrokeThickness="1" />
                            <TextBlock Text="{x:Bind DisplayName}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox
                Header="Reason (required)"
                PlaceholderText="Why is the marking changing?"
                Text="{x:Bind ViewModel.OverrideReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Width="34"
                    Height="34"
                    Padding="0"
                    AutomationProperties.Name="Save change"
                    Command="{x:Bind ViewModel.SaveOverrideCommand}"
                    CornerRadius="4"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LotMarking.SaveChange'), Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE74E;" />
                </Button>
                <Button
                    Width="34"
                    Height="34"
                    Padding="0"
                    AutomationProperties.Name="Lock or unlock"
                    Command="{x:Bind ViewModel.ToggleLockCommand}"
                    CornerRadius="4"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LotMarking.ToggleLock'), Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE72E;" />
                </Button>
                <ProgressRing
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="A locked lot is never recomputed. A hand-made change is always allowed and records who made it and why."
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="24,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Button
                Width="34"
                Height="34"
                Padding="0"
                HorizontalAlignment="Right"
                AutomationProperties.Name="Close"
                Click="OnCloseClick"
                CornerRadius="4"
                ToolTipService.ToolTip="Close">
                <FontIcon FontSize="16" Glyph="&#xE711;" />
            </Button>
        </Border>
    </Grid>
</Page>
