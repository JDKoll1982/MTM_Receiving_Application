<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MTM_Receiving_Application.Module_ShipRec_Tools.Views.View_Tool_ReceivingAnalyticsTopDays"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:models="using:MTM_Receiving_Application.Module_ShipRec_Tools.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_InverseBooleanToVisibility x:Key="InverseBooleanToVisibilityConverter" />

        <!--  Column headers, so every table reads the same  -->
        <Style x:Key="RecordDayHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style
            x:Key="RecordDayHeaderNumberStyle"
            BasedOn="{StaticResource RecordDayHeaderStyle}"
            TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!--  One row of an item-type ranking  -->
        <DataTemplate x:Key="ItemTypeDayRowTemplate" x:DataType="models:Model_Tool_ReceivingAnalyticsAppTopDayRow">
            <Grid ColumnSpacing="8" Padding="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Rank}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{x:Bind DayText}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind LoadsText}"
                    TextAlignment="Right" />
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind LabelsText}"
                    TextAlignment="Right" />
            </Grid>
        </DataTemplate>

        <!--  One row of the all-item-type ranking  -->
        <DataTemplate x:Key="BusiestDayRowTemplate" x:DataType="models:Model_Tool_ReceivingAnalyticsAppBusiestDayRow">
            <Grid ColumnSpacing="8" Padding="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Rank}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{x:Bind DayText}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind LoadsText}"
                    TextAlignment="Right" />
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind LabelsText}"
                    TextAlignment="Right" />
            </Grid>
        </DataTemplate>

        <!--  One row of a ranked list; selected rows do nothing, so the list reads as a table  -->
        <Style x:Key="RecordDayRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="16,8,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Filter bar, shared by every table  -->
        <Border
            Grid.Row="0"
            Padding="16,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="From:" />
                    <CalendarDatePicker
                        Width="130"
                        Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}"
                        PlaceholderText="From" />
                    <TextBlock VerticalAlignment="Center" Text="To:" />
                    <CalendarDatePicker
                        Width="130"
                        Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}"
                        PlaceholderText="To" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="Show:" />
                    <ComboBox
                        MinWidth="90"
                        SelectedIndex="{x:Bind ViewModel.SelectedTopCountIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Top 5" />
                        <ComboBoxItem Content="Top 10" />
                        <ComboBoxItem Content="Top 20" />
                    </ComboBox>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.LoadCommand}"
                        Content="Load"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button Command="{x:Bind ViewModel.ClearCommand}" Content="Clear" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="4"
                    MaxWidth="420"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!--  One ranking per item type, side by side  -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Coils (MMC)  -->
            <Border
                Grid.Column="0"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,2"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#3CB371"
                        Text="Top Coil Days" />

                    <Border
                        Grid.Row="1"
                        Padding="0,0,0,6"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource RecordDayHeaderStyle}"
                                Text="#" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource RecordDayHeaderStyle}"
                                Text="Day" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource RecordDayHeaderNumberStyle}"
                                Text="Loads" />
                            <TextBlock
                                Grid.Column="3"
                                Style="{StaticResource RecordDayHeaderNumberStyle}"
                                Text="Labels" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ListView
                            ItemContainerStyle="{StaticResource RecordDayRowContainerStyle}"
                            ItemTemplate="{StaticResource ItemTypeDayRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.CoilDays, Mode=OneWay}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="None" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.CoilEmptyStateText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasCoilDays, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>

            <!--  Flat stock (MMF)  -->
            <Border
                Grid.Column="1"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,2"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#9370DB"
                        Text="Top Flat Stock Days" />

                    <Border
                        Grid.Row="1"
                        Padding="0,0,0,6"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource RecordDayHeaderStyle}"
                                Text="#" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource RecordDayHeaderStyle}"
                                Text="Day" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource RecordDayHeaderNumberStyle}"
                                Text="Loads" />
                            <TextBlock
                                Grid.Column="3"
                                Style="{StaticResource RecordDayHeaderNumberStyle}"
                                Text="Labels" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ListView
                            ItemContainerStyle="{StaticResource RecordDayRowContainerStyle}"
                            ItemTemplate="{StaticResource ItemTypeDayRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.FlatStockDays, Mode=OneWay}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="None" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.FlatStockEmptyStateText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasFlatStockDays, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>

            <!--  Other (Standard)  -->
            <Border
                Grid.Column="2"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,2"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#1E90FF"
                        Text="Top Other Item Days" />

                    <Border
                        Grid.Row="1"
                        Padding="0,0,0,6"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource RecordDayHeaderStyle}"
                                Text="#" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource RecordDayHeaderStyle}"
                                Text="Day" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource RecordDayHeaderNumberStyle}"
                                Text="Loads" />
                            <TextBlock
                                Grid.Column="3"
                                Style="{StaticResource RecordDayHeaderNumberStyle}"
                                Text="Labels" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ListView
                            ItemContainerStyle="{StaticResource RecordDayRowContainerStyle}"
                            ItemTemplate="{StaticResource ItemTypeDayRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.OtherDays, Mode=OneWay}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="None" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.OtherEmptyStateText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasOtherDays, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--  Busiest days across every item type, spanning the full width  -->
        <Border
            Grid.Row="2"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Busiest Days" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Total loads recorded per day across all item types. A load carrying more than one item type is counted once."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Padding="0,0,0,6"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource RecordDayHeaderStyle}"
                            Text="#" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource RecordDayHeaderStyle}"
                            Text="Day" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource RecordDayHeaderNumberStyle}"
                            Text="Loads" />
                        <TextBlock
                            Grid.Column="3"
                            Style="{StaticResource RecordDayHeaderNumberStyle}"
                            Text="Labels" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <ListView
                        ItemContainerStyle="{StaticResource RecordDayRowContainerStyle}"
                        ItemTemplate="{StaticResource BusiestDayRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.BusiestDays, Mode=OneWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="None" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.BusiestDaysEmptyStateText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasBusiestDays, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
