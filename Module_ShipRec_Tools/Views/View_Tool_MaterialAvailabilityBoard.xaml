<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MTM_Receiving_Application.Module_ShipRec_Tools.Views.View_Tool_MaterialAvailabilityBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_ShipRec_Tools.Models"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_InverseBool x:Key="InverseBoolConverter" />
        <converters:Converter_InfoBarSeverity x:Key="InfoBarSeverityConverter" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,20"
            Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Material Availability Board" />
            <TextBlock
                Opacity="0.7"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Search by warehouse location or part number to review current stock, incoming material, and which associated parent parts are due to run next." />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,16"
            Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <ToggleButton
                        Command="{x:Bind ViewModel.SetSearchByLocationCommand}"
                        Content="Warehouse Location"
                        CornerRadius="4,0,0,4"
                        IsChecked="{x:Bind ViewModel.IsSearchByLocation, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                    <ToggleButton
                        Command="{x:Bind ViewModel.SetSearchByPartCommand}"
                        Content="Part Number"
                        CornerRadius="0,4,4,0"
                        IsChecked="{x:Bind ViewModel.IsSearchByPart, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                </StackPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Warehouse scope: 002" />
            </StackPanel>

            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.SearchLabel, Mode=OneWay}" />
                <TextBox
                    x:Name="SearchBox"
                    Width="260"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                    KeyDown="SearchBox_KeyDown"
                    PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                    Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Command="{x:Bind ViewModel.SearchCommand}"
                    Content="Search"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    Click="ClearButton_Click"
                    Content="Clear"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                <Button
                    Command="{x:Bind ViewModel.PrintCommand}"
                    Content="Print"
                    IsEnabled="{x:Bind ViewModel.HasCards, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.LookAheadLabel, Mode=OneWay}" />
                <ComboBox
                    Width="110"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                    ItemsSource="{x:Bind ViewModel.LookAheadOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedLookAheadOption, Mode=TwoWay}" />
                <ProgressRing
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <InfoBar
            Grid.Row="2"
            Margin="0,0,0,12"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay, Converter={StaticResource InfoBarSeverityConverter}}" />

        <Grid Grid.Row="3">
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasCards, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="No material cards loaded yet." />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Search by warehouse location to build one card per part in that location, or search directly by part number to review all positive-quantity locations and near-term inbound supply." />
                </StackPanel>
            </Border>

            <ListView
                HorizontalAlignment="Stretch"
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.HasCards, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,12" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Model_Tool_MaterialAvailabilityCard">
                        <Border
                            Padding="16"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Expander
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind PartId}" />
                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind PartDescription}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind LocationCountSummary}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind NextDateSummary}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Spacing="4">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind QuantitySummaryLabel}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                Text="{x:Bind QuantitySummaryDisplay}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="Total on hand" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind TotalPositiveQuantityDisplay}" />
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Margin="0,12,0,0" Spacing="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Current locations with qty &gt; 0" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="No positive-quantity locations were found for this part in warehouse 002."
                                            Visibility="{x:Bind HasCurrentLocations, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />
                                        <ItemsRepeater ItemsSource="{x:Bind CurrentLocations, Mode=OneWay}" Visibility="{x:Bind HasCurrentLocations, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="8" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:Model_Tool_MaterialAvailabilityLocation">
                                                    <Border
                                                        Padding="10,8"
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Style="{StaticResource BodyTextBlockStyle}"
                                                                Text="{x:Bind LocationLabel}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                HorizontalAlignment="Right"
                                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                Text="{x:Bind QuantityDisplay}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Incoming Material" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="No qualifying incoming material was found for the selected look-ahead window."
                                            Visibility="{x:Bind HasIncomingSupply, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />
                                        <StackPanel Spacing="8" Visibility="{x:Bind HasIncomingSupply, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Received" />
                                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind IncomingRollup.ReceivedQtyDisplay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Ordered" />
                                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind IncomingRollup.OrderedQtyDisplay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Remaining" />
                                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind IncomingRollup.RemainingQtyDisplay}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="3"
                                                    HorizontalAlignment="Right"
                                                    Spacing="2">
                                                    <TextBlock
                                                        HorizontalAlignment="Right"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind IncomingRollup.PurchaseOrderCountSummary}" />
                                                    <TextBlock
                                                        HorizontalAlignment="Right"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind IncomingRollup.POLineCountSummary}" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar
                                                Height="8"
                                                Maximum="100"
                                                Minimum="0"
                                                Value="{x:Bind IncomingRollup.PercentComplete, Mode=OneWay}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind IncomingRollup.PercentCompleteSummary}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Associated Parts" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="No associated part runs were found for the selected look-ahead window."
                                            Visibility="{x:Bind HasAssociatedPartRuns, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />
                                        <ItemsRepeater ItemsSource="{x:Bind AssociatedPartRuns, Mode=OneWay}" Visibility="{x:Bind HasAssociatedPartRuns, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="8" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:Model_Tool_MaterialAvailabilityAssociatedPartRun">
                                                    <Border
                                                        Padding="10,8"
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind AssociatedPartNumber}" />
                                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind AssociatedPartDescription}" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind WorkOrderDisplay}" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind RunTimingLabel}" />
                                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind NextRunDateDisplay}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
