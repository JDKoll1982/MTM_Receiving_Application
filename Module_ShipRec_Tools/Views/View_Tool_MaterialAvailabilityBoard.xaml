<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MTM_Receiving_Application.Module_ShipRec_Tools.Views.View_Tool_MaterialAvailabilityBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_ShipRec_Tools.Models"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_InverseBool x:Key="InverseBoolConverter" />
        <converters:Converter_InfoBarSeverity x:Key="InfoBarSeverityConverter" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,6"
            Spacing="6">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <ToggleButton
                        Command="{x:Bind ViewModel.SetSearchByLocationCommand}"
                        Content="Warehouse Location"
                        CornerRadius="4,0,0,4"
                        IsChecked="{x:Bind ViewModel.IsSearchByLocation, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                    <ToggleButton
                        Command="{x:Bind ViewModel.SetSearchByPartCommand}"
                        Content="Part Number"
                        CornerRadius="0,4,4,0"
                        IsChecked="{x:Bind ViewModel.IsSearchByPart, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                </StackPanel>
            </StackPanel>

            <Grid HorizontalAlignment="Stretch" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.SearchLabel, Mode=OneWay}" />
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Width="260"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                    KeyDown="SearchBox_KeyDown"
                    PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                    Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    Content="Search"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    Grid.Column="3"
                    Click="ClearButton_Click"
                    Content="Clear"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                <Button
                    Grid.Column="4"
                    Command="{x:Bind ViewModel.PrintCommand}"
                    Content="Print"
                    IsEnabled="{x:Bind ViewModel.HasCards, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="6"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.LookAheadLabel, Mode=OneWay}" />
                <ComboBox
                    Grid.Column="7"
                    Width="110"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                    ItemsSource="{x:Bind ViewModel.LookAheadOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedLookAheadOption, Mode=TwoWay}" />
                <ProgressRing
                    Grid.Column="5"
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </Grid>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.MockDataHintText, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.IsMockDataHintVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

        </StackPanel>


        <Grid Grid.Row="1">
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasCards, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="No material cards loaded yet." />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Search by warehouse location to build one card per part in that location, or search directly by part number to review all positive-quantity locations and near-term inbound supply." />
                </StackPanel>
            </Border>

            <ListView
                HorizontalAlignment="Stretch"
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.HasCards, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Model_Tool_MaterialAvailabilityCard">
                        <Border
                            Padding="14"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Expander
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <Grid ColumnSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,6,0,6"
                                            Padding="6"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel Spacing="4">
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind PartId}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind DescriptionDisplay}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind LocationCountSummary}" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="1"
                                            Margin="0,6,0,6"
                                            Padding="6"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">

                                            <Grid
                                                VerticalAlignment="Stretch"
                                                ColumnSpacing="6"
                                                RowSpacing="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width=".5*" />
                                                    <ColumnDefinition Width=".5*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Padding="6"
                                                    VerticalAlignment="Stretch"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock
                                                            Grid.Row="0"
                                                            HorizontalAlignment="Center"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind QuantitySummaryLabel}" />

                                                        <TextBlock
                                                            Grid.Row="1"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Text="{x:Bind QuantitySummaryDisplay}" />
                                                    </Grid>
                                                </Border>


                                                <Border
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Padding="6"
                                                    VerticalAlignment="Stretch"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock
                                                            Grid.Row="0"
                                                            HorizontalAlignment="Center"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="Total on hand" />

                                                        <TextBlock
                                                            Grid.Row="1"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Text="{x:Bind TotalPositiveQuantityDisplay}" />
                                                    </Grid>
                                                </Border>

                                                <Button
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom"
                                                    Click="WorkOrderDetailsButton_Click"
                                                    Content="Run Summary Info"
                                                    Tag="{x:Bind}" />
                                            </Grid>






                                        </Border>

                                        <Border
                                            Grid.Row="1"
                                            Margin="0,0,0,6"
                                            Padding="6"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Next Run Summary" />
                                                        <TextBlock
                                                            Style="{StaticResource BodyTextBlockStyle}"
                                                            Text="{x:Bind NextRunSummaryDisplay}"
                                                            TextWrapping="WrapWholeWords" />
                                                    </StackPanel>

                                                </Grid>
                                                <Border
                                                    Padding="8,6"
                                                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Visibility="{x:Bind HasEstimatedCoilUseRisk, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock
                                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind EstimatedCoilUseRiskText}"
                                                        TextWrapping="WrapWholeWords" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Margin="0,6,0,0" Spacing="6">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Current Locations" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="No positive-quantity locations were found for this part in warehouse 002."
                                            Visibility="{x:Bind HasCurrentLocations, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />
                                        <ItemsRepeater ItemsSource="{x:Bind CurrentLocations, Mode=OneWay}" Visibility="{x:Bind HasCurrentLocations, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="8" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:Model_Tool_MaterialAvailabilityLocation">
                                                    <Border
                                                        Padding="10,8"
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Style="{StaticResource BodyTextBlockStyle}"
                                                                Text="{x:Bind LocationLabel}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                HorizontalAlignment="Right"
                                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                Text="{x:Bind QuantityDisplay}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Incoming Material" />
                                            <Button
                                                Grid.Column="1"
                                                Click="IncomingDetailsButton_Click"
                                                Content="View incoming details"
                                                IsEnabled="{x:Bind HasIncomingDetails, Mode=OneWay}"
                                                Tag="{x:Bind}" />
                                        </Grid>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="No qualifying incoming material was found for the selected look-ahead window."
                                            Visibility="{x:Bind HasIncomingSupply, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />
                                        <Border
                                            Padding="6"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{x:Bind HasIncomingSupply, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Received" />
                                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind IncomingRollup.ReceivedQtyDisplay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Ordered" />
                                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind IncomingRollup.OrderedQtyDisplay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="2">
                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Remaining" />
                                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind IncomingRollup.RemainingQtyDisplay}" />
                                                    </StackPanel>
                                                    <StackPanel
                                                        Grid.Column="3"
                                                        HorizontalAlignment="Right"
                                                        Spacing="2">
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind IncomingRollup.PurchaseOrderCountSummary}" />
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind IncomingRollup.POLineCountSummary}" />
                                                    </StackPanel>
                                                </Grid>
                                                <ProgressBar
                                                    Height="8"
                                                    Maximum="100"
                                                    Minimum="0"
                                                    Value="{x:Bind IncomingRollup.PercentComplete, Mode=OneWay}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind IncomingRollup.PercentCompleteSummary}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Associated Parts" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="No associated parts were found for this material."
                                            Visibility="{x:Bind HasAssociatedPartRuns, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}" />
                                        <ItemsRepeater ItemsSource="{x:Bind AssociatedPartRuns, Mode=OneWay}" Visibility="{x:Bind HasAssociatedPartRuns, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="8" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:Model_Tool_MaterialAvailabilityAssociatedPartRun">
                                                    <Border
                                                        Padding="10,8"
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                        <Grid ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind AssociatedPartNumber}" />
                                                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind AssociatedPartDescription}" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind WorkOrderDisplay}" />
                                                            </StackPanel>
                                                            <StackPanel
                                                                Grid.Column="1"
                                                                HorizontalAlignment="Right"
                                                                Spacing="2">
                                                                <TextBlock
                                                                    HorizontalAlignment="Right"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind RunTimingLabel}" />
                                                                <TextBlock
                                                                    HorizontalAlignment="Right"
                                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                    Text="{x:Bind NextRunDateDisplay}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
