<Page
    x:Class="MTM_Receiving_Application.Module_ShipRec_Tools.Views.View_Tool_LotMarking"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_ShipRec_Tools.Models"
    xmlns:shipRecConverters="using:MTM_Receiving_Application.Module_ShipRec_Tools.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BoolToVisibility" />
        <shipRecConverters:Converter_LotColorCodeToBrush x:Key="LotColorCodeToBrush" />
    </Page.Resources>

    <Grid Padding="16,8,16,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Utility card: the search box and the page actions  -->
        <Border
            Grid.Row="0"
            Padding="16,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="0"
                        KeyDown="SearchBox_KeyDown"
                        PlaceholderText="Search a heat / lot or part number..."
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Width="34"
                        Height="34"
                        Padding="0"
                        AutomationProperties.Name="Search"
                        Command="{x:Bind ViewModel.SearchMarkingsCommand}"
                        CornerRadius="4"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LotMarking.Search'), Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="&#xE721;" />
                    </Button>
                    <ProgressRing
                        Grid.Column="2"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Width="34"
                        Height="34"
                        Padding="0"
                        AutomationProperties.Name="Filters"
                        Click="OnFiltersClick"
                        CornerRadius="4"
                        ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LotMarking.Filters'), Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="&#xE71C;" />
                    </Button>
                    <Button
                        Width="34"
                        Height="34"
                        Padding="0"
                        AutomationProperties.Name="Print the list"
                        Click="OnPrintClick"
                        CornerRadius="4"
                        IsEnabled="{x:Bind ViewModel.HasMarkings, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LotMarking.Print'), Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="&#xE749;" />
                    </Button>
                    <Button
                        Width="34"
                        Height="34"
                        Padding="0"
                        AutomationProperties.Name="Change this marking"
                        Click="OnChangeMarkingClick"
                        CornerRadius="4"
                        IsEnabled="{x:Bind ViewModel.CanChangeSelectedMarking, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LotMarking.ChangeMarking'), Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="&#xE70F;" />
                    </Button>
                    <Button
                        Width="34"
                        Height="34"
                        Padding="0"
                        AutomationProperties.Name="Part numbers that receive markings"
                        Click="OnManagePartsClick"
                        CornerRadius="4"
                        ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LotMarking.ManageParts'), Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                    </Button>
                    <Button
                        Width="34"
                        Height="34"
                        Padding="0"
                        AutomationProperties.Name="Update all lots"
                        Command="{x:Bind ViewModel.UpdateAllLotsCommand}"
                        CornerRadius="4"
                        ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LotMarking.UpdateAllLots'), Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="&#xE895;" />
                    </Button>
                    <Rectangle
                        Width="1"
                        Height="24"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button
                        Width="34"
                        Height="34"
                        Padding="0"
                        AutomationProperties.Name="Palette"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Click="OnShowPaletteClick"
                        CornerRadius="4"
                        ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LotMarking.Palette'), Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="&#xE790;" />
                    </Button>
                    <Button
                        Width="34"
                        Height="34"
                        Padding="0"
                        AutomationProperties.Name="Help"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Click="OnHelpClick"
                        CornerRadius="4"
                        ToolTipService.ToolTip="{x:Bind ViewModel.GetTooltip('Button.LotMarking.Help'), Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="&#xE946;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  The lot list  -->
        <Border
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Heat / lot markings" />

                <TextBlock
                    Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.FilterSummary, Mode=OneWay}" />

                <controls:DataGrid
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    AutoGenerateColumns="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind ViewModel.Markings, Mode=OneWay}"
                    SelectionMode="Single"
                    SelectedItem="{x:Bind ViewModel.SelectedMarking, Mode=TwoWay}"
                    VerticalScrollBarVisibility="Auto">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTemplateColumn Width="80" Header="Shape" Visibility="{x:Bind ViewModel.ShowShapeColumn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Model_Tool_LotMarking">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        IsColorFontEnabled="False"
                                        Text="{x:Bind ShapeCode, Mode=OneTime}" />
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <controls:DataGridTemplateColumn Width="120" Header="Color" Visibility="{x:Bind ViewModel.ShowColorColumn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Model_Tool_LotMarking">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Rectangle
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            Fill="{x:Bind ColorCode, Mode=OneTime, Converter={StaticResource LotColorCodeToBrush}}"
                                            RadiusX="3"
                                            RadiusY="3"
                                            Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                            StrokeThickness="1" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ColorCode, Mode=OneTime}" />
                                    </StackPanel>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <controls:DataGridTemplateColumn Width="*" Header="Heat" Visibility="{x:Bind ViewModel.ShowHeatColumn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Model_Tool_LotMarking">
                                    <TextBlock Text="{x:Bind HeatNumber, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <controls:DataGridTemplateColumn Width="220" Header="Supplier" Visibility="{x:Bind ViewModel.ShowSupplierColumn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Model_Tool_LotMarking">
                                    <TextBlock Text="{x:Bind SupplierText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <controls:DataGridTemplateColumn Width="200" Header="Parts" Visibility="{x:Bind ViewModel.ShowPartsColumn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Model_Tool_LotMarking">
                                    <TextBlock
                                        Text="{x:Bind PartsText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <controls:DataGridTemplateColumn Width="80" Header="Skids" Visibility="{x:Bind ViewModel.ShowSkidsColumn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Model_Tool_LotMarking">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Text="{x:Bind LineCountText, Mode=OneWay}" />
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <controls:DataGridTemplateColumn Width="120" Header="Last received" Visibility="{x:Bind ViewModel.ShowLastLineColumn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Model_Tool_LotMarking">
                                    <TextBlock Text="{x:Bind LastLineText, Mode=OneWay}" />
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>

                <TextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsHitTestVisible="False"
                    Text="{x:Bind ViewModel.MarkingListEmptyText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsMarkingListEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</Page>
