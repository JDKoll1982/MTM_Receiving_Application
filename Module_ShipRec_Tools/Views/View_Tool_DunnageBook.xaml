<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MTM_Receiving_Application.Module_ShipRec_Tools.Views.View_Tool_DunnageBook"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_ShipRec_Tools.Models"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="8,0,8,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button
            Grid.Row="0"
            Canvas.ZIndex="100"
            Width="34"
            Height="34"
            Margin="0,8,16,0"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.Name="Help"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Click="OnHelpClick"
            CornerRadius="4"
            ToolTipService.ToolTip="Help">
            <FontIcon FontSize="16" Glyph="&#xE946;" />
        </Button>

        <!--  Book configuration  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,12"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Header="Book title"
                        PlaceholderText="Dunnage Reference Book"
                        Text="{x:Bind ViewModel.CoverTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        Header="Cover page"
                        IsOn="{x:Bind ViewModel.IncludeCoverPage, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                    <ToggleSwitch
                        Grid.Column="2"
                        Header="Table of contents"
                        IsOn="{x:Bind ViewModel.IncludeTableOfContents, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                </Grid>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="The book prints on 8.5 x 11 portrait pages with a running title and page numbers." />
            </StackPanel>
        </Border>

        <!--  Filters and actions  -->
        <Grid
            Grid.Row="1"
            Margin="0,0,0,12"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                Grid.Column="0"
                Width="220"
                ItemsSource="{x:Bind ViewModel.TypeFilterOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedTypeFilter, Mode=TwoWay}" />
            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                PlaceholderText="Search part ID, type, home location, or custom fields"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="2"
                Command="{x:Bind ViewModel.SelectAllCommand}"
                Content="Select all" />
            <Button
                Grid.Column="3"
                Command="{x:Bind ViewModel.ClearAllCommand}"
                Content="Clear all" />
            <ProgressRing
                Grid.Column="4"
                Width="28"
                Height="28"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>

        <!--  Grouped selection list  -->
        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredGroups, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Model_Tool_DunnageBook_TypeGroup">
                        <Border
                            Margin="0,0,0,10"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Content="{x:Bind TypeName}"
                                        IsChecked="{x:Bind IsTypeSelected, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind SelectedCount}" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Model_Tool_DunnageBook_Entry">
                                            <Grid
                                                Margin="20,0,0,4"
                                                ColumnSpacing="16"
                                                Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Content="{x:Bind PartId}"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                    Text="{x:Bind HomeLocation}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                    Text="{x:Bind QuantityType}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  Generate bar  -->
        <Grid
            Grid.Row="3"
            Margin="0,12,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.GenerateBookCommand}"
                Content="Generate Book"
                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
