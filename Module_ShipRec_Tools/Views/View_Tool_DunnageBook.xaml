<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MTM_Receiving_Application.Module_ShipRec_Tools.Views.View_Tool_DunnageBook"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_ShipRec_Tools.Models"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="8,0,8,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Utility card (configuration + filters + help)  -->
        <Border
            Grid.Row="0"
            Padding="16,12"
            Margin="0,0,0,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!--  Book title  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  divider  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Type filter  -->
                    <ColumnDefinition Width="*" />
                    <!--  Search  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Select all  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Clear all  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Book options  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Progress  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Help  -->
                </Grid.ColumnDefinitions>

                <!--  Book title  -->
                <TextBox
                    Grid.Column="0"
                    Width="300"
                    PlaceholderText="Book title"
                    Text="{x:Bind ViewModel.CoverTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTipService.ToolTip="Book title (printed on the cover)" />

                <Rectangle
                    Grid.Column="1"
                    Width="1"
                    Height="24"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!--  Type filter  -->
                <ComboBox
                    Grid.Column="2"
                    MinWidth="180"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.TypeFilterOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedTypeFilter, Mode=TwoWay}" />

                <!--  Search  -->
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="3"
                    MinWidth="180"
                    VerticalAlignment="Center"
                    PlaceholderText="Search part ID, type, home location, or custom fields"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!--  Select all  -->
                <Button
                    Grid.Column="4"
                    Width="34"
                    Height="34"
                    Padding="0"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.SelectAllCommand}"
                    ToolTipService.ToolTip="Select all">
                    <FontIcon FontSize="16" Glyph="&#xE8B3;" />
                </Button>

                <!--  Clear all  -->
                <Button
                    Grid.Column="5"
                    Width="34"
                    Height="34"
                    Padding="0"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ClearAllCommand}"
                    ToolTipService.ToolTip="Clear all">
                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                </Button>

                <!--  Book options flyout (cover page + table of contents)  -->
                <Button
                    Grid.Column="6"
                    Width="34"
                    Height="34"
                    Padding="0"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Book options">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel MinWidth="280" Padding="8" Spacing="10">
                                <ToggleSwitch
                                    Header="Cover page"
                                    IsOn="{x:Bind ViewModel.IncludeCoverPage, Mode=TwoWay}"
                                    OffContent="Off"
                                    OnContent="On" />
                                <ToggleSwitch
                                    Header="Table of contents"
                                    IsOn="{x:Bind ViewModel.IncludeTableOfContents, Mode=TwoWay}"
                                    OffContent="Off"
                                    OnContent="On" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="The book prints on 8.5 x 11 portrait pages with a running title and page numbers."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!--  Progress  -->
                <ProgressRing
                    Grid.Column="7"
                    Width="22"
                    Height="22"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                <!--  Help  -->
                <Button
                    Grid.Column="8"
                    Width="34"
                    Height="34"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Help"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="OnHelpClick"
                    CornerRadius="4"
                    ToolTipService.ToolTip="Help">
                    <FontIcon FontSize="16" Glyph="&#xE946;" />
                </Button>
            </Grid>
        </Border>

        <!--  Grouped selection list  -->
        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredGroups, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Model_Tool_DunnageBook_TypeGroup">
                        <Border
                            Margin="0,0,0,10"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Content="{x:Bind TypeName}"
                                        IsChecked="{x:Bind IsTypeSelected, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind SelectedCount}" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Model_Tool_DunnageBook_Entry">
                                            <Grid
                                                Margin="20,0,0,4"
                                                ColumnSpacing="16"
                                                Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Content="{x:Bind PartId}"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                    Text="{x:Bind HomeLocation}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                    Text="{x:Bind QuantityType}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  Generate bar  -->
        <Grid
            Grid.Row="3"
            Margin="0,12,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.GenerateBookCommand}"
                Content="Generate Book"
                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
