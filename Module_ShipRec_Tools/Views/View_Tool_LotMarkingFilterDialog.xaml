<Page
    x:Class="MTM_Receiving_Application.Module_ShipRec_Tools.Views.View_Tool_LotMarkingFilterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_ShipRec_Tools.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:Converter_InverseBooleanToVisibility x:Key="InverseBoolToVisibility" />
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            x:Name="ContentScroll"
            Grid.Row="0"
            Padding="24,16,24,8">
            <StackPanel Spacing="16">

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Choose what the lot list shows and how it is ordered. The printed sheet uses the same choices, so what you see is what prints."
                    TextWrapping="WrapWholeWords" />

                <!--  Dates  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Which dates to include" />

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="A lot is listed when any of its skids was received inside this range. Leave a date empty for no limit."
                            TextWrapping="WrapWholeWords" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CalendarDatePicker
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}"
                                PlaceholderText="First day" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="to" />
                            <CalendarDatePicker
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}"
                                PlaceholderText="Last day" />
                        </Grid>

                        <DropDownButton
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Quick date range"
                            ToolTipService.ToolTip="Fill both dates from a quick range">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE787;" />
                                <TextBlock VerticalAlignment="Center" Text="Quick date range" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="DatePresetFlyout" Placement="Bottom" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </Border>

                <!--  Order  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="What to sort by" />

                        <ComboBox
                            x:Name="SortFieldComboBox"
                            HorizontalAlignment="Stretch"
                            Header="Sort by"
                            ItemsSource="{x:Bind ViewModel.SortOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Model_Tool_LotMarkingSortOption">
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ToggleSwitch
                            Header="Direction"
                            IsOn="{x:Bind ViewModel.IsSortDescending, Mode=TwoWay}"
                            OffContent="Lowest first"
                            OnContent="Highest first" />
                    </StackPanel>
                </Border>

                <!--  Columns  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Which columns to show" />

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="These columns appear on screen and on the printed sheet."
                            TextWrapping="WrapWholeWords" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.ColumnOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Model_Tool_LotMarkingColumnOption">
                                    <CheckBox
                                        Margin="0,2"
                                        Content="{x:Bind DisplayName}"
                                        IsChecked="{x:Bind IsVisible, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Padding="24,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.ResetFiltersCommand}"
                    Content="Show everything"
                    ToolTipService.ToolTip="Every date, every column, newest first" />

                <Button
                    Grid.Column="1"
                    Click="OnCancelClick"
                    Content="Cancel" />

                <Button
                    Grid.Column="2"
                    Click="OnApplyClick"
                    Content="Apply"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
