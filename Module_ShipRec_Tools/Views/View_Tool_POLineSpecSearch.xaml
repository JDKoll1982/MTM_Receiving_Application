<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MTM_Receiving_Application.Module_ShipRec_Tools.Views.View_Tool_POLineSpecSearch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_InverseBool x:Key="InverseBoolConverter" />
    </Page.Resources>

    <Grid Padding="8,0,8,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,16"
            Spacing="10">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Search Spec Text:" />
                <TextBox
                    x:Name="SearchBox"
                    Width="360"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                    KeyDown="SearchBox_KeyDown"
                    PlaceholderText="e.g. PUR AIR CYLINDER"
                    Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Command="{x:Bind ViewModel.SearchCommand}"
                    Content="Search"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    Click="ClearButton_Click"
                    Content="Clear"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                <Button
                    Command="{x:Bind ViewModel.OpenOptionsCommand}"
                    Content="Options"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                <ProgressRing
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Visible lines:" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.VisibleLines, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Search mode:" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.SearchModeDisplay, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="PO Status filter:" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.PoStatusFilterDisplay, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <controls:DataGrid
                x:Name="ResultsGrid"
                AutoGenerateColumns="False"
                AutomationProperties.Name="PO Line Spec Search Results"
                CanUserSortColumns="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                SelectionMode="Single">
                <controls:DataGrid.CellStyle>
                    <Style TargetType="controls:DataGridCell">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </controls:DataGrid.CellStyle>
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn
                        x:Name="ColumnPONumber"
                        Width="Auto"
                        Binding="{Binding PONumber}"
                        Header="PO Number"
                        IsReadOnly="True" />
                    <controls:DataGridTextColumn
                        x:Name="ColumnPOLineNumber"
                        Width="Auto"
                        Binding="{Binding POLineNumber}"
                        Header="PO Line"
                        IsReadOnly="True" />
                    <controls:DataGridTextColumn
                        x:Name="ColumnPartId"
                        Width="Auto"
                        Binding="{Binding PartId}"
                        Header="Part ID"
                        IsReadOnly="True" />
                    <controls:DataGridTextColumn
                        x:Name="ColumnVendorName"
                        Width="Auto"
                        Binding="{Binding VendorName}"
                        Header="Vendor Name"
                        IsReadOnly="True" />
                    <controls:DataGridTextColumn
                        x:Name="ColumnVendorId"
                        Width="Auto"
                        Binding="{Binding VendorId}"
                        Header="Vendor ID"
                        IsReadOnly="True" />
                    <controls:DataGridTextColumn
                        x:Name="ColumnVendorPartId"
                        Width="Auto"
                        Binding="{Binding VendorPartId}"
                        Header="Vendor Part ID"
                        IsReadOnly="True" />
                    <controls:DataGridTextColumn
                        x:Name="ColumnQtyOrdered"
                        Width="Auto"
                        Binding="{Binding QtyOrdered}"
                        Header="Qty Ordered"
                        IsReadOnly="True" />
                    <controls:DataGridTextColumn
                        x:Name="ColumnTotalQtyReceived"
                        Width="Auto"
                        Binding="{Binding TotalQtyReceived}"
                        Header="Total Qty Received"
                        IsReadOnly="True" />
                    <controls:DataGridTextColumn
                        x:Name="ColumnPoStatus"
                        Width="Auto"
                        Binding="{Binding PoStatus}"
                        Header="PO Status"
                        IsReadOnly="True" />
                    <controls:DataGridTemplateColumn
                        x:Name="ColumnSpecExcerpt"
                        Width="*"
                        Header="Spec text excerpt"
                        IsReadOnly="True">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Click="ShowFullSpecTextButton_Click"
                                        ToolTipService.ToolTip="Show full spec text">
                                        <SymbolIcon Symbol="View" />
                                    </Button>
                                    <TextBlock
                                        Grid.Column="1"
                                        MaxLines="2"
                                        Text="{Binding SpecExcerpt}" />
                                </Grid>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTextColumn
                        x:Name="ColumnMatchScore"
                        Width="Auto"
                        Binding="{Binding MatchScore}"
                        Header="Match score"
                        IsReadOnly="True" />
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Border>
    </Grid>
</Page>
