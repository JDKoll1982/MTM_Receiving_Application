<ContentDialog
    x:Class="MTM_Receiving_Application.Module_ShipRec_Tools.Dialogs.Dialog_LotMarkingBackfillConfirm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CloseButtonText="Cancel"
    DefaultButton="Close"
    MinWidth="440"
    MaxWidth="560"
    PrimaryButtonText="Mark them">

    <StackPanel Spacing="10">
        <TextBlock
            x:Name="PartText"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            TextWrapping="WrapWholeWords" />

        <TextBlock
            x:Name="LotsText"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="WrapWholeWords" />

        <TextBlock
            x:Name="RowsText"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="WrapWholeWords" />

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="This covers both the receiving queue and receiving history. A row that already carries a marking is not touched."
            TextWrapping="WrapWholeWords" />
    </StackPanel>
</ContentDialog>
