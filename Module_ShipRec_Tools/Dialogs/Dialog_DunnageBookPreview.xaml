<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MTM_Receiving_Application.Module_ShipRec_Tools.Dialogs.Dialog_DunnageBookPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
    Width="1050"
    CloseButtonText="Close"
    DefaultButton="Primary"
    PrimaryButtonCommand="{x:Bind ViewModel.PrintCommand}"
    PrimaryButtonText="Print / Save as PDF"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <x:Double x:Key="ContentDialogMaxWidth">1600</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">780</x:Double>
    </ContentDialog.Resources>

    <Grid>
        <Border
            MinHeight="620"
            MaxHeight="760"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <controls:WebView2
                    x:Name="BookPreview"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

                <TextBox
                    x:Name="BookFallbackBox"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.PlainTextPreview, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
        
    </Grid>
</ContentDialog>
