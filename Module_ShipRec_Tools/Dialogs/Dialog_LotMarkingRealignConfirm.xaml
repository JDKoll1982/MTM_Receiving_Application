<ContentDialog
    x:Class="MTM_Receiving_Application.Module_ShipRec_Tools.Dialogs.Dialog_LotMarkingRealignConfirm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CloseButtonText="Cancel"
    DefaultButton="Close"
    MinWidth="560"
    MaxWidth="760"
    PrimaryButtonText="Update all lots">

    <StackPanel Spacing="10">
        <TextBlock
            x:Name="SummaryText"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            TextWrapping="WrapWholeWords" />

        <TextBlock
            x:Name="CreateText"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="WrapWholeWords" />

        <TextBlock
            x:Name="RemoveText"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="WrapWholeWords" />

        <TextBlock
            x:Name="SkipText"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="WrapWholeWords" />

        <ScrollViewer
            MaxHeight="240"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <TextBlock
                x:Name="ChangeListText"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="WrapWholeWords" />
        </ScrollViewer>

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="This covers both the receiving queue and receiving history, matching the lot number and supplier exactly as captured. Only rows that already carry a marking are changed, so no marking is introduced where there was none. A protected lot is never changed and never removed."
            TextWrapping="WrapWholeWords" />
    </StackPanel>
</ContentDialog>
