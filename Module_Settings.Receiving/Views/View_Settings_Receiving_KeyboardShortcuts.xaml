<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Receiving.Views.View_Settings_Receiving_KeyboardShortcuts"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
        <Grid Padding="24">
            <StackPanel
                Width="960"
                HorizontalAlignment="Center"
                Spacing="20">
                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Workflow Actions" />

                        <StackPanel Spacing="16">
                            <Border
                                Padding="16"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="6">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Mode Selection" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Returns the user to the workflow mode selector."
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            Grid.Column="0"
                                            DisplayMemberPath="DisplayName"
                                            Header="Key"
                                            ItemsSource="{x:Bind ViewModel.AvailableKeys, Mode=OneWay}"
                                            SelectedValue="{x:Bind ViewModel.ModeSelectionShortcut.Key, Mode=TwoWay}"
                                            SelectedValuePath="Value" />
                                        <CheckBox
                                            Grid.Column="1"
                                            Content="Ctrl"
                                            IsChecked="{x:Bind ViewModel.ModeSelectionShortcut.IsCtrlEnabled, Mode=TwoWay}" />
                                        <CheckBox
                                            Grid.Column="2"
                                            Content="Shift"
                                            IsChecked="{x:Bind ViewModel.ModeSelectionShortcut.IsShiftEnabled, Mode=TwoWay}" />
                                        <CheckBox
                                            Grid.Column="3"
                                            Content="Alt"
                                            IsChecked="{x:Bind ViewModel.ModeSelectionShortcut.IsAltEnabled, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="16"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="6">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Clear Label Data" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Clears active label data and archives it to history."
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            Grid.Column="0"
                                            DisplayMemberPath="DisplayName"
                                            Header="Key"
                                            ItemsSource="{x:Bind ViewModel.AvailableKeys, Mode=OneWay}"
                                            SelectedValue="{x:Bind ViewModel.ClearLabelDataShortcut.Key, Mode=TwoWay}"
                                            SelectedValuePath="Value" />
                                        <CheckBox
                                            Grid.Column="1"
                                            Content="Ctrl"
                                            IsChecked="{x:Bind ViewModel.ClearLabelDataShortcut.IsCtrlEnabled, Mode=TwoWay}" />
                                        <CheckBox
                                            Grid.Column="2"
                                            Content="Shift"
                                            IsChecked="{x:Bind ViewModel.ClearLabelDataShortcut.IsShiftEnabled, Mode=TwoWay}" />
                                        <CheckBox
                                            Grid.Column="3"
                                            Content="Alt"
                                            IsChecked="{x:Bind ViewModel.ClearLabelDataShortcut.IsAltEnabled, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="16"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="6">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Next Step" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Advances the workflow to the next step when the current step is valid."
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            Grid.Column="0"
                                            DisplayMemberPath="DisplayName"
                                            Header="Key"
                                            ItemsSource="{x:Bind ViewModel.AvailableKeys, Mode=OneWay}"
                                            SelectedValue="{x:Bind ViewModel.NextStepShortcut.Key, Mode=TwoWay}"
                                            SelectedValuePath="Value" />
                                        <CheckBox
                                            Grid.Column="1"
                                            Content="Ctrl"
                                            IsChecked="{x:Bind ViewModel.NextStepShortcut.IsCtrlEnabled, Mode=TwoWay}" />
                                        <CheckBox
                                            Grid.Column="2"
                                            Content="Shift"
                                            IsChecked="{x:Bind ViewModel.NextStepShortcut.IsShiftEnabled, Mode=TwoWay}" />
                                        <CheckBox
                                            Grid.Column="3"
                                            Content="Alt"
                                            IsChecked="{x:Bind ViewModel.NextStepShortcut.IsAltEnabled, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.NextStepCurrentShortcutText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="16"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="6">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Back Step" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Moves the workflow back one step without changing data access rules."
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            Grid.Column="0"
                                            DisplayMemberPath="DisplayName"
                                            Header="Key"
                                            ItemsSource="{x:Bind ViewModel.AvailableKeys, Mode=OneWay}"
                                            SelectedValue="{x:Bind ViewModel.BackStepShortcut.Key, Mode=TwoWay}"
                                            SelectedValuePath="Value" />
                                        <CheckBox
                                            Grid.Column="1"
                                            Content="Ctrl"
                                            IsChecked="{x:Bind ViewModel.BackStepShortcut.IsCtrlEnabled, Mode=TwoWay}" />
                                        <CheckBox
                                            Grid.Column="2"
                                            Content="Shift"
                                            IsChecked="{x:Bind ViewModel.BackStepShortcut.IsShiftEnabled, Mode=TwoWay}" />
                                        <CheckBox
                                            Grid.Column="3"
                                            Content="Alt"
                                            IsChecked="{x:Bind ViewModel.BackStepShortcut.IsAltEnabled, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.BackStepCurrentShortcutText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="16"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="6">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Help" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Opens the same contextual help action used by the workflow help button."
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            Grid.Column="0"
                                            DisplayMemberPath="DisplayName"
                                            Header="Key"
                                            ItemsSource="{x:Bind ViewModel.AvailableKeys, Mode=OneWay}"
                                            SelectedValue="{x:Bind ViewModel.HelpShortcut.Key, Mode=TwoWay}"
                                            SelectedValuePath="Value" />
                                        <CheckBox
                                            Grid.Column="1"
                                            Content="Ctrl"
                                            IsChecked="{x:Bind ViewModel.HelpShortcut.IsCtrlEnabled, Mode=TwoWay}" />
                                        <CheckBox
                                            Grid.Column="2"
                                            Content="Shift"
                                            IsChecked="{x:Bind ViewModel.HelpShortcut.IsShiftEnabled, Mode=TwoWay}" />
                                        <CheckBox
                                            Grid.Column="3"
                                            Content="Alt"
                                            IsChecked="{x:Bind ViewModel.HelpShortcut.IsAltEnabled, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Simple Navigation Toggle" />
                        <ToggleSwitch
                            Header="Enable Ctrl+T Simple Navigation Toggle"
                            IsOn="{x:Bind ViewModel.IsToggleSimpleNavigationEnabled, Mode=TwoWay}"
                            OffContent="Ctrl+T is ignored"
                            OnContent="Ctrl+T swaps Next and Back to plain Right and Left" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.SimpleNavigationNoteText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button Command="{x:Bind ViewModel.ResetCommand}" Content="Reset" />
                    <Button
                        Command="{x:Bind ViewModel.SaveShortcutsCommand}"
                        Content="Save"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
