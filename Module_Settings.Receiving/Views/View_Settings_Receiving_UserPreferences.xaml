<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Receiving.Views.View_Settings_Receiving_UserPreferences"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MTM_Receiving_Application.Module_Settings.Core.Views.Controls"
    xmlns:models="using:MTM_Receiving_Application.Module_Receiving.Models"
    xmlns:viewmodels="using:MTM_Receiving_Application.Module_Settings.Receiving.ViewModels">
    <ScrollViewer Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
        <Grid Padding="24">
            <StackPanel
                Width="960"
                HorizontalAlignment="Center"
                Spacing="20">
                <!--  Enable/Disable Card  -->
                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Part Number Auto-Padding" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Automatically format part numbers based on prefix patterns" />
                        </StackPanel>

                        <ToggleSwitch
                            Header="Enable Auto-Padding"
                            IsOn="{x:Bind ViewModel.IsPaddingEnabled, Mode=TwoWay}"
                            OffContent="Disabled - Part numbers will not be auto-formatted"
                            OnContent="Enabled - Part numbers will be formatted on entry" />
                    </StackPanel>
                </Border>

                <!--  Padding Rules Card  -->
                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Padding Rules" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Configure prefix patterns to auto-format part numbers"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Rules List  -->
                            <StackPanel Grid.Column="0" Spacing="12">
                                <Border
                                    Height="280"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <ListView
                                        ItemsSource="{x:Bind ViewModel.PrefixRules, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedRule, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:Model_PartNumberPrefixRule">
                                                <Grid Padding="12,8" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind Name, Mode=OneWay}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind Prefix, Mode=OneWay}" />
                                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}">
                                                            <Run Text="Length:" />
                                                            <Run Text="{x:Bind MaxLength, Mode=OneWay}" />
                                                            <Run Text=" • Pad:" />
                                                            <Run Text="{x:Bind PadChar, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!--  Status indicator - green when enabled, red when disabled  -->
                                                    <Ellipse
                                                        Grid.Column="1"
                                                        Width="8"
                                                        Height="8"
                                                        VerticalAlignment="Center"
                                                        Fill="{x:Bind StatusColor, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.AddRuleCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                                            <TextBlock Text="Add" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.RemoveRuleCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                            <TextBlock Text="Remove" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!--  Rule Editor  -->
                            <Border
                                Grid.Column="1"
                                Padding="20"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontSize="16"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="Rule Configuration" />
                                        <TextBlock
                                            x:Name="NoSelectionText"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="← Select a rule to edit" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="RuleEditorFields"
                                        Spacing="16"
                                        Visibility="Collapsed">
                                        <TextBox
                                            x:Name="NameTextBox"
                                            Description="Friendly name shown in the auto-padding rule list"
                                            Header="Name"
                                            PlaceholderText="e.g., Coil, Flatstock"
                                            TextChanged="NameTextBox_TextChanged" />

                                        <TextBox
                                            x:Name="PrefixTextBox"
                                            Description="Part numbers starting with this text will be formatted"
                                            Header="Prefix"
                                            PlaceholderText="e.g., MMC, MMF, PART-"
                                            TextChanged="PrefixTextBox_TextChanged" />

                                        <NumberBox
                                            x:Name="MaxLengthNumberBox"
                                            Description="Total characters after padding (includes prefix)"
                                            Header="Maximum Length"
                                            Maximum="50"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Inline"
                                            ValueChanged="MaxLengthNumberBox_ValueChanged" />

                                        <StackPanel Spacing="8">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Padding Character" />
                                            <ComboBox
                                                x:Name="PadCharComboBox"
                                                HorizontalAlignment="Stretch"
                                                SelectedIndex="0"
                                                SelectionChanged="PadCharComboBox_SelectionChanged">
                                                <ComboBoxItem Content="0 (Zero)" Tag="0" />
                                                <ComboBoxItem Content="Space" Tag=" " />
                                                <ComboBoxItem Content="_ (Underscore)" Tag="_" />
                                                <ComboBoxItem Content="- (Dash)" Tag="-" />
                                            </ComboBox>
                                        </StackPanel>

                                        <Border
                                            Padding="12"
                                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                            CornerRadius="4">
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Text="Example" />
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                                                    <Run Text="Input:" />
                                                    <Run FontWeight="SemiBold" Text="MMC1000" />
                                                    <Run Text="→ Output:" />
                                                    <Run FontWeight="SemiBold" Text="MMC0001000" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <ToggleSwitch
                                            x:Name="IsEnabledToggle"
                                            Header="Enable This Rule"
                                            OffContent="Rule disabled"
                                            OnContent="Rule enabled"
                                            Toggled="IsEnabledToggle_Toggled" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Location Reconciliation Preferences" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Keep reconciliation options together. Additional ignored locations for recommendations and reconciliation are managed in the next card."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch
                            Header="Validate All History During Reconciliation"
                            IsOn="{x:Bind ViewModel.ValidateAllHistoryForLocationReconciliation, Mode=TwoWay}"
                            ToolTipService.ToolTip="When turned on, the InforVisual location reconciliation action checks all visible receiving history rows instead of only today and Current Labels." />

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Ignored locations affect both the Recommended Locations card in Guided Receiving and the reconciliation review flow."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Ignored Recommended Locations" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="WC, NCM, FG, and RECV are always excluded automatically. Add any extra InforVisual locations you never want suggested in Recommended Locations or auto-applied during reconciliation."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="IgnoredLocationTextBox"
                                Grid.Column="0"
                                Header="Additional Ignored Locations"
                                LostFocus="IgnoredLocationTextBox_LostFocus"
                                PlaceholderText="Enter a location to exclude from recommendations"
                                Text="{x:Bind ViewModel.PendingIgnoredLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                Grid.Column="1"
                                MinWidth="120"
                                VerticalAlignment="Bottom"
                                Click="AddIgnoredLocationButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                    <TextBlock Text="Add Location" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="If the location is not an exact match, you will be prompted to choose a fuzzy-match result just like the Receiving Load Entry location field."
                            TextWrapping="Wrap" />

                        <Border
                            MinHeight="140"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <ListView
                                ItemsSource="{x:Bind ViewModel.IgnoredReconciliationLocations, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedIgnoredLocation, Mode=TwoWay}"
                                SelectionMode="Single" />
                        </Border>

                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="12">
                            <Button Command="{x:Bind ViewModel.RemoveIgnoredLocationCommand}" Content="Remove Selected" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Vendor Variable Prompts" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Define which vendor names should show the extra guided receiving textbox and what variable label appears beside it."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="12">
                                <Border
                                    Height="280"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <ListView
                                        ItemsSource="{x:Bind ViewModel.VendorVariableMappings, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedVendorVariableMapping, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:Model_ReceivingVendorVariableMapping">
                                                <Grid Padding="12,8">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind VendorName, Mode=OneWay}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind VariableName, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.SaveVendorVariableMappingCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                                            <TextBlock Text="{x:Bind ViewModel.VendorVariableActionText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.RemoveVendorVariableMappingCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                            <TextBlock Text="Remove" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Padding="20"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontSize="16"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="Prompt Configuration" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Select a mapping to edit, or enter a new vendor and variable label." />
                                    </StackPanel>

                                    <TextBox
                                        Header="Vendor Name"
                                        PlaceholderText="e.g., Skana"
                                        Text="{x:Bind ViewModel.PendingVendorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBox
                                        Header="Variable Label"
                                        PlaceholderText="e.g., DM #"
                                        Text="{x:Bind ViewModel.PendingVariableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="When the guided PO's vendor name contains the configured vendor text, Receiving will show the additional textbox on the Heat/Lot step." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Test Padding Card  -->
                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="20"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE8CB;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="Test Padding" />
                            </StackPanel>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Preview how part numbers will be formatted" />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Padding="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Input" />
                                    <TextBox
                                        Background="Transparent"
                                        BorderThickness="0"
                                        PlaceholderText="e.g., MMC1000"
                                        Text="{x:Bind ViewModel.TestInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>

                            <FontIcon
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE72A;" />

                            <Border
                                Grid.Column="2"
                                Padding="12"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource AccentControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Text="Output" />
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Text="{x:Bind ViewModel.TestOutput, Mode=OneWay}"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Save Button Card  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            MinWidth="140"
                            Command="{x:Bind ViewModel.SaveCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE74E;" />
                                <TextBlock Text="Save Settings" />
                            </StackPanel>
                        </Button>

                        <StackPanel
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <ProgressRing
                                Width="20"
                                Height="20"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
