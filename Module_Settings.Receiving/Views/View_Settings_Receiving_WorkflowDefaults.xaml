<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Receiving.Views.View_Settings_Receiving_WorkflowDefaults"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
        <Grid Padding="24">
            <StackPanel
                Width="960"
                HorizontalAlignment="Center"
                Spacing="20">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Workflow Defaults" />

                        <ComboBox
                            DisplayMemberPath="DisplayName"
                            Header="Default Mode On Startup"
                            ItemsSource="{x:Bind ViewModel.DefaultModeOptions, Mode=OneWay}"
                            SelectedValue="{x:Bind ViewModel.DefaultModeOnStartup, Mode=TwoWay}"
                            SelectedValuePath="Value" />

                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ToggleSwitch
                                Grid.Row="0"
                                Grid.Column="0"
                                Header="Confirm Mode Change"
                                IsOn="{x:Bind ViewModel.ConfirmModeChange, Mode=TwoWay}" />
                            <ToggleSwitch
                                Grid.Row="0"
                                Grid.Column="1"
                                Header="Show Review Table By Default"
                                IsOn="{x:Bind ViewModel.ShowReviewTableByDefault, Mode=TwoWay}" />
                            <ToggleSwitch
                                Grid.Row="1"
                                Grid.Column="0"
                                Header="Use InforVisual Mock Data"
                                IsOn="{x:Bind ViewModel.UseInforVisualMockData, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.MockDataToggleVisibility, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button Command="{x:Bind ViewModel.ResetCommand}" Content="Reset" />
                    <Button
                        Command="{x:Bind ViewModel.SaveCommand}"
                        Content="Save"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
