<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Receiving.Views.View_Settings_Receiving_ValidationRules"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MTM_Receiving_Application.Module_Settings.Receiving.Views">
    <ScrollViewer>
        <Grid Padding="24">
            <StackPanel
                Width="960"
                HorizontalAlignment="Center"
                Spacing="20">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Required Fields &amp; Warnings" />

                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ToggleSwitch
                                Grid.Row="0"
                                Grid.Column="0"
                                Header="Require PO Number"
                                IsOn="{x:Bind ViewModel.RequirePoNumber, Mode=TwoWay}" />
                            <ToggleSwitch
                                Grid.Row="0"
                                Grid.Column="1"
                                Header="Require Quantity"
                                IsOn="{x:Bind ViewModel.RequireQuantity, Mode=TwoWay}" />
                            <ToggleSwitch
                                Grid.Row="1"
                                Grid.Column="0"
                                Header="Require Heat/Lot"
                                IsOn="{x:Bind ViewModel.RequireHeatLot, Mode=TwoWay}" />
                            <ToggleSwitch
                                Grid.Row="1"
                                Grid.Column="1"
                                Header="Allow Negative Quantity"
                                IsOn="{x:Bind ViewModel.AllowNegativeQuantity, Mode=TwoWay}" />
                            <ToggleSwitch
                                Grid.Row="2"
                                Grid.Column="0"
                                Header="Validate PO Exists"
                                IsOn="{x:Bind ViewModel.ValidatePoExists, Mode=TwoWay}" />
                            <ToggleSwitch
                                Grid.Row="2"
                                Grid.Column="1"
                                Header="Validate Part Exists"
                                IsOn="{x:Bind ViewModel.ValidatePartExists, Mode=TwoWay}" />
                            <ToggleSwitch
                                Grid.Row="3"
                                Grid.Column="0"
                                Header="Warn On Quantity Exceeds PO"
                                IsOn="{x:Bind ViewModel.WarnOnQuantityExceedsPo, Mode=TwoWay}" />
                            <ToggleSwitch
                                Grid.Row="3"
                                Grid.Column="1"
                                Header="Warn On Same-Day Receiving"
                                IsOn="{x:Bind ViewModel.WarnOnSameDayReceiving, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Thresholds" />

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBox
                                Grid.Row="0"
                                Grid.Column="0"
                                Header="Minimum Load Count"
                                Text="{x:Bind ViewModel.MinLoadCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Header="Maximum Load Count"
                                Text="{x:Bind ViewModel.MaxLoadCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="0"
                                Header="Minimum Quantity"
                                Text="{x:Bind ViewModel.MinQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Header="Maximum Quantity"
                                Text="{x:Bind ViewModel.MaxQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button Command="{x:Bind ViewModel.ResetCommand}" Content="Reset" />
                    <Button
                        Command="{x:Bind ViewModel.SaveCommand}"
                        Content="Save"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
