<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Receiving.Views.View_Settings_Receiving_CategoryHub"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:MTM_Receiving_Application.Module_Settings.Receiving.ViewModels">
    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ColumnSpacing="16"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Row="0"
                Grid.Column="0"
                Width="320"
                Height="180"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OnStep0Clicked"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE74C;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Entry Defaults" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Set default locations and baseline values for new receiving entries."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button
                Grid.Row="0"
                Grid.Column="1"
                Width="320"
                Height="180"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OnStep1Clicked"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE7BA;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Validation Rules" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Configure required fields, warnings, and quantity thresholds for Receiving."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button
                Grid.Row="0"
                Grid.Column="2"
                Width="320"
                Height="180"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OnStep2Clicked"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE8CB;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Part Formatting" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Manage auto-padding rules and preview normalized part numbers."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button
                Grid.Row="1"
                Grid.Column="0"
                Width="320"
                Height="180"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OnStep3Clicked"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE8FD;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Reconciliation" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Choose ignored locations and how visible history rows are checked."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button
                Grid.Row="1"
                Grid.Column="1"
                Width="320"
                Height="180"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OnStep4Clicked"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE7C3;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Workflow Defaults" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Set startup mode, confirmations, review defaults, and mock data."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button
                Grid.Row="1"
                Grid.Column="2"
                Width="320"
                Height="180"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OnStep5Clicked"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE92E;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Keyboard Shortcuts" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Customize workflow shortcuts and the simple navigation toggle."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button
                Grid.Row="2"
                Grid.Column="0"
                Width="320"
                Height="180"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OnStep6Clicked"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE8A5;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Label Files" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Set LabelView template paths for Receiving and Mini-Receiving."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button
                Grid.Row="2"
                Grid.Column="1"
                Width="320"
                Height="180"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OnStep7Clicked"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xF1B1;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Custom Vendor Variables" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Set Vendor Variables allowing for special input in the Heat/Lot screen."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>                
            </Button>
        </Grid>
    </Grid>
</Page>
