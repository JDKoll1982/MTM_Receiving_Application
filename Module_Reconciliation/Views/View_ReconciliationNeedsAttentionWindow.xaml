<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MTM_Receiving_Application.Module_Reconciliation.Views.View_ReconciliationNeedsAttentionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_Reconciliation.Models"
    Title="Needs Attention"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="These lines could not be answered from the movement evidence. Type a location for a line and submit it; the write goes through the same accepted-line path as the review cycle."
            TextWrapping="Wrap" />

        <ListView
            Grid.Row="1"
            AutomationProperties.Name="Lines that need attention"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Model_ReconciliationAttentionItem">
                    <StackPanel Margin="0,0,0,12" Spacing="4">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind LineHeader, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Reason, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Evidence, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind DifferenceText, Mode=OneWay}" AutomationProperties.Name="Raw difference" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                MinWidth="200"
                                AutomationProperties.Name="Location to set for this line"
                                PlaceholderText="Location"
                                Text="{x:Bind LocationInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                AutomationProperties.Name="Write this line's location"
                                Command="{x:Bind SubmitCommand, Mode=OneWay}"
                                Content="Set location" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <TextBlock AutomationProperties.Name="Unresolved count" Text="{x:Bind ViewModel.UnresolvedCount, Mode=OneWay}" />
            <Button
                AutomationProperties.Name="Close the needs attention window"
                Click="OnCloseClicked"
                Content="Close" />
        </StackPanel>
    </Grid>
</Window>
