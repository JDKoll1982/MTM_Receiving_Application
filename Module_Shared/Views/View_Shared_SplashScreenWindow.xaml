<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MTM_Receiving_Application.Module_Shared.Views.View_Shared_SplashScreenWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MTM Receiving Application">
    <Grid Padding="32" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Logo and Branding  -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            Spacing="12">
            <Image
                Height="120"
                MaxWidth="360"
                HorizontalAlignment="Center"
                Source="ms-appx:///Assets/MTMLogo.jpg"
                Stretch="Uniform" />

            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="SemiBold"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="MTM Receiving Application" />

            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.AppVersion, Mode=OneTime}" />

            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="MTM Manufacturing" />
        </StackPanel>

        <!--  Progress Section  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,40,0,0"
            Spacing="12">
            <TextBlock
                x:Name="StatusMessageTextBlock"
                Height="44"
                HorizontalAlignment="Center"
                MaxLines="2"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Initializing..."
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />

            <ProgressBar
                x:Name="MainProgressBar"
                Height="4"
                HorizontalAlignment="Stretch"
                Maximum="100"
                Minimum="0"
                Value="0" />

            <TextBlock
                x:Name="ProgressPercentageTextBlock"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="0%" />

            <!--
                The step currently running, on its own smaller bar under the overall one. The container
                keeps a fixed height whether or not a step is running, so the main bar above it never
                moves; only the contents appear and disappear.
            -->
            <Grid Height="48" Margin="0,4,0,0">
                <StackPanel
                    Spacing="4"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind ViewModel.IsStepVisible, Mode=OneWay}">
                    <TextBlock
                        Height="34"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.StepStatusMessage, Mode=OneWay}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />

                    <ProgressBar
                        Height="2"
                        HorizontalAlignment="Stretch"
                        Foreground="{ThemeResource AccentFillColorSecondaryBrush}"
                        Maximum="100"
                        Minimum="0"
                        Value="{x:Bind ViewModel.StepProgressPercentage, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!--  Copyright  -->
        <TextBlock
            Grid.Row="3"
            Margin="0,28,0,0"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="© 2025 John Koll. All rights reserved." />
    </Grid>
</Window>
