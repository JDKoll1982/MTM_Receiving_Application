<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Shared.Views.View_Shared_NewUserSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="480"
    Title="New User Entry"
    CornerRadius="16">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">880</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">825</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">825</x:Double>
    </ContentDialog.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        

        <!--  Main Content - Using Grid for compact two-column layout -->
        
        <Grid
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="20,12"
            ColumnSpacing="16"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Row="0"
                Grid.Column="0"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel Spacing="14">

                    <StackPanel Spacing="8">
                        <TextBlock
                            Margin="4,0,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Name" />
                        <Border
                            x:Name="NameCardBorder"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Padding="6,0,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="First Name:" />
                                    <TextBox
                                        x:Name="FirstNameTextBox"
                                        GotFocus="InputControl_GotFocus"
                                        LostFocus="InputControl_LostFocus"
                                        MaxLength="50"
                                        PlaceholderText="Enter your first name"
                                        TabIndex="0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Padding="6,0,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Last Name:" />
                                    <TextBox
                                        x:Name="LastNameTextBox"
                                        GotFocus="InputControl_GotFocus"
                                        LostFocus="InputControl_LostFocus"
                                        MaxLength="50"
                                        PlaceholderText="Enter your last name"
                                        TabIndex="1" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock
                            Margin="4,0,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Employee Details" />
                        <Border
                            x:Name="EmployeeDetailsCardBorder"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Employee Number:" />
                                    <TextBox
                                        x:Name="EmployeeNumberTextBox"
                                        GotFocus="InputControl_GotFocus"
                                        InputScope="Number"
                                        LostFocus="InputControl_LostFocus"
                                        MaxLength="10"
                                        PlaceholderText="e.g., 6229"
                                        TabIndex="2" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="Windows Username:" />
                                    <TextBox
                                        x:Name="WindowsUsernameTextBox"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                        IsReadOnly="True"
                                        TabIndex="-1" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock
                            Margin="4,0,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Department Assignment" />
                        <Border
                            x:Name="DepartmentAssignmentCardBorder"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Department:" />
                                        <ComboBox
                                        x:Name="DepartmentComboBox"
                                        GotFocus="InputControl_GotFocus"
                                        HorizontalAlignment="Stretch"
                                        LostFocus="InputControl_LostFocus"
                                        PlaceholderText="Select department"
                                        SelectionChanged="DepartmentComboBox_SelectionChanged"
                                        TabIndex="3" />
                                </StackPanel>

                                <StackPanel
                                    x:Name="CustomDepartmentPanel"
                                    Spacing="6"
                                    Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Custom Department Name:" />
                                    <TextBox
                                        x:Name="CustomDepartmentTextBox"
                                        GotFocus="InputControl_GotFocus"
                                        LostFocus="InputControl_LostFocus"
                                        MaxLength="50"
                                        PlaceholderText="Enter department name"
                                        TabIndex="4" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Grid.Row="0"
                Grid.Column="1"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel Spacing="14">

                    <StackPanel Spacing="8">
                        <TextBlock
                            Margin="4,0,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Work Schedule" />
                        <Border
                            x:Name="WorkScheduleCardBorder"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Shift:" />
                                <ComboBox
                                    x:Name="ShiftComboBox"
                                    GotFocus="InputControl_GotFocus"
                                    HorizontalAlignment="Stretch"
                                    LostFocus="InputControl_LostFocus"
                                    PlaceholderText="Select shift"
                                    TabIndex="5">
                                    <ComboBoxItem Content="1st Shift" />
                                    <ComboBoxItem Content="2nd Shift" />
                                    <ComboBoxItem Content="3rd Shift" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock
                            Margin="4,0,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Account Security" />
                        <Border
                            x:Name="AccountSecurityCardBorder"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="6">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="4-Digit PIN:" />
                                    <PasswordBox
                                        x:Name="PinPasswordBox"
                                        GotFocus="InputControl_GotFocus"
                                        LostFocus="InputControl_LostFocus"
                                        MaxLength="4"
                                        PasswordRevealMode="Peek"
                                        PlaceholderText="Create PIN"
                                        TabIndex="6" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="For shared terminal login" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="6">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Confirm PIN:" />
                                    <PasswordBox
                                        x:Name="ConfirmPinPasswordBox"
                                        GotFocus="InputControl_GotFocus"
                                        LostFocus="InputControl_LostFocus"
                                        MaxLength="4"
                                        PasswordRevealMode="Peek"
                                        PlaceholderText="Re-enter PIN"
                                        TabIndex="7" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Spacing="8">
                <TextBlock
                    Margin="4,0,0,0"
                    FontSize="16"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="ERP System Access" />
                <Border
                    x:Name="ErpAccessCardBorder"
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Visual/Infor Username:" />
                            <TextBox
                                x:Name="VisualUsernameTextBox"
                                GotFocus="InputControl_GotFocus"
                                LostFocus="InputControl_LostFocus"
                                MaxLength="50"
                                PlaceholderText="ERP username"
                                TabIndex="8" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Visual/Infor Password:" />
                            <PasswordBox
                                x:Name="VisualPasswordBox"
                                GotFocus="InputControl_GotFocus"
                                LostFocus="InputControl_LostFocus"
                                MaxLength="100"
                                PasswordRevealMode="Peek"
                                PlaceholderText="ERP password"
                                TabIndex="9" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!--  Footer: Status Bar & Progress  -->
        <StackPanel
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Padding="20,8,20,16"
            Spacing="6">
            <ProgressBar
                x:Name="LoadingProgressBar"
                Height="4"
                IsIndeterminate="True"
                Visibility="Collapsed" />

            <InfoBar
                x:Name="StatusInfoBar"
                IsClosable="True"
                IsOpen="False" />

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="CancelActionButton"
                    Click="CancelActionButton_Click"
                    Content="Cancel"
                    MinWidth="120" />
                <Button
                    x:Name="CreateAccountActionButton"
                    Click="CreateAccountActionButton_Click"
                    Content="Create Account"
                    MinWidth="140"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>
