<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Shared.Views.View_Shared_NewUserSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Create Your Account"
    Width="480"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
    PrimaryButtonText="Create Account">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header with Icon and Welcome  -->
        <StackPanel
            Grid.Row="0"
            Padding="20,16,20,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Spacing="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="32"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    Glyph="&#xE77B;" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Welcome to MTM Receiving" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Let's set up your account to get started" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!--  Main Content - Using Grid for compact two-column layout with ScrollViewer  -->
        <ScrollViewer
            Grid.Row="1"
            MaxHeight="480"
            Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
            <Grid
                Padding="20,12"
                ColumnSpacing="12"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Row 0: First Name & Last Name  -->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE77B;" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="First Name *" />
                    </StackPanel>
                    <TextBox
                        x:Name="FirstNameTextBox"
                        MaxLength="50"
                        PlaceholderText="Enter your first name"
                        TabIndex="0" />
                </StackPanel>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE77B;" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Last Name *" />
                    </StackPanel>
                    <TextBox
                        x:Name="LastNameTextBox"
                        MaxLength="50"
                        PlaceholderText="Enter your last name"
                        TabIndex="1" />
                </StackPanel>

                <!--  Row 1: Employee Number & Windows Username  -->
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE8D4;" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Employee Number *" />
                    </StackPanel>
                    <TextBox
                        x:Name="EmployeeNumberTextBox"
                        InputScope="Number"
                        MaxLength="10"
                        PlaceholderText="e.g., 6229"
                        TabIndex="2" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE910;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Windows Username" />
                    </StackPanel>
                    <TextBox
                        x:Name="WindowsUsernameTextBox"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                        IsReadOnly="True"
                        TabIndex="-1" />
                </StackPanel>

                <!--  Row 2: Department & Shift  -->
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="0"
                    Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE716;" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Department *" />
                    </StackPanel>
                    <ComboBox
                        x:Name="DepartmentComboBox"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Select department"
                        SelectionChanged="DepartmentComboBox_SelectionChanged"
                        TabIndex="3" />
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    Grid.Column="1"
                    Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE823;" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Shift *" />
                    </StackPanel>
                    <ComboBox
                        x:Name="ShiftComboBox"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Select shift"
                        TabIndex="5">
                        <ComboBoxItem Content="1st Shift" />
                        <ComboBoxItem Content="2nd Shift" />
                        <ComboBoxItem Content="3rd Shift" />
                    </ComboBox>
                </StackPanel>

                <!--  Row 3: Custom Department (Visible when "Other" selected, spans both columns)  -->
                <StackPanel
                    x:Name="CustomDepartmentPanel"
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Spacing="6"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE70F;" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Custom Department Name *" />
                    </StackPanel>
                    <TextBox
                        x:Name="CustomDepartmentTextBox"
                        MaxLength="50"
                        PlaceholderText="Enter department name"
                        TabIndex="4" />
                </StackPanel>

                <!--  Row 4: PIN Fields  -->
                <StackPanel
                    Grid.Row="4"
                    Grid.Column="0"
                    Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE72E;" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="4-Digit PIN *" />
                    </StackPanel>
                    <PasswordBox
                        x:Name="PinPasswordBox"
                        MaxLength="4"
                        PasswordRevealMode="Peek"
                        PlaceholderText="Create PIN"
                        TabIndex="6" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="For shared terminal login" />
                </StackPanel>

                <StackPanel
                    Grid.Row="4"
                    Grid.Column="1"
                    Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE8C9;" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Confirm PIN *" />
                    </StackPanel>
                    <PasswordBox
                        x:Name="ConfirmPinPasswordBox"
                        MaxLength="4"
                        PasswordRevealMode="Peek"
                        PlaceholderText="Re-enter PIN"
                        TabIndex="7" />
                </StackPanel>

                <!--  Row 5: ERP Credentials Section (Optional)  -->
                <Expander
                    x:Name="ErpExpander"
                    Grid.Row="5"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Header="ERP System Access (Optional)"
                    IsExpanded="False">
                    <Expander.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Glyph="&#xE89F;" />
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </Expander.HeaderTemplate>

                    <StackPanel Padding="12,8,0,0" Spacing="12">
                        <CheckBox
                            x:Name="ConfigureErpCheckBox"
                            Checked="ConfigureErpCheckBox_Checked"
                            Content="Configure Visual/Infor ERP credentials"
                            TabIndex="8"
                            Unchecked="ConfigureErpCheckBox_Unchecked" />

                        <StackPanel
                            x:Name="ErpCredentialsPanel"
                            Spacing="12"
                            Visibility="Collapsed">
                            <InfoBar
                                IsClosable="False"
                                IsOpen="True"
                                Message="Credentials are stored in plain text for ERP integration."
                                Severity="Warning" />

                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Visual/Infor Username" />
                                <TextBox
                                    x:Name="VisualUsernameTextBox"
                                    MaxLength="50"
                                    PlaceholderText="ERP username"
                                    TabIndex="9" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Visual/Infor Password" />
                                <PasswordBox
                                    x:Name="VisualPasswordBox"
                                    MaxLength="100"
                                    PasswordRevealMode="Peek"
                                    PlaceholderText="ERP password"
                                    TabIndex="10" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Grid>
        </ScrollViewer>

        <!--  Footer: Status Bar & Progress  -->
        <StackPanel
            Grid.Row="2"
            Padding="20,8,20,16"
            Spacing="6">
            <ProgressBar
                x:Name="LoadingProgressBar"
                Height="4"
                IsIndeterminate="True"
                Visibility="Collapsed" />

            <InfoBar
                x:Name="StatusInfoBar"
                IsClosable="True"
                IsOpen="False" />
        </StackPanel>
    </Grid>
</ContentDialog>
