<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MTM_Receiving_Application.Module_Shared.Views.View_Shared_MathQuantityHelpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Quantity Box Help"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Hero  -->
        <Border
            Grid.Row="0"
            Padding="20,18"
            Background="{ThemeResource AccentFillColorDefaultBrush}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="34"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Glyph="&#xE8EF;" />

                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="Quantity box" />
                    <TextBlock
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Opacity="0.9"
                        Text="Whole numbers only — and you can type the math instead of the answer."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            Padding="20,16"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!--  1. What the box takes  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE73E;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="What it takes" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="Only whole numbers. 12 is fine, 12.5 is not." />
                        <TextBlock TextWrapping="Wrap" Text="No negatives. A minus sign may appear inside the math, but the answer cannot be below zero." />
                        <TextBlock TextWrapping="Wrap" Text="Nothing but digits, + - * /, parentheses, and spaces can be typed." />
                    </StackPanel>
                </Border>

                <!--  2. Math  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8EF;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Type the math" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="The box works out the answer for you. Type an expression, then press = or Enter, or click away." />
                        <Grid ColumnSpacing="12" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="+" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Add — 12+4 becomes 16" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="-" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Subtract — 20-5 becomes 15" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="*" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Multiply — 6*7 becomes 42" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="/" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Divide — 10/2 becomes 5" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="( )" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Group — (2+3)*4 becomes 20" />
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Multiplies and divides happen first, then adds and subtracts. Parentheses win over both."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  3. Rounding  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE7BA;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="What the icon on the right means" />
                        </StackPanel>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xE7BA;" />
                            <TextBlock
                                Grid.Column="1"
                                Text="Warning — the answer is not a whole number yet, or the text is not a valid expression. Point at the icon to see the reason."
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;" />
                            <TextBlock
                                Grid.Column="1"
                                Text="Checkmark — the box accepts the number as it stands."
                                TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="An answer with a fraction rounds to the nearest whole number: 10/4 gives 3."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  4. Keys  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE765;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Keys" />
                        </StackPanel>
                        <Grid ColumnSpacing="12" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="= or Enter" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Works out the answer and puts it in the box." />
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tab" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Accepts the answer and moves to the next field." />
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Ctrl+I" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Opens this help — while the box summary is showing." />
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Esc" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Closes this help." />
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Point at the box to see its summary, then press Ctrl+I for this page."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  5. Examples  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE70F;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Examples" />
                        </StackPanel>
                        <Grid ColumnSpacing="12" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="You type" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="You get" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="48" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="→" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="48" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="12*4" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="→" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="48" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="(8+4)/2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="→" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="6" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="100-25*2" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="→" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="50" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  Footer  -->
        <Border
            Grid.Row="2"
            Padding="20,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Tip: wrong answer? Type over it — nothing is saved until you press = or leave the box."
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    Click="OnCloseClick"
                    Content="Got it"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
