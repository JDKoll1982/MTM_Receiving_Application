<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>WIN2D0001</NoWarn>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup>
    <_WinUITestAssetRuntime>win-x64</_WinUITestAssetRuntime>
    <_ReferencedAppWinUIAssetSourceDir>$(PkgMicrosoft_WindowsAppSDK_WinUI)\runtimes-framework\$(_WinUITestAssetRuntime)\native\Microsoft.UI.Xaml\Assets</_ReferencedAppWinUIAssetSourceDir>
    <_ReferencedAppWinUIAssetOutputDir>$(MSBuildThisFileDirectory)..\bin\$(Platform)\$(Configuration)\$(TargetFramework)\Microsoft.UI.Xaml\Assets</_ReferencedAppWinUIAssetOutputDir>
  </PropertyGroup>

  <!-- xUnit packages (per project standards) -->
  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="FsCheck.Xunit" Version="3.3.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="Verify.Xunit" Version="31.12.5" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.TestPlatform.TestHost" Version="18.5.1">
      <ExcludeAssets>build</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <!-- Mocking and Assertions -->
  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
  </ItemGroup>

  <!-- Database Testing -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="MySql.Data" Version="9.7.0" />
  </ItemGroup>

  <!--Reference
    the main app project -->
  <ItemGroup>
    <ProjectReference Include="..\MTM_Receiving_Application.csproj">
      <AdditionalProperties>WindowsAppSdkBootstrapInitialize=false;WindowsAppSdkUndockedRegFreeWinRTInitialize=false;WindowsAppSDKSelfContained=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Unit\Module_OutsideService\**" />
    <None Remove="Unit\Module_OutsideService\**" />
  </ItemGroup>

  <Target Name="RestoreReferencedWinUIAssetsForTests" AfterTargets="ResolveProjectReferences" BeforeTargets="CopyFilesToOutputDirectory" Condition="Exists('$(_ReferencedAppWinUIAssetSourceDir)')">
    <ItemGroup>
      <_ReferencedWinUIAsset Include="$(_ReferencedAppWinUIAssetSourceDir)\map.html">
        <TargetPath>$(_ReferencedAppWinUIAssetOutputDir)\map.html</TargetPath>
      </_ReferencedWinUIAsset>
      <_ReferencedWinUIAsset Include="$(_ReferencedAppWinUIAssetSourceDir)\NoiseAsset_256x256_PNG.png">
        <TargetPath>$(_ReferencedAppWinUIAssetOutputDir)\NoiseAsset_256X256_PNG.png</TargetPath>
      </_ReferencedWinUIAsset>
    </ItemGroup>

    <MakeDir Directories="$(_ReferencedAppWinUIAssetOutputDir)" />
    <Copy SourceFiles="@(_ReferencedWinUIAsset)" DestinationFiles="@(_ReferencedWinUIAsset->'%(TargetPath)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
