<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Volvo.Views.View_Volvo_GeneratedLabelDataDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:models="using:MTM_Receiving_Application.Module_Volvo.Models"
    Title="Generated Label Data"
    Width="980"
    CloseButtonText="Close"
    DefaultButton="Close">
    <ContentDialog.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_InverseBooleanToVisibility x:Key="InverseBooleanToVisibilityConverter" />
        <x:Double x:Key="ContentDialogMaxWidth">1280</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
    </ContentDialog.Resources>

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />

            <Button
                Grid.Column="1"
                Click="OnClearLabelDataClick"
                IsEnabled="{x:Bind ViewModel.HasRows, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Delete" />
                    <TextBlock Text="Clear Label Data" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.7"
                Text="No generated label rows are currently queued."
                Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

            <controls:DataGrid
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                RowHeight="40"
                SelectionMode="Single"
                Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:DataGrid.Columns>
                    <controls:DataGridTemplateColumn Width="150" Header="Part ID">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Model_VolvoGeneratedLabelData">
                                <TextBlock Text="{x:Bind PartNumber, Mode=OneTime}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn Width="120" Header="Quantity">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Model_VolvoGeneratedLabelData">
                                <TextBlock Text="{x:Bind Quantity, Mode=OneTime}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn Width="120" Header="Skid #">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Model_VolvoGeneratedLabelData">
                                <TextBlock Text="{x:Bind SkidNumber, Mode=OneTime}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn Width="120" Header="Total Skids">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Model_VolvoGeneratedLabelData">
                                <TextBlock Text="{x:Bind TotalSkids, Mode=OneTime}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn Width="*" Header="Description">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Model_VolvoGeneratedLabelData">
                                <TextBlock Text="{x:Bind PartDescription, Mode=OneTime}" TextWrapping="WrapWholeWords" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Grid>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8">
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</ContentDialog>
