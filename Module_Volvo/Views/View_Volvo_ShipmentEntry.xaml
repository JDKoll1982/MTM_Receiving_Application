<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MTM_Receiving_Application.Module_Volvo.Views.View_Volvo_ShipmentEntry"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_Volvo.Models"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_InverseBooleanToVisibility x:Key="InverseBooleanToVisibilityConverter" />
        <converters:Converter_IntToString x:Key="IntToStringConverter" />
        <converters:Converter_InfoBarSeverity x:Key="InfoBarSeverityConverter" />
        <converters:Converter_InverseBool x:Key="InverseBoolConverter" />
        <converters:Converter_VolvoPoStatusToBrush x:Key="VolvoPoStatusToBrushConverter" />
        <converters:Converter_VolvoDiscrepancyBorderBrush x:Key="VolvoDiscrepancyBorderBrushConverter" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsSuccessMessageVisible, Mode=OneWay}"
                Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                Severity="Success" />
            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay, Converter={StaticResource InfoBarSeverityConverter}}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="12,6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Opacity="0.75"
                    Text="Active Volvo lines are saved automatically." />

            <Button
                Grid.Column="1"
                Click="AddPartButton_Click"
                IsEnabled="{x:Bind ViewModel.IsAutoSaveInProgress, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="Add Part" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                Command="{x:Bind ViewModel.PreviewEmailCommand}"
                IsEnabled="{x:Bind ViewModel.HasAnyParts, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Mail" />
                    <TextBlock Text="Preview Email" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Command="{x:Bind ViewModel.ViewLabelDataCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="List" />
                    <TextBlock Text="View Label Data" />
                </StackPanel>
            </Button>

            <Button Grid.Column="4" Command="{x:Bind ViewModel.ViewHistoryCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Calendar" />
                    <TextBlock Text="View History" />
                </StackPanel>
            </Button>

            <Rectangle
                Grid.Column="5"
                Width="1"
                Height="24"
                Margin="2,0"
                VerticalAlignment="Center"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Button
                Grid.Column="6"
                Width="34"
                Height="34"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Help"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OnHelpClick"
                CornerRadius="4"
                ToolTipService.ToolTip="Help">
                <FontIcon FontSize="16" Glyph="&#xE946;" />
            </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.7"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Click Add Part to begin transaction."
                Visibility="{x:Bind ViewModel.HasAnyParts, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

            <ScrollViewer HorizontalContentAlignment="Stretch" Visibility="{x:Bind ViewModel.HasAnyParts, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Parts, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Model_VolvoShipmentLine">
                            <Border
                                Margin="0,0,0,12"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                BorderBrush="{x:Bind HasDiscrepancy, Mode=OneWay, Converter={StaticResource VolvoDiscrepancyBorderBrushConverter}}"
                                BorderThickness="2"
                                CornerRadius="8">
                                <Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <Border
                                            BorderBrush="{StaticResource VolvoAccentBrush}"
                                            BorderThickness="4,0,0,0"
                                            CornerRadius="8,0,0,8">
                                            <Grid
                                                Padding="12"
                                                HorizontalAlignment="Stretch"
                                                RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel
                                                    Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <Button
                                                        HorizontalAlignment="Left"
                                                        Click="PartNumberButton_Click"
                                                        Content="{x:Bind PartNumber, Mode=OneWay}"
                                                        Tag="{x:Bind}" />
                                                    <TextBlock VerticalAlignment="Center" Text="-" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Text="{x:Bind PartDescriptionDisplay, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <Border
                                                    Grid.Column="1"
                                                    Padding="8,4"
                                                    Background="#FFFFFFFF"
                                                    BorderBrush="#33000000"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind PoStatus, Mode=OneWay}" />
                                                </Border>
                                            </Grid>

                                            <Grid Grid.Row="1" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel
                                                    Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock VerticalAlignment="Center" Text="File Discrepancy:" />
                                                    <Button
                                                        Click="ReportDiscrepancyButton_Click"
                                                        Content="Report"
                                                        IsEnabled="{x:Bind HasDiscrepancy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                                        Tag="{x:Bind}" />
                                                    <Button
                                                        Click="RemoveDiscrepancyButton_Click"
                                                        Content="Remove"
                                                        IsEnabled="{x:Bind HasDiscrepancy, Mode=OneWay}"
                                                        Tag="{x:Bind}" />
                                                </StackPanel>

                                                <Button
                                                    Grid.Column="1"
                                                    Click="RemovePartButton_Click"
                                                    Content="Remove Part"
                                                    Tag="{x:Bind}" />
                                            </Grid>
                                        </Grid>
                                        </Border>
                                    </Expander.Header>

                                    <Grid
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid
                                            Grid.Row="0"
                                            HorizontalAlignment="Stretch"
                                            ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox
                                                Grid.Column="0"
                                                BeforeTextChanging="ReceivedSkidCountTextBox_BeforeTextChanging"
                                                Header="Skids"
                                                InputScope="Number"
                                                LostFocus="ReceivedSkidCountTextBox_LostFocus"
                                                Tag="{x:Bind}"
                                                Text="{x:Bind ReceivedSkidCount, Mode=OneWay, Converter={StaticResource IntToStringConverter}}"
                                                TextChanged="ReceivedSkidCountTextBox_TextChanged" />

                                            <TextBox
                                                Grid.Column="1"
                                                Header="Qty per Skid"
                                                IsHitTestVisible="False"
                                                IsReadOnly="True"
                                                Tag="{x:Bind}"
                                                Text="{x:Bind QuantityPerSkid, Mode=OneWay, Converter={StaticResource IntToStringConverter}}" />

                                            <TextBox
                                                Grid.Column="2"
                                                FontWeight="SemiBold"
                                                Header="Calculated Piece Count"
                                                IsHitTestVisible="False"
                                                IsReadOnly="True"
                                                Text="{x:Bind CalculatedPieceCountDisplay, Mode=OneWay}" />

                                        </Grid>

                                        <Border
                                            Grid.Row="1"
                                            Padding="12"
                                            HorizontalAlignment="Stretch"
                                            Background="LightSalmon"
                                            BorderBrush="DeepPink"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="{x:Bind HasDiscrepancy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Spacing="10">
                                                <TextBlock FontWeight="SemiBold" Text="Discrepancy Details" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        FontWeight="SemiBold"
                                                        Text="Expected Skids" />
                                                    <TextBlock
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        FontWeight="SemiBold"
                                                        Text="Skids Received" />
                                                    <TextBlock
                                                        Grid.Row="0"
                                                        Grid.Column="2"
                                                        FontWeight="SemiBold"
                                                        Text="Expected Qty" />
                                                    <TextBlock
                                                        Grid.Row="0"
                                                        Grid.Column="3"
                                                        FontWeight="SemiBold"
                                                        Text="Received Qty" />

                                                    <TextBox
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        IsHitTestVisible="False"
                                                        IsReadOnly="True"
                                                        Text="{x:Bind ExpectedSkidCount, Mode=OneWay}" />
                                                    <TextBox
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        IsHitTestVisible="False"
                                                        IsReadOnly="True"
                                                        Text="{x:Bind ReceivedSkidCount, Mode=OneWay}" />
                                                    <TextBox
                                                        Grid.Row="1"
                                                        Grid.Column="2"
                                                        IsHitTestVisible="False"
                                                        IsReadOnly="True"
                                                        Text="{x:Bind ExpectedPieceCount, Mode=OneWay}" />
                                                    <TextBox
                                                        Grid.Row="1"
                                                        Grid.Column="3"
                                                        IsHitTestVisible="False"
                                                        IsReadOnly="True"
                                                        Text="{x:Bind CalculatedPieceCount, Mode=OneWay}" />
                                                </Grid>

                                                <StackPanel Spacing="4">
                                                    <TextBlock FontWeight="SemiBold" Text="Discrepancy Notes" />
                                                    <TextBox
                                                        IsHitTestVisible="False"
                                                        IsReadOnly="True"
                                                        Text="{x:Bind DiscrepancyNote, Mode=OneWay, TargetNullValue=''}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsAutoSaveInProgress, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsAutoSaveInProgress, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>

            <Button Grid.Column="1" Command="{x:Bind ViewModel.CompleteShipmentCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Accept" />
                    <TextBlock Text="Complete Shipment" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
