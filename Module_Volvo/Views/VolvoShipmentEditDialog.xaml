<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Volvo.Views.VolvoShipmentEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:models="using:MTM_Receiving_Application.Module_Volvo.Models"
    x:Name="RootDialog"
    Title="Edit Shipment"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="Save Changes">
    <ContentDialog.Resources>

        <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">960</x:Double>
        <converters:NullableDoubleToDoubleConverter x:Key="NullableDoubleToDoubleConverter" />
        <converters:Converter_BoolToString x:Key="BoolToStringConverter" />
        <converters:Converter_IntToString x:Key="IntToStringConverter" />
        <converters:Converter_InverseBool x:Key="InverseBoolConverter" />
        <converters:Converter_NullableDoubleToString x:Key="NullableDoubleToStringConverter" />
        <converters:Converter_NullableIntToString x:Key="NullableIntToStringConverter" />
    </ContentDialog.Resources>

    <!--  No ScrollViewer - fixed height layout  -->
    <Grid
        x:Name="RootGrid"
        Padding="20"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Row 0: Error/Success Message Bar  -->
        <InfoBar
            x:Name="ValidationErrorBar"
            Grid.Row="0"
            Margin="0,0,0,8"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <!--  Row 1: Shipment Details (Compact 4-column layout)  -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="12"
            RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <CalendarDatePicker
                x:Name="ShipmentDatePicker"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Header="Shipment Date"
                IsEnabled="{x:Bind IsEditableMode, Mode=OneWay}" />

            <TextBox
                x:Name="ShipmentNumberBox"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Header="Shipment #"
                IsReadOnly="True" />

            <TextBox
                x:Name="PONumberBox"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Header="PO Number"
                IsReadOnly="{x:Bind IsReadOnlyMode, Mode=OneWay}"
                PlaceholderText="Optional" />

            <TextBox
                x:Name="ReceiverNumberBox"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                Header="Receiver #"
                IsReadOnly="{x:Bind IsReadOnlyMode, Mode=OneWay}"
                PlaceholderText="Optional" />
        </Grid>

        <!--  Row 1: Notes (Full Width, Compact)  -->
        <TextBox
            x:Name="NotesBox"
            Grid.Row="2"
            Height="60"
            HorizontalAlignment="Stretch"
            AcceptsReturn="True"
            Header="Notes (applies to entire shipment)"
            IsReadOnly="{x:Bind IsReadOnlyMode, Mode=OneWay}"
            PlaceholderText="Optional notes..."
            TextWrapping="Wrap" />

        <!--  Row 3: Parts Section (Main Content)  -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Parts Header with Actions  -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Parts Received" />

                <Button
                    x:Name="ToggleAddPartButton"
                    Grid.Column="2"
                    Height="32"
                    Margin="0,0,8,0"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ActionControlsVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon x:Name="AddPartIcon" Symbol="Add" />
                        <TextBlock x:Name="AddPartButtonText" Text="Add Part" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="RemovePartButton"
                    Grid.Column="3"
                    Height="32"
                    Content="Remove Selected"
                    Visibility="{x:Bind ActionControlsVisibility, Mode=OneWay}" />
            </Grid>

            <!--  Add Part Panel (Collapsible)  -->
            <Border
                x:Name="AddPartPanel"
                Grid.Row="1"
                Margin="0,0,0,8"
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="AddPartErrorMessage"
                        Grid.Row="0"
                        FontWeight="SemiBold"
                        Foreground="Red"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <TextBox
                        x:Name="PartSearchBox"
                        Grid.Row="1"
                        PlaceholderText="Search part numbers..."
                        TabIndex="0"
                        TextChanged="OnPartSearchTextChanged" />

                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="AddPartQuantityBox"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Header="Received Skids"
                            InputScope="Number"
                            PlaceholderText="1-99"
                            TabIndex="2" />

                        <TextBox
                            x:Name="AddPartLocationBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Header="Location"
                            IsReadOnly="True"
                            IsTabStop="False"
                            PlaceholderText="Auto-set from Infor Visual" />
                    </Grid>

                    <TextBlock
                        Grid.Row="3"
                        FontWeight="SemiBold"
                        Text="Available Parts" />

                    <Border
                        Grid.Row="4"
                        Height="170"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ListView
                            x:Name="AddPartListView"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            DisplayMemberPath="PartNumber"
                            SelectionChanged="AddPartListView_SelectionChanged"
                            SelectionMode="Single"
                            TabIndex="1" />
                    </Border>

                    <StackPanel
                        Grid.Row="5"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="ConfirmAddPartButton"
                            Content="Add to List"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="CancelAddPartButton" Content="Cancel" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  DataGrid (Fixed Height, Scrollable)  -->
            <controls:DataGrid
                x:Name="PartsDataGrid"
                Grid.Row="2"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserSortColumns="False"
                GridLinesVisibility="All"
                HorizontalScrollBarVisibility="Auto"
                SelectionMode="Single"
                VerticalScrollBarVisibility="Auto">
                <controls:DataGrid.Columns>
                    <controls:DataGridTemplateColumn Width="*" Header="Part Number">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Model_VolvoShipmentLine">
                                <TextBlock
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind PartNumber, Mode=OneWay}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn
                        Width="Auto"
                        MinWidth="50"
                        Header="Received Skids">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Model_VolvoShipmentLine">
                                <TextBox
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    InputScope="Number"
                                    Text="{x:Bind ReceivedSkidCount, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn
                        Width="Auto"
                        MinWidth="50"
                        Header="Calculated Pieces">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Model_VolvoShipmentLine">
                                <TextBlock
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind CalculatedPieceCount, Mode=OneWay}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn
                        Width="Auto"
                        MinWidth="50"
                        Header="Location">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Model_VolvoShipmentLine">
                                <TextBlock
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Location, Mode=OneWay}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn Width="*" Header="Discrepancy">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Model_VolvoShipmentLine">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button
                                        MinWidth="50"
                                        Click="ReportDiscrepancyButton_Click"
                                        Content="Report"
                                        IsEnabled="{x:Bind HasDiscrepancy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                        Tag="{x:Bind}" />
                                    <Button
                                        MinWidth="50"
                                        Click="ViewDiscrepancyButton_Click"
                                        Content="View"
                                        IsEnabled="{x:Bind HasDiscrepancy, Mode=OneWay}"
                                        Tag="{x:Bind}" />
                                    <Button
                                        MinWidth="50"
                                        Click="RemoveDiscrepancyButton_Click"
                                        Content="Remove"
                                        IsEnabled="{x:Bind HasDiscrepancy, Mode=OneWay}"
                                        Tag="{x:Bind}" />
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!--  Hidden columns for data integrity  -->
                    <controls:DataGridTemplateColumn
                        Width="0"
                        Header="Expected Skids"
                        Visibility="Collapsed">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Model_VolvoShipmentLine">
                                <TextBlock Text="{x:Bind ExpectedSkidCount, Mode=OneWay, Converter={StaticResource NullableDoubleToStringConverter}}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn
                        Width="0"
                        Header="Expected Pieces"
                        Visibility="Collapsed">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Model_VolvoShipmentLine">
                                <TextBlock Text="{x:Bind ExpectedPieceCount, Mode=OneWay, Converter={StaticResource NullableIntToStringConverter}}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn
                        Width="0"
                        Header="Difference"
                        Visibility="Collapsed">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Model_VolvoShipmentLine">
                                <TextBlock Text="{x:Bind PieceDifference, Mode=OneWay, Converter={StaticResource NullableIntToStringConverter}}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn
                        Width="0"
                        Header="Discrepancy Note"
                        Visibility="Collapsed">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Model_VolvoShipmentLine">
                                <TextBlock Text="{x:Bind DiscrepancyNote, Mode=OneWay}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Grid>
    </Grid>
</ContentDialog>
