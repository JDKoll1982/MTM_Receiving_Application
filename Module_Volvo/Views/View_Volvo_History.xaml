<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MTM_Receiving_Application.Module_Volvo.Views.View_Volvo_History"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_Volvo.Models"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.GoBackCommand}"
                ToolTipService.ToolTip="Back to Shipment Entry">
                <SymbolIcon Symbol="Back" />
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{StaticResource VolvoAccentBrush}"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Volvo Shipment History" />
        </StackPanel>

        <!--  Filters (utility ribbon with in-card help)  -->
        <Border
            Grid.Row="1"
            Padding="12,6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CalendarDatePicker
                    Grid.Column="0"
                    Width="200"
                    Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}"
                    Header="Start Date" />

                <CalendarDatePicker
                    Grid.Column="1"
                    Width="200"
                    Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}"
                    Header="End Date" />

                <ComboBox
                    Grid.Column="2"
                    Width="190"
                    Header="Status"
                    ItemsSource="{x:Bind ViewModel.StatusOptions}"
                    SelectedItem="{x:Bind ViewModel.StatusFilter, Mode=TwoWay}" />

                <Button
                    Grid.Column="4"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.FilterCommand}"
                    Content="Filter"
                    Style="{StaticResource AccentButtonStyle}" />

                <Rectangle
                    Grid.Column="5"
                    Width="1"
                    Height="24"
                    Margin="2,0"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Button
                    Grid.Column="6"
                    Width="34"
                    Height="34"
                    Padding="0"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Help"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="OnHelpClick"
                    CornerRadius="4"
                    ToolTipService.ToolTip="Help">
                    <FontIcon FontSize="16" Glyph="&#xE946;" />
                </Button>
            </Grid>
        </Border>

        <!--  DataGrid  -->
        <controls:DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            CanUserReorderColumns="False"
            GridLinesVisibility="Horizontal"
            IsReadOnly="True"
            ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedShipment, Mode=TwoWay}">
            <controls:DataGrid.Columns>
                <controls:DataGridTemplateColumn Width="100" Header="Shipment #">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Model_VolvoShipment">
                            <TextBlock Text="{x:Bind ShipmentNumber, Mode=OneTime}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn Width="120" Header="Date">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Model_VolvoShipment">
                            <TextBlock Text="{x:Bind ShipmentDateDisplay, Mode=OneTime}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn Width="120" Header="PO Number">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Model_VolvoShipment">
                            <TextBlock Text="{x:Bind PONumber, Mode=OneTime}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn Width="120" Header="Receiver">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Model_VolvoShipment">
                            <TextBlock Text="{x:Bind ReceiverNumber, Mode=OneTime}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn Width="120" Header="Status">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Model_VolvoShipment">
                            <TextBlock Text="{x:Bind StatusDisplay, Mode=OneTime}" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn Width="*" Header="Notes">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Model_VolvoShipment">
                            <TextBlock Text="{x:Bind Notes, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!--  Status Bar  -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Spacing="12">
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            <Button
                Margin="12,0,0,0"
                Command="{x:Bind ViewModel.ViewDetailCommand}"
                Content="View Details" />
            <Button Command="{x:Bind ViewModel.EditCommand}" Content="Edit" />
            <Button Command="{x:Bind ViewModel.DeleteCommand}" Content="Delete">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Delete" />
                </Button.KeyboardAccelerators>
            </Button>
        </StackPanel>
    </Grid>
</Page>
