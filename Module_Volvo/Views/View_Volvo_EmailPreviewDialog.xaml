<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Volvo.Views.View_Volvo_EmailPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
    Width="1100"
    CloseButtonText="Close"
    DefaultButton="Primary"
    PrimaryButtonText="Copy Email Body"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />        
            <x:Double x:Key="ContentDialogMaxWidth">1600</x:Double>
            <x:Double x:Key="ContentDialogMinWidth">900</x:Double>
            <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
        </ContentDialog.Resources>

    <Grid MaxWidth="1200">
        <ScrollViewer MaxHeight="720" Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
            <StackPanel Spacing="12">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" ColumnSpacing="8" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>                        
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        HorizontalTextAlignment="Right"
                        VerticalAlignment="Center"
                        Text="To:" />
                    <TextBox
                        Grid.Column="1"
                        TextAlignment="Left"
                        VerticalAlignment="Center"
                        MaxHeight="40"
                        IsReadOnly="True"
                        Text="{x:Bind ViewModel.ToRecipients, Mode=OneWay}"
                        TextWrapping="Wrap"/>
                    <Button
                        Grid.Column="2"
                        Width="38"
                        Height="32"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.CopyToRecipientsCommand}"
                        Content="🗐" />
                </Grid>

                <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" ColumnSpacing="8" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        HorizontalTextAlignment="Right"
                        VerticalAlignment="Center"
                        Text="CC:" />
                    
                    <TextBox
                        Grid.Column="1"
                        TextAlignment="Left"
                        VerticalAlignment="Center"
                        MaxHeight="40"
                        IsReadOnly="True"
                        Text="{x:Bind ViewModel.CcRecipients, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <Button
                        Grid.Column="2"
                        Width="38"
                        Height="32"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.CopyCcRecipientsCommand}"
                        Content="🗐" />
                </Grid>

                <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" ColumnSpacing="8" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        HorizontalTextAlignment="Right"
                        VerticalAlignment="Center"
                        Text="Subject:" />

                    <TextBox
                        Grid.Column="1"
                        TextAlignment="Left"
                        VerticalAlignment="Center"
                        MaxHeight="40"
                        IsReadOnly="True"
                        Text="{x:Bind ViewModel.Subject, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <Button
                        Grid.Column="2"
                        Width="38"
                        Height="32"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.CopySubjectCommand}"
                        Content="🗐" />
                </Grid>

                <TextBlock
                    Margin="0,8,0,4"
                    FontWeight="Bold"
                    Text="Email Body Preview:" />

                <Border MaxHeight="400" MinHeight="300"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                        <Grid>
                            <controls:WebView2
                            x:Name="EmailBodyPreview"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

                            <TextBox
                            x:Name="EmailBodyFallbackBox"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.PlainTextPreview, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        </Grid>
                </Border>

                <TextBox
                    Height="60"
                    AcceptsReturn="True"
                    Header="Additional Notes:"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.AdditionalNotes, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasAdditionalNotes, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
