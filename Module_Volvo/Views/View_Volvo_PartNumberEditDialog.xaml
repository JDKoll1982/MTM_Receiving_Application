<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Volvo.Views.View_Volvo_PartNumberEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:models="using:MTM_Receiving_Application.Module_Volvo.Models"
    Title="Change Part Number"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="Save">
    <ContentDialog.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
    </ContentDialog.Resources>
    <StackPanel Width="440" Spacing="12">
        <TextBlock Text="Select a replacement part number for this card." TextWrapping="WrapWholeWords" />
        <TextBlock
            Foreground="Red"
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            TextWrapping="WrapWholeWords"
            Visibility="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <TextBox
            x:Name="SearchTextBox"
            Header="Search"
            PlaceholderText="Search part numbers..."
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <ListView
            x:Name="PartsListView"
            Height="280"
            ItemsSource="{x:Bind ViewModel.FilteredParts, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedPart, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Model_VolvoPart">
                    <StackPanel Padding="8" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind PartNumber, Mode=OneTime}" />
                        <TextBlock
                            Opacity="0.75"
                            Text="{x:Bind Description, Mode=OneTime, TargetNullValue=(No Description)}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
