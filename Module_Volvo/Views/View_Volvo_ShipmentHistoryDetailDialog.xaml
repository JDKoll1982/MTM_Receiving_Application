<Page
    x:Class="MTM_Receiving_Application.Module_Volvo.Views.View_Volvo_ShipmentHistoryDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_Volvo.Models"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_InverseBooleanToVisibility x:Key="InverseBooleanToVisibilityConverter" />
        <converters:Converter_IntToString x:Key="IntToStringConverter" />
        <converters:Converter_NullableDoubleToString x:Key="NullableDoubleToStringConverter" />
        <converters:Converter_NullableIntToString x:Key="NullableIntToStringConverter" />
        <converters:Converter_VolvoDiscrepancyBorderBrush x:Key="VolvoDiscrepancyBorderBrushConverter" />
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="40"
            Background="Transparent">
            <TextBlock
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Volvo Shipment Details" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,16,24,24" Spacing="16">
                <Border
                    Padding="20"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.WindowTitle, Mode=OneWay}" />
                                <TextBlock Opacity="0.75" Text="Read-only shipment detail from the Volvo history archive." />
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Padding="10,4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Shipment.StatusDisplay, Mode=OneWay}" />
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBox
                                Grid.Row="0"
                                Grid.Column="0"
                                Header="Shipment #"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.Shipment.ShipmentNumber, Mode=OneWay, Converter={StaticResource IntToStringConverter}}" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Header="Shipment Date"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.Shipment.ShipmentDateDisplay, Mode=OneWay}" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="2"
                                Header="Employee #"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.Shipment.EmployeeNumber, Mode=OneWay}" />

                            <TextBox
                                Grid.Row="1"
                                Grid.Column="0"
                                Header="PO Number"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.Shipment.PONumber, Mode=OneWay}" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Header="Receiver #"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.Shipment.ReceiverNumber, Mode=OneWay}" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="2"
                                Header="History State"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.LineSummaryText, Mode=OneWay}" />
                        </Grid>

                        <TextBox
                            MinHeight="72"
                            Header="Notes"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.Shipment.Notes, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock
                    HorizontalAlignment="Center"
                    Opacity="0.7"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="No archived lines were found for this shipment."
                    Visibility="{x:Bind ViewModel.HasLines, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                <ItemsControl
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasLines, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Model_VolvoShipmentLine">
                            <Border
                                Margin="0,0,0,12"
                                Padding="20"
                                BorderBrush="{x:Bind HasDiscrepancy, Mode=OneWay, Converter={StaticResource VolvoDiscrepancyBorderBrushConverter}}"
                                BorderThickness="2"
                                CornerRadius="12">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind PartNumber, Mode=OneWay}" />
                                            <TextBlock Text="-" />
                                            <TextBlock Text="{x:Bind PartDescriptionDisplay, Mode=OneWay}" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="1"
                                            Padding="8,4"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind PoStatus, Mode=OneWay}" />
                                        </Border>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            Grid.Column="0"
                                            Header="Skids"
                                            IsReadOnly="True"
                                            Text="{x:Bind ReceivedSkidCount, Mode=OneWay, Converter={StaticResource IntToStringConverter}}" />
                                        <TextBox
                                            Grid.Column="1"
                                            Header="Qty per Skid"
                                            IsReadOnly="True"
                                            Text="{x:Bind QuantityPerSkid, Mode=OneWay, Converter={StaticResource IntToStringConverter}}" />
                                        <TextBox
                                            Grid.Column="2"
                                            Header="Calculated Piece Count"
                                            IsReadOnly="True"
                                            Text="{x:Bind CalculatedPieceCountDisplay, Mode=OneWay}" />
                                        <TextBox
                                            Grid.Column="3"
                                            Header="Location"
                                            IsReadOnly="True"
                                            Text="{x:Bind Location, Mode=OneWay}" />
                                    </Grid>

                                    <Border
                                        Padding="12"
                                        Background="LightSalmon"
                                        BorderBrush="DeepPink"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="{x:Bind HasDiscrepancy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Spacing="10">
                                            <TextBlock FontWeight="SemiBold" Text="Discrepancy Details" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    FontWeight="SemiBold"
                                                    Text="Expected Skids" />
                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    FontWeight="SemiBold"
                                                    Text="Skids Received" />
                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="2"
                                                    FontWeight="SemiBold"
                                                    Text="Expected Qty" />
                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="3"
                                                    FontWeight="SemiBold"
                                                    Text="Received Qty" />

                                                <TextBox
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    IsReadOnly="True"
                                                    Text="{x:Bind ExpectedSkidCount, Mode=OneWay, Converter={StaticResource NullableDoubleToStringConverter}}" />
                                                <TextBox
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    IsReadOnly="True"
                                                    Text="{x:Bind ReceivedSkidCount, Mode=OneWay, Converter={StaticResource IntToStringConverter}}" />
                                                <TextBox
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    IsReadOnly="True"
                                                    Text="{x:Bind ExpectedPieceCount, Mode=OneWay, Converter={StaticResource NullableIntToStringConverter}}" />
                                                <TextBox
                                                    Grid.Row="1"
                                                    Grid.Column="3"
                                                    IsReadOnly="True"
                                                    Text="{x:Bind CalculatedPieceCount, Mode=OneWay, Converter={StaticResource IntToStringConverter}}" />
                                            </Grid>

                                            <TextBox
                                                MinHeight="56"
                                                Header="Discrepancy Notes"
                                                IsReadOnly="True"
                                                Text="{x:Bind DiscrepancyNote, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="24,0,24,24">
            <Button
                MinWidth="120"
                HorizontalAlignment="Right"
                Click="CloseButton_Click"
                Content="Close" />
        </Grid>
    </Grid>
</Page>
