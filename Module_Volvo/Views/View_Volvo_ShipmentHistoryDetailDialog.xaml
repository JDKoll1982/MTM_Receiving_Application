<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Volvo.Views.View_Volvo_ShipmentHistoryDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
    Width="760"
    CloseButtonText="Close"
    DefaultButton="Close"
    mc:Ignorable="d">
    <Grid>
        <ScrollViewer MaxHeight="500" Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
            <TextBlock
                FontFamily="Consolas"
                Text="{x:Bind ViewModel.DetailText, Mode=OneWay}"
                TextWrapping="Wrap" />
        </ScrollViewer>
    </Grid>
</ContentDialog>
