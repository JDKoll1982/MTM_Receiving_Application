<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MTM_Receiving_Application.Module_VisualAutomation.Views.View_VisualAutomation_MacroTester"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_VisualAutomation.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_VisualAutomation.Models"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:Converter_VisualMacroStatusToBrush x:Key="StatusToBrushConverter" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Target + commands  -->
        <Border
            Grid.Row="0"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Infor VISUAL Macro Tester" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Performs the same field reads and writes a VISUAL macro would, directly against the live Purchase Receipt Entry window. No macro file is deployed or executed, and nothing is saved - the VISUAL Save button is never pressed."
                    TextWrapping="Wrap" />

                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.TargetSummary, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.SnapshotSummary, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RefreshTargetCommand}" Content="Check VISUAL window" />
                    <Button
                        Command="{x:Bind ViewModel.RunSelectedCommand}"
                        Content="Run selected probes"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button Command="{x:Bind ViewModel.CancelRunCommand}" Content="Stop" />
                    <Button Command="{x:Bind ViewModel.ResetCommand}" Content="Reset" />
                    <Button
                        Width="40"
                        Height="34"
                        Padding="0"
                        AutomationProperties.Name="Probe details"
                        Click="OnDetailsClick"
                        ToolTipService.ToolTip="Probe details">
                        <FontIcon FontSize="16" Glyph="&#xE946;" />
                    </Button>
                    <Button
                        Width="40"
                        Height="34"
                        Padding="0"
                        AutomationProperties.Name="Field values sent to VISUAL"
                        Click="OnInputsClick"
                        ToolTipService.ToolTip="Field values sent to VISUAL">
                        <FontIcon FontSize="16" Glyph="&#xE70F;" />
                    </Button>
                </StackPanel>

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.InputsSummary, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  Live instruction  -->
        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind ViewModel.InstructionText, Mode=OneWay}"
            Severity="Informational" />

        <!--  Probe cards - each one its own collapsible panel, collapsed by default  -->
        <ListView
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Probes}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Model_VisualProbeCard">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Expander
                            Padding="16,10,16,16"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="False">
                            <Expander.Header>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        Grid.Column="0"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Include this probe in the next run"
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Category}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="•" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind WindowImpactLabel}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="•" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Id}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border
                                        Grid.Column="2"
                                        Padding="10,3"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="10">
                                        <TextBlock
                                            Foreground="White"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind StatusText, Mode=OneWay}" />
                                    </Border>
                                </Grid>
                            </Expander.Header>

                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="On the VISUAL window" />
                                    <TextBlock
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind UiSteps}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="What it proves" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind Purpose}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Expected result" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind Expected}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Button
                                    HorizontalAlignment="Right"
                                    Command="{x:Bind RunCommand, Mode=OneWay}"
                                    CommandParameter="{x:Bind}"
                                    Content="Run this probe" />
                            </StackPanel>
                        </Expander>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
