<Page
    x:Class="MTM_Receiving_Application.Module_Scanner.Views.View_Scanner_Main"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid
        x:Name="ScannerMainRootGrid"
        Margin="16,0,16,16"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <ContentControl
            x:Name="WorkbenchHost"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="{x:Bind ViewModel.IsWorkbenchVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <ContentControl
            x:Name="HistoryHost"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="{x:Bind ViewModel.IsHistoryVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <ContentControl
            x:Name="SettingsHost"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="{x:Bind ViewModel.IsSettingsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Button
            Width="36"
            Height="36"
            Margin="0,8,16,0"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.Name="Help"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Click="OnHelpClick"
            CornerRadius="4"
            ToolTipService.ToolTip="Help">
            <FontIcon FontSize="16" Glyph="&#xE946;" />
        </Button>
    </Grid>
</Page>
