<Page
    x:Class="MTM_Receiving_Application.Module_Scanner.Views.View_Scanner_Workbench"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:models="using:MTM_Receiving_Application.Module_Scanner.Models"
    xmlns:sharedControls="using:MTM_Receiving_Application.Module_Shared.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_ValidationStatusToBrush x:Key="ValidationStatusToBrushConverter" />
        <Style x:Key="ScannerSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="ScannerActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="ScannerPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid x:Name="WorkbenchRootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Non-blocking header error area (ScannerUpdate.md Step 6b-a2) -->
        <InfoBar
            x:Name="HeaderErrorBar"
            Grid.Row="0"
            Margin="16,8,16,0"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsHeaderErrorVisible, Mode=OneWay}"
            Message="{x:Bind ViewModel.HeaderErrorText, Mode=OneWay}"
            Severity="Error" />

        <Grid
            Grid.Row="1"
            Padding="16"
            ColumnSpacing="16"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Entry form: part/location lookup (fills the row) -->
            <Grid>
                <sharedControls:Control_Shared_TypedLookupTextBox
                    x:Name="PartIdLookupControl"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{x:Bind ViewModel.IsPartEditable, Mode=OneWay}"
                    AutoResolveFuzzyMatches="False"
                    HeaderText="{x:Bind ViewModel.LookupHeaderText, Mode=OneWay}"
                    InputValue="{x:Bind ViewModel.NewPartId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    LookupType="{x:Bind ViewModel.LookupType, Mode=OneWay}"
                    PlaceholderText="{x:Bind ViewModel.LookupPlaceholderText, Mode=OneWay}"
                    ValidationCompleted="PartIdLookupControl_ValidationCompleted" />
            </Grid>

            <!-- Current list -->
            <Grid Grid.Row="1" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Right padding matches the row items' right inset so header columns stay\n                     aligned with the row content. -->
                <Grid Padding="0,0,14,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" />
                    <TextBlock Grid.Column="1" Text="Part" />
                    <TextBlock Grid.Column="2" Text="From" />
                    <TextBlock Grid.Column="3" Text="To" />
                    <TextBlock Grid.Column="4" Text="Qty" />
                    <TextBlock Grid.Column="5" Text="Status" VerticalAlignment="Center" />
                </Grid>
                <ListView
                    x:Name="SessionItemsListView"
                    Grid.Row="1"
                    VerticalAlignment="Stretch"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ItemsSource="{x:Bind ViewModel.SessionItems, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedSessionItem, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Model_ScannerBatchItem">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.5*" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind SequenceNumber}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind PayloadPartId}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind PayloadFromLocation}" VerticalAlignment="Center" />
                                <TextBox
                                    Grid.Column="3"
                                    Tag="ToCell"
                                    PlaceholderText="To"
                                    Text="{x:Bind PayloadToLocation, Mode=TwoWay}"
                                    LostFocus="SessionItemToTextBox_LostFocus"
                                    KeyDown="SessionItemTextBox_KeyDown"
                                    VerticalAlignment="Center" />
                                <TextBox
                                    Grid.Column="4"
                                    Tag="QtyCell"
                                    PlaceholderText="Qty"
                                    Text="{x:Bind PayloadQuantity, Mode=TwoWay}"
                                    BeforeTextChanging="SessionItemQtyTextBox_BeforeTextChanging"
                                    LostFocus="SessionItemQtyTextBox_LostFocus"
                                    KeyDown="SessionItemTextBox_KeyDown"
                                    VerticalAlignment="Center" />

                                <!--  Status - colored icon opens the explainer modal  -->
                                <Button
                                    Grid.Column="5"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="StatusIconButton_Click"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind StatusText}">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{x:Bind StatusIsValid, Converter={StaticResource ValidationStatusToBrushConverter}}"
                                        Glyph="&#xE946;" />
                                </Button>

                                <!--  Add-lines split button  -->
                                <SplitButton
                                    Grid.Column="6"
                                    Width="30"
                                    Height="30"
                                    Margin="2,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="AddLinesSplitButton_Click"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Add lines of this part">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                    <SplitButton.Flyout>
                                        <Flyout>
                                            <StackPanel MinWidth="220" Padding="6" Spacing="10">
                                                <TextBlock
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="Add additional lines" />
                                                <NumberBox
                                                    Minimum="1"
                                                    Maximum="100"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Compact"
                                                    Header="How many additional lines?"
                                                    Value="1" />
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    Click="AddLinesConfirmButton_Click"
                                                    Content="Add Lines"
                                                    Style="{StaticResource ScannerPrimaryActionButtonStyle}" />
                                            </StackPanel>
                                        </Flyout>
                                    </SplitButton.Flyout>
                                </SplitButton>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <!-- Stretch + right padding so row columns line up with the header
                                 grid (ListViewItem defaults to left-aligned content) and the last
                                 column clears the ListView's right-edge scrollbar gutter. -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,2,14,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Grid>

        <!-- Footer action bar (ribbon card) -->
        <Border
            Grid.Row="2"
            Margin="16,0,16,12"
            Padding="10,6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Left: batch actions (icon-only)  -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <Button
                            Width="34"
                            Height="34"
                            MinWidth="0"
                            Padding="0"
                            Style="{StaticResource ScannerActionButtonStyle}"
                            Command="{x:Bind ViewModel.CheckAllCommand}"
                            ToolTipService.ToolTip="Check all">
                            <FontIcon FontSize="16" Glyph="&#xE8B3;" />
                        </Button>
                        <Button
                            Width="34"
                            Height="34"
                            MinWidth="0"
                            Padding="0"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SendSelectedCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SendButtonText, Mode=OneWay}">
                            <FontIcon FontSize="16" Glyph="&#xE724;" />
                        </Button>

                        <Rectangle
                            Width="1"
                            Height="24"
                            Margin="2,0"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Button
                            Width="34"
                            Height="34"
                            MinWidth="0"
                            Padding="0"
                            Style="{StaticResource ScannerActionButtonStyle}"
                            Command="{x:Bind ViewModel.ClearListCommand}"
                            ToolTipService.ToolTip="Clear list">
                            <FontIcon FontSize="16" Glyph="&#xE711;" />
                        </Button>
                        <Button
                            Width="34"
                            Height="34"
                            MinWidth="0"
                            Padding="0"
                            Style="{StaticResource ScannerActionButtonStyle}"
                            Command="{x:Bind ViewModel.OpenInventoryCommand}"
                            ToolTipService.ToolTip="Open inventory">
                            <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                        </Button>
                        <Button
                            Width="34"
                            Height="34"
                            MinWidth="0"
                            Padding="0"
                            Style="{StaticResource ScannerActionButtonStyle}"
                            Command="{x:Bind ViewModel.ExportCommand}"
                            ToolTipService.ToolTip="Export">
                            <FontIcon FontSize="16" Glyph="&#xE74E;" />
                        </Button>
                        <Button
                            Width="34"
                            Height="34"
                            MinWidth="0"
                            Padding="0"
                            Style="{StaticResource ScannerActionButtonStyle}"
                            Command="{x:Bind ViewModel.ManageItemsDialogCommand}"
                            ToolTipService.ToolTip="Manage items">
                            <FontIcon FontSize="16" Glyph="&#xE70F;" />
                        </Button>
                    </StackPanel>

                    <!--  Right: search-by toggle, remove selected (red), help  -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Rectangle
                            Width="1"
                            Height="24"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock VerticalAlignment="Center" Text="Search By:" />
                        <ToggleSwitch
                            MinWidth="0"
                            VerticalAlignment="Center"
                            OffContent="Part"
                            OnContent="Location"
                            IsOn="{x:Bind ViewModel.IsLocationModeEnabled, Mode=TwoWay}" />
                        <Button
                            Height="34"
                            Padding="14,0"
                            VerticalAlignment="Center"
                            Background="#C42B1C"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.RemoveSelectedSessionItemCommand}"
                            Content="Remove Selected"
                            CornerRadius="4"
                            Foreground="White"
                            IsEnabled="{x:Bind ViewModel.HasSelectedSessionItem, Mode=OneWay}" />
                        <Rectangle
                            Width="1"
                            Height="24"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button
                            Width="34"
                            Height="34"
                            MinWidth="0"
                            Padding="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Help"
                            Style="{StaticResource ScannerActionButtonStyle}"
                            Click="OnHelpClick"
                            ToolTipService.ToolTip="Help">
                            <FontIcon FontSize="16" Glyph="&#xE946;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Saved? manual confirmation row -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="{x:Bind ViewModel.IsSendPromptVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Was the transaction saved in Infor Visual?" />
                    <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.ConfirmSavedCommand}" Content="Yes" />
                    <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.ConfirmNotSavedCommand}" Content="No" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
