<Page
    x:Class="MTM_Receiving_Application.Module_Scanner.Views.View_Scanner_Workbench"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:models="using:MTM_Receiving_Application.Module_Scanner.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ScannerSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="ScannerActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="ScannerPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="ScannerChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollMode="Auto"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Padding="16"
                ColumnSpacing="16"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="16"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    CornerRadius="8">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Scanner" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Prepare items and send them to inventory." />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Padding="14,7"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <TextBlock Style="{StaticResource ScannerChipTextStyle}" Text="System: Ready" />
                        </Border>
                        <Border
                            Grid.Column="2"
                            Padding="14,7"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="8">
                            <TextBlock Style="{StaticResource ScannerChipTextStyle}" Text="Stop: Between Items" />
                        </Border>
                    </Grid>
                </Border>

                <Grid
                    Grid.Row="1"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="12"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="8">
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Row="0"
                                Grid.Column="0"
                                Header="Session Owner"
                                Text="{x:Bind ViewModel.OwnerUserId, Mode=TwoWay}" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Header="Display Name"
                                Text="{x:Bind ViewModel.OwnerDisplayName, Mode=TwoWay}" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="2"
                                Header="Target Window"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.AppWindowTitleSnapshot, Mode=TwoWay}" />
                            <Button
                                Grid.Row="0"
                                Grid.Column="3"
                                Style="{StaticResource ScannerActionButtonStyle}"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.StartDraftSessionCommand}"
                                Content="Start Draft" />
                            <Button
                                Grid.Row="0"
                                Grid.Column="4"
                                Style="{StaticResource ScannerActionButtonStyle}"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.BuildRunSnapshotCommand}"
                                Content="Save For Later" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Session Active"
                                Visibility="{x:Bind ViewModel.HasActiveSession, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="12"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="8">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Validation" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.LastValidationStatus, Mode=OneWay}" />
                            <TextBlock TextWrapping="Wrap" Text="{x:Bind ViewModel.LastValidationNotes, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid
                    Grid.Row="2"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="12"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="8">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ScannerSectionHeaderStyle}" Text="Items To Send" />
                                <Button
                                    Grid.Column="1"
                                    Style="{StaticResource ScannerActionButtonStyle}"
                                    Command="{x:Bind ViewModel.ManageItemsCommand}"
                                    Content="Manage Items" />
                            </Grid>

                            <Grid
                                Grid.Row="1"
                                ColumnSpacing="10"
                                RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    Grid.Column="0"
                                    Header="Part"
                                    LostFocus="PartTextBox_LostFocus"
                                    Text="{x:Bind ViewModel.NewPartId, Mode=TwoWay}" />
                                <TextBox Grid.Column="1" Header="From WH" Text="{x:Bind ViewModel.NewFromWarehouse, Mode=TwoWay}" />
                                <TextBox Grid.Column="2" Header="From Loc" Text="{x:Bind ViewModel.NewFromLocation, Mode=TwoWay}" />
                                <TextBox Grid.Column="3" Header="To WH" Text="{x:Bind ViewModel.NewToWarehouse, Mode=TwoWay}" />
                                <TextBox Grid.Column="4" Header="To Loc" Text="{x:Bind ViewModel.NewToLocation, Mode=TwoWay}" />
                                <TextBox Grid.Column="5" Header="Qty" Text="{x:Bind ViewModel.NewQuantity, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="6"
                                    Style="{StaticResource ScannerActionButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.AddDraftItemCommand}"
                                    Content="Add" />
                            </Grid>

                            <ListView
                                Grid.Row="2"
                                ItemsSource="{x:Bind ViewModel.SessionItems, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedSessionItem, Mode=TwoWay}">
                                <ListView.Header>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.5*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="#" />
                                        <TextBlock Grid.Column="1" Text="Part" />
                                        <TextBlock Grid.Column="2" Text="From WH" />
                                        <TextBlock Grid.Column="3" Text="From Loc" />
                                        <TextBlock Grid.Column="4" Text="To WH" />
                                        <TextBlock Grid.Column="5" Text="To Loc" />
                                        <TextBlock Grid.Column="6" Text="Qty" />
                                        <TextBlock Grid.Column="7" Text="State" />
                                        <TextBlock Grid.Column="8" Text="Notes" />
                                        <TextBlock Grid.Column="9" Text="Execution" />
                                    </Grid>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Model_ScannerBatchItem">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.5*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind SequenceNumber}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind PayloadPartId}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind PayloadFromWarehouse}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind PayloadFromLocation}" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind PayloadToWarehouse}" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind PayloadToLocation}" />
                                            <TextBlock Grid.Column="6" Text="{x:Bind PayloadQuantity}" />
                                            <TextBlock Grid.Column="7" Text="{x:Bind ValidationState}" />
                                            <TextBlock Grid.Column="8" Text="{x:Bind ValidationNotes}" TextWrapping="WrapWholeWords" />
                                            <TextBlock Grid.Column="9" Text="{x:Bind ExecutionState}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="12"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="8">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource ScannerSectionHeaderStyle}" Text="Item Details" />

                            <TextBox
                                Grid.Row="1"
                                Header="Part ID"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.SelectedSessionItem.PayloadPartId, Mode=OneWay}" />

                            <Grid Grid.Row="2" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    Header="From Warehouse"
                                    IsReadOnly="True"
                                    Text="{x:Bind ViewModel.SelectedSessionItem.PayloadFromWarehouse, Mode=OneWay}" />
                                <TextBox
                                    Grid.Column="1"
                                    Header="From Location"
                                    IsReadOnly="True"
                                    Text="{x:Bind ViewModel.SelectedSessionItem.PayloadFromLocation, Mode=OneWay}" />
                            </Grid>

                            <Grid Grid.Row="3" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    Header="To Warehouse"
                                    IsReadOnly="True"
                                    Text="{x:Bind ViewModel.SelectedSessionItem.PayloadToWarehouse, Mode=OneWay}" />
                                <TextBox
                                    Grid.Column="1"
                                    Header="To Location"
                                    IsReadOnly="True"
                                    Text="{x:Bind ViewModel.SelectedSessionItem.PayloadToLocation, Mode=OneWay}" />
                            </Grid>

                            <TextBox
                                Grid.Row="4"
                                Header="Issues"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.SelectedSessionItem.ValidationNotes, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <Grid Grid.Row="5" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Padding="10"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Sent" />
                                        <TextBlock FontSize="18" Text="{x:Bind ViewModel.CurrentSession.SentItems, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Padding="10"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Failed" />
                                        <TextBlock FontSize="18" Text="{x:Bind ViewModel.CurrentSession.FailedItems, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Grid.Column="2"
                                    Padding="10"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Waiting" />
                                        <TextBlock FontSize="18" Text="{x:Bind ViewModel.CurrentSession.WaitingItems, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border
                                Grid.Row="6"
                                Padding="10,8"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                CornerRadius="6">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Stops work between items only." />
                            </Border>

                            <TextBlock
                                Grid.Row="7"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="User manually validates and saves in ERP after send." />
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Margin="16,0,16,12"
            Padding="12"
            Background="{ThemeResource LayerFillColorAltBrush}"
            CornerRadius="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.CheckAllCommand}" Content="Check All" />
                <Button Grid.Column="1" Style="{StaticResource ScannerPrimaryActionButtonStyle}" Command="{x:Bind ViewModel.SendNextCommand}" Content="Send Next" />
                <Button Grid.Column="2" Style="{StaticResource ScannerPrimaryActionButtonStyle}" Command="{x:Bind ViewModel.SendAllCommand}" Content="Send All" />
                <Button Grid.Column="3" Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.StopAfterThisCommand}" Content="Stop After This" />
                <Button Grid.Column="4" Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.ClearHistoryCommand}" Content="Clear History" />
                <Button Grid.Column="5" Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.ExportCommand}" Content="Export" />
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Padding="24,12,24,16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.NavigateToWorkbenchCommand}" Content="Workbench" />
                <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.NavigateToHistoryCommand}" Content="History" />
                <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.NavigateToSettingsCommand}" Content="Settings" />
            </StackPanel>
        </Border>
    </Grid>
</Page>