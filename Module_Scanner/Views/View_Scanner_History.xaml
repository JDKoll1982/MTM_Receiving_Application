<Page
    x:Class="MTM_Receiving_Application.Module_Scanner.Views.View_Scanner_History"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MTM_Receiving_Application.Module_Scanner.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ScannerSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="ScannerActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Filter ribbon card  -->
        <Border
            Grid.Row="0"
            Padding="16,12"
            Margin="0,0,0,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CalendarDatePicker
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Header="From"
                    Date="{x:Bind ViewModel.DateFromUtc, Mode=TwoWay}" />
                <CalendarDatePicker
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Header="To"
                    Date="{x:Bind ViewModel.DateToUtc, Mode=TwoWay}" />
                <ComboBox
                    Grid.Column="2"
                    MinWidth="150"
                    Header="Status"
                    ItemsSource="{x:Bind ViewModel.StatusOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.StatusFilter, Mode=TwoWay}" />

                <Button
                    Grid.Column="3"
                    Width="34"
                    Height="34"
                    MinWidth="0"
                    Padding="0"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource ScannerActionButtonStyle}"
                    Command="{x:Bind ViewModel.RefreshHistoryCommand}"
                    ToolTipService.ToolTip="Refresh">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>
                <Button
                    Grid.Column="4"
                    Width="34"
                    Height="34"
                    MinWidth="0"
                    Padding="0"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource ScannerActionButtonStyle}"
                    Command="{x:Bind ViewModel.ClearFiltersCommand}"
                    ToolTipService.ToolTip="Clear filters">
                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                </Button>

                <!--  Help  -->
                <StackPanel
                    Grid.Column="5"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Rectangle
                        Width="1"
                        Height="24"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button
                        Width="34"
                        Height="34"
                        MinWidth="0"
                        Padding="0"
                        AutomationProperties.Name="Help"
                        Style="{StaticResource ScannerActionButtonStyle}"
                        Click="OnHelpClick"
                        ToolTipService.ToolTip="Help">
                        <FontIcon FontSize="16" Glyph="&#xE946;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                Grid.Column="0"
                ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Model_ScannerHistoryEntry">
                        <StackPanel Spacing="4" Padding="4">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind SessionName}" />
                            <TextBlock Opacity="0.7" Text="{x:Bind FinalStatus}" />
                            <TextBlock Opacity="0.7" Text="{x:Bind CreatedUtc}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView
                Grid.Column="1"
                Header="Items"
                ItemsSource="{x:Bind ViewModel.SelectedEntryItems, Mode=OneWay}"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Model_ScannerHistoryItem">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind SequenceNumber}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind PartId}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind FromLocation}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind ToLocation}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
