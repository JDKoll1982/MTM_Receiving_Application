<Page
    x:Class="MTM_Receiving_Application.Module_Scanner.Views.View_Scanner_History"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MTM_Receiving_Application.Module_Scanner.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="ScannerSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="ScannerActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollMode="Auto"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Padding="16"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="16"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="History" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="See what was sent and retry items that failed." />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Padding="12"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    CornerRadius="8">
                    <Grid ColumnSpacing="10" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" Style="{StaticResource ScannerSectionHeaderStyle}" Text="Filters" />

                        <TextBox Grid.Row="1" Grid.Column="0" Header="Owner User" Text="{x:Bind ViewModel.OwnerUserId, Mode=TwoWay}" />
                        <DatePicker Grid.Row="1" Grid.Column="1" Header="Date From" Date="{x:Bind ViewModel.DateFromUtc, Mode=TwoWay}" />
                        <DatePicker Grid.Row="1" Grid.Column="2" Header="Date To" Date="{x:Bind ViewModel.DateToUtc, Mode=TwoWay}" />
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="3"
                            Header="Status"
                            ItemsSource="{x:Bind ViewModel.StatusOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.StatusFilter, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Row="1"
                            Grid.Column="4"
                            Header="Max"
                            Minimum="1"
                            Value="{x:Bind ViewModel.MaxResults, Mode=TwoWay}" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="5"
                            Style="{StaticResource ScannerActionButtonStyle}"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.RefreshHistoryCommand}"
                            Content="Apply" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="6"
                            Style="{StaticResource ScannerActionButtonStyle}"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.ClearFiltersCommand}"
                            Content="Clear" />
                    </Grid>
                </Border>

                <Grid
                    Grid.Row="2"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="10"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="8">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource ScannerSectionHeaderStyle}" Text="Send History" />
                            <ListView
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.Runs, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedRun, Mode=TwoWay}">
                                <ListView.Header>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Time" />
                                        <TextBlock Grid.Column="1" Text="Status" />
                                        <TextBlock Grid.Column="2" Text="Sent" />
                                        <TextBlock Grid.Column="3" Text="Fail" />
                                        <TextBlock Grid.Column="4" Text="Waiting" />
                                    </Grid>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Model_ScannerRun">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="0.9*" />
                                                <ColumnDefinition Width="0.9*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind StartedUtc}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind FinalStatus}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind SentItems}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind FailedItems}" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind WaitingItems}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="10"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="8">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource ScannerSectionHeaderStyle}" Text="Details" />

                            <Border
                                Grid.Row="1"
                                Padding="10"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="6">
                                <StackPanel Spacing="4">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Selected Run" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedRun.OwnerDisplayName, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedRun.OwnerUserId, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedRun.FailureSummary, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="2"
                                Padding="10"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="6">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="History details are read-only and support retry decisions in workbench." />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border
                    Grid.Row="3"
                    Padding="10"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    CornerRadius="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource ScannerSectionHeaderStyle}" Text="Item Results" />

                        <ListView
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.SelectedRunItems, Mode=OneWay}">
                            <ListView.Header>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.5*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" />
                                    <TextBlock Grid.Column="1" Text="Item ID" />
                                    <TextBlock Grid.Column="2" Text="From WH" />
                                    <TextBlock Grid.Column="3" Text="From Loc" />
                                    <TextBlock Grid.Column="4" Text="To WH" />
                                    <TextBlock Grid.Column="5" Text="To Loc" />
                                    <TextBlock Grid.Column="6" Text="Status" />
                                    <TextBlock Grid.Column="7" Text="Attempts" />
                                    <TextBlock Grid.Column="8" Text="Issue" />
                                    <TextBlock Grid.Column="9" Text="Details" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Model_ScannerRunItem">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.5*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind SequenceNumber}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind PartId}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind FromWarehouse}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind FromLocation}" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind ToWarehouse}" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind ToLocation}" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind ExecutionState}" />
                                        <TextBlock Grid.Column="7" Text="{x:Bind ValidationState}" />
                                        <TextBlock Grid.Column="8" Text="{x:Bind IssueType}" />
                                        <TextBlock Grid.Column="9" Text="{x:Bind IssueMessage}" TextWrapping="WrapWholeWords" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Padding="24,12,24,16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.NavigateToWorkbenchCommand}" Content="Workbench" />
                <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.NavigateToHistoryCommand}" Content="History" />
                <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.NavigateToSettingsCommand}" Content="Settings" />
            </StackPanel>
        </Border>
    </Grid>
</Page>