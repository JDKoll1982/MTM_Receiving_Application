<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Scanner.Views.View_Scanner_ManageItemsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MTM_Receiving_Application.Module_Scanner.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Manage Items"
    PrimaryButtonText="Apply"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1600</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">1000</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
        <Style x:Key="ScannerActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </ContentDialog.Resources>

    <!-- Task 5 fix: explicit MinWidth/MinHeight plus a constrained, scrollable list so
         content is never cut off regardless of the number of rows. -->
    <Grid RowSpacing="12" MinWidth="1000" MinHeight="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource ScannerActionButtonStyle}" Click="AddItem_Click" Content="Add Item" />
            <Button Grid.Column="1" Style="{StaticResource ScannerActionButtonStyle}" Click="DuplicateItem_Click" Content="Duplicate" />
            <Button Grid.Column="2" Style="{StaticResource ScannerActionButtonStyle}" Click="MoveUpItem_Click" Content="Move Up" />
            <Button Grid.Column="3" Style="{StaticResource ScannerActionButtonStyle}" Click="MoveDownItem_Click" Content="Move Down" />
            <Button Grid.Column="4" Style="{StaticResource ScannerActionButtonStyle}" Click="DeleteItem_Click" Content="Delete" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            MaxHeight="420"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            HorizontalScrollMode="Enabled">
            <ListView
                x:Name="ItemsListView"
                SelectionMode="Single"
                ItemsSource="{x:Bind Items, Mode=OneWay}"
                SelectedItem="{x:Bind SelectedItem, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Model_ScannerBatchItem">
                        <Border
                            Margin="0,0,0,8"
                            Padding="10"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            CornerRadius="6">
                            <Grid ColumnSpacing="8" RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="1.7*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="0.7*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind SequenceNumber}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Header="Part" Text="{x:Bind PayloadPartId, Mode=TwoWay}" />
                                <TextBox Grid.Row="0" Grid.Column="2" Header="From WH" IsReadOnly="True" Text="{x:Bind PayloadFromWarehouse, Mode=OneTime}" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Header="From Loc"
                                    LostFocus="LocationTextBox_LostFocus"
                                    Tag="From"
                                    Text="{x:Bind PayloadFromLocation, Mode=TwoWay}" />
                                <TextBox Grid.Row="0" Grid.Column="4" Header="To WH" IsReadOnly="True" Text="{x:Bind PayloadToWarehouse, Mode=OneTime}" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="5"
                                    Header="To Loc"
                                    LostFocus="LocationTextBox_LostFocus"
                                    Tag="To"
                                    Text="{x:Bind PayloadToLocation, Mode=TwoWay}" />
                                <TextBox Grid.Row="0" Grid.Column="6" Header="Qty" Text="{x:Bind PayloadQuantity, Mode=TwoWay}" />
                                <TextBlock Grid.Row="0" Grid.Column="7" VerticalAlignment="Center" Text="{x:Bind ValidationState}" />

                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="8"
                                    Header="Notes"
                                    IsReadOnly="True"
                                    Text="{x:Bind ValidationNotes, Mode=OneTime}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock
                x:Name="ApplyErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Warehouse values stay read-only. Apply saves the reordered batch back to the current list." />
        </StackPanel>
    </Grid>
</ContentDialog>
