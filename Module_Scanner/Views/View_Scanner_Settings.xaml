<Page
    x:Class="MTM_Receiving_Application.Module_Scanner.Views.View_Scanner_Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MTM_Receiving_Application.Module_Scanner.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="ScannerSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="ScannerActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="ScannerPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="16"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.32*" />
                <ColumnDefinition Width="0.68*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="14"
                Background="{ThemeResource LayerFillColorAltBrush}"
                CornerRadius="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Profiles" />

                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.NewProfileCommand}" Content="New" />
                        <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.DuplicateProfileCommand}" Content="Copy" />
                        <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.DeleteProfileCommand}" Content="Delete" />
                    </StackPanel>

                    <ListView
                        Grid.Row="2"
                        ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Model_ScannerProfile">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind ProfileName}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind OwnerUserId}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button
                        Grid.Row="3"
                        Style="{StaticResource ScannerActionButtonStyle}"
                        HorizontalAlignment="Left"
                        Command="{x:Bind ViewModel.LoadProfilesCommand}"
                        Content="Load Profiles" />
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Column="1"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollMode="Auto"
                VerticalScrollBarVisibility="Auto">
                <Border
                    Padding="14"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    CornerRadius="8">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Profile Name" Text="{x:Bind ViewModel.ProfileName, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource ScannerActionButtonStyle}"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.SetDefaultProfileCommand}"
                                Content="Set As Default" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="8">
                            <TextBlock Style="{StaticResource ScannerSectionHeaderStyle}" Text="Application" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="Executable" Text="{x:Bind ViewModel.TargetExecutableName, Mode=TwoWay}" />
                                <TextBox Grid.Column="1" Header="Window Title" Text="{x:Bind ViewModel.AppWindowTitle, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="Child Screen" Text="{x:Bind ViewModel.TargetChildWindowTitle, Mode=TwoWay}" />
                                <TextBox Grid.Column="1" Header="Optional Window Class" Text="{x:Bind ViewModel.AppWindowClass, Mode=TwoWay}" />
                            </Grid>
                            <ToggleSwitch Header="Exact Title Match" IsOn="{x:Bind ViewModel.RequireExactTitleMatch, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="8">
                            <TextBlock Style="{StaticResource ScannerSectionHeaderStyle}" Text="Warehouse Defaults" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="From Warehouse" Text="{x:Bind ViewModel.FromWarehouseDefault, Mode=TwoWay}" />
                                <TextBox Grid.Column="1" Header="To Warehouse" Text="{x:Bind ViewModel.ToWarehouseDefault, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Warehouse values are settings-controlled and read-only on workbench items." />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Spacing="8">
                            <TextBlock Style="{StaticResource ScannerSectionHeaderStyle}" Text="Timing (Milliseconds)" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox Grid.Column="0" Header="Startup Wait" Minimum="0" Value="{x:Bind ViewModel.ActivationDelayMs, Mode=TwoWay}" />
                                <NumberBox Grid.Column="1" Header="Delay Between Fields" Minimum="0" Value="{x:Bind ViewModel.DelayBetweenFieldsMs, Mode=TwoWay}" />
                                <NumberBox Grid.Column="2" Header="Pause After Item" Minimum="0" Value="{x:Bind ViewModel.PauseAfterItemMs, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox Grid.Column="0" Header="Popup Timeout" Minimum="0" Value="{x:Bind ViewModel.PopupTimeoutMs, Mode=TwoWay}" />
                                <NumberBox Grid.Column="1" Header="Auto-close Popup Timeout" Minimum="0" Value="{x:Bind ViewModel.PopupCloseTimeoutMs, Mode=TwoWay}" />
                            </Grid>
                            <ToggleSwitch Header="Allow Advanced Timing" IsOn="{x:Bind ViewModel.AllowAdvancedTiming, Mode=TwoWay}" />
                            <Border
                                Padding="10"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                CornerRadius="6">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Advanced timing is optional (usually off). When on, enforce safety timeouts." />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Spacing="8">
                            <TextBlock Style="{StaticResource ScannerSectionHeaderStyle}" Text="Keyboard Shortcuts" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="Start/Send" Text="{x:Bind ViewModel.SendShortcutChord, Mode=TwoWay}" />
                                <TextBox Grid.Column="1" Header="Stop" Text="{x:Bind ViewModel.StopShortcutChord, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Keys must be different. Stop works between items." />
                            <Border
                                Padding="10"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                CornerRadius="6">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Use distinct shortcuts to prevent accidental stop/start overlap." />
                            </Border>
                        </StackPanel>

                        <StackPanel
                            Grid.Row="5"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.ResetEditorCommand}" Content="Reset" />
                            <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.ApplySafeDefaultsCommand}" Content="Safe Defaults" />
                            <Button Style="{StaticResource ScannerPrimaryActionButtonStyle}" Command="{x:Bind ViewModel.SaveProfileCommand}" Content="Save" />
                        </StackPanel>

                        <Border
                            Grid.Row="6"
                            Padding="10"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            CornerRadius="6">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Use Load Profiles before editing defaults for a specific user." />
                        </Border>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="24,12,24,16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.NavigateToWorkbenchCommand}" Content="Workbench" />
                <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.NavigateToHistoryCommand}" Content="History" />
                <Button Style="{StaticResource ScannerActionButtonStyle}" Command="{x:Bind ViewModel.NavigateToSettingsCommand}" Content="Settings" />
            </StackPanel>
        </Border>
    </Grid>
</Page>