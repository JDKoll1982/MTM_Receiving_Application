<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Scanner.Views.View_Scanner_AdvancedMoveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MTM_Receiving_Application.Module_Scanner.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Advanced Bulk Move"
    PrimaryButtonText="Next"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="PrimaryButton_Click"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <Style x:Key="ScannerDialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </ContentDialog.Resources>

    <Grid MinWidth="760" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="StatusTextBlock"
            Grid.Row="3"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <!--  Step 1: Select From Location  -->
        <Grid
            x:Name="Step1Panel"
            Grid.Row="0"
            Grid.RowSpan="3"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                FontWeight="SemiBold"
                Text="1. Select a From Location and choose the parts to move." />

            <Grid
                Grid.Row="1"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="From Loc" />
                <TextBox
                    x:Name="FromLocationTextBox"
                    Grid.Column="1"
                    Header="From Location"
                    PlaceholderText="e.g. RECV" />
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    Click="LoadParts_Click"
                    Content="Load Parts"
                    Style="{StaticResource ScannerDialogButtonStyle}" />
            </Grid>

            <Grid Grid.Row="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="✓" />
                    <TextBlock Grid.Column="1" Text="Entries" />
                    <TextBlock Grid.Column="2" Text="Part" />
                    <TextBlock Grid.Column="3" Text="Description" />
                    <TextBlock Grid.Column="4" Text="Qty" />
                </Grid>

                <ListView
                    x:Name="PartsListView"
                    Grid.Row="1"
                    MaxHeight="360"
                    ItemsSource="{x:Bind Parts, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Model_ScannerBulkMovePart">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Grid.Column="0"
                                    MinWidth="20"
                                    VerticalAlignment="Center"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                <NumberBox
                                    Grid.Column="1"
                                    Width="70"
                                    Minimum="1"
                                    Maximum="99"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind EntryCount, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind PartId}" />
                                <TextBlock
                                    Grid.Column="3"
                                    MaxWidth="260"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind PartDescription}" />
                                <TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Quantity}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!--  Step 2: Add To Locations  -->
        <Grid
            x:Name="Step2Panel"
            Grid.Row="0"
            Grid.RowSpan="3"
            RowSpacing="12"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                FontWeight="SemiBold"
                Text="2. Enter the destination location and quantity for each row." />

            <Grid Grid.Row="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Part" />
                    <TextBlock Grid.Column="1" Text="From" />
                    <TextBlock Grid.Column="2" Text="To Loc" />
                    <TextBlock Grid.Column="3" Text="Qty" />
                </Grid>

                <ListView
                    x:Name="DestinationsListView"
                    Grid.Row="1"
                    MaxHeight="360"
                    ItemsSource="{x:Bind Destinations, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Model_ScannerBulkMoveDestination">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind PartId}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind FromLocation}" />
                                <TextBox
                                    Grid.Column="2"
                                    PlaceholderText="To Loc"
                                    Text="{x:Bind ToLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <NumberBox
                                    Grid.Column="3"
                                    Minimum="0"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind QuantityNumber, Mode=TwoWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
