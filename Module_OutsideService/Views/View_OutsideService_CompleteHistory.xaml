<Page
    x:Class="MTM_Receiving_Application.Module_OutsideService.Views.View_OutsideService_CompleteHistory"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_OutsideService.Models"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_InverseBool x:Key="InverseBoolConverter" />
    </Page.Resources>

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="#fbfcfe"
            BorderBrush="#d6dde8"
            BorderThickness="1"
            CornerRadius="18">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Header="Search"
                    PlaceholderText="Search part, request, vendor, or BOL"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Header="Vendor"
                    ItemsSource="{x:Bind ViewModel.VendorFilterOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedVendorFilter, Mode=TwoWay}" />
                <ComboBox
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Header="Completed"
                    ItemsSource="{x:Bind ViewModel.DateRangeOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedDateRange, Mode=TwoWay}" />
                <Button
                    Grid.Column="3"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Content="Refresh"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="16"
                Background="#fbfcfe"
                BorderBrush="#d6dde8"
                BorderThickness="1"
                CornerRadius="18">
                <ListView
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.FilteredLines, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedLine, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Model_OutsideServiceRequestLine">
                            <Border
                                Margin="0,0,0,8"
                                Padding="12"
                                Background="#ffffff"
                                BorderBrush="#d6dde8"
                                BorderThickness="1"
                                CornerRadius="14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        Text="{x:Bind QueueKey}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        Text="{x:Bind PartId}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind CompletedUtcText}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind SetupVendorName}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        Text="{x:Bind BOLNumber}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Padding="16"
                    Background="#f6f9ff"
                    BorderBrush="#cfe1f7"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="History Detail" />
                        <TextBlock
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.SelectedLine.QueueKey, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedLine.SetupVendorName, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.SelectedLine.BOLNumber, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.SelectedLine.PackageSummaryMultiline, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SelectedLine.CompletionNotes, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="Select a line to review final details." Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>