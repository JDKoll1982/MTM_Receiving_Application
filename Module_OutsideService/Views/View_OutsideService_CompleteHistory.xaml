<Page
    x:Class="MTM_Receiving_Application.Module_OutsideService.Views.View_OutsideService_CompleteHistory"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_OutsideService.Models"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_InverseBool x:Key="InverseBoolConverter" />
        <converters:Converter_InfoBarSeverity x:Key="InfoBarSeverityConverter" />
    </Page.Resources>

    <Grid RowSpacing="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#fbfcfe" BorderBrush="#d6dde8" BorderThickness="1" CornerRadius="18" Padding="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="Search" PlaceholderText="Search part, request, vendor, or BOL" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" />
                <ComboBox Grid.Column="1" Header="Vendor" ItemsSource="{x:Bind ViewModel.VendorFilterOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedVendorFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                <ComboBox Grid.Column="2" Header="Completed" ItemsSource="{x:Bind ViewModel.DateRangeOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedDateRange, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                <Button Grid.Column="3" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#fbfcfe" BorderBrush="#d6dde8" BorderThickness="1" CornerRadius="18" Padding="16">
                <ListView ItemsSource="{x:Bind ViewModel.FilteredLines, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedLine, Mode=TwoWay}" HorizontalAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Model_OutsideServiceRequestLine">
                            <Border Margin="0,0,0,8" Background="#ffffff" BorderBrush="#d6dde8" BorderThickness="1" CornerRadius="14" Padding="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind QueueKey}" FontFamily="Consolas" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind PartId}" FontFamily="Consolas" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind CompletedUtcText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind SetupVendorName}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind BOLNumber}" FontFamily="Consolas" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#f6f9ff" BorderBrush="#cfe1f7" BorderThickness="1" CornerRadius="18" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="History Detail" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedLine.QueueKey, Mode=OneWay}" FontFamily="Consolas" Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedLine.SetupVendorName, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedLine.BOLNumber, Mode=OneWay}" FontFamily="Consolas" Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedLine.PackageSummaryMultiline, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedLine.CompletionNotes, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="Select a line to review final details." Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                    </StackPanel>
                </Border>

                <InfoBar
                    Grid.Row="1"
                    IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                    Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay, Converter={StaticResource InfoBarSeverityConverter}}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    IsClosable="True" />
            </Grid>
        </Grid>
    </Grid>
</Page>