<Page
    x:Class="MTM_Receiving_Application.Module_OutsideService.Views.View_OutsideService_RequestEntry"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_OutsideService.Models"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_InverseBool x:Key="InverseBoolConverter" />
    </Page.Resources>

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="16"
                Background="#fbfcfe"
                BorderBrush="#d6dde8"
                BorderThickness="1"
                CornerRadius="18">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Request Context" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Requested by" />
                    <TextBox IsReadOnly="True" Text="{x:Bind ViewModel.CreatedByDisplay, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Request date" />
                    <DatePicker Date="{x:Bind ViewModel.RequestDate, Mode=OneWay}" IsEnabled="False" />
                    <Border
                        Padding="10,4"
                        Background="#dff6dd"
                        CornerRadius="12">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.DraftBadgeText, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Padding="16"
                Background="#fbfcfe"
                BorderBrush="#d6dde8"
                BorderThickness="1"
                CornerRadius="18">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Request Notes" />
                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="These notes stay with the request."
                        TextWrapping="Wrap" />
                    <TextBox
                        MinHeight="110"
                        AcceptsReturn="True"
                        PlaceholderText="Add request notes."
                        Text="{x:Bind ViewModel.RequestNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="16"
                Background="#fbfcfe"
                BorderBrush="#d6dde8"
                BorderThickness="1"
                CornerRadius="18">
                <Grid
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Current Request Lines" />
                            <TextBlock
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Use Add Line to enter parts and package quantities."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.RequestAddLineCommand}"
                            Content="Add Line"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.CurrentLines, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedLine, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Model_OutsideServiceRequestLine">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    Background="#ffffff"
                                    BorderBrush="#d6dde8"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Text="{x:Bind QueueKey}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Text="{x:Bind PartId}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind PackageCountText}" />
                                        <Border
                                            Grid.Column="3"
                                            Padding="10,4"
                                            Background="#e8f2ff"
                                            CornerRadius="12">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="#0f6cbd"
                                                Text="{x:Bind LinePhaseText}" />
                                        </Border>
                                        <Border
                                            Grid.Column="4"
                                            Padding="10,4"
                                            Background="#dff6dd"
                                            CornerRadius="12">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="#0b6a0b"
                                                Text="Line ready" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Top"
                Spacing="16">
                <Border
                    Height="210"
                    Padding="16"
                    Background="#f6f9ff"
                    BorderBrush="#cfe1f7"
                    BorderThickness="1"
                    CornerRadius="18">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Selected Line Summary" />
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontFamily="Consolas"
                                    Text="{x:Bind ViewModel.SelectedLine.QueueKey, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    Text="{x:Bind ViewModel.SelectedLine.PartId, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    Text="{x:Bind ViewModel.SelectedLine.PackageSummaryMultiline, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="Select a line to review packages." Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="12">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="12">
                <Button Command="{x:Bind ViewModel.ClearRequestCommand}" Content="Clear" />
                <Button
                    Command="{x:Bind ViewModel.SaveRequestCommand}"
                    Content="Save Request"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>