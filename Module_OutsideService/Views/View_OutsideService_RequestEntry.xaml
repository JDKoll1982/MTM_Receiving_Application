<Page
    x:Class="MTM_Receiving_Application.Module_OutsideService.Views.View_OutsideService_RequestEntry"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_OutsideService.Models"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_InverseBool x:Key="InverseBoolConverter" />
        <converters:Converter_InfoBarSeverity x:Key="InfoBarSeverityConverter" />
    </Page.Resources>

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#fbfcfe" BorderBrush="#d6dde8" BorderThickness="1" CornerRadius="18" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Request Context" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Requested by" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBox Text="{x:Bind ViewModel.CreatedByDisplay, Mode=OneWay}" IsReadOnly="True" />
                    <TextBlock Text="Request date" Style="{StaticResource CaptionTextBlockStyle}" />
                    <DatePicker Date="{x:Bind ViewModel.RequestDate, Mode=OneWay}" IsEnabled="False" />
                    <Border Background="#dff6dd" CornerRadius="12" Padding="10,4">
                        <TextBlock Text="{x:Bind ViewModel.DraftBadgeText, Mode=OneWay}" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#fbfcfe" BorderBrush="#d6dde8" BorderThickness="1" CornerRadius="18" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Request Notes" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Notes entered here stay at the request level and follow every line for Shipping context." TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBox Text="{x:Bind ViewModel.RequestNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="110" TextWrapping="Wrap" PlaceholderText="Add request-level notes for Shipping." />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#fbfcfe" BorderBrush="#d6dde8" BorderThickness="1" CornerRadius="18" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Current Request Lines" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Use Add Line to enter Part ID, package count, and package-by-package quantities." Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Add Line" Command="{x:Bind ViewModel.RequestAddLineCommand}" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.CurrentLines, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedLine, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Model_OutsideServiceRequestLine">
                                <Border Margin="0,0,0,8" Background="#ffffff" BorderBrush="#d6dde8" BorderThickness="1" CornerRadius="14" Padding="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind QueueKey}" FontFamily="Consolas" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind PartId}" FontFamily="Consolas" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind PackageCountText}" VerticalAlignment="Center" />
                                        <Border Grid.Column="3" Background="#e8f2ff" CornerRadius="12" Padding="10,4">
                                            <TextBlock Text="{x:Bind LinePhaseText}" Foreground="#0f6cbd" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{x:Bind PackageSummary}" FontFamily="Consolas" TextWrapping="Wrap" />
                                        <Border Grid.Column="5" Background="#dff6dd" CornerRadius="12" Padding="10,4">
                                            <TextBlock Text="Line ready" Foreground="#0b6a0b" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="16">
                <Border Background="#f6f9ff" BorderBrush="#cfe1f7" BorderThickness="1" CornerRadius="18" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Selected Line Summary" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedLine.QueueKey, Mode=OneWay}" FontFamily="Consolas" Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedLine.PartId, Mode=OneWay}" FontFamily="Consolas" Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedLine.PackageSummaryMultiline, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="Select a line to review its package-by-package summary." Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                    </StackPanel>
                </Border>

                <Border Background="#f6f9ff" BorderBrush="#cfe1f7" BorderThickness="1" CornerRadius="18" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="How New Lines Are Added" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="The Add Line modal is the only place where Part ID, package count, and per-package quantities are entered in Version 1." TextWrapping="Wrap" />
                        <TextBlock Text="Package quantities can differ from one package to the next, and the request cannot be saved until every quantity is valid." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="12">
            <InfoBar
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay, Converter={StaticResource InfoBarSeverityConverter}}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                IsClosable="True" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Content="Clear" Command="{x:Bind ViewModel.ClearRequestCommand}" />
                <Button Content="Save Request" Command="{x:Bind ViewModel.SaveRequestCommand}" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>