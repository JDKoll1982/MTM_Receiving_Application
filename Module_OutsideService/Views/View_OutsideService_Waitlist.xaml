<Page
    x:Class="MTM_Receiving_Application.Module_OutsideService.Views.View_OutsideService_Waitlist"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_OutsideService.Models"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_InverseBool x:Key="InverseBoolConverter" />
    </Page.Resources>

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="#fbfcfe"
            BorderBrush="#d6dde8"
            BorderThickness="1"
            CornerRadius="18">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Header="Search"
                    PlaceholderText="Search request, part, vendor, or BOL"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Header="Phase"
                    ItemsSource="{x:Bind ViewModel.PhaseFilterOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedPhaseFilter, Mode=TwoWay}" />
                <ComboBox
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Header="Sort"
                    ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}" />
                <Button
                    Grid.Column="3"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Content="Refresh"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="16"
                Background="#fbfcfe"
                BorderBrush="#d6dde8"
                BorderThickness="1"
                CornerRadius="18">
                <ListView
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.FilteredLines, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedLine, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Model_OutsideServiceRequestLine">
                            <Border
                                Margin="0,0,0,8"
                                Padding="12"
                                Background="#ffffff"
                                BorderBrush="#d6dde8"
                                BorderThickness="1"
                                CornerRadius="14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        Text="{x:Bind QueueKey}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        Text="{x:Bind PartId}" />
                                    <Border
                                        Grid.Column="2"
                                        Padding="10,4"
                                        Background="#e8f2ff"
                                        CornerRadius="12"
                                        Visibility="{x:Bind IsInitialize, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="#0f6cbd"
                                            Text="Initialize" />
                                    </Border>
                                    <Border
                                        Grid.Column="2"
                                        Padding="10,4"
                                        Background="#fff4ce"
                                        CornerRadius="12"
                                        Visibility="{x:Bind IsSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="#8a5d00"
                                            Text="Setup" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind PackageCountText}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind WaitTimeLabel}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Padding="16"
                    Background="#f6f9ff"
                    BorderBrush="#cfe1f7"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Line Detail" />
                        <TextBlock
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.SelectedLine.QueueKey, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.SelectedLine.PartId, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedLine.CreatedByDisplay, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.SelectedLine.PackageSummaryMultiline, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="Select a line to review it and open the next step." Visibility="{x:Bind ViewModel.HasSelectedLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Padding="16"
                    Background="#f6f9ff"
                    BorderBrush="#cfe1f7"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Actions" />
                        <TextBlock Text="Initialize lines open Setup. Setup lines can be edited or completed directly from the waitlist." TextWrapping="Wrap" />
                        <Button
                            Command="{x:Bind ViewModel.OpenSelectedLineCommand}"
                            Content="Open Setup"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.HasSelectedInitializeLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.HasSelectedSetupLine, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Command="{x:Bind ViewModel.OpenSelectedLineCommand}" Content="Edit" />
                            <Button
                                Click="OnMarkCompleteClick"
                                Content="Mark Complete"
                                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>