<Page
    x:Class="MTM_Receiving_Application.Module_OutsideService.Views.View_OutsideService_Main"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="20" RowSpacing="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Active Waitlist" Command="{x:Bind ViewModel.ShowWaitlistCommand}" MinHeight="40" HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Content="Request Entry" Command="{x:Bind ViewModel.ShowRequestEntryCommand}" MinHeight="40" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" Content="Setup" Command="{x:Bind ViewModel.ShowSetupCommand}" IsEnabled="{x:Bind ViewModel.IsSetupEnabled, Mode=OneWay}" MinHeight="40" HorizontalAlignment="Stretch" />
            <Button Grid.Column="3" Content="Complete History" Command="{x:Bind ViewModel.ShowHistoryCommand}" MinHeight="40" HorizontalAlignment="Stretch" />
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ContentControl
                x:Name="RequestEntryHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsRequestEntryVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ContentControl
                x:Name="WaitlistHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsWaitlistVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ContentControl
                x:Name="SetupHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsSetupVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ContentControl
                x:Name="HistoryHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsHistoryVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</Page>