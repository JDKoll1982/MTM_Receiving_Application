<ContentDialog
    x:Class="MTM_Receiving_Application.Module_OutsideService.Views.View_OutsideService_AddLineModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title=""
    PrimaryButtonText="Save To Request"
    CloseButtonText="Cancel"
    PrimaryButtonClick="AddLineDialog_PrimaryButtonClick">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">1320</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1320</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="16" MinWidth="1160">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#115ea3" CornerRadius="18" Padding="20">
            <StackPanel Spacing="8">
                <TextBlock Text="Line Details" Style="{StaticResource TitleTextBlockStyle}" Foreground="White" />
                <TextBlock
                    Text="Enter the part and package quantities for this line."
                    Foreground="#d9ecff"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="PartIdBox"
                    Grid.Column="0"
                    Header="Part ID"
                    LostFocus="PartIdBox_LostFocus"
                    PlaceholderText="Enter part ID" />

                <Button
                    Grid.Column="1"
                    Content="Part Match Helper"
                    Click="PartMatchHelperButton_Click"
                    VerticalAlignment="Bottom" />
            </Grid>

            <Border Background="#f6f9ff" BorderBrush="#cfe1f7" BorderThickness="1" CornerRadius="16" Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PartMatchStatusText" Text="Validation required" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="PartMatchReasonText"
                        Text="Use the helper if the part does not match Infor Visual."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Background="#fbfcfe" BorderBrush="#d6dde8" BorderThickness="1" CornerRadius="16" Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="Number of packages" FontWeight="SemiBold" />
                <NumberBox
                    x:Name="PackageCountBox"
                    Minimum="1"
                    Value="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact"
                    ValueChanged="PackageCountBox_ValueChanged" />
                <TextBlock
                    Text="Changing the count adds or removes rows."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#fbfcfe" BorderBrush="#d6dde8" BorderThickness="1" CornerRadius="16" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Package breakdown" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Each row is one package." TextWrapping="Wrap" />
                    <StackPanel x:Name="PackageRowsPanel" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#f6f9ff" BorderBrush="#cfe1f7" BorderThickness="1" CornerRadius="16" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Entry Guidance" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Use one row per package." TextWrapping="Wrap" />
                    <TextBlock Text="Quantities may vary by package." TextWrapping="Wrap" />
                    <TextBlock Text="Saved lines appear in Request Entry." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" />
    </Grid>
</ContentDialog>