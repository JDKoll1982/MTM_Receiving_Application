<ContentDialog
    x:Class="MTM_Receiving_Application.Module_OutsideService.Views.View_OutsideService_AddLineModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title=""
    CloseButtonText="Cancel"
    PrimaryButtonClick="AddLineDialog_PrimaryButtonClick"
    PrimaryButtonText="Save To Request">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">1320</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1320</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="1160" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="20"
            Background="#115ea3"
            CornerRadius="18">
            <StackPanel Spacing="8">
                <TextBlock
                    Foreground="White"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Line Details" />
                <TextBlock
                    Foreground="#d9ecff"
                    Text="Enter the part and package quantities for this line."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBox
                x:Name="PartIdBox"
                Header="Part ID"
                LostFocus="PartIdBox_LostFocus"
                PlaceholderText="Enter part ID"
                TextChanged="PartIdBox_TextChanged" />

            <Border
                Padding="12"
                Background="#f6f9ff"
                BorderBrush="#cfe1f7"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="PartMatchStatusText"
                        FontWeight="SemiBold"
                        Text="Validation required" />
                    <TextBlock
                        x:Name="PartMatchReasonText"
                        Text="The helper opens automatically if the part is not found."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border
            Grid.Row="2"
            Padding="12"
            Background="#fbfcfe"
            BorderBrush="#d6dde8"
            BorderThickness="1"
            CornerRadius="16">
            <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Number of packages" />
                <NumberBox
                    x:Name="PackageCountBox"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Hidden"
                    ValueChanged="PackageCountBox_ValueChanged"
                    Value="1" />
                <TextBlock Text="Changing the count adds or removes rows." TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="12"
                Background="#fbfcfe"
                BorderBrush="#d6dde8"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Package breakdown" />
                    <TextBlock Text="Each row is one package." TextWrapping="Wrap" />
                    <ScrollViewer
                        x:Name="PackageRowsScrollViewer"
                        Height="208"
                        Style="{StaticResource SharedScrollViewerVerticalOnHorizontalOffHiddenStyle}">
                        <StackPanel x:Name="PackageRowsPanel" Spacing="8" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Padding="12"
                Background="#f6f9ff"
                BorderBrush="#cfe1f7"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Entry Guidance" />
                    <TextBlock Text="Use one row per package." TextWrapping="Wrap" />
                    <TextBlock Text="Quantities may vary by package." TextWrapping="Wrap" />
                    <TextBlock Text="Saved lines appear in Request Entry." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock
            x:Name="ErrorText"
            Grid.Row="4"
            Foreground="Red"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</ContentDialog>
