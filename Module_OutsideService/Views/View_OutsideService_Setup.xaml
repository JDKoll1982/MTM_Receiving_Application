<Page
    x:Class="MTM_Receiving_Application.Module_OutsideService.Views.View_OutsideService_Setup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_OutsideService.Models"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_InverseBool x:Key="InverseBoolConverter" />
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <Grid Padding="20" RowSpacing="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="16">
                    <Border Background="#fbfcfe" BorderBrush="#d6dde8" BorderThickness="1" CornerRadius="18" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Selected Line" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentLine.QueueKey, Mode=OneWay}" FontFamily="Consolas" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentLine.PartId, Mode=OneWay}" FontFamily="Consolas" />
                            <TextBlock Text="Current phase" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentPhaseText, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentLine.WaitTimeLabel, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Background="#fbfcfe" BorderBrush="#d6dde8" BorderThickness="1" CornerRadius="18" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Vendor And Shipment Setup" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ComboBox
                                Header="Suggested vendor"
                                ItemsSource="{x:Bind ViewModel.VendorSuggestions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedVendorSuggestion, Mode=TwoWay}"
                                DisplayMemberPath="VendorName"
                                Visibility="{x:Bind ViewModel.IsVendorSuggestionPickerVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                IsEnabled="{x:Bind ViewModel.UseCustomVendor, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                            <CheckBox Content="Use custom vendor" IsChecked="{x:Bind ViewModel.UseCustomVendor, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanToggleCustomVendor, Mode=OneWay}" />
                            <TextBox Header="Custom vendor name" Text="{x:Bind ViewModel.CustomVendorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind ViewModel.UseCustomVendor, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox Header="Reference number" Text="{x:Bind ViewModel.BolNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <CalendarDatePicker
                                Header="Scheduled ship"
                                Date="{x:Bind ViewModel.ScheduledShipDate, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />
                            <TextBox Header="Shipping contact" Text="{x:Bind ViewModel.ShippingContact, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="Setup notes" Text="{x:Bind ViewModel.SetupNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Background="#f6f9ff" BorderBrush="#cfe1f7" BorderThickness="1" CornerRadius="18" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Package Editor" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <NumberBox Header="Package count" Value="{x:Bind ViewModel.PackageCountInputValue, Mode=TwoWay}" Minimum="1" SmallChange="1" SpinButtonPlacementMode="Compact" />
                            <ListView ItemsSource="{x:Bind ViewModel.EditablePackages, Mode=OneWay}" MaxHeight="240">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Model_OutsideServiceEditablePackage">
                                        <Grid ColumnSpacing="12" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind PackageLabel}" VerticalAlignment="Center" />
                                            <NumberBox Grid.Column="1" Value="{x:Bind PackageQuantity, Mode=TwoWay}" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Background="#f6f9ff" BorderBrush="#cfe1f7" BorderThickness="1" CornerRadius="18" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Before You Save" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="1. Confirm the vendor selection or enter a custom vendor." TextWrapping="Wrap" />
                            <TextBlock Text="2. Update package count and package quantities if the order changed." TextWrapping="Wrap" />
                            <TextBlock Text="3. Enter the reference number, ship date, shipping contact, and setup notes." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Content="Return To Queue" Command="{x:Bind ViewModel.ReturnToQueueCommand}" />
                <Button Content="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}" Command="{x:Bind ViewModel.SavePrimaryActionCommand}" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>