<Page
    x:Class="MTM_Receiving_Application.Module_OutsideService.Views.View_OutsideService_Setup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_OutsideService.Models"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
        <converters:Converter_InverseBool x:Key="InverseBoolConverter" />
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <Grid
            Padding="20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="16">
                    <Border
                        Padding="16"
                        Background="#fbfcfe"
                        BorderBrush="#d6dde8"
                        BorderThickness="1"
                        CornerRadius="18">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Selected Line" />
                            <TextBlock FontFamily="Consolas" Text="{x:Bind ViewModel.CurrentLine.QueueKey, Mode=OneWay}" />
                            <TextBlock FontFamily="Consolas" Text="{x:Bind ViewModel.CurrentLine.PartId, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Current phase" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentPhaseText, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentLine.WaitTimeLabel, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="16"
                        Background="#fbfcfe"
                        BorderBrush="#d6dde8"
                        BorderThickness="1"
                        CornerRadius="18">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Vendor And Shipment Setup" />
                            <ComboBox
                                DisplayMemberPath="VendorName"
                                Header="Suggested vendor"
                                IsEnabled="{x:Bind ViewModel.UseCustomVendor, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                ItemsSource="{x:Bind ViewModel.VendorSuggestions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedVendorSuggestion, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.IsVendorSuggestionPickerVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <CheckBox
                                Content="Use custom vendor"
                                IsChecked="{x:Bind ViewModel.UseCustomVendor, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.CanToggleCustomVendor, Mode=OneWay}" />
                            <TextBox
                                Header="Custom vendor name"
                                Text="{x:Bind ViewModel.CustomVendorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{x:Bind ViewModel.UseCustomVendor, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox Header="Reference number" Text="{x:Bind ViewModel.BolNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <CalendarDatePicker
                                HorizontalAlignment="Stretch"
                                Date="{x:Bind ViewModel.ScheduledShipDate, Mode=TwoWay}"
                                Header="Scheduled ship" />
                            <TextBox Header="Shipping contact" Text="{x:Bind ViewModel.ShippingContact, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                MinHeight="100"
                                AcceptsReturn="True"
                                Header="Setup notes"
                                Text="{x:Bind ViewModel.SetupNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border
                        Padding="16"
                        Background="#f6f9ff"
                        BorderBrush="#cfe1f7"
                        BorderThickness="1"
                        CornerRadius="18">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Package Editor" />
                            <NumberBox
                                Header="Package count"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.PackageCountInputValue, Mode=TwoWay}" />
                            <ListView MaxHeight="240" ItemsSource="{x:Bind ViewModel.EditablePackages, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Model_OutsideServiceEditablePackage">
                                        <Grid Padding="0,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind PackageLabel}" />
                                            <NumberBox
                                                Grid.Column="1"
                                                HorizontalAlignment="Stretch"
                                                Minimum="0"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                Value="{x:Bind PackageQuantity, Mode=TwoWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="16"
                        Background="#f6f9ff"
                        BorderBrush="#cfe1f7"
                        BorderThickness="1"
                        CornerRadius="18">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Before You Save" />
                            <TextBlock Text="1. Confirm the vendor selection or enter a custom vendor." TextWrapping="Wrap" />
                            <TextBlock Text="2. Update package count and package quantities if the order changed." TextWrapping="Wrap" />
                            <TextBlock Text="3. Enter the reference number, ship date, shipping contact, and setup notes." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="12">
                <Button Command="{x:Bind ViewModel.ReturnToQueueCommand}" Content="Return To Queue" />
                <Button
                    Command="{x:Bind ViewModel.SavePrimaryActionCommand}"
                    Content="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>