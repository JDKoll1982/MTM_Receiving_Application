<UserControl
    x:Class="MTM_Receiving_Application.Module_Settings.Core.Views.Controls.Control_SettingsEmailRecipientsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:models="using:MTM_Receiving_Application.Module_Settings.Core.Models"
    xmlns:viewmodels="using:MTM_Receiving_Application.Module_Settings.Core.ViewModels"
    x:Name="Root">
    <UserControl.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
        <Grid Padding="24">
            <StackPanel
                Width="1040"
                HorizontalAlignment="Center"
                Spacing="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="To Recipients" />
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind EditorViewModel.ToRecipientCount, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Saved addresses used in the To line for this module's email workflow."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="CC Recipients" />
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind EditorViewModel.CcRecipientCount, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Saved addresses used in the CC line for this module's email workflow."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind EditorViewModel.EditorTitle, Mode=OneWay}" />

                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBox
                                Grid.Row="0"
                                Grid.Column="0"
                                Header="First Name"
                                Text="{x:Bind EditorViewModel.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Header="Last Name"
                                Text="{x:Bind EditorViewModel.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox
                                Grid.Row="1"
                                Grid.Column="0"
                                Header="Email"
                                PlaceholderText="name@mantoolmfg.com"
                                Text="{x:Bind EditorViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Header="Recipient Type"
                                ItemsSource="{x:Bind EditorViewModel.RecipientTypeOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind EditorViewModel.RecipientType, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="The email field defaults to first initial plus last name with the mantoolmfg.com domain, but any edited address is saved exactly as entered."
                            TextWrapping="Wrap" />

                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="12">
                            <Button Command="{x:Bind EditorViewModel.StartNewRecipientCommand}" Content="New Recipient" />
                            <Button Command="{x:Bind EditorViewModel.RefreshRecipientsCommand}" Content="Refresh" />
                            <Button
                                Command="{x:Bind EditorViewModel.SaveRecipientCommand}"
                                Content="{x:Bind EditorViewModel.SaveButtonText, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="To Recipients" />
                        <ItemsControl ItemsSource="{x:Bind EditorViewModel.ToRecipients, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Model_EmailRecipientSetting">
                                    <Border
                                        Margin="0,0,0,12"
                                        Padding="16"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind FullName, Mode=OneTime}" />
                                                <TextBlock Text="{x:Bind Email, Mode=OneTime}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind OutlookFormat, Mode=OneTime}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Button
                                                    Click="EditRecipientButton_Click"
                                                    Content="Edit"
                                                    Tag="{x:Bind}" />
                                                <Button
                                                    Click="DeleteRecipientButton_Click"
                                                    Content="Delete"
                                                    Tag="{x:Bind}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="CC Recipients" />
                        <ItemsControl ItemsSource="{x:Bind EditorViewModel.CcRecipients, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Model_EmailRecipientSetting">
                                    <Border
                                        Margin="0,0,0,12"
                                        Padding="16"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind FullName, Mode=OneTime}" />
                                                <TextBlock Text="{x:Bind Email, Mode=OneTime}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind OutlookFormat, Mode=OneTime}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Button
                                                    Click="EditRecipientButton_Click"
                                                    Content="Edit"
                                                    Tag="{x:Bind}" />
                                                <Button
                                                    Click="DeleteRecipientButton_Click"
                                                    Content="Delete"
                                                    Tag="{x:Bind}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind EditorViewModel.IsBusy, Mode=OneWay}"
                            Visibility="{x:Bind EditorViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind EditorViewModel.StatusMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
