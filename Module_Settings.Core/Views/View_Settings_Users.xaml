<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Core.Views.View_Settings_Users"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:models="using:MTM_Receiving_Application.Module_Core.Models.Systems"
    xmlns:viewmodels="using:MTM_Receiving_Application.Module_Settings.Core.ViewModels"
    x:Name="RootPage"
    Loaded="Page_Loaded">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BoolToVisibilityConverter" />
        <converters:Converter_InfoBarSeverity x:Key="InfoBarSeverityConverter" />
        <converters:Converter_BoolToString x:Key="BoolToStringConverter" />
        <converters:Converter_IntToString x:Key="IntToStringConverter" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Two-column body  -->
        <Grid
            Grid.Row="2"
            Margin="0,12,0,0"
            ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                ============================================================
                LEFT COLUMN — user list
                ============================================================
            -->
            <Border
                Padding="16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Toolbar  -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.AddNewUserCommand}" Content="Add User" />
                        <Button
                            Click="EditSelectedUser_Click"
                            Content="Edit"
                            IsEnabled="{x:Bind ViewModel.HasSelectedUser, Mode=OneWay}" />
                        <Button
                            Click="ToggleSelectedUserActive_Click"
                            Content="{x:Bind ViewModel.ToggleSelectedUserButtonText, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanToggleSelectedUser, Mode=OneWay}" />
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="UserSearchTextBox"
                            PlaceholderText="Search users or use name:, dept:, role:, shift:"
                            TextChanged="UserSearchTextBox_TextChanged" />

                        <CheckBox
                            x:Name="ShowDeactivatedFilterCheckBox"
                            Grid.Column="1"
                            Content="{x:Bind ViewModel.ShowDeactivatedFilterLabel, Mode=OneWay}"
                            Click="ShowDeactivatedFilterCheckBox_Click"
                            IsThreeState="True"
                            VerticalAlignment="Center" />
                    </Grid>

                    <!--  User list  -->
                    <ListView
                        Grid.Row="2"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{x:Bind ViewModel.UserRows, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedUserRow, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="12" />
                                <Setter Property="Margin" Value="0,0,0,12" />
                                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ViewModel_SettingsUserRoleRow">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind User.FullName}" />
                                            <TextBlock Opacity="0.7">
                                                <Run Text="{x:Bind User.Department}" />
                                                <Run Text=" · " />
                                                <Run Text="{x:Bind User.Shift}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind CurrentRoleDisplayName, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Opacity="0.7"
                                            Text="{x:Bind User.IsActive, Mode=OneTime, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Active|Inactive'}" />
                                    </Grid>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            IsEnabled="{x:Bind CanEditRole, Mode=OneWay}"
                                            ItemsSource="{x:Bind AvailableRoleNames, Mode=OneWay}"
                                            SelectedItem="{x:Bind SelectedRoleName, Mode=TwoWay}" />
                                        <Button
                                            Grid.Column="1"
                                            Click="SaveUserRole_Click"
                                            Content="Save Role"
                                            IsEnabled="{x:Bind CanEditRole, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!--
                ============================================================
                RIGHT COLUMN — edit form
                ============================================================
            -->
            <ScrollViewer
                Grid.Column="1"
                Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}"
                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border
                    Padding="20"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel MaxWidth="520" Spacing="16">
                        <!--  User Details section  -->
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="User Details" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="Full Name" />
                            <TextBox PlaceholderText="First Last" Text="{x:Bind ViewModel.EditingUser.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Employee Number" />
                            <TextBox
                                IsEnabled="{x:Bind ViewModel.IsAddingNew, Mode=OneWay}"
                                PlaceholderText="e.g. 1001"
                                Text="{x:Bind ViewModel.EditingUser.EmployeeNumber, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Windows Username" />
                            <TextBox PlaceholderText="DOMAIN\username" Text="{x:Bind ViewModel.EditingUser.WindowsUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="PIN (4 digits)" />
                            <TextBox
                                MaxLength="4"
                                PlaceholderText="{x:Bind ViewModel.PinPlaceholderText, Mode=OneWay}"
                                Text="{x:Bind ViewModel.EditingUser.Pin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Department" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.Departments, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.EditingUser.Department, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Shift" />
                            <ComboBox HorizontalAlignment="Stretch" SelectedItem="{x:Bind ViewModel.EditingUser.Shift, Mode=TwoWay}">
                                <x:String>1st Shift</x:String>
                                <x:String>2nd Shift</x:String>
                                <x:String>3rd Shift</x:String>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsAddingNew, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Inverse'}">
                            <TextBlock Text="Account Active" />
                            <ToggleSwitch IsOn="{x:Bind ViewModel.EditingUser.IsActive, Mode=TwoWay}" />
                        </StackPanel>

                        <!--  Infor Visual Credentials section  -->
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Infor Visual Credentials" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="Visual Username" />
                            <TextBox
                                x:Name="VisualUsernameTextBox"
                                PlaceholderText="e.g. JSMITH"
                                Text="{x:Bind ViewModel.EditingUser.VisualUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Visual Password" />
                            <PasswordBox
                                x:Name="VisualPasswordBox"
                                PasswordChanged="VisualPasswordBox_PasswordChanged"
                                PlaceholderText="Enter new password to change" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="{x:Bind ViewModel.VisualPasswordMask, Mode=OneWay}" />
                        </StackPanel>

                        <Button
                            Command="{x:Bind ViewModel.SaveVisualCredentialsCommand}"
                            Content="Save Visual Credentials"
                            Visibility="{x:Bind ViewModel.IsAddingNew, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Inverse'}" />

                        <!--  Form footer  -->
                        <StackPanel
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Command="{x:Bind ViewModel.SaveUserCommand}"
                                Content="Save"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button Command="{x:Bind ViewModel.CancelEditCommand}" Content="Cancel" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
