<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Core.Views.View_Settings_DatabaseConfig"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    x:Name="RootPage">

    <Page.Resources>
        <converters:Converter_InverseBool x:Key="InverseBoolConverter" />
        <converters:Converter_InfoBarSeverity x:Key="InfoBarSeverityConverter" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            Grid.Row="0"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay, Converter={StaticResource InfoBarSeverityConverter}}" />

        <ScrollViewer
            Grid.Row="1"
            Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Disabled">
            <StackPanel Spacing="24">

                <!-- ============================= Application database ============================= -->
                <Border
                    Padding="16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Application Database" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Choose which MySQL database this computer connects to. The choice is saved to this PC only (appsettings.local.json next to the executable) and takes effect after a restart. The shared appsettings.json and every other computer stay unchanged."
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Currently connected" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.CurrentDatabaseDisplay, Mode=OneWay}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Server" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.CurrentServerDisplay, Mode=OneWay}" />
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Connect to this database on the next launch" />
                            <ComboBox
                                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{x:Bind ViewModel.ConnectionTargets, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedConnectionTarget, Mode=TwoWay}"
                                Width="420"
                                HorizontalAlignment="Left" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedConnectionTargetSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.DatabaseListStatusText, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Text="{x:Bind ViewModel.PendingStateText, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                Command="{x:Bind ViewModel.TestConnectionCommand}"
                                Content="Test Connection"
                                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                            <Button
                                Command="{x:Bind ViewModel.SaveSelectionCommand}"
                                Content="Save Selection"
                                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                            <Button
                                Command="{x:Bind ViewModel.RefreshDatabasesCommand}"
                                Content="Refresh DB List"
                                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                            <Button
                                Command="{x:Bind ViewModel.RestartApplicationCommand}"
                                Content="Restart Now"
                                IsEnabled="{x:Bind ViewModel.IsRestartPending, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
