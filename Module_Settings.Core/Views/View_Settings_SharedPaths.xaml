<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Core.Views.View_Settings_SharedPaths"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:viewmodels="using:MTM_Receiving_Application.Module_Settings.Core.ViewModels">
    <Page.Resources>
        <converters:Converter_InverseBool x:Key="InverseBoolConverter" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar
            Grid.Row="0"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="Informational" />

        <ScrollViewer Grid.Row="1" Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
            <StackPanel Spacing="24">
                <!--  Export Paths section  -->
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Export Paths" />

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Export Root Path" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Root directory for all application exports and reports." />
                        <TextBox
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                            PlaceholderText="e.g. C:/MTM/Exports"
                            Text="{x:Bind ViewModel.ExportRootPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>

                <!--  Save button  -->
                <Button
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Content="Save"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
