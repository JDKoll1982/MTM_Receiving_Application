<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Core.Views.View_Settings_MaterialAvailabilityBoardFields"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MTM_Receiving_Application.Module_Settings.Core.Models">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Show all chip" />
                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Enable a chip in the work-order dialog that temporarily reveals the logic-only fields without making them permanently visible."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    Header="Enabled"
                    IsOn="{x:Bind ViewModel.IsShowAllChipEnabled, Mode=TwoWay}" />
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button Command="{x:Bind ViewModel.ToggleSelectAllCommand}" Content="{x:Bind ViewModel.SelectAllButtonText, Mode=OneWay}" />
                    <Button Command="{x:Bind ViewModel.ResetCommand}" Content="Reset" />
                    <Button
                        Command="{x:Bind ViewModel.SaveCommand}"
                        Content="Save"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Command="{x:Bind ViewModel.ExpandAllCommand}" Content="Expand all" />
            <Button Command="{x:Bind ViewModel.CollapseAllCommand}" Content="Collapse all" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Style="{StaticResource SharedScrollViewerVerticalAutoHorizontalOffHiddenStyle}">
            <ItemsControl ItemsSource="{x:Bind ViewModel.FieldGroups, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Model_Settings_MaterialAvailabilityFieldGroup">
                        <Expander
                            Margin="0,0,0,12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <Grid Padding="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Title}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind SelectionSummary, Mode=OneWay}" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Padding="0,4" Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Field"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="Choose which work-order fields appear in the Material Availability board dialog and print layout." />
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Show in UI" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Include in print" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Model_Settings_MaterialAvailabilityFieldOption">
                                            <Grid Margin="0,0,0,6" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind DisplayName}"
                                                    TextWrapping="WrapWholeWords" />
                                                <!--  WinUI's default CheckBox reserves a 120px minimum width
                                                      plus content padding. Inside these fixed 100px columns that
                                                      reserve overflows and the visuals clip, so each check box is
                                                      sized to its glyph while keeping a touch-friendly hit area.  -->
                                                <CheckBox
                                                    Grid.Column="1"
                                                    MinWidth="32"
                                                    MinHeight="32"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    IsChecked="{x:Bind IsVisibleInUi, Mode=TwoWay}" />
                                                <CheckBox
                                                    Grid.Column="2"
                                                    MinWidth="32"
                                                    MinHeight="32"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    IsChecked="{x:Bind IsVisibleInPrint, Mode=TwoWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
