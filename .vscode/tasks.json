{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Menu Launcher",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/MTM_Receiving_Application.slnx",
        "-c",
        "${input:buildConfiguration}",
        "/p:Platform=x64",
        "/m:1",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "dependsOn": "clean obj/bin",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Prompts for a build target profile and runs it sequentially."
    },
    {
      "label": "clean obj/bin",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-Command",
        "Get-ChildItem -Recurse -Include bin, obj | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue"
      ],
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      },
      "detail": "Force-deletes all bin and obj folders recursively to unlock stuck WindowsAppSDK files."
    },
    {
      "label": "run app",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/MTM_Receiving_Application.csproj"
      ],
      "problemMatcher": "$msCompile",
      "detail": "Runs the main application project."
    },
    {
      "label": "build debug",
      "dependsOn": "clean obj/bin",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/MTM_Receiving_Application.slnx",
        "-c",
        "Debug",
        "/p:Platform=x64",
        "/m:1",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "detail": "Cleans project artifacts then builds Debug sequentially to prevent file lock errors."
    },
    {
      "label": "build release",
      "dependsOn": "clean obj/bin",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/MTM_Receiving_Application.slnx",
        "-c",
        "Release",
        "/p:Platform=x64",
        "/m:1",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "detail": "Cleans project artifacts then builds Release sequentially to prevent file lock errors."
    },
    {
      "label": "run all tests",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/MTM_Receiving_Application.Tests/MTM_Receiving_Application.Tests.csproj"
      ],
      "problemMatcher": "$msCompile",
      "detail": "Runs all unit tests in the test project."
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/MTM_Receiving_Application.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build startup app",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/MTM_Receiving_Application.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign",
        "/p:Platform=x64",
        "/m:1"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/MTM_Receiving_Application.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/MTM_Receiving_Application.slnx"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Start CopilotForms Server",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/docs/CopilotForms/Start-CopilotForms.ps1",
        "-OpenTarget",
        "${input:copilotFormsOpenTarget}"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "copilotforms",
        "pattern": {
          "regexp": "^(LISTENING|ERROR)\\s+(.+)$",
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting CopilotForms",
          "endsPattern": "^LISTENING"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "detail": "Serves the repo root at http://172.16.1.104:8421 and asks whether to open CopilotForms in a VS Code tab or the web browser"
    },
    {
      "label": "CopilotForms: Open Index in Editor",
      "type": "shell",
      "command": "code",
      "args": [
        "${workspaceFolder}/docs/CopilotForms/index.html"
      ],
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Opens docs/CopilotForms/index.html — then press Ctrl+Shift+V for HTML Preview Pro side panel"
    },
    {
      "label": "CopilotForms: Launch (Server + Preview)",
      "dependsOn": [
        "Start CopilotForms Server",
        "CopilotForms: Open Index in Editor"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "detail": "Starts the local server then opens index.html in the editor — press Ctrl+Shift+V to open the HTML Preview Pro side panel"
    },
    {
      "label": "reconciliation narrow tests",
      "type": "shell",
      "command": "C:\\Program Files\\dotnet\\dotnet.exe",
      "args": [
        "test",
        ".\\MTM_Receiving_Application.Tests\\MTM_Receiving_Application.Tests.csproj",
        "--filter",
        "FullyQualifiedName~Service_ReceivingLocationReconciliationTests|FullyQualifiedName~ViewModel_Receiving_LocationReconciliationReviewTests"
      ],
      "isBackground": false
    },
    {
      "label": "reconciliation service tests",
      "type": "shell",
      "command": "C:\\Program Files\\dotnet\\dotnet.exe",
      "args": [
        "test",
        ".\\MTM_Receiving_Application.Tests\\MTM_Receiving_Application.Tests.csproj",
        "--filter",
        "FullyQualifiedName~Service_ReceivingLocationReconciliationTests"
      ],
      "isBackground": false
    },
    {
      "label": "reconciliation review viewmodel tests",
      "type": "shell",
      "command": "C:\\Program Files\\dotnet\\dotnet.exe",
      "args": [
        "test",
        ".\\MTM_Receiving_Application.Tests\\MTM_Receiving_Application.Tests.csproj",
        "--filter",
        "FullyQualifiedName~ViewModel_Receiving_LocationReconciliationReviewTests"
      ],
      "isBackground": false
    }
  ],
  "inputs": [
    {
      "id": "buildConfiguration",
      "type": "pickString",
      "description": "Select compilation target deployment environment:",
      "default": "Debug",
      "options": [
        {
          "label": "🔧 Debug Profile (Local Development Engine)",
          "value": "Debug"
        },
        {
          "label": "🚀 Release Profile (Optimized Production Output)",
          "value": "Release"
        }
      ]
    },
    {
      "id": "copilotFormsOpenTarget",
      "type": "pickString",
      "description": "Where should CopilotForms open when the server starts?",
      "default": "editor",
      "options": [
        {
          "label": "VS Code interactive preview",
          "value": "editor"
        },
        {
          "label": "Web browser",
          "value": "browser"
        },
        {
          "label": "Do not open automatically",
          "value": "none"
        }
      ]
    }
  ]
}
