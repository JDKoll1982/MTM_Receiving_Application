{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serena: ensure MCP server is running",
      "detail": "Starts the shared Serena MCP server on port 24300 only if it is not already running.",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.serena/start-serena-http.ps1"
      ],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "Serena: restart MCP server",
      "detail": "Stops any process on port 24300 and starts a fresh Serena MCP server.",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.serena/start-serena-http.ps1",
        "-ForceRestart"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Serena: stop MCP server",
      "detail": "Stops the shared Serena MCP server listening on port 24300.",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.serena/stop-serena-http.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
