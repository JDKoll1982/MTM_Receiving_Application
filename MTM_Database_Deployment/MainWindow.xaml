<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MTM_Database_Deployment.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Database_Deployment.Models"
    mc:Ignorable="d"
    Title="MTM Database Deployment">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="MTM Database Deployment" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Idempotent object deployment - no migration scripts required"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.SqlRoot}" FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Connection -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Preferred server" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.PreferredServer, Mode=TwoWay}"
                         PlaceholderText="172.16.1.104" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Local fallback" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="3" Text="{x:Bind ViewModel.FallbackServer, Mode=TwoWay}"
                         PlaceholderText="127.0.0.1" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Port / database" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <NumberBox Value="{x:Bind ViewModel.Port, Mode=TwoWay}" Minimum="1" Maximum="65535" Width="110" />
                    <TextBox Text="{x:Bind ViewModel.Database, Mode=TwoWay}" Width="260" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="User / password" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{x:Bind ViewModel.UserName, Mode=TwoWay}" Width="140" />
                    <PasswordBox Password="{x:Bind ViewModel.Password, Mode=TwoWay}" Width="140" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.ActiveServerText, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Content="Test connection" Command="{x:Bind ViewModel.TestConnectionCommand}" />
                    <CheckBox Content="Remove database-only columns and tables"
                              IsChecked="{x:Bind ViewModel.RemoveDatabaseOnlyObjects, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mode + actions -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <RadioButtons SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}" MaxColumns="2">
                        <x:String>Update in place (never drops data)</x:String>
                        <x:String>Fresh rebuild (drops the database)</x:String>
                    </RadioButtons>
                    <CheckBox Content="I understand a fresh rebuild deletes all existing data"
                              IsChecked="{x:Bind ViewModel.ConfirmRebuild, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Preview (What-If)" Command="{x:Bind ViewModel.PreviewCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Deploy" Command="{x:Bind ViewModel.DeployCommand}" />
                    <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
                    <Button Content="Export preview" Command="{x:Bind ViewModel.ExportPlanCommand}" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                    <TextBlock Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.PlanSummary, Mode=OneWay}" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Plan + log -->
        <Grid Grid.Row="3" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Planned changes" FontWeight="SemiBold" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.PlanChanges}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Model_SchemaChange">
                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                    <TextBlock Text="{x:Bind KindLabel}" Width="130" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Target}" Width="320" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Activity log" FontWeight="SemiBold" />
                    <ScrollViewer Grid.Row="1">
                        <TextBlock Text="{x:Bind ViewModel.LogText, Mode=OneWay}" FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
