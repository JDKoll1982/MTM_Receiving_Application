<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MTM_Receiving_Application.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:helpers="using:MTM_Receiving_Application.Module_Core.Helpers.UI"
    xmlns:local="using:MTM_Receiving_Application"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="MainWindowRoot"
    Title="MTM_Receiving_Application"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!--
                Per-button style for the label-file shortcut buttons in the nav pane footer.
                Provides individual hover/pressed highlighting and a discrete rounded border.
            -->
            <Style x:Key="LabelFileButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border
                                    x:Name="BackgroundBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="BackgroundBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Target="BackgroundBorder.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="BackgroundBorder.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="BackgroundBorder.BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Opacity" Value="0.38" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HeaderUserMenuButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border
                                    x:Name="UserCardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <!--  Translucent white keeps the white header text readable on the accent fill.  -->
                                                <Setter Target="UserCardBorder.Background" Value="#26FFFFFF" />
                                                <Setter Target="UserCardBorder.BorderBrush" Value="{TemplateBinding BorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="UserCardBorder.Background" Value="#3DFFFFFF" />
                                                <Setter Target="UserCardBorder.BorderBrush" Value="{TemplateBinding BorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="UserCardBorder.Opacity" Value="0.6" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Custom Title Bar Area (when ExtendsContentIntoTitleBar = true)  -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0" />
                <ColumnDefinition x:Name="PaneToggleColumn" Width="Auto" />
                <ColumnDefinition x:Name="IconColumn" Width="Auto" />
                <ColumnDefinition x:Name="TitleColumn" Width="Auto" />
                <ColumnDefinition x:Name="LeftDragColumn" Width="*" />
                <ColumnDefinition
                    x:Name="SearchColumn"
                    Width="4*"
                    MinWidth="220" />
                <ColumnDefinition
                    x:Name="RightDragColumn"
                    Width="*"
                    MinWidth="48" />
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!--  NavigationView Pane Toggle Button  -->
            <Button
                x:Name="PaneToggleButton"
                Grid.Column="1"
                Width="48"
                Height="48"
                VerticalAlignment="Center"
                Click="PaneToggleButton_Click"
                Style="{StaticResource PaneToggleButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE700;" />
            </Button>

            <!--  App Icon  -->
            <Image
                x:Name="TitleBarIcon"
                Grid.Column="2"
                Width="16"
                Height="16"
                Margin="8,0,4,0"
                Source="Assets/Square44x44Logo.scale-200.png" />

            <!--  App Title  -->
            <TextBlock
                x:Name="TitleBarTextBlock"
                Grid.Column="3"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="MTM Receiving Application" />

            <!--  Search Box  -->
            <AutoSuggestBox
                x:Name="TitleBarSearchBox"
                Grid.Column="5"
                MaxWidth="600"
                Margin="8,0,8,0"
                VerticalAlignment="Center"
                PlaceholderText="Search"
                QueryIcon="Find"
                QuerySubmitted="TitleBarSearchBox_QuerySubmitted"
                SuggestionChosen="TitleBarSearchBox_SuggestionChosen"
                TextChanged="TitleBarSearchBox_TextChanged" />
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            Margin="0,20,20,20"
            HorizontalAlignment="Stretch"
            BackRequested="NavView_BackRequested"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            Loaded="NavView_Loaded"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.Header>
                <Grid
                    MinHeight="80"
                    Margin="-36,0,-4,0"
                    Padding="0,0,24,0"
                    RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="HeaderBarBorder"
                        Grid.Row="0"
                        Padding="12,10"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="HeaderBackButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Click="HeaderBackButton_Click"
                                    CornerRadius="8"
                                    Visibility="Collapsed">
                                    <FontIcon x:Name="HeaderBackButtonIcon" FontSize="14" Glyph="&#xE72B;" />
                                </Button>

                                <TextBlock
                                    x:Name="PageTitleTextBlock"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    MaxLines="1"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="Dashboard"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!--
                                Guided-walk step bar. MainWindow owns it so the walk is described once,
                                in the title bar, instead of by a copy on every workflow page. The card
                                chrome is stripped so the steps sit directly on the header, and the
                                labels are white because the bar only appears on the fixed dark accent
                                fill of the module header.
                            -->
                            <dev:StepBar
                                x:Name="HeaderStepBar"
                                Grid.Column="1"
                                Margin="16,0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Workflow steps"
                                Background="Transparent"
                                BorderThickness="0"
                                Orientation="Horizontal"
                                ShowStepIndex="True"
                                Visibility="Collapsed">
                                <dev:StepBar.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            MaxLines="1"
                                            FontSize="10"
                                            Foreground="White"
                                            Text="{Binding}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </dev:StepBar.ItemTemplate>
                            </dev:StepBar>

                            <Button
                                x:Name="UserMenuButton"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource HeaderUserMenuButtonStyle}">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="UserLogOutMenuItem_Click" Text="Log Out" />
                                    </MenuFlyout>
                                </Button.Flyout>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border
                                        x:Name="UserPictureBorder"
                                        Width="32"
                                        Height="32"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="2"
                                        CornerRadius="16">
                                        <PersonPicture
                                            x:Name="UserPicture"
                                            Width="28"
                                            Height="28"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock
                                        x:Name="UserDisplayTextBlock"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Not Logged In"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <InfoBar
                        x:Name="StatusInfoBar"
                        Grid.Row="1"
                        Margin="0,0,0,2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.NotificationService.IsStatusOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.NotificationService.StatusMessage, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.WinUIStatusSeverity, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button
                                x:Name="StatusInfoBarActionButton"
                                Click="StatusInfoBarActionButton_Click"
                                Visibility="Collapsed" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </Grid>
            </NavigationView.Header>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    Margin="0,0,0,4"
                    Content="Receiving Labels"
                    Tag="ReceivingWorkflowView">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Margin="0,0,0,4"
                    Content="Non-Inventoried Labels"
                    Tag="DunnageLabelPage">

                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA18;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Margin="0,0,0,4"
                    Content="Volvo Dunnage Requisition"
                    Tag="VolvoShipmentEntry">

                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
        <!--  Receiving Validator: the module's single navigation entry, in the Reporting group (FR-062)  -->
                <NavigationViewItem Margin="0,0,0,4" Tag="ReconciliationLauncherPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Receiving Validator" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="from Infor Visual" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem
                    Margin="0,0,0,4"
                    Content="End of Day Reports"
                    Tag="ReportingMainPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Margin="0,0,0,4"
                    Content="Extra Tools"
                    Tag="ShipRecToolsPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Margin="0,0,0,4"
                    Content="Reprint Labels"
                    Tag="ReprintLabelsPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AB;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Margin="0,0,0,4"
                    Content="Scanner"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Scanner functionality is not yet fully implemented. Use with caution."
                    Tag="ScannerMainPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Margin="0,0,0,4"
                    Content="Documentation"
                    Tag="AppDocumentation">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem SelectsOnInvoked="False">
                    <!--  Suppress the full-row hover highlight so only individual buttons glow  -->
                    <NavigationViewItem.Resources>
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewItemRevealBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewItemRevealBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewItemBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewItemBorderBrushPressed" Color="Transparent" />
                    </NavigationViewItem.Resources>
                    <Grid
                        Margin="0,8,0,12"
                        HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            x:Name="PrimaryLabelButtonsPanel"
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="2" />

                        <StackPanel
                            x:Name="PrimaryLabelButtonsPagingPanel"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Spacing="2"
                            Visibility="Collapsed">
                            <Button
                                x:Name="PrimaryLabelButtonsUpButton"
                                Width="22"
                                Height="18"
                                Padding="0"
                                Click="PrimaryLabelButtonsPageUpButton_Click"
                                Style="{StaticResource LabelFileButtonStyle}">
                                <FontIcon FontSize="10" Glyph="&#xE70E;" />
                            </Button>
                            <Button
                                x:Name="PrimaryLabelButtonsDownButton"
                                Width="22"
                                Height="18"
                                Padding="0"
                                Click="PrimaryLabelButtonsPageDownButton_Click"
                                Style="{StaticResource LabelFileButtonStyle}">
                                <FontIcon FontSize="10" Glyph="&#xE70D;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />

                <!--
                    Shared page-navigation strip. It sits under the page content on the side
                    opposite the navigation pane, so Back, Next, Clear Label Data and Help land in
                    the same place on every page. It collapses entirely when the active page
                    supplies no actions, leaving the content the full remaining height.
                -->
                <Border
                    x:Name="ShellActionBarHost"
                    Grid.Row="1"
                    Padding="16,6"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{x:Bind helpers:Helper_Visibility.FromBool(ShellActionBar.IsVisible), Mode=OneWay}">
                    <ScrollViewer
                        x:Name="ShellActionBarScroller"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <!--
                            Three columns: the entry-mode group takes the left star, the Back and
                            Next pair sits centred in the auto column, and Clear Label Data plus Help
                            take the right star. MinWidth keeps the star columns distributing across
                            the full width while the scroller can still reach actions on a narrow
                            window.
                        -->
                        <Grid
                            MinWidth="{x:Bind ShellActionBarScroller.ActualWidth, Mode=OneWay}"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                x:Name="ShellModeGroupPanel"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ColumnSpacing="4"
                                Visibility="{x:Bind helpers:Helper_Visibility.FromBool(ShellActionBar.ShowModeGroup), Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--
                                    Each entry is a two-row grid: the button on top, and the Default
                                    badge underneath. The badge keeps its slot when it is hidden so
                                    every button stays on the same baseline.
                                -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                    </Grid.RowDefinitions>
                                    <Button
                                        x:Name="ShellGuidedButton"
                                        Grid.Row="0"
                                        AutomationProperties.Name="{x:Bind ShellActionBar.Guided.AccessibilityName, Mode=OneWay}"
                                        BorderBrush="{x:Bind helpers:Helper_ShellBrush.ModeBorder(ShellActionBar.Guided.IsActive), Mode=OneWay}"
                                        BorderThickness="1"
                                        Click="ShellModeButton_Click"
                                        Tag="guided"
                                        ToolTipService.ToolTip="{x:Bind ShellActionBar.Guided.DefaultTooltip, Mode=OneWay}">
                                        <TextBlock
                                            Foreground="{x:Bind helpers:Helper_ShellBrush.ModeText(ShellActionBar.Guided.IsActive), Mode=OneWay}"
                                            Text="{x:Bind ShellActionBar.Guided.Label, Mode=OneWay}" />
                                    </Button>
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Text="{x:Bind ShellActionBar.Guided.DefaultBadge, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ShellActionBar.Guided.DefaultTooltip, Mode=OneWay}"
                                        Visibility="{x:Bind helpers:Helper_Visibility.FromBool(ShellActionBar.IsGuidedDefault), Mode=OneWay}" />
                                </Grid>

                                <Border
                                    x:Name="ShellGuidedDivider"
                                    Grid.Column="1"
                                    Width="1"
                                    Height="20"
                                    Margin="4,6,4,0"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind helpers:Helper_Visibility.FromBool(ShellActionBar.Guided.ShowDividerAfter), Mode=OneWay}" />

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                    </Grid.RowDefinitions>
                                    <Button
                                        x:Name="ShellManualButton"
                                        Grid.Row="0"
                                        AutomationProperties.Name="{x:Bind ShellActionBar.Manual.AccessibilityName, Mode=OneWay}"
                                        BorderBrush="{x:Bind helpers:Helper_ShellBrush.ModeBorder(ShellActionBar.Manual.IsActive), Mode=OneWay}"
                                        BorderThickness="1"
                                        Click="ShellModeButton_Click"
                                        Tag="manual"
                                        ToolTipService.ToolTip="{x:Bind ShellActionBar.Manual.DefaultTooltip, Mode=OneWay}">
                                        <TextBlock
                                            Foreground="{x:Bind helpers:Helper_ShellBrush.ModeText(ShellActionBar.Manual.IsActive), Mode=OneWay}"
                                            Text="{x:Bind ShellActionBar.Manual.Label, Mode=OneWay}" />
                                    </Button>
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Text="{x:Bind ShellActionBar.Manual.DefaultBadge, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ShellActionBar.Manual.DefaultTooltip, Mode=OneWay}"
                                        Visibility="{x:Bind helpers:Helper_Visibility.FromBool(ShellActionBar.IsManualDefault), Mode=OneWay}" />
                                </Grid>

                                <Border
                                    x:Name="ShellManualDivider"
                                    Grid.Column="3"
                                    Width="1"
                                    Height="20"
                                    Margin="4,6,4,0"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind helpers:Helper_Visibility.FromBool(ShellActionBar.Manual.ShowDividerAfter), Mode=OneWay}" />

                                <Grid Grid.Column="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                    </Grid.RowDefinitions>
                                    <Button
                                        x:Name="ShellEditButton"
                                        Grid.Row="0"
                                        AutomationProperties.Name="{x:Bind ShellActionBar.Edit.AccessibilityName, Mode=OneWay}"
                                        BorderBrush="{x:Bind helpers:Helper_ShellBrush.ModeBorder(ShellActionBar.Edit.IsActive), Mode=OneWay}"
                                        BorderThickness="1"
                                        Click="ShellModeButton_Click"
                                        Tag="edit"
                                        ToolTipService.ToolTip="{x:Bind ShellActionBar.Edit.DefaultTooltip, Mode=OneWay}">
                                        <TextBlock
                                            Foreground="{x:Bind helpers:Helper_ShellBrush.ModeText(ShellActionBar.Edit.IsActive), Mode=OneWay}"
                                            Text="{x:Bind ShellActionBar.Edit.Label, Mode=OneWay}" />
                                    </Button>
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Text="{x:Bind ShellActionBar.Edit.DefaultBadge, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ShellActionBar.Edit.DefaultTooltip, Mode=OneWay}"
                                        Visibility="{x:Bind helpers:Helper_Visibility.FromBool(ShellActionBar.IsEditDefault), Mode=OneWay}" />
                                </Grid>

                                <Border
                                    x:Name="ShellEditDivider"
                                    Grid.Column="5"
                                    Width="1"
                                    Height="20"
                                    Margin="4,6,4,0"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind helpers:Helper_Visibility.FromBool(ShellActionBar.Edit.ShowDividerAfter), Mode=OneWay}" />

                                <Grid Grid.Column="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                    </Grid.RowDefinitions>
                                    <Button
                                        x:Name="ShellOverlayButton"
                                        Grid.Row="0"
                                        AutomationProperties.Name="{x:Bind ShellActionBar.Overlay.AccessibilityName, Mode=OneWay}"
                                        Command="{x:Bind ShellActionBar.Overlay.Command, Mode=OneWay}"
                                        Content="{x:Bind ShellActionBar.Overlay.Label, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ShellActionBar.Overlay.Tooltip, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Text="{x:Bind ShellActionBar.Overlay.DefaultBadge, Mode=OneWay}"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Grid>

                            <Grid
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                    <Button
                                        x:Name="ShellBackButton"
                                        Grid.Column="0"
                                        AutomationProperties.Name="{x:Bind ShellActionBar.Back.AccessibilityName, Mode=OneWay}"
                                        Command="{x:Bind ShellActionBar.Back.Command, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ShellActionBar.Back.Tooltip, Mode=OneWay}"
                                        Visibility="{x:Bind helpers:Helper_Visibility.FromBool(ShellActionBar.Back.IsVisible), Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{x:Bind helpers:Helper_ShellBrush.ForActionKind(ShellActionBar.Back.Kind), Mode=OneWay}"
                                                Glyph="&#xE72B;" />
                                            <TextBlock
                                                Foreground="{x:Bind helpers:Helper_ShellBrush.ForActionKind(ShellActionBar.Back.Kind), Mode=OneWay}"
                                                Text="{x:Bind ShellActionBar.Back.Label, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>

                                <Border
                                    x:Name="ShellBackNextDivider"
                                    Grid.Column="1"
                                    Width="1"
                                    Height="20"
                                    Margin="4,0"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind helpers:Helper_Visibility.FromBool(ShellActionBar.ShowDividerAfterBack), Mode=OneWay}" />

                                <Button
                                    x:Name="ShellNextButton"
                                    Grid.Column="2"
                                    AutomationProperties.Name="{x:Bind ShellActionBar.Next.AccessibilityName, Mode=OneWay}"
                                    Command="{x:Bind ShellActionBar.Next.Command, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind ShellActionBar.Next.Tooltip, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:Helper_Visibility.FromBool(ShellActionBar.Next.IsVisible), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            Foreground="{x:Bind helpers:Helper_ShellBrush.ForActionKind(ShellActionBar.Next.Kind), Mode=OneWay}"
                                            Text="{x:Bind ShellActionBar.Next.Label, Mode=OneWay}" />
                                        <FontIcon
                                            FontSize="12"
                                            Foreground="{x:Bind helpers:Helper_ShellBrush.ForActionKind(ShellActionBar.Next.Kind), Mode=OneWay}"
                                            Glyph="&#xE72A;" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    x:Name="ShellClearLabelDataButton"
                                    Grid.Column="0"
                                    AutomationProperties.Name="{x:Bind ShellActionBar.ClearLabelData.AccessibilityName, Mode=OneWay}"
                                    Command="{x:Bind ShellActionBar.ClearLabelData.Command, Mode=OneWay}"
                                    IsEnabled="{x:Bind ShellActionBar.ClearLabelData.IsEnabled, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind ShellActionBar.ClearLabelData.Tooltip, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:Helper_Visibility.FromBool(ShellActionBar.ClearLabelData.IsVisible), Mode=OneWay}">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource ShellDangerBrush}"
                                        Glyph="&#xE74D;" />
                                </Button>

                                <Button
                                    x:Name="ShellHelpButton"
                                    Grid.Column="1"
                                    AutomationProperties.Name="{x:Bind ShellActionBar.Help.AccessibilityName, Mode=OneWay}"
                                    Command="{x:Bind ShellActionBar.Help.Command, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind ShellActionBar.Help.Tooltip, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:Helper_Visibility.FromBool(ShellActionBar.Help.IsVisible), Mode=OneWay}">
                                    <FontIcon FontSize="14" Glyph="&#xE9CE;" />
                                </Button>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </NavigationView>

        <!--  Full-window overlay host for modal surfaces such as the image lightbox  -->
        <ContentControl
            x:Name="ModalOverlayHostControl"
            Grid.RowSpan="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Visibility="Collapsed" />
    </Grid>
</Window>
