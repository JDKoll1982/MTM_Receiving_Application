<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MTM_Receiving_Application.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MTM_Receiving_Application"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="MainWindowRoot"
    Title="MTM_Receiving_Application"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!--
                Per-button style for the label-file shortcut buttons in the nav pane footer.
                Provides individual hover/pressed highlighting and a discrete rounded border.
            -->
            <Style x:Key="LabelFileButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border
                                    x:Name="BackgroundBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="BackgroundBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Target="BackgroundBorder.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="BackgroundBorder.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="BackgroundBorder.BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Opacity" Value="0.38" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Custom Title Bar Area (when ExtendsContentIntoTitleBar = true)  -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0" />
                <ColumnDefinition x:Name="PaneToggleColumn" Width="Auto" />
                <ColumnDefinition x:Name="IconColumn" Width="Auto" />
                <ColumnDefinition x:Name="TitleColumn" Width="Auto" />
                <ColumnDefinition x:Name="LeftDragColumn" Width="*" />
                <ColumnDefinition
                    x:Name="SearchColumn"
                    Width="4*"
                    MinWidth="220" />
                <ColumnDefinition
                    x:Name="RightDragColumn"
                    Width="*"
                    MinWidth="48" />
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!--  NavigationView Pane Toggle Button  -->
            <Button
                x:Name="PaneToggleButton"
                Grid.Column="1"
                Width="48"
                Height="48"
                VerticalAlignment="Center"
                Click="PaneToggleButton_Click"
                Style="{StaticResource PaneToggleButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE700;" />
            </Button>

            <!--  App Icon  -->
            <Image
                x:Name="TitleBarIcon"
                Grid.Column="2"
                Width="16"
                Height="16"
                Margin="8,0,4,0"
                Source="Assets/Square44x44Logo.scale-200.png" />

            <!--  App Title  -->
            <TextBlock
                x:Name="TitleBarTextBlock"
                Grid.Column="3"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="MTM Receiving Application" />

            <!--  Search Box  -->
            <AutoSuggestBox
                x:Name="TitleBarSearchBox"
                Grid.Column="5"
                MaxWidth="600"
                Margin="8,0,8,0"
                VerticalAlignment="Center"
                PlaceholderText="Search"
                QueryIcon="Find"
                QuerySubmitted="TitleBarSearchBox_QuerySubmitted"
                SuggestionChosen="TitleBarSearchBox_SuggestionChosen"
                TextChanged="TitleBarSearchBox_TextChanged" />
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            Margin="0,20,20,20"
            HorizontalAlignment="Stretch"
            BackRequested="NavView_BackRequested"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            Loaded="NavView_Loaded"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.Header>
                <Grid MinHeight="80" Padding="0,0,40,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="HeaderBackButton"
                                Padding="8"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="HeaderBackButton_Click"
                                Visibility="Collapsed">
                                <FontIcon FontSize="14" Glyph="&#xE72B;" />
                            </Button>

                            <TextBlock
                                x:Name="PageTitleTextBlock"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                MaxLines="1"
                                Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                                Text="Dashboard" />
                        </StackPanel>

                        <Button
                            x:Name="UserMenuButton"
                            Grid.Column="1"
                            Padding="8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="UserLogOutMenuItem_Click" Text="Log Out" />
                                </MenuFlyout>
                            </Button.Flyout>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PersonPicture
                                    x:Name="UserPicture"
                                    Width="32"
                                    Height="32" />
                                <TextBlock
                                    x:Name="UserDisplayTextBlock"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="Not Logged In" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <InfoBar
                        x:Name="StatusInfoBar"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.NotificationService.IsStatusOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.NotificationService.StatusMessage, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.WinUIStatusSeverity, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button
                                x:Name="StatusInfoBarActionButton"
                                Click="StatusInfoBarActionButton_Click"
                                Visibility="Collapsed" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </Grid>
            </NavigationView.Header>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    Margin="0,0,0,4"
                    Content="Receiving Labels"
                    Tag="ReceivingWorkflowView">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Margin="0,0,0,4"
                    Content="Dunnage Labels"
                    Tag="DunnageLabelPage">

                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA18;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Margin="0,0,0,4"
                    Content="Volvo Dunnage Requisition"
                    Tag="VolvoShipmentEntry">

                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    Margin="0,0,0,4"
                    Content="End of Day Reports"
                    Tag="ReportingMainPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Margin="0,0,0,4"
                    Content="Ship/Rec Tools"
                    Tag="ShipRecToolsPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Margin="0,0,0,4"
                    Content="Documentation"
                    Tag="AppDocumentation">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem SelectsOnInvoked="False">
                    <!--  Suppress the full-row hover highlight so only individual buttons glow  -->
                    <NavigationViewItem.Resources>
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewItemRevealBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewItemRevealBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewItemBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewItemBorderBrushPressed" Color="Transparent" />
                    </NavigationViewItem.Resources>
                    <Grid
                        Margin="0,8,0,12"
                        HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            x:Name="PrimaryLabelButtonsPanel"
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="2" />

                        <StackPanel
                            x:Name="PrimaryLabelButtonsPagingPanel"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Spacing="2"
                            Visibility="Collapsed">
                            <Button
                                x:Name="PrimaryLabelButtonsUpButton"
                                Width="22"
                                Height="18"
                                Padding="0"
                                Click="PrimaryLabelButtonsPageUpButton_Click"
                                Style="{StaticResource LabelFileButtonStyle}">
                                <FontIcon FontSize="10" Glyph="&#xE70E;" />
                            </Button>
                            <Button
                                x:Name="PrimaryLabelButtonsDownButton"
                                Width="22"
                                Height="18"
                                Padding="0"
                                Click="PrimaryLabelButtonsPageDownButton_Click"
                                Style="{StaticResource LabelFileButtonStyle}">
                                <FontIcon FontSize="10" Glyph="&#xE70D;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
            </NavigationView.FooterMenuItems>

            <Frame
                x:Name="ContentFrame"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </NavigationView>
    </Grid>
</Window>
