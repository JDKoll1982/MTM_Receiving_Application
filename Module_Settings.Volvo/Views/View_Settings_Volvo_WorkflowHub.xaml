<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Volvo.Views.View_Settings_Volvo_NavigationHub"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:MTM_Receiving_Application.Module_Settings.Volvo.ViewModels">
    <Grid Padding="24">
        <Border
            MaxWidth="760"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel Spacing="20">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Volvo Settings" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Volvo settings currently focus on maintaining the part catalog used by shipment entry and related workflows."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Width="320"
                    Height="180"
                    Padding="20"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="OnStep0Clicked"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.GetStepVisibility(0), Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <FontIcon
                            FontSize="40"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE8D1;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.GetStepTitle(0), Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Open the active Volvo settings surface to review, add, edit, import, and deactivate part master records."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
