<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Volvo.Views.View_Settings_Volvo_NavigationHub"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:MTM_Receiving_Application.Module_Settings.Volvo.ViewModels">
    <Grid Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        

                <Button
                    Width="320"
                    Height="200"
                    Padding="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="OnStep0Clicked"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.GetStepVisibility(0), Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <FontIcon
                            FontSize="40"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE8D1;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.GetStepTitle(0), Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Open the active Volvo settings surface to review, add, edit, import, and deactivate part master records."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
    </Grid>
</Page>
