<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Volvo.Views.View_Settings_Volvo_NavigationHub"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:MTM_Receiving_Application.Module_Settings.Volvo.ViewModels">
    <Grid
        Padding="24"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <Grid ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Width="320"
                Height="180"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OnStep0Clicked"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE8D1;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Part Catalog" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Review, add, edit, import, and deactivate Volvo part master-data rows."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="1"
                Width="320"
                Height="180"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OnStep1Clicked"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE715;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Email Recipients" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Manage the saved To and CC recipients used when the Volvo email preview is generated."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                Width="320"
                Height="180"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OnStep2Clicked"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE8A5;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Label Files" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Set the LabelView template path used when opening the Volvo label file."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
