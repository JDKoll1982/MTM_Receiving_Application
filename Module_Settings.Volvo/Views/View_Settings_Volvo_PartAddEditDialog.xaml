<ContentDialog
    x:Class="MTM_Receiving_Application.Module_Settings.Volvo.Views.View_Settings_Volvo_PartAddEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Add/Edit Volvo Part"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSaveClicked"
    PrimaryButtonText="Save"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">500</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">640</x:Double>
    </ContentDialog.Resources>

    <Grid
        x:Name="RootGrid"
        MinWidth="500"
        MaxWidth="720"
        Padding="8">
        <StackPanel Spacing="16">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Maintain the Volvo part master with the minimum fields currently used by shipment entry."
                TextWrapping="Wrap" />

            <TextBox
                x:Name="PartNumberTextBox"
                Header="Part Number"
                MaxLength="50"
                PlaceholderText="e.g., V-EMB-500" />

            <NumberBox
                x:Name="QuantityPerSkidNumberBox"
                Header="Quantity Per Skid"
                Maximum="10000"
                Minimum="0"
                PlaceholderText="e.g., 88"
                SpinButtonPlacementMode="Inline"
                Value="0" />

            <InfoBar
                x:Name="EditModeWarning"
                IsClosable="False"
                IsOpen="False"
                Message="Changing quantity per skid updates future use only; historical shipment piece counts remain unchanged."
                Severity="Warning" />

            <Expander Header="Components (planned)" IsExpanded="False">
                <StackPanel Padding="8" Spacing="8">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Component maintenance is still planned as a follow-on settings enhancement." />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Use imports or supporting data tools until that workflow is externalized into this settings surface." />
                </StackPanel>
            </Expander>
        </StackPanel>
    </Grid>
</ContentDialog>
