<Page
    x:Class="MTM_Receiving_Application.Module_Settings.Volvo.Views.View_Settings_Volvo_PartCatalog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:MTM_Receiving_Application.Module_Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Receiving_Application.Module_Volvo.Models"
    xmlns:views="using:MTM_Receiving_Application.Module_Settings.Volvo.Views"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:Converter_BooleanToVisibility x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="24">
        <StackPanel
            Width="Auto"
            HorizontalAlignment="Center"
            Spacing="20">


            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Height="Auto"
                    VerticalAlignment="Stretch"
                    Grid.Column="0"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                    
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Catalog Records" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="Review the current Volvo part list and select a row to edit or inspect related components."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.RefreshCommand}"
                                Content="Refresh"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>

                        
                            <controls:DataGrid
                                Height="500"
                                Grid.Row="1"
                                AlternatingRowBackground="{ThemeResource SystemListLowColor}"
                                AutoGenerateColumns="False"
                                GridLinesVisibility="Horizontal"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                ItemsSource="{x:Bind ViewModel.Parts, Mode=OneWay}"
                                RowHeight="38"
                                SelectedItem="{x:Bind ViewModel.SelectedPart, Mode=TwoWay}"
                                SelectionMode="Single">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTemplateColumn Width="*" Header="Part Number">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="models:Model_VolvoPart">
                                                <TextBlock Text="{x:Bind PartNumber, Mode=OneTime}" />
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                    <controls:DataGridTemplateColumn Width="120" Header="Qty / Skid">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="models:Model_VolvoPart">
                                                <TextBlock Text="{x:Bind QuantityPerSkid, Mode=OneTime}" />
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                    <controls:DataGridTemplateColumn Width="100" Header="Active">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="models:Model_VolvoPart">
                                                <TextBlock Text="{x:Bind IsActive, Mode=OneTime}" />
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>

                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border
                        Padding="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="16">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Catalog Summary" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Padding="12"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Total" />
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.TotalPartsCount, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="12"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Active" />
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.ActivePartsCount, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="2"
                                    Padding="12"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Inactive" />
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.InactivePartsCount, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <ToggleSwitch
                                Header="Show inactive parts"
                                IsOn="{x:Bind ViewModel.ShowInactive, Mode=TwoWay}"
                                OffContent="Only active rows"
                                OnContent="Include inactive rows" />
                            <StackPanel Orientation="Horizontal" Spacing="12">

                                <Button Command="{x:Bind ViewModel.AddPartCommand}" Content="Add Part" />
                                <Button Command="{x:Bind ViewModel.ImportDataCommand}" Content="Bulk Import" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="16">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Selected Part" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedPartNumberText, Mode=OneWay}" />



                            <Button Command="{x:Bind ViewModel.EditPartCommand}" Content="Edit Selected Part" />
                            <Button Command="{x:Bind ViewModel.ViewComponentsCommand}" Content="View Components" />
                            <Button Command="{x:Bind ViewModel.TogglePartActiveCommand}" Content="{x:Bind ViewModel.SelectedPartToggleActionText, Mode=OneWay}" />

                        </StackPanel>
                    </Border>

                    <Border
                        Padding="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Status" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
